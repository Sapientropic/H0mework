/-- Concrete endpoint-source target law for unit center-cover completion.

This is narrower than `SU7A6SignedHeightActiveSectorUnitCenterCoverEndpointGrammarLaw`:
it does not ask for an opaque computed endpoint core.  Instead, the grammar
must choose an endpoint/source target from the source A6 label, prove that this
target is a unit center-cover descent, and prove the three finite endpoint
readout facts for produced active cells.

The remaining hard mathematics is to instantiate this law from the SU(7)
source-path/incidence grammar; this structure only names the exact payload. -/
structure SU7A6SignedHeightConcreteUnitCenterCoverEndpointTargetLaw
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat) where
  targetLeft :
    (source : SU7A6WeightLabel) ->
      0 < su7A6SignedHeight source -> Nat
  targetRight :
    (source : SU7A6WeightLabel) ->
      0 < su7A6SignedHeight source -> Nat
  targetEnergy :
    (source : SU7A6WeightLabel) ->
      0 < su7A6SignedHeight source -> Nat
  unit_center_cover_move :
    ∀ (source : SU7A6WeightLabel)
      (hheight : 0 < su7A6SignedHeight source),
      SU7A6UnitCenterCoverDisplacement source
        (su7A6EndpointSourceLabel
          (targetLeft source hheight)
          (targetRight source hheight)
          (targetEnergy source hheight))
  left_check :
    ∀ (source : SU7A6WeightLabel)
      (hheight : 0 < su7A6SignedHeight source),
      natMultiplicativelyAtomicCheck
        (targetLeft source hheight) = true
  right_check :
    ∀ (source : SU7A6WeightLabel)
      (hheight : 0 < su7A6SignedHeight source),
      natMultiplicativelyAtomicCheck
        (targetRight source hheight) = true
  raw_energy_reads_target :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
      let source := su7A6ConcreteEndpointSourceLabelOf A
      let hheight :=
        (su7A6ConcreteEndpointSourceReadout A).source_signedHeight_pos hpos
      rawCodePairResidualEnergy n
        (targetLeft source hheight)
        (targetRight source hheight) =
          targetEnergy source hheight

namespace SU7A6SignedHeightConcreteUnitCenterCoverEndpointTargetLaw

variable {K : Type*} [Field K]
variable {σ : K} {hσ : σ ≠ 1} {n bound : Nat}

/-- The endpoint target law determines a concrete active-sector unit
center-cover grammar. -/
def grammar
    (L :
      SU7A6SignedHeightConcreteUnitCenterCoverEndpointTargetLaw
        σ hσ n bound) :
    SU7A6ActiveSectorUnitCenterCoverEndpointGrammar where
  leftCodeOf := su7A6ConcreteEndpointSourceGrammar.leftCodeOf
  rightCodeOf := su7A6ConcreteEndpointSourceGrammar.rightCodeOf
  targetOf := fun source hheight =>
    su7A6EndpointSourceLabel
      (L.targetLeft source hheight)
      (L.targetRight source hheight)
      (L.targetEnergy source hheight)
  moveOf := L.unit_center_cover_move

/-- The explicit endpoint-source target law supplies the active-sector
unit-center-cover endpoint grammar law.

This removes the opaque finite-core premise from the unit-center-cover grammar
socket: the core is reconstructed from the target equality plus atomic and raw
endpoint-energy readout facts. -/
def toActiveSectorUnitCenterCoverEndpointGrammarLaw
    (L :
      SU7A6SignedHeightConcreteUnitCenterCoverEndpointTargetLaw
        σ hσ n bound) :
    SU7A6SignedHeightActiveSectorUnitCenterCoverEndpointGrammarLaw
      L.grammar σ hσ n bound where
  source_readout := fun A _hpos =>
    su7A6ConcreteEndpointSourceReadout A
  computed_endpoint_core := by
    intro A hpos
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let R := R0.toSourceReadout
    let hheight := R0.source_signedHeight_pos hpos
    let N := L.grammar.neighborOf R0.source_label hheight
    have htarget :
        N.target =
          su7A6EndpointSourceLabel
            (L.targetLeft R0.source_label hheight)
            (L.targetRight R0.source_label hheight)
            (L.targetEnergy R0.source_label hheight) := by
      rfl
    have C :
        SU7A6UnitCenterCoverComputedEndpointCodeCompletionCore
          su7A6ConcreteEndpointSourceGrammar.readoutFrame A R N :=
      SU7A6UnitCenterCoverComputedEndpointCodeCompletionCore.of_concreteEndpointSourceLabel_target
          (A := A) (R := R) (N := N)
          htarget
          (L.left_check R0.source_label hheight)
          (L.right_check R0.source_label hheight)
          (by
            simpa [R0, hheight, su7A6ConcreteEndpointSourceReadout] using
              L.raw_energy_reads_target A hpos)
    simpa [R0, R, hheight, N, grammar,
      SU7A6ActiveSectorUnitCenterCoverEndpointGrammar.readoutFrame,
      SU7A6ActiveSectorEndpointGrammar.readoutFrame,
      SU7A6ActiveSectorReadoutFrame, su7A6ConcreteEndpointSourceGrammar]
      using C

/-- The target law's center-cover displacement spends exactly one signed-height
unit against the produced active source.

This is the representation-side unit quantization theorem.  It uses only the
generated source readout and the unit center-cover displacement, not the raw
endpoint filter. -/
theorem target_energy_unit
    (L :
      SU7A6SignedHeightConcreteUnitCenterCoverEndpointTargetLaw
        σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    let source := su7A6ConcreteEndpointSourceLabelOf A
    let hheight :=
      (su7A6ConcreteEndpointSourceReadout A).source_signedHeight_pos hpos
    L.targetEnergy source hheight + 1 = A.energy := by
  dsimp
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  have hunit :
      (L.targetEnergy R0.source_label hheight : Int) + 1 =
        (A.energy : Int) := by
    have H :=
      (L.unit_center_cover_move
        R0.source_label hheight).signedHeight_unit_decrement
    rw [su7A6EndpointSourceLabel_signedHeight] at H
    rw [R0.source_height_reads_energy] at H
    exact H
  simpa [R0, hheight, su7A6ConcreteEndpointSourceReadout]
    using (by exact_mod_cast hunit)

/-- After the raw endpoint readout field is supplied, the target law reads as
a raw endpoint-residual unit successor.

This separates the proof sources: `target_energy_unit` is the representation
unit descent, while this theorem adds the finite arithmetic readout. -/
theorem target_raw_energy_unit
    (L :
      SU7A6SignedHeightConcreteUnitCenterCoverEndpointTargetLaw
        σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    let source := su7A6ConcreteEndpointSourceLabelOf A
    let hheight :=
      (su7A6ConcreteEndpointSourceReadout A).source_signedHeight_pos hpos
    rawCodePairResidualEnergy n
      (L.targetLeft source hheight)
      (L.targetRight source hheight) + 1 =
        A.energy := by
  dsimp
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  rw [L.raw_energy_reads_target A hpos]
  simpa [R0, hheight, su7A6ConcreteEndpointSourceReadout]
    using L.target_energy_unit A hpos

/-- The concrete endpoint-source target law directly materializes the generated
lower no-prime cell for a positive produced active cell.

This is the source/phase-to-filtered payoff before any downstream repair-cell
adapter is invoked. -/
theorem materializes_generated_lower_cell
    (L :
      SU7A6SignedHeightConcreteUnitCenterCoverEndpointTargetLaw
        σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    let source := su7A6ConcreteEndpointSourceLabelOf A
    let hheight :=
      (su7A6ConcreteEndpointSourceReadout A).source_signedHeight_pos hpos
    ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
      lower ∈
        generatedNoPrimeBranchingCells n
          (computedEndpointRoomBound bound
            (L.targetLeft source hheight)
            (L.targetRight source hheight)) ∧
        noPrimeBranchingEndpointResidualEnergy lower + 1 = A.energy := by
  dsimp
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let R := R0.toSourceReadout
  let hheight := R0.source_signedHeight_pos hpos
  let N := L.grammar.neighborOf R0.source_label hheight
  have htarget :
      N.target =
        su7A6EndpointSourceLabel
          (L.targetLeft R0.source_label hheight)
          (L.targetRight R0.source_label hheight)
          (L.targetEnergy R0.source_label hheight) := by
    rfl
  simpa [R0, R, hheight, N, grammar, su7A6ConcreteEndpointSourceReadout]
    using
      SU7A6UnitCenterCoverComputedEndpointCodeCompletionCore.materializes_concreteEndpointSourceLabel_target
          (A := A) (R := R) (N := N)
          htarget
          (L.left_check R0.source_label hheight)
          (L.right_check R0.source_label hheight)
          (by
            simpa [R0, hheight, su7A6ConcreteEndpointSourceReadout] using
              L.raw_energy_reads_target A hpos)

end SU7A6SignedHeightConcreteUnitCenterCoverEndpointTargetLaw

/-- Endpoint-code raw unit readout automatically materializes as a
unit-center-cover displacement in the concrete A6 endpoint/source encoding.

This removes one degree of freedom from the next producer gate: once SU(7)
grammar has generated target endpoint codes whose raw residual is exactly one
below the produced source residual, the representation-side unit
center-cover motion is forced by the signed-height readout. -/
def su7A6ConcreteEndpointCodePairUnitTarget_unitCenterCoverDisplacement
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound)
    (targetLeft targetRight : Nat)
    (hunit :
      rawCodePairResidualEnergy n targetLeft targetRight + 1 =
        A.energy) :
    SU7A6UnitCenterCoverDisplacement
      (su7A6ConcreteEndpointSourceLabelOf A)
      (su7A6EndpointSourceLabel targetLeft targetRight
        (rawCodePairResidualEnergy n targetLeft targetRight)) :=
  su7A6UnitCenterCoverDisplacement_of_signedHeight_unit (by
    rw [su7A6EndpointSourceLabel_signedHeight,
      su7A6ConcreteEndpointSourceLabel_signedHeight]
    exact_mod_cast hunit)

/-- A grammar-generated endpoint-code pair with Boolean atomic checks and raw
`E - 1` readout reaches the generated repair-cell source target.

This is the code-pair form of the filtered connectedness gate.  It does not
assume a repair cell, a normalizer, an endpoint shell, coverage, or `F + Q`.
It also does not assume a separate representation move: the concrete A6
endpoint/source encoding forces the unit center-cover displacement from the
raw unit readout above. -/
theorem su7A6ConcreteEndpointCodePairUnitTarget_generated_repair_law
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0)
    (targetLeft targetRight : Nat)
    (hleft : natMultiplicativelyAtomicCheck targetLeft = true)
    (hright : natMultiplicativelyAtomicCheck targetRight = true)
    (hunit :
      rawCodePairResidualEnergy n targetLeft targetRight + 1 =
        A.energy) :
    ∃ completedBound,
      ∃ _repair :
        SU7GeneratedRepairCell A
          (SU7RepairObligation.of_positive A hpos),
        bound ≤ completedBound := by
  let completedBound :=
    computedEndpointRoomBound bound targetLeft targetRight
  let step : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n :=
    noPrimeBranchingCellOfBooleanAtomicRawCell
      (booleanAtomicCellOfRawCodePair n
        targetLeft targetRight hleft hright)
  have hmem :
      step ∈ generatedNoPrimeBranchingCells n completedBound := by
    dsimp [step, completedBound]
    exact
      generatedNoPrimeBranchingCellOf_boundedAtomicRawCodePair_mem
        (repairLeft_mem_rawCodeBoundedList_computedEndpointRoomBound
          bound targetLeft targetRight)
        (repairRight_mem_rawCodeBoundedList_computedEndpointRoomBound
          bound targetLeft targetRight)
        hleft hright
  have hstep_energy :
      noPrimeBranchingEndpointResidualEnergy step + 1 = A.energy := by
    dsimp [step]
    rw [noPrimeBranchingCellOfBooleanAtomicRawCell_energy_eq,
      booleanAtomicCellOfRawCodePair_energy_eq]
    exact hunit
  have hbound : bound ≤ completedBound := by
    simpa [completedBound] using
      bound_le_computedEndpointRoomBound bound targetLeft targetRight
  exact
    ⟨completedBound,
      generatedRepairCell_of_noPrimeUnitStepAtRepairBound
        A hpos hbound hmem hstep_energy,
      hbound⟩

/-- Global concrete endpoint-code target law for the current A6/SU(7)
endpoint-source encoding.

This is now the narrowest code-level producer socket on this track.  It asks
SU(7) grammar to generate endpoint target codes for each positive produced
active cell and to prove only the Boolean no-prime checks plus the raw
`E - 1` readout.  It does not ask for a raw target cell, a center-cover move,
a repair cell, coverage, `F + Q`, a normalizer, or an endpoint shell. -/
structure SU7A6ConcreteEndpointCodePairUnitTargetLaw
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat) where
  targetLeft :
    (A : SU7ProducedActiveCell σ hσ n bound) ->
      A.energy ≠ 0 -> Nat
  targetRight :
    (A : SU7ProducedActiveCell σ hσ n bound) ->
      A.energy ≠ 0 -> Nat
  left_check :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
      natMultiplicativelyAtomicCheck (targetLeft A hpos) = true
  right_check :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
      natMultiplicativelyAtomicCheck (targetRight A hpos) = true
  raw_unit :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
      rawCodePairResidualEnergy n (targetLeft A hpos) (targetRight A hpos) +
          1 =
        A.energy

namespace SU7A6ConcreteEndpointCodePairUnitTargetLaw

variable {K : Type*} [Field K]
variable {σ : K} {hσ : σ ≠ 1} {n bound : Nat}

/-- The code-pair target law forces the corresponding unit center-cover motion
in the concrete A6 endpoint/source encoding. -/
def unitCenterCoverDisplacement
    (L : SU7A6ConcreteEndpointCodePairUnitTargetLaw σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    SU7A6UnitCenterCoverDisplacement
      (su7A6ConcreteEndpointSourceLabelOf A)
      (su7A6EndpointSourceLabel
        (L.targetLeft A hpos)
        (L.targetRight A hpos)
        (rawCodePairResidualEnergy n
          (L.targetLeft A hpos)
          (L.targetRight A hpos))) :=
  su7A6ConcreteEndpointCodePairUnitTarget_unitCenterCoverDisplacement
    A (L.targetLeft A hpos) (L.targetRight A hpos)
    (L.raw_unit A hpos)

/-- The global endpoint-code target law reaches the generated repair-cell
source target for every positive produced active cell. -/
theorem generated_repair_law
    (L : SU7A6ConcreteEndpointCodePairUnitTargetLaw σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    ∃ completedBound,
      ∃ _repair :
        SU7GeneratedRepairCell A
          (SU7RepairObligation.of_positive A hpos),
        bound ≤ completedBound :=
  su7A6ConcreteEndpointCodePairUnitTarget_generated_repair_law
    A hpos (L.targetLeft A hpos) (L.targetRight A hpos)
    (L.left_check A hpos) (L.right_check A hpos)
    (L.raw_unit A hpos)

end SU7A6ConcreteEndpointCodePairUnitTargetLaw

/-- Source-label endpoint-code target law.

This is stricter than `SU7A6ConcreteEndpointCodePairUnitTargetLaw`: target
codes are generated only from the concrete A6 source label and its positive
signed-height witness, not from the whole produced active cell.  The raw
unit law is also stated against the source signed-height itself. -/
structure SU7A6EndpointSourceLabelCodePairUnitTargetLaw
    (n : Nat) where
  targetLeft :
    (source : SU7A6WeightLabel) ->
      0 < su7A6SignedHeight source -> Nat
  targetRight :
    (source : SU7A6WeightLabel) ->
      0 < su7A6SignedHeight source -> Nat
  left_check :
    ∀ (source : SU7A6WeightLabel)
      (hheight : 0 < su7A6SignedHeight source),
      natMultiplicativelyAtomicCheck (targetLeft source hheight) = true
  right_check :
    ∀ (source : SU7A6WeightLabel)
      (hheight : 0 < su7A6SignedHeight source),
      natMultiplicativelyAtomicCheck (targetRight source hheight) = true
  raw_unit_reads_signedHeight :
    ∀ (source : SU7A6WeightLabel)
      (hheight : 0 < su7A6SignedHeight source),
      ((rawCodePairResidualEnergy n
          (targetLeft source hheight)
          (targetRight source hheight) + 1 : Nat) : Int) =
        su7A6SignedHeight source

namespace SU7A6EndpointSourceLabelCodePairUnitTargetLaw

variable {K : Type*} [Field K]
variable {σ : K} {hσ : σ ≠ 1} {n bound : Nat}

/-- A source-label endpoint-code target law instantiates the produced-cell
code-pair target law for the concrete endpoint/source readout. -/
def toConcreteEndpointCodePairUnitTargetLaw
    (L : SU7A6EndpointSourceLabelCodePairUnitTargetLaw n) :
    SU7A6ConcreteEndpointCodePairUnitTargetLaw σ hσ n bound where
  targetLeft := fun A hpos =>
    let R0 := su7A6ConcreteEndpointSourceReadout A
    L.targetLeft R0.source_label (R0.source_signedHeight_pos hpos)
  targetRight := fun A hpos =>
    let R0 := su7A6ConcreteEndpointSourceReadout A
    L.targetRight R0.source_label (R0.source_signedHeight_pos hpos)
  left_check := by
    intro A hpos
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    simpa [R0, hheight] using L.left_check R0.source_label hheight
  right_check := by
    intro A hpos
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    simpa [R0, hheight] using L.right_check R0.source_label hheight
  raw_unit := by
    intro A hpos
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    have H :=
      L.raw_unit_reads_signedHeight R0.source_label hheight
    have Henergy :
        ((rawCodePairResidualEnergy n
            (L.targetLeft R0.source_label hheight)
            (L.targetRight R0.source_label hheight) + 1 : Nat) : Int) =
          (A.energy : Int) := by
      simpa [R0, hheight, su7A6ConcreteEndpointSourceReadout]
        using H.trans R0.source_height_reads_energy
    exact_mod_cast Henergy

/-- The source-label target law reaches the generated repair-cell target for
every positive produced active cell. -/
theorem generated_repair_law
    (L : SU7A6EndpointSourceLabelCodePairUnitTargetLaw n)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    ∃ completedBound,
      ∃ _repair :
        SU7GeneratedRepairCell A
          (SU7RepairObligation.of_positive A hpos),
        bound ≤ completedBound :=
  L.toConcreteEndpointCodePairUnitTargetLaw.generated_repair_law A hpos

end SU7A6EndpointSourceLabelCodePairUnitTargetLaw

/-- Generated-source-label endpoint-code target law.

This is the source/phase-domain version of the previous all-label socket.  The
endpoint target codes are still selected from an A6 source label, but the
Boolean filter and raw `E - 1` readout are required only for labels that are
actually read from a produced active SU(7) cell.  This keeps the producer target
inside the generated weight graph instead of silently quantifying over the whole
A6 lattice. -/
structure SU7A6GeneratedSourceLabelCodePairUnitTargetLaw
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat) where
  targetLeft :
    (source : SU7A6WeightLabel) ->
      0 < su7A6SignedHeight source -> Nat
  targetRight :
    (source : SU7A6WeightLabel) ->
      0 < su7A6SignedHeight source -> Nat
  left_check :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
      let R0 := su7A6ConcreteEndpointSourceReadout A
      let hheight := R0.source_signedHeight_pos hpos
      natMultiplicativelyAtomicCheck
        (targetLeft R0.source_label hheight) = true
  right_check :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
      let R0 := su7A6ConcreteEndpointSourceReadout A
      let hheight := R0.source_signedHeight_pos hpos
      natMultiplicativelyAtomicCheck
        (targetRight R0.source_label hheight) = true
  raw_unit_reads_sourceSignedHeight :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
      let R0 := su7A6ConcreteEndpointSourceReadout A
      let hheight := R0.source_signedHeight_pos hpos
      ((rawCodePairResidualEnergy n
          (targetLeft R0.source_label hheight)
          (targetRight R0.source_label hheight) + 1 : Nat) : Int) =
        su7A6SignedHeight R0.source_label

namespace SU7A6GeneratedSourceLabelCodePairUnitTargetLaw

variable {K : Type*} [Field K]
variable {σ : K} {hσ : σ ≠ 1} {n bound : Nat}

/-- A generated-source-label target law instantiates the produced-cell
code-pair target law for the concrete endpoint/source readout. -/
def toConcreteEndpointCodePairUnitTargetLaw
    (L : SU7A6GeneratedSourceLabelCodePairUnitTargetLaw σ hσ n bound) :
    SU7A6ConcreteEndpointCodePairUnitTargetLaw σ hσ n bound where
  targetLeft := fun A hpos =>
    let R0 := su7A6ConcreteEndpointSourceReadout A
    L.targetLeft R0.source_label (R0.source_signedHeight_pos hpos)
  targetRight := fun A hpos =>
    let R0 := su7A6ConcreteEndpointSourceReadout A
    L.targetRight R0.source_label (R0.source_signedHeight_pos hpos)
  left_check := by
    intro A hpos
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    simpa [R0, hheight] using L.left_check A hpos
  right_check := by
    intro A hpos
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    simpa [R0, hheight] using L.right_check A hpos
  raw_unit := by
    intro A hpos
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    have H :=
      L.raw_unit_reads_sourceSignedHeight A hpos
    have Henergy :
        ((rawCodePairResidualEnergy n
            (L.targetLeft R0.source_label hheight)
            (L.targetRight R0.source_label hheight) + 1 : Nat) : Int) =
          (A.energy : Int) := by
      simpa [R0, hheight, su7A6ConcreteEndpointSourceReadout]
        using H.trans R0.source_height_reads_energy
    exact_mod_cast Henergy

/-- The generated-source-label target law reaches the generated repair-cell
target for every positive produced active cell. -/
theorem generated_repair_law
    (L : SU7A6GeneratedSourceLabelCodePairUnitTargetLaw σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    ∃ completedBound,
      ∃ _repair :
        SU7GeneratedRepairCell A
          (SU7RepairObligation.of_positive A hpos),
        bound ≤ completedBound :=
  L.toConcreteEndpointCodePairUnitTargetLaw.generated_repair_law A hpos

/-- Nat residual-code form of the generated source-label raw-unit readout.

The structure field records the unit law as an integer signed-height equality
because the source/phase label arithmetic lives in the A6 lattice.  Produced
positive cells carry a positive signed-height witness, so the same law reads
faithfully in the Nat residual-code coordinate used by endpoint shells.  This
is still only a source/phase readout: it does not assume a repair cell,
coverage theorem, normalizer, or endpoint shell. -/
theorem raw_unit_reads_sourceSignedHeightNat
    (L : SU7A6GeneratedSourceLabelCodePairUnitTargetLaw σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    rawCodePairResidualEnergy n
        (L.targetLeft R0.source_label hheight)
        (L.targetRight R0.source_label hheight) + 1 =
      su7A6SignedHeightNat R0.source_label := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  let raw :=
    rawCodePairResidualEnergy n
      (L.targetLeft R0.source_label hheight)
      (L.targetRight R0.source_label hheight)
  have H :
      ((raw + 1 : Nat) : Int) =
        su7A6SignedHeight R0.source_label := by
    simpa [R0, hheight, raw] using
      L.raw_unit_reads_sourceSignedHeight A hpos
  have hnonneg : 0 ≤ su7A6SignedHeight R0.source_label :=
    le_of_lt hheight
  unfold su7A6SignedHeightNat
  have htarget_cast :
      (((su7A6SignedHeight R0.source_label).toNat : Nat) : Int) =
        su7A6SignedHeight R0.source_label :=
    Int.toNat_of_nonneg hnonneg
  have hcast :
      ((raw + 1 : Nat) : Int) =
        ((su7A6SignedHeight R0.source_label).toNat : Nat) := by
    rw [htarget_cast]
    exact H
  exact_mod_cast hcast

end SU7A6GeneratedSourceLabelCodePairUnitTargetLaw

/-- Generated-source-label unit center-cover endpoint target law.

This is one layer below `SU7A6GeneratedSourceLabelCodePairUnitTargetLaw`.
Instead of choosing endpoint codes directly, SU(7) grammar chooses a target A6
source/phase label.  For produced active cells this target label must be a
unit center-cover descent, must be faithfully endpoint-shaped by the concrete
encoding, and must pass the finite no-prime endpoint-code filter.  The raw
`E - 1` code-pair law is then derived from representation unit quantization
plus endpoint-shape faithfulness. -/
structure SU7A6GeneratedSourceLabelUnitCenterCoverEndpointTargetLaw
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat) where
  targetLabel :
    (source : SU7A6WeightLabel) ->
      0 < su7A6SignedHeight source -> SU7A6WeightLabel
  unit_center_cover_move :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
      let R0 := su7A6ConcreteEndpointSourceReadout A
      let hheight := R0.source_signedHeight_pos hpos
      SU7A6UnitCenterCoverDisplacement R0.source_label
        (targetLabel R0.source_label hheight)
  target_endpoint_shape :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
      let R0 := su7A6ConcreteEndpointSourceReadout A
      let hheight := R0.source_signedHeight_pos hpos
      let target := targetLabel R0.source_label hheight
      target =
        su7A6EndpointSourceLabel
          (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
          (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target)
          (rawCodePairResidualEnergy n
            (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
            (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target))
  left_check :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
      let R0 := su7A6ConcreteEndpointSourceReadout A
      let hheight := R0.source_signedHeight_pos hpos
      let target := targetLabel R0.source_label hheight
      natMultiplicativelyAtomicCheck
        (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target) = true
  right_check :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
      let R0 := su7A6ConcreteEndpointSourceReadout A
      let hheight := R0.source_signedHeight_pos hpos
      let target := targetLabel R0.source_label hheight
      natMultiplicativelyAtomicCheck
        (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target) = true

/-- Pure generated source-label unit center-cover adjacency law.

This is the weight-graph half of the producer target.  It deliberately does not
mention endpoint-code filters, raw-code readout, generated lower cells, or
repair cells.  SU(7) grammar only has to generate the target source/phase label
and prove that it is a unit center-cover descent from the produced source
label. -/
structure SU7A6GeneratedSourceLabelUnitCenterCoverAdjacencyLaw
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat) where
  targetLabel :
    (source : SU7A6WeightLabel) ->
      0 < su7A6SignedHeight source -> SU7A6WeightLabel
  unit_center_cover_move :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
      let R0 := su7A6ConcreteEndpointSourceReadout A
      let hheight := R0.source_signedHeight_pos hpos
      SU7A6UnitCenterCoverDisplacement R0.source_label
        (targetLabel R0.source_label hheight)

/-- Finite endpoint projection/filter law for a generated source-label target.

This is the filtered projection half.  Given the target-label function generated
by the weight graph, it says that produced active targets are endpoint-shaped
under the concrete source-code readout and pass the Boolean no-prime endpoint
checks. -/
structure SU7A6GeneratedSourceLabelEndpointProjectionLaw
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat)
    (targetLabel :
      (source : SU7A6WeightLabel) ->
        0 < su7A6SignedHeight source -> SU7A6WeightLabel) where
  target_endpoint_shape :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
      let R0 := su7A6ConcreteEndpointSourceReadout A
      let hheight := R0.source_signedHeight_pos hpos
      let target := targetLabel R0.source_label hheight
      target =
        su7A6EndpointSourceLabel
          (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
          (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target)
          (rawCodePairResidualEnergy n
            (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
            (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target))
  left_check :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
      let R0 := su7A6ConcreteEndpointSourceReadout A
      let hheight := R0.source_signedHeight_pos hpos
      let target := targetLabel R0.source_label hheight
      natMultiplicativelyAtomicCheck
        (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target) = true
  right_check :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
      let R0 := su7A6ConcreteEndpointSourceReadout A
      let hheight := R0.source_signedHeight_pos hpos
      let target := targetLabel R0.source_label hheight
      natMultiplicativelyAtomicCheck
        (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target) = true

/-- Local endpoint projection/filter core for one source-phase target label.

This is the pointwise finite projection object behind
`SU7A6GeneratedSourceLabelEndpointProjectionLaw`: the target must be
endpoint-shaped under the concrete code readout, and both endpoint codes must
pass the Boolean no-prime/atomic filter. -/
structure SU7A6EndpointProjectionCore
    (n : Nat) (target : SU7A6WeightLabel) : Prop where
  target_endpoint_shape :
    target =
      su7A6EndpointSourceLabel
        (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
        (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target)
        (rawCodePairResidualEnergy n
          (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
          (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target))
  left_check :
    natMultiplicativelyAtomicCheck
      (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target) = true
  right_check :
    natMultiplicativelyAtomicCheck
      (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target) = true

namespace SU7A6EndpointProjectionCore

/-- Endpoint projection cores read signed height as raw endpoint residual. -/
theorem signedHeight_reads_raw
    {n : Nat} {target : SU7A6WeightLabel}
    (C : SU7A6EndpointProjectionCore n target) :
    su7A6SignedHeight target =
      (rawCodePairResidualEnergy n
        (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
        (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target) : Int) := by
  rw [C.target_endpoint_shape, su7A6EndpointSourceLabel_signedHeight]
  simp [su7A6ConcreteEndpointSourceGrammar,
    su7A6EndpointSourceLabel_leftCode,
    su7A6EndpointSourceLabel_rightCode]

/-- Local projection core as the older three-field endpoint finite core. -/
theorem endpoint_core
    {n : Nat} {target : SU7A6WeightLabel}
    (C : SU7A6EndpointProjectionCore n target) :
    natMultiplicativelyAtomicCheck
        (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target) = true ∧
      natMultiplicativelyAtomicCheck
        (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target) = true ∧
      su7A6SignedHeight target =
        (rawCodePairResidualEnergy n
          (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
          (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target) : Int) :=
  ⟨C.left_check, C.right_check, C.signedHeight_reads_raw⟩

end SU7A6EndpointProjectionCore

/-- P948's fixed simple-root A6 targets fail the local endpoint projection
core.  This is the pointwise version of the old finite-core obstruction:
unfiltered A6 adjacency supplies an `E-1` label, but the endpoint/no-prime
readout can still cut that label out. -/
theorem su7A6P948BoundarySimpleRootTarget_no_endpointProjectionCore
    (i : Fin 6) :
    ¬ SU7A6EndpointProjectionCore 6
      (su7A6P948BoundarySimpleRootTarget i) := by
  intro C
  exact
    su7A6P948BoundarySimpleRootTarget_no_endpoint_core i
      (by
        simpa [su7A6ConcreteEndpointSourceGrammar] using C.endpoint_core)

/-- The concrete endpoint/source grammar's current fixed simple-root selector
fails the endpoint projection core on the P948 boundary source.

This is the guardrail for the new
`...of_endpointProjectionCore` producer mouth: the fixed-root concrete grammar
cannot be the final filtered-connectivity theorem.  The successful P948 target
below needs the center-cover/completion coordinate, not the raw fixed
simple-root neighbor. -/
theorem su7A6ConcreteEndpointSourceGrammar_P948SelectedNeighbor_no_endpointProjectionCore
    (hheight : 0 < su7A6SignedHeight su7A6P948BoundarySourceLabel) :
    let N :=
      su7A6UnfilteredUnitDescentNeighborAt su7A6P948BoundarySourceLabel
        (su7A6ConcreteEndpointSourceGrammar.repairRootOf
          su7A6P948BoundarySourceLabel hheight)
    ¬ SU7A6EndpointProjectionCore 6 N.target := by
  simpa [su7A6ConcreteEndpointSourceGrammar,
    su7A6P948BoundarySimpleRootTarget,
    su7A6UnfilteredUnitDescentNeighborAt] using
    su7A6P948BoundarySimpleRootTarget_no_endpointProjectionCore (0 : Fin 6)

/-- The completed P948 center-cover repair label passes the local endpoint
projection core.

This records the narrow positive half: the completed target is not a
Goldbach/coverage theorem, but it is a genuine finite projection target for
the concrete endpoint source readout. -/
theorem su7A6P948CompletedRepairLabel_endpointProjectionCore :
    SU7A6EndpointProjectionCore 6 su7A6P948CompletedRepairLabel where
  target_endpoint_shape := by
    simp [su7A6P948CompletedRepairLabel, su7A6ConcreteEndpointSourceGrammar,
      su7A6EndpointSourceLabel_leftCode, su7A6EndpointSourceLabel_rightCode,
      rawCodePairResidualEnergy_six_two_five]
  left_check := by
    simpa [su7A6P948CompletedRepairLabel, su7A6ConcreteEndpointSourceGrammar,
      su7A6EndpointSourceLabel_leftCode] using
      natMultiplicativelyAtomicCheck_two
  right_check := by
    simpa [su7A6P948CompletedRepairLabel, su7A6ConcreteEndpointSourceGrammar,
      su7A6EndpointSourceLabel_rightCode] using
      natMultiplicativelyAtomicCheck_five

/-- The P948 unit center-cover neighbor target is exactly the local endpoint
projection core target that the split generated-source-label law can consume. -/
theorem su7A6P948UnitCenterCoverNeighbor_endpointProjectionCore :
    SU7A6EndpointProjectionCore 6
      su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target := by
  simpa [su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor] using
    su7A6P948CompletedRepairLabel_endpointProjectionCore

/-- Pointwise source/phase target core for the representation-generated
successor law.

This is the narrow object the global SU(7) grammar should generate for each
positive produced source label: the same target must be a unit center-cover
descent in the source/phase lattice and must satisfy the finite endpoint
projection core.  It is still upstream of generated repair cells. -/
structure SU7A6SourceLabelUnitCenterCoverProjectionCore
    (n : Nat) (source target : SU7A6WeightLabel) where
  unit_center_cover_move :
    SU7A6UnitCenterCoverDisplacement source target
  endpoint_projection_core :
    SU7A6EndpointProjectionCore n target

namespace SU7A6SourceLabelUnitCenterCoverProjectionCore

/-- A source/projection core supplies the finite computed-endpoint core for
the same unit center-cover neighbor under the concrete endpoint/source readout.

This is the exact finite-filter handoff for the source/phase target: the
target is already a unit center-cover move, and the endpoint projection core
provides the Boolean atomic checks plus signed-height/raw readout. -/
theorem toUnitCenterCoverComputedEndpointCodeCompletionCore
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    {A : SU7ProducedActiveCell σ hσ n bound}
    {R :
      SU7ProducedActiveCellA6SourceReadout
        su7A6ConcreteEndpointSourceGrammar.readoutFrame A}
    {N : SU7A6UnitCenterCoverDescentNeighbor R.source_label}
    (C :
      SU7A6SourceLabelUnitCenterCoverProjectionCore
        n R.source_label N.target) :
    SU7A6UnitCenterCoverComputedEndpointCodeCompletionCore
      su7A6ConcreteEndpointSourceGrammar.readoutFrame A R N := by
  refine ⟨?_, ?_, ?_⟩
  ·
    simpa [SU7A6ActiveSectorEndpointGrammar.readoutFrame,
      SU7A6ActiveSectorReadoutFrame,
      su7A6ConcreteEndpointSourceGrammar] using
      C.endpoint_projection_core.left_check
  ·
    simpa [SU7A6ActiveSectorEndpointGrammar.readoutFrame,
      SU7A6ActiveSectorReadoutFrame,
      su7A6ConcreteEndpointSourceGrammar] using
      C.endpoint_projection_core.right_check
  ·
    simpa [SU7A6ActiveSectorEndpointGrammar.readoutFrame,
      SU7A6ActiveSectorReadoutFrame,
      su7A6ConcreteEndpointSourceGrammar] using
      C.endpoint_projection_core.signedHeight_reads_raw

/-- A source/projection core materializes the generated lower-cell half in the
computed endpoint room, still before constructing a generated repair cell. -/
theorem materializes_generated_lower_cell
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    {A : SU7ProducedActiveCell σ hσ n bound}
    {R :
      SU7ProducedActiveCellA6SourceReadout
        su7A6ConcreteEndpointSourceGrammar.readoutFrame A}
    {N : SU7A6UnitCenterCoverDescentNeighbor R.source_label}
    (C :
      SU7A6SourceLabelUnitCenterCoverProjectionCore
        n R.source_label N.target) :
    ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
      lower ∈
        generatedNoPrimeBranchingCells n
          (computedEndpointRoomBound bound
            (su7A6ConcreteEndpointSourceGrammar.leftCodeOf N.target)
            (su7A6ConcreteEndpointSourceGrammar.rightCodeOf N.target)) ∧
        noPrimeBranchingEndpointResidualEnergy lower + 1 = A.energy := by
  let X :=
    C.toUnitCenterCoverComputedEndpointCodeCompletionCore
      (A := A) (R := R) (N := N)
  simpa [SU7A6ActiveSectorEndpointGrammar.readoutFrame,
    SU7A6ActiveSectorReadoutFrame, su7A6ConcreteEndpointSourceGrammar]
    using X.materializes_generated_lower_cell

/-- A pointwise source/projection core materializes completed-bound filtered
downward connectivity.

This is the local narrow door for the representation track: once SU(7) grammar
produces a unit center-cover source target plus endpoint projection core for
that same target, the computed endpoint room supplies the generated `E - 1`
lower cell. -/
theorem filtered_weight_graph_downward_connectivity
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    {A : SU7ProducedActiveCell σ hσ n bound}
    {R :
      SU7ProducedActiveCellA6SourceReadout
        su7A6ConcreteEndpointSourceGrammar.readoutFrame A}
    {N : SU7A6UnitCenterCoverDescentNeighbor R.source_label}
    (C :
      SU7A6SourceLabelUnitCenterCoverProjectionCore
        n R.source_label N.target) :
    ∃ completedBound,
      ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
        bound ≤ completedBound ∧
          lower ∈ generatedNoPrimeBranchingCells n completedBound ∧
            noPrimeBranchingEndpointResidualEnergy lower + 1 = A.energy := by
  let completedBound :=
    computedEndpointRoomBound bound
      (su7A6ConcreteEndpointSourceGrammar.leftCodeOf N.target)
      (su7A6ConcreteEndpointSourceGrammar.rightCodeOf N.target)
  have Hmat :
      ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
        lower ∈ generatedNoPrimeBranchingCells n completedBound ∧
          noPrimeBranchingEndpointResidualEnergy lower + 1 = A.energy := by
    simpa [completedBound] using
      C.materializes_generated_lower_cell (A := A) (R := R) (N := N)
  rcases Hmat with ⟨lower, hmem, hunit⟩
  exact
    ⟨completedBound, lower,
      by
        simpa [completedBound] using
          bound_le_computedEndpointRoomBound bound
            (su7A6ConcreteEndpointSourceGrammar.leftCodeOf N.target)
            (su7A6ConcreteEndpointSourceGrammar.rightCodeOf N.target),
      hmem, hunit⟩

/-- A source/phase target core derives the projected raw unit successor.

The proof source is exactly the two fields of the core: unit center-cover
quantization and faithful endpoint projection. -/
theorem raw_unit_reads_sourceSignedHeight
    {n : Nat} {source target : SU7A6WeightLabel}
    (C :
      SU7A6SourceLabelUnitCenterCoverProjectionCore n source target) :
    ((rawCodePairResidualEnergy n
        (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
        (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target) + 1 :
          Nat) : Int) =
      su7A6SignedHeight source := by
  let left := su7A6ConcreteEndpointSourceGrammar.leftCodeOf target
  let right := su7A6ConcreteEndpointSourceGrammar.rightCodeOf target
  let raw := rawCodePairResidualEnergy n left right
  have Htarget :
      su7A6SignedHeight target = (raw : Int) := by
    simpa [left, right, raw] using
      C.endpoint_projection_core.signedHeight_reads_raw
  have Hmove :
      su7A6SignedHeight target + 1 =
        su7A6SignedHeight source :=
    C.unit_center_cover_move.signedHeight_unit_decrement
  calc
    ((raw + 1 : Nat) : Int) = (raw : Int) + 1 := by norm_num
    _ = su7A6SignedHeight target + 1 := by rw [← Htarget]
    _ = su7A6SignedHeight source := Hmove

/-- A source/projection core turns its endpoint-code readout into a canonical
Boolean-atomic raw branching cell.

This is still upstream of generated repair cells: it only packages the finite
endpoint-code transform and the two Boolean no-prime checks already carried by
the projection core. -/
def targetRawCell
    {n : Nat} {source target : SU7A6WeightLabel}
    (C :
      SU7A6SourceLabelUnitCenterCoverProjectionCore n source target) :
    SU7BooleanAtomicRawBranchingCell n :=
  booleanAtomicCellOfRawCodePair n
    (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
    (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target)
    C.endpoint_projection_core.left_check
    C.endpoint_projection_core.right_check

/-- The raw cell produced by a source/projection core reads exactly the raw
endpoint-code residual of the same source-label target. -/
theorem targetRawCell_energy_eq_raw
    {n : Nat} {source target : SU7A6WeightLabel}
    (C :
      SU7A6SourceLabelUnitCenterCoverProjectionCore n source target) :
    rawAtomCodeBranchingDecompositionResidualEnergy
        (C.targetRawCell).cell =
      rawCodePairResidualEnergy n
        (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
        (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target) := by
  simp [targetRawCell, booleanAtomicCellOfRawCodePair_energy_eq]

/-- The raw cell produced by a source/projection core is exactly one residual
unit below the source signed-height.

This is the generic version of the local `(5,7)` transform:
source-label target, endpoint-code readout, Boolean no-prime checks, and raw
`E - 1` all come from the same source/phase core. -/
theorem targetRawCell_energy_reads_sourceSignedHeight
    {n : Nat} {source target : SU7A6WeightLabel}
    (C :
      SU7A6SourceLabelUnitCenterCoverProjectionCore n source target) :
    ((rawAtomCodeBranchingDecompositionResidualEnergy
        (C.targetRawCell).cell + 1 : Nat) : Int) =
      su7A6SignedHeight source := by
  rw [C.targetRawCell_energy_eq_raw]
  exact C.raw_unit_reads_sourceSignedHeight

/-- The source/projection core exposes the finite target transform in one
place: endpoint shape, atomic/no-prime checks, and raw signed-height readout. -/
theorem endpointCode_atomic_rawUnit
    {n : Nat} {source target : SU7A6WeightLabel}
    (C :
      SU7A6SourceLabelUnitCenterCoverProjectionCore n source target) :
    target =
        su7A6EndpointSourceLabel
          (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
          (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target)
          (rawCodePairResidualEnergy n
            (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
            (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target)) ∧
      natMultiplicativelyAtomicCheck
          (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target) = true ∧
        natMultiplicativelyAtomicCheck
            (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target) = true ∧
          ((rawCodePairResidualEnergy n
              (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
              (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target) + 1 :
                Nat) : Int) =
            su7A6SignedHeight source := by
  exact
    ⟨C.endpoint_projection_core.target_endpoint_shape,
      C.endpoint_projection_core.left_check,
      C.endpoint_projection_core.right_check,
      C.raw_unit_reads_sourceSignedHeight⟩

end SU7A6SourceLabelUnitCenterCoverProjectionCore

/-- The completed P948 center-cover repair is a source/phase projection core:
one target carries both the unit center-cover move and the finite endpoint
projection core. -/
def su7A6P948CompletedRepairLabel_unitCenterCoverProjectionCore :
    SU7A6SourceLabelUnitCenterCoverProjectionCore
      6 su7A6P948BoundarySourceLabel su7A6P948CompletedRepairLabel where
  unit_center_cover_move :=
    su7A6P948CompletedRepairLabel_unitCenterCoverDisplacement
  endpoint_projection_core :=
    su7A6P948CompletedRepairLabel_endpointProjectionCore

/-- The P948 unit center-cover neighbor is the same pointwise
source/phase-projection core, phrased through the neighbor object. -/
def su7A6P948UnitCenterCoverNeighbor_sourceProjectionCore :
    SU7A6SourceLabelUnitCenterCoverProjectionCore
      6 su7A6P948BoundarySourceLabel
      su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target := by
  simpa [su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor] using
    su7A6P948CompletedRepairLabel_unitCenterCoverProjectionCore

/-- A produced active cell whose source endpoint codes are P948's `(3,3)`
has residual energy `6`.

This is a produced-cell readout calibration, not a constructor for a P950
witness: the produced cell still has to come from a canonical rich source path.
-/
theorem su7A6P948ProducedActiveCell_energy_eq_six
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    (A : SU7ProducedActiveCell σ hσ 6 3)
    (hleft : A.sourceCell.cell.leftWeightCode = 3)
    (hright : A.sourceCell.cell.rightWeightCode = 3) :
    A.energy = 6 := by
  rw [SU7ProducedActiveCell.energy_eq_raw_source_pair A,
    hleft, hright, rawCodePairResidualEnergy_six_three_three]

/-- The concrete endpoint/source readout of a P948-coded produced cell is the
P948 boundary source label.

This is the point where the local P948 boundary sample is lifted from a naked
A6 label to an actual produced-cell readout. -/
theorem su7A6P948ProducedActiveCell_sourceLabel_eq
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    (A : SU7ProducedActiveCell σ hσ 6 3)
    (hleft : A.sourceCell.cell.leftWeightCode = 3)
    (hright : A.sourceCell.cell.rightWeightCode = 3) :
    (su7A6ConcreteEndpointSourceReadout A).source_label =
      su7A6P948BoundarySourceLabel := by
  have henergy := su7A6P948ProducedActiveCell_energy_eq_six A hleft hright
  simp [su7A6ConcreteEndpointSourceReadout,
    su7A6ConcreteEndpointSourceLabelOf, su7A6P948BoundarySourceLabel,
    hleft, hright, henergy]

/-- The fixed-root concrete endpoint grammar fails the projection core on
P948-coded produced active cells.

This ties the local P948 boundary obstruction back to the actual
`SU7ProducedActiveCell` interface: if the produced source endpoint codes are
`(3,3)`, the concrete grammar's current fixed simple-root lowered neighbor is
not a legal filtered endpoint target. -/
theorem su7A6P948ProducedActiveCell_fixedRootSelectedNeighbor_no_endpointProjectionCore
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    (A : SU7ProducedActiveCell σ hσ 6 3)
    (hleft : A.sourceCell.cell.leftWeightCode = 3)
    (hright : A.sourceCell.cell.rightWeightCode = 3)
    (hpos : A.energy ≠ 0) :
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    let N :=
      su7A6UnfilteredUnitDescentNeighborAt R0.source_label
        (su7A6ConcreteEndpointSourceGrammar.repairRootOf
          R0.source_label hheight)
    ¬ SU7A6EndpointProjectionCore 6 N.target := by
  dsimp only
  intro hcore
  have henergy : A.energy = 6 :=
    su7A6P948ProducedActiveCell_energy_eq_six A hleft hright
  have htarget :
      (su7A6UnfilteredUnitDescentNeighborAt
        (su7A6ConcreteEndpointSourceReadout A).source_label
        (su7A6ConcreteEndpointSourceGrammar.repairRootOf
          (su7A6ConcreteEndpointSourceReadout A).source_label
          ((su7A6ConcreteEndpointSourceReadout A).source_signedHeight_pos
            hpos))).target =
        su7A6P948BoundarySimpleRootTarget (0 : Fin 6) := by
    simp [su7A6ConcreteEndpointSourceReadout,
      su7A6ConcreteEndpointSourceLabelOf, su7A6ConcreteEndpointSourceGrammar,
      su7A6P948BoundarySimpleRootTarget, su7A6P948BoundarySourceLabel,
      su7A6UnfilteredUnitDescentNeighborAt, hleft, hright, henergy]
  exact
    (su7A6P948BoundarySimpleRootTarget_no_endpointProjectionCore
      (0 : Fin 6)) (by
        simpa [htarget] using hcore)

/-- The concrete fixed-root endpoint projection law cannot cover a P948-coded
produced active source path.

This is the global projection-law version of
`su7A6P948ProducedActiveCell_fixedRootSelectedNeighbor_no_endpointProjectionCore`:
`localCore` would force an endpoint projection core for the grammar-selected
fixed simple-root neighbor, exactly the target that the P948 obstruction cuts
out. -/
theorem su7A6_concreteEndpointSourceGrammar_endpointProjectionLaw_contradicts_P948
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    (Proj :
      SU7A6GeneratedSourceLabelEndpointProjectionLaw
        σ hσ 6 3
        (fun source hheight =>
          (su7A6UnfilteredUnitDescentNeighborAt source
            (su7A6ConcreteEndpointSourceGrammar.repairRootOf
              source hheight)).target))
    (A : SU7ProducedActiveCell σ hσ 6 3)
    (hleft : A.sourceCell.cell.leftWeightCode = 3)
    (hright : A.sourceCell.cell.rightWeightCode = 3)
    (hpos : A.energy ≠ 0) :
    False := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  let N :=
    su7A6UnfilteredUnitDescentNeighborAt R0.source_label
      (su7A6ConcreteEndpointSourceGrammar.repairRootOf
        R0.source_label hheight)
  have hnoCore :
      ¬ SU7A6EndpointProjectionCore 6 N.target := by
    simpa [R0, hheight, N] using
      su7A6P948ProducedActiveCell_fixedRootSelectedNeighbor_no_endpointProjectionCore
        A hleft hright hpos
  have Hcore : SU7A6EndpointProjectionCore 6 N.target := by
    refine
      { target_endpoint_shape := ?_
        left_check := ?_
        right_check := ?_ }
    ·
      simpa [R0, hheight, N] using
        Proj.target_endpoint_shape A hpos
    ·
      simpa [R0, hheight, N] using
        Proj.left_check A hpos
    ·
      simpa [R0, hheight, N] using
        Proj.right_check A hpos
  exact hnoCore Hcore

/-- The concrete grammar's narrow endpoint-core premise is already false on a
P948-coded produced active source path.

This targets the lower `of_endpointProjectionCore` socket directly: even before
assembling a global endpoint projection law, the premise that the fixed-root
grammar-selected lowered neighbor has an endpoint projection core contradicts
the P948 produced-active obstruction. -/
theorem su7A6_concreteEndpointSourceGrammar_endpointProjectionCorePremise_contradicts_P948
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    (H :
      ∀ (A : SU7ProducedActiveCell σ hσ 6 3)
        (hpos : A.energy ≠ 0),
        let R0 := su7A6ConcreteEndpointSourceReadout A
        let hheight := R0.source_signedHeight_pos hpos
        let N :=
          su7A6UnfilteredUnitDescentNeighborAt R0.source_label
            (su7A6ConcreteEndpointSourceGrammar.repairRootOf
              R0.source_label hheight)
        SU7A6EndpointProjectionCore 6 N.target)
    (A : SU7ProducedActiveCell σ hσ 6 3)
    (hleft : A.sourceCell.cell.leftWeightCode = 3)
    (hright : A.sourceCell.cell.rightWeightCode = 3)
    (hpos : A.energy ≠ 0) :
    False := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  let N :=
    su7A6UnfilteredUnitDescentNeighborAt R0.source_label
      (su7A6ConcreteEndpointSourceGrammar.repairRootOf
        R0.source_label hheight)
  have hnoCore :
      ¬ SU7A6EndpointProjectionCore 6 N.target := by
    simpa [R0, hheight, N] using
      su7A6P948ProducedActiveCell_fixedRootSelectedNeighbor_no_endpointProjectionCore
        A hleft hright hpos
  have Hcore : SU7A6EndpointProjectionCore 6 N.target := by
    simpa [R0, hheight, N] using H A hpos
  exact hnoCore Hcore

/-- The P948 center-cover source/projection core applies to any produced
active cell whose source endpoint codes are `(3,3)`.

The target is still source/phase data plus finite endpoint projection core;
no generated repair cell or downstream carrier is assumed here. -/
def su7A6P948ProducedActiveCell_sourceProjectionCore
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    (A : SU7ProducedActiveCell σ hσ 6 3)
    (hleft : A.sourceCell.cell.leftWeightCode = 3)
    (hright : A.sourceCell.cell.rightWeightCode = 3) :
    SU7A6SourceLabelUnitCenterCoverProjectionCore
      6 (su7A6ConcreteEndpointSourceReadout A).source_label
      su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target := by
  rw [su7A6P948ProducedActiveCell_sourceLabel_eq A hleft hright]
  exact su7A6P948UnitCenterCoverNeighbor_sourceProjectionCore

/-- The P948 produced-cell source/projection core reads as a raw `E - 1`
successor against the produced cell's own residual energy.

This is still upstream of repair-cell materialization: it only says the
source/phase target and endpoint projection core account for the one residual
unit on the produced-cell readout. -/
theorem su7A6P948ProducedActiveCell_raw_unit_reads_energy
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    (A : SU7ProducedActiveCell σ hσ 6 3)
    (hleft : A.sourceCell.cell.leftWeightCode = 3)
    (hright : A.sourceCell.cell.rightWeightCode = 3) :
    rawCodePairResidualEnergy 6
        (su7A6ConcreteEndpointSourceGrammar.leftCodeOf
          su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target)
        (su7A6ConcreteEndpointSourceGrammar.rightCodeOf
          su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target) +
      1 =
        A.energy := by
  rw [su7A6P948ProducedActiveCell_energy_eq_six A hleft hright]
  simpa [su7A6ConcreteEndpointSourceGrammar,
    rawCodePairResidualEnergy_six_three_three] using
    su7A6P948UnitCenterCoverNeighbor_raw_endpoint_energy_unit

/-- The P948 produced-active boundary has a source/phase-generated completed
lower cell in computed endpoint room.

This is the positive half paired with
`su7A6P948ProducedActiveCell_fixedRootSelectedNeighbor_no_endpointProjectionCore`:
the fixed simple-root neighbor is filtered out, but the center-cover completion
target materializes a generated `E - 1` lower cell without assuming coverage,
an endpoint shell, or a repair cell. -/
theorem su7A6P948ProducedActiveCell_sourceCompletion_filtered_weight_graph_downward_connectivity
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    (A : SU7ProducedActiveCell σ hσ 6 3)
    (hleft : A.sourceCell.cell.leftWeightCode = 3)
    (hright : A.sourceCell.cell.rightWeightCode = 3)
    (_hpos : A.energy ≠ 0) :
    ∃ completedBound,
      ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding 6,
        3 ≤ completedBound ∧
          lower ∈ generatedNoPrimeBranchingCells 6 completedBound ∧
            noPrimeBranchingEndpointResidualEnergy lower + 1 = A.energy := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let R := R0.toSourceReadout
  let target := su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target
  let C := su7A6P948ProducedActiveCell_sourceProjectionCore A hleft hright
  let N : SU7A6UnitCenterCoverDescentNeighbor R.source_label :=
    { target := target
      move := by
        simpa [R0, R, target,
          SU7ProducedActiveCellA6EndpointSourceReadout.toSourceReadout] using
          C.unit_center_cover_move }
  let completedBound :=
    computedEndpointRoomBound 3
      (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
      (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target)
  have Hmat :
      ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding 6,
        lower ∈ generatedNoPrimeBranchingCells 6 completedBound ∧
          noPrimeBranchingEndpointResidualEnergy lower + 1 = A.energy := by
    simpa [R0, R, target, N, completedBound,
      SU7ProducedActiveCellA6EndpointSourceReadout.toSourceReadout] using
      C.materializes_generated_lower_cell (A := A) (R := R) (N := N)
  rcases Hmat with ⟨lower, hmem, hunit⟩
  exact
    ⟨completedBound, lower,
      by
        simpa [completedBound] using
          bound_le_computedEndpointRoomBound 3
            (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
            (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target),
      hmem, hunit⟩

/-- The P948 produced-active boundary reaches the generated-repair throat via
the source/phase center-cover completion target.

This theorem is intentionally P948-local: it records that the known obstruction
is solved by the completion coordinate, while the general theorem still needs a
SU(7) grammar proof that every produced active positive cell has such a
projection core. -/
theorem su7A6P948ProducedActiveCell_sourceCompletion_generated_repair_law
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    (A : SU7ProducedActiveCell σ hσ 6 3)
    (hleft : A.sourceCell.cell.leftWeightCode = 3)
    (hright : A.sourceCell.cell.rightWeightCode = 3)
    (hpos : A.energy ≠ 0) :
    ∃ completedBound,
      ∃ _repair :
        SU7GeneratedRepairCell A
          (SU7RepairObligation.of_positive A hpos),
        3 ≤ completedBound := by
  rcases
    su7A6P948ProducedActiveCell_sourceCompletion_filtered_weight_graph_downward_connectivity
      A hleft hright hpos with
    ⟨completedBound, lower, hbound, hmem, hunit⟩
  exact
    ⟨completedBound,
      generatedRepairCell_of_noPrimeUnitStepAtRepairBound
        A hpos hbound hmem hunit,
      hbound⟩

/-- A canonical rich witness over the P948 `(3,3)` source pair inherits the
same produced-cell source/projection core.

The witness already carries the source path; this theorem only reads its
endpoint-code coordinates back into the produced-cell calibration above. -/
def su7A6P948CanonicalRichWitness_sourceProjectionCore
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ 6 3 (3, 3)) :
    SU7A6SourceLabelUnitCenterCoverProjectionCore
      6
      (su7A6ConcreteEndpointSourceReadout
        (producedActiveCell_of_canonicalRichHolonomyWitness W)).source_label
      su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target := by
  let A := producedActiveCell_of_canonicalRichHolonomyWitness W
  have hleft : A.sourceCell.cell.leftWeightCode = 3 := by
    simpa [A, producedActiveCell_of_canonicalRichHolonomyWitness,
      SU7ProducedActiveCell.sourceCell, SU7ProducedActiveCell.sourceLift]
      using W.source_lift.source_left
  have hright : A.sourceCell.cell.rightWeightCode = 3 := by
    simpa [A, producedActiveCell_of_canonicalRichHolonomyWitness,
      SU7ProducedActiveCell.sourceCell, SU7ProducedActiveCell.sourceLift]
      using W.source_lift.source_right
  exact su7A6P948ProducedActiveCell_sourceProjectionCore A hleft hright

/-- The P948 canonical rich witness source/projection core reads as raw
`E - 1` against the produced cell extracted from that same witness. -/
theorem su7A6P948CanonicalRichWitness_raw_unit_reads_energy
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ 6 3 (3, 3)) :
    rawCodePairResidualEnergy 6
        (su7A6ConcreteEndpointSourceGrammar.leftCodeOf
          su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target)
        (su7A6ConcreteEndpointSourceGrammar.rightCodeOf
          su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target) +
      1 =
        (producedActiveCell_of_canonicalRichHolonomyWitness W).energy := by
  let A := producedActiveCell_of_canonicalRichHolonomyWitness W
  have hleft : A.sourceCell.cell.leftWeightCode = 3 := by
    simpa [A, producedActiveCell_of_canonicalRichHolonomyWitness,
      SU7ProducedActiveCell.sourceCell, SU7ProducedActiveCell.sourceLift]
      using W.source_lift.source_left
  have hright : A.sourceCell.cell.rightWeightCode = 3 := by
    simpa [A, producedActiveCell_of_canonicalRichHolonomyWitness,
      SU7ProducedActiveCell.sourceCell, SU7ProducedActiveCell.sourceLift]
      using W.source_lift.source_right
  exact su7A6P948ProducedActiveCell_raw_unit_reads_energy A hleft hright

/-- A generated endpoint projection law is exactly pointwise local endpoint
projection core over produced active targets. -/
theorem SU7A6GeneratedSourceLabelEndpointProjectionLaw.localCore
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    {targetLabel :
      (source : SU7A6WeightLabel) ->
        0 < su7A6SignedHeight source -> SU7A6WeightLabel}
    (L :
      SU7A6GeneratedSourceLabelEndpointProjectionLaw
        σ hσ n bound targetLabel)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    SU7A6EndpointProjectionCore n
      (targetLabel R0.source_label hheight) := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  exact
    { target_endpoint_shape := L.target_endpoint_shape A hpos
      left_check := L.left_check A hpos
      right_check := L.right_check A hpos }

/-- Pointwise local endpoint projection cores assemble the generated endpoint
projection law. -/
theorem SU7A6GeneratedSourceLabelEndpointProjectionLaw.ofLocalCore
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    {targetLabel :
      (source : SU7A6WeightLabel) ->
        0 < su7A6SignedHeight source -> SU7A6WeightLabel}
    (H :
      ∀ (A : SU7ProducedActiveCell σ hσ n bound)
        (hpos : A.energy ≠ 0),
        let R0 := su7A6ConcreteEndpointSourceReadout A
        let hheight := R0.source_signedHeight_pos hpos
        SU7A6EndpointProjectionCore n
          (targetLabel R0.source_label hheight)) :
    SU7A6GeneratedSourceLabelEndpointProjectionLaw
      σ hσ n bound targetLabel where
  target_endpoint_shape := by
    intro A hpos
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    simpa [R0, hheight] using
      (H A hpos).target_endpoint_shape
  left_check := by
    intro A hpos
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    simpa [R0, hheight] using
      (H A hpos).left_check
  right_check := by
    intro A hpos
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
