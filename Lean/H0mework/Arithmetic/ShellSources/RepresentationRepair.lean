/-- The pointwise projection-core law materializes the generated lower-cell
half in the computed endpoint room for every positive produced source cell.

This stops one layer before `SU7GeneratedRepairCell`: the output is the
generated no-prime lower cell plus exact endpoint-energy unit readout. -/
theorem materializes_generated_lower_cell
    (L :
      SU7A6GeneratedSourceLabelUnitCenterCoverProjectionCoreLaw
        σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    let target := L.targetLabel R0.source_label hheight
    ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
      lower ∈
        generatedNoPrimeBranchingCells n
          (computedEndpointRoomBound bound
            (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
            (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target)) ∧
        noPrimeBranchingEndpointResidualEnergy lower + 1 = A.energy := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let R := R0.toSourceReadout
  let hheight := R0.source_signedHeight_pos hpos
  let target := L.targetLabel R0.source_label hheight
  let C := L.source_target_core A hpos
  let N : SU7A6UnitCenterCoverDescentNeighbor R.source_label :=
    { target := target
      move := by
        simpa [R, R0, hheight, target,
          SU7ProducedActiveCellA6EndpointSourceReadout.toSourceReadout] using
          C.unit_center_cover_move }
  have H :=
    C.materializes_generated_lower_cell (A := A) (R := R) (N := N)
  simpa [R0, R, hheight, target, N,
    SU7ProducedActiveCellA6EndpointSourceReadout.toSourceReadout,
    SU7A6ActiveSectorEndpointGrammar.readoutFrame,
    SU7A6ActiveSectorReadoutFrame, su7A6ConcreteEndpointSourceGrammar]
    using H

/-- Source-label filtered weight-graph downward connectivity.

This is the completed-bound form of `materializes_generated_lower_cell`.
The theorem remains just upstream of `SU7GeneratedRepairCell`: it exposes the
grammar-computed endpoint room, the generated lower no-prime cell, and the
exact `E - 1` endpoint readout, without invoking the repair-cell adapter. -/
theorem filtered_weight_graph_downward_connectivity
    (L :
      SU7A6GeneratedSourceLabelUnitCenterCoverProjectionCoreLaw
        σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    ∃ completedBound,
      ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
        bound ≤ completedBound ∧
          lower ∈ generatedNoPrimeBranchingCells n completedBound ∧
            noPrimeBranchingEndpointResidualEnergy lower + 1 = A.energy := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  let target := L.targetLabel R0.source_label hheight
  let completedBound :=
    computedEndpointRoomBound bound
      (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
      (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target)
  have Hmat :
      ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
        lower ∈ generatedNoPrimeBranchingCells n completedBound ∧
          noPrimeBranchingEndpointResidualEnergy lower + 1 = A.energy := by
    simpa [R0, hheight, target, completedBound] using
      L.materializes_generated_lower_cell A hpos
  rcases Hmat with ⟨lower, hmem, hunit⟩
  exact
    ⟨completedBound, lower,
      by
        simpa [completedBound] using
          bound_le_computedEndpointRoomBound bound
            (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
            (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target),
      hmem, hunit⟩

/-- Split source-generation laws imply filtered weight-graph downward
connectivity in the computed endpoint room.

This is the theorem shape that should receive the real SU(7) grammar proof:
one premise for generated unit center-cover adjacency, one premise for
filtered endpoint projection of the same target. -/
theorem filtered_weight_graph_downward_connectivity_of_adjacency_and_projection
    (Adj :
      SU7A6GeneratedSourceLabelUnitCenterCoverAdjacencyLaw
        σ hσ n bound)
    (Proj :
      SU7A6GeneratedSourceLabelEndpointProjectionLaw
        σ hσ n bound Adj.targetLabel)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    ∃ completedBound,
      ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
        bound ≤ completedBound ∧
          lower ∈ generatedNoPrimeBranchingCells n completedBound ∧
            noPrimeBranchingEndpointResidualEnergy lower + 1 = A.energy :=
  (of_adjacency_and_projection Adj Proj).filtered_weight_graph_downward_connectivity
    A hpos

