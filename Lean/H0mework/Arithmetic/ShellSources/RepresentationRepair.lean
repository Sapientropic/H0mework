theorem su7A6EndpointLeftAnchorCompletionTarget_sourceOrientedSameSpectrumProjectionCore_of_orientationBelow_and_rightCheck
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
