            rawCodePairResidualEnergy n
              A.sourceCell.cell.leftWeightCode
              A.sourceCell.cell.rightWeightCode := by
          exact
            rawCodePairResidualEnergy_endpointShift_unit_of_sourceBelow
              (by
                have hleft2 : 2 ≤ A.sourceCell.cell.leftWeightCode :=
                  two_le_of_natMultiplicativelyAtomicCheck
                    A.sourceCell.left_check
                omega)
              hbelow
        _ = A.energy :=
          (SU7ProducedActiveCell.energy_eq_raw_source_pair A).symm
    ·
      simp [hbelow]
      have hraw_ne :
          rawCodePairResidualEnergy n
              A.sourceCell.cell.leftWeightCode
              A.sourceCell.cell.rightWeightCode ≠ 0 := by
        intro hraw_zero
        exact hpos (by
          rw [SU7ProducedActiveCell.energy_eq_raw_source_pair A]
          exact hraw_zero)
      have hsum_ne :
          A.sourceCell.cell.leftWeightCode +
              A.sourceCell.cell.rightWeightCode ≠ 2 * n := by
        intro hsum
        apply hraw_ne
        unfold rawCodePairResidualEnergy rawCodePairResidual
        simp [hsum]
      have habove :
          2 * n <
            A.sourceCell.cell.leftWeightCode +
              A.sourceCell.cell.rightWeightCode := by
        omega
      calc
        rawCodePairResidualEnergy n
              (A.sourceCell.cell.leftWeightCode + 1)
              (A.sourceCell.cell.rightWeightCode - 2) + 1 =
            rawCodePairResidualEnergy n
              A.sourceCell.cell.leftWeightCode
              A.sourceCell.cell.rightWeightCode := by
          exact
            rawCodePairResidualEnergy_endpointBackshift_unit_of_sourceAbove
              (two_le_of_natMultiplicativelyAtomicCheck
                A.sourceCell.right_check)
              habove
        _ = A.energy :=
          (SU7ProducedActiveCell.energy_eq_raw_source_pair A).symm
  have hunitInt :
      (rawCodePairResidualEnergy n targetLeft targetRight : Int) + 1 =
        (A.energy : Int) := by
    exact_mod_cast hunitRaw
  calc
    su7A6SignedHeight
          (su7A6SourceOrientedEndpointTargetLabel n
            R0.source_label hheight) + 1 =
        (rawCodePairResidualEnergy n targetLeft targetRight : Int) + 1 := by
          change
            su7A6SignedHeight
                  (su7A6EndpointSourceLabel targetLeft targetRight
                    (rawCodePairResidualEnergy n targetLeft targetRight)) +
                1 =
              (rawCodePairResidualEnergy n targetLeft targetRight : Int) + 1
          rw [su7A6EndpointSourceLabel_signedHeight]
    _ = (A.energy : Int) := hunitInt
    _ = su7A6SignedHeight R0.source_label :=
        R0.source_height_reads_energy.symm

/-- The sign-oriented source/phase endpoint target uses the center-cover
coordinate for produced active source cells.

This lifts the endpoint-shift/backshift root-index obstruction to the actual
source-oriented target generated from a positive produced source path.  It is
still only a representation-coordinate fact: it does not assert that the
target endpoint codes survive the finite no-prime filter. -/
theorem su7A6SourceOrientedEndpointTargetLabel_not_integerRootLatticeDisplacement
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    ¬ SU7A6IntegerRootLatticeDisplacement R0.source_label
      (su7A6SourceOrientedEndpointTargetLabel n R0.source_label hheight) := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  change
    ¬ SU7A6IntegerRootLatticeDisplacement R0.source_label
      (su7A6SourceOrientedEndpointTargetLabel n R0.source_label hheight)
  have hleft1 : 1 ≤ A.sourceCell.cell.leftWeightCode := by
    have hleft2 : 2 ≤ A.sourceCell.cell.leftWeightCode :=
      two_le_of_natMultiplicativelyAtomicCheck A.sourceCell.left_check
    omega
  have hright2 : 2 ≤ A.sourceCell.cell.rightWeightCode :=
    two_le_of_natMultiplicativelyAtomicCheck A.sourceCell.right_check
  by_cases hbelow :
      A.sourceCell.cell.leftWeightCode +
          A.sourceCell.cell.rightWeightCode < 2 * n
  ·
    have heq :
        su7A6SourceOrientedEndpointTargetLabel n R0.source_label hheight =
          su7A6EndpointShiftCompletionTarget R0.source_label hheight := by
      simpa [R0, hheight] using
        su7A6SourceOrientedEndpointTargetLabel_eq_endpointShiftCompletionTarget_of_sourceBelow
          A hpos hbelow
    have hnot :
        ¬ SU7A6IntegerRootLatticeDisplacement R0.source_label
          (su7A6EndpointShiftCompletionTarget R0.source_label hheight) := by
      simpa [R0, su7A6ConcreteEndpointSourceReadout,
        su7A6ConcreteEndpointSourceLabelOf] using
        su7A6EndpointShiftCompletionTarget_not_integerRootLatticeDisplacement_of_endpointSourceLabel
          (left := A.sourceCell.cell.leftWeightCode)
          (right := A.sourceCell.cell.rightWeightCode)
          (energy := A.energy)
          hleft1
          (by
            simpa [R0, su7A6ConcreteEndpointSourceReadout,
              su7A6ConcreteEndpointSourceLabelOf] using hheight)
    intro hdisp
    apply hnot
    rw [← heq]
    exact hdisp
  ·
    have hraw_ne :
        rawCodePairResidualEnergy n
            A.sourceCell.cell.leftWeightCode
            A.sourceCell.cell.rightWeightCode ≠ 0 := by
      intro hraw_zero
      exact hpos (by
        rw [SU7ProducedActiveCell.energy_eq_raw_source_pair A]
        exact hraw_zero)
    have hsum_ne :
        A.sourceCell.cell.leftWeightCode +
            A.sourceCell.cell.rightWeightCode ≠ 2 * n := by
      intro hsum
      apply hraw_ne
      unfold rawCodePairResidualEnergy rawCodePairResidual
      simp [hsum]
    have habove :
        2 * n <
          A.sourceCell.cell.leftWeightCode +
            A.sourceCell.cell.rightWeightCode := by
      omega
    have heq :
        su7A6SourceOrientedEndpointTargetLabel n R0.source_label hheight =
          su7A6EndpointBackshiftCompletionTarget R0.source_label hheight := by
      simpa [R0, hheight] using
        su7A6SourceOrientedEndpointTargetLabel_eq_endpointBackshiftCompletionTarget_of_sourceAbove
          A hpos habove
    have hnot :
        ¬ SU7A6IntegerRootLatticeDisplacement R0.source_label
          (su7A6EndpointBackshiftCompletionTarget R0.source_label hheight) := by
      simpa [R0, su7A6ConcreteEndpointSourceReadout,
        su7A6ConcreteEndpointSourceLabelOf] using
        su7A6EndpointBackshiftCompletionTarget_not_integerRootLatticeDisplacement_of_endpointSourceLabel
          (left := A.sourceCell.cell.leftWeightCode)
          (right := A.sourceCell.cell.rightWeightCode)
          (energy := A.energy)
          hright2
          (by
            simpa [R0, su7A6ConcreteEndpointSourceReadout,
              su7A6ConcreteEndpointSourceLabelOf] using hheight)
    intro hdisp
    apply hnot
    rw [← heq]
    exact hdisp

/-- Source-oriented endpoint descent supplies the generated-source
unit-center-cover adjacency half without any finite endpoint filter premise.

This is the source/phase producer half: a produced active source label has a
grammar-selected sign-correct `E - 1` target.  The no-prime/atomic endpoint
projection law remains separate. -/
def su7A6_sourceOrientedEndpointUnitDescent_sourceLabelUnitCenterCoverAdjacencyLaw
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
