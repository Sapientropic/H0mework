import H0mework.Arithmetic.SourceAtoms.RootDatum
import H0mework.Arithmetic.ShellSources.CheckedShellSource

/-!
# SU(7) representation-generated repair law

This file isolates the upstream representation-theoretic payload needed by the
current producer chain.

The existing source file already has a narrow repair-cell socket:
`generatedRepairCell_of_noPrimeUnitStepAtRepairBound`.  It only asks for a
generated completed-bound cell whose endpoint residual energy is exactly one
unit below the observed produced active cell.

Here we name the representation-side data that should eventually produce that
socket: an A6/SU(7) weight graph move, a faithful atom-code readout, branching
and filtering preservation, and admissible completion room.  This does not use
the older `NoPrimeBranchingConfiningResidualFlow` plus
`NoPrimeBranchingQuantizedUnitBridge` route.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

/-- A code functional on A6 Dynkin labels whose legal simple-root moves are
known to spend exactly one residual unit.

Constructing this object from the real SU(7) representation/readout is one of
the remaining hard gates.  Keeping it separate prevents the generic repair
move from hiding unit quantization as a per-cell arbitrary field. -/
structure SU7A6UnitDescentCodeFunctional where
  code : SU7A6WeightLabel -> Nat
  unit_decrement_on_simple_root :
    ∀ {source target : SU7A6WeightLabel},
      SU7A6SimpleRootMove source target ->
        code target + 1 = code source

/-- Minimal representation graph readout needed for a repair move.

`RootMove` is the SU(7)/A6 adjacency relation to be instantiated later from the
actual weight lattice/root operators.  `atomCode` is the representation-side
energy/readout functional whose unit decrement must be faithful to endpoint
residual energy after branching and filtering. -/
structure SU7RepresentationWeightGraphModel where
  RootMove : SU7A6WeightLabel -> SU7A6WeightLabel -> Prop
  atomCode : SU7A6WeightLabel -> Nat

/-- The concrete A6 simple-root model associated to a unit-descent code
functional. -/
def su7A6WeightGraphModel
    (C : SU7A6UnitDescentCodeFunctional) :
    SU7RepresentationWeightGraphModel where
  RootMove := SU7A6SimpleRootMove
  atomCode := C.code

/-- A representation-generated filtered repair move for one produced active
cell.

This is the upstream object the next proof must actually generate from SU(7)
grammar:

* a root/weight graph move;
* a completed endpoint room generated by the grammar;
* branching/filter preservation into `generatedNoPrimeBranchingCells`;
* a faithful atom-code readout;
* exact unit quantization of that representation readout.

Unlike `SU7FilteredWeightGraphDownwardConnectivity`, this object does not take
`NoPrimeBranchingQuantizedUnitBridge` as a premise.  The unit decrement is part
of the representation repair move itself. -/
structure SU7RepresentationFilteredRepairMove
    (M : SU7RepresentationWeightGraphModel)
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound) where
  completedBound : Nat
  completion_room : bound ≤ completedBound
  source_label : SU7A6WeightLabel
  repair_label : SU7A6WeightLabel
  root_move : M.RootMove source_label repair_label
  source_code_reads_energy : M.atomCode source_label = A.energy
  lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n
  branching_filter_preserved :
    lower ∈ generatedNoPrimeBranchingCells n completedBound
  repair_code_reads_lower :
    M.atomCode repair_label = noPrimeBranchingEndpointResidualEnergy lower
  unit_decrement :
    M.atomCode repair_label + 1 = M.atomCode source_label

namespace SU7RepresentationFilteredRepairMove

variable {M : SU7RepresentationWeightGraphModel}
variable {K : Type*} [Field K]
variable {σ : K} {hσ : σ ≠ 1} {n bound : Nat}
variable {A : SU7ProducedActiveCell σ hσ n bound}

/-- The representation atom-code decrement reads back as an endpoint-energy
unit decrement for the generated filtered lower cell. -/
theorem lower_energy_unit
    (X : SU7RepresentationFilteredRepairMove M A) :
    noPrimeBranchingEndpointResidualEnergy X.lower + 1 = A.energy := by
  rw [← X.repair_code_reads_lower, X.unit_decrement,
    X.source_code_reads_energy]

/-- A representation-generated filtered repair move materializes the existing
generated repair-cell throat. -/
def to_generatedRepairCell
    (X : SU7RepresentationFilteredRepairMove M A)
    (hpos : A.energy ≠ 0) :
    SU7GeneratedRepairCell A (SU7RepairObligation.of_positive A hpos) :=
  generatedRepairCell_of_noPrimeUnitStepAtRepairBound
    (completedBound := X.completedBound) (step := X.lower)
    A hpos X.completion_room X.branching_filter_preserved
    X.lower_energy_unit

/-- Existential completed-bound form consumed by the producer-chain target. -/
theorem exists_generatedRepairCell
    (X : SU7RepresentationFilteredRepairMove M A)
    (hpos : A.energy ≠ 0) :
    ∃ completedBound,
      ∃ _repair :
        SU7GeneratedRepairCell A
          (SU7RepairObligation.of_positive A hpos),
        bound ≤ completedBound := by
  exact ⟨X.completedBound, X.to_generatedRepairCell hpos,
    X.completion_room⟩

end SU7RepresentationFilteredRepairMove

/-- A concrete A6 simple-root repair move after branching, filtering, and
completion.

Compared with `SU7RepresentationFilteredRepairMove`, this version fixes the
root relation to the A6 simple-root move and derives unit decrement from a
global code functional.  The still-hard fields are the source/repair label
readout and the fact that the lowered branch survives the generated filter at
the completed bound. -/
structure SU7A6FilteredRootRepairMove
    (C : SU7A6UnitDescentCodeFunctional)
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound) where
  completedBound : Nat
  completion_room : bound ≤ completedBound
  source_label : SU7A6WeightLabel
  repair_label : SU7A6WeightLabel
  root_move : SU7A6SimpleRootMove source_label repair_label
  source_code_reads_energy : C.code source_label = A.energy
  lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n
  branching_filter_preserved :
    lower ∈ generatedNoPrimeBranchingCells n completedBound
  repair_code_reads_lower :
    C.code repair_label = noPrimeBranchingEndpointResidualEnergy lower

namespace SU7A6FilteredRootRepairMove

variable {C : SU7A6UnitDescentCodeFunctional}
variable {K : Type*} [Field K]
variable {σ : K} {hσ : σ ≠ 1} {n bound : Nat}
variable {A : SU7ProducedActiveCell σ hσ n bound}

/-- Concrete A6 root-repair moves lower to the generic representation repair
move interface. -/
def toRepresentationFilteredRepairMove
    (X : SU7A6FilteredRootRepairMove C A) :
    SU7RepresentationFilteredRepairMove (su7A6WeightGraphModel C) A where
  completedBound := X.completedBound
  completion_room := X.completion_room
  source_label := X.source_label
  repair_label := X.repair_label
  root_move := X.root_move
  source_code_reads_energy := X.source_code_reads_energy
  lower := X.lower
  branching_filter_preserved := X.branching_filter_preserved
  repair_code_reads_lower := X.repair_code_reads_lower
  unit_decrement :=
    C.unit_decrement_on_simple_root X.root_move

/-- A concrete A6 root-repair move materializes the generated repair cell. -/
def to_generatedRepairCell
    (X : SU7A6FilteredRootRepairMove C A)
    (hpos : A.energy ≠ 0) :
    SU7GeneratedRepairCell A (SU7RepairObligation.of_positive A hpos) :=
  X.toRepresentationFilteredRepairMove.to_generatedRepairCell hpos

/-- Existential completed-bound form for a concrete A6 root-repair move. -/
theorem exists_generatedRepairCell
    (X : SU7A6FilteredRootRepairMove C A)
    (hpos : A.energy ≠ 0) :
    ∃ completedBound,
      ∃ _repair :
        SU7GeneratedRepairCell A
          (SU7RepairObligation.of_positive A hpos),
        bound ≤ completedBound := by
  exact
    X.toRepresentationFilteredRepairMove.exists_generatedRepairCell hpos

end SU7A6FilteredRootRepairMove

/-- Concrete A6 signed-height repair move after branching, filtering, and
completion.

This is a stricter source-facing interface than
`SU7A6FilteredRootRepairMove`: the unit decrement is no longer supplied by a
generic `Nat` code functional.  It is calculated from the A6 signed-height
functional, while the remaining readout fields state that this signed height
faithfully reads the source residual and the generated lower endpoint energy. -/
structure SU7A6SignedHeightFilteredRootRepairMove
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound) where
  completedBound : Nat
  completion_room : bound ≤ completedBound
  source_label : SU7A6WeightLabel
  repair_label : SU7A6WeightLabel
  root_move : SU7A6SimpleRootMove source_label repair_label
  source_height_reads_energy :
    su7A6SignedHeight source_label = (A.energy : Int)
  lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n
  branching_filter_preserved :
    lower ∈ generatedNoPrimeBranchingCells n completedBound
  repair_height_reads_lower :
    su7A6SignedHeight repair_label =
      (noPrimeBranchingEndpointResidualEnergy lower : Int)

namespace SU7A6SignedHeightFilteredRootRepairMove

variable {K : Type*} [Field K]
variable {σ : K} {hσ : σ ≠ 1} {n bound : Nat}
variable {A : SU7ProducedActiveCell σ hσ n bound}

/-- The A6 signed-height unit descent reads back as the endpoint-energy
`E - 1` equation. -/
theorem lower_energy_unit
    (X : SU7A6SignedHeightFilteredRootRepairMove A) :
    noPrimeBranchingEndpointResidualEnergy X.lower + 1 = A.energy := by
  have hheight :
      ((noPrimeBranchingEndpointResidualEnergy X.lower : Nat) : Int) + 1 =
        (A.energy : Int) := by
    calc
      ((noPrimeBranchingEndpointResidualEnergy X.lower : Nat) : Int) + 1 =
          su7A6SignedHeight X.repair_label + 1 := by
            rw [X.repair_height_reads_lower]
      _ = su7A6SignedHeight X.source_label :=
          su7A6SignedHeight_unit_decrement_of_simpleRootMove X.root_move
      _ = (A.energy : Int) := X.source_height_reads_energy
  omega

/-- The source signed-height readout of a legal filtered repair move lives in
the nonnegative residual region. -/
theorem source_signedHeight_nonneg
    (X : SU7A6SignedHeightFilteredRootRepairMove A) :
    0 ≤ su7A6SignedHeight X.source_label := by
  rw [X.source_height_reads_energy]
  exact_mod_cast Nat.zero_le A.energy

/-- The repair signed-height readout of a legal filtered repair move lives in
the nonnegative residual region. -/
theorem repair_signedHeight_nonneg
    (X : SU7A6SignedHeightFilteredRootRepairMove A) :
    0 ≤ su7A6SignedHeight X.repair_label := by
  rw [X.repair_height_reads_lower]
  exact_mod_cast
    Nat.zero_le (noPrimeBranchingEndpointResidualEnergy X.lower)

/-- On a legal filtered repair move, the integer signed-height readout is
faithful to the source Nat residual shell. -/
theorem source_signedHeightNat_reads_energy
    (X : SU7A6SignedHeightFilteredRootRepairMove A) :
    su7A6SignedHeightNat X.source_label = A.energy := by
  have hcast :
      ((su7A6SignedHeightNat X.source_label : Nat) : Int) =
        (A.energy : Int) := by
    unfold su7A6SignedHeightNat
    rw [Int.toNat_of_nonneg X.source_signedHeight_nonneg]
    exact X.source_height_reads_energy
  exact_mod_cast hcast

/-- On a legal filtered repair move, the integer signed-height readout is
faithful to the generated lower Nat residual shell. -/
theorem repair_signedHeightNat_reads_lower
    (X : SU7A6SignedHeightFilteredRootRepairMove A) :
    su7A6SignedHeightNat X.repair_label =
      noPrimeBranchingEndpointResidualEnergy X.lower := by
  have hcast :
      ((su7A6SignedHeightNat X.repair_label : Nat) : Int) =
        (noPrimeBranchingEndpointResidualEnergy X.lower : Int) := by
    unfold su7A6SignedHeightNat
    rw [Int.toNat_of_nonneg X.repair_signedHeight_nonneg]
    exact X.repair_height_reads_lower
  exact_mod_cast hcast

/-- The A6 signed-height move also reads as a Nat-shell unit decrement on the
legal filtered source/repair region. -/
theorem signedHeightNat_unit_decrement
    (X : SU7A6SignedHeightFilteredRootRepairMove A) :
    su7A6SignedHeightNat X.repair_label + 1 =
      su7A6SignedHeightNat X.source_label :=
  su7A6SignedHeightNat_unit_decrement_of_simpleRootMove
    X.root_move X.repair_signedHeight_nonneg

/-- A concrete A6 signed-height root move materializes the generated repair
cell. -/
def to_generatedRepairCell
    (X : SU7A6SignedHeightFilteredRootRepairMove A)
    (hpos : A.energy ≠ 0) :
    SU7GeneratedRepairCell A (SU7RepairObligation.of_positive A hpos) :=
  generatedRepairCell_of_noPrimeUnitStepAtRepairBound
    (completedBound := X.completedBound) (step := X.lower)
    A hpos X.completion_room X.branching_filter_preserved
    X.lower_energy_unit

/-- Existential completed-bound form for a concrete A6 signed-height move. -/
theorem exists_generatedRepairCell
    (X : SU7A6SignedHeightFilteredRootRepairMove A)
    (hpos : A.energy ≠ 0) :
    ∃ completedBound,
      ∃ _repair :
        SU7GeneratedRepairCell A
          (SU7RepairObligation.of_positive A hpos),
        bound ≤ completedBound := by
  exact ⟨X.completedBound, X.to_generatedRepairCell hpos,
    X.completion_room⟩

end SU7A6SignedHeightFilteredRootRepairMove

/-- Global readout frame for interpreting A6 labels as SU(7) source-cell data.

This frame is deliberately global.  A source readout is not allowed to invent a
fresh label that only encodes the scalar energy of one cell; it must read the
same branch, incidence, and endpoint-code coordinates carried by the produced
source path. -/
structure SU7A6SourceReadoutFrame where
  branchOf : SU7A6WeightLabel -> SU3FlagSchubertCell
  incidenceOf : SU7A6WeightLabel -> RunningSigmaBeta.SU7BlockIncidence
  leftCodeOf : SU7A6WeightLabel -> Nat
  rightCodeOf : SU7A6WeightLabel -> Nat

/-- Active-sector readout frame.

For canonical rich produced active cells, the branch and block-incidence
coordinates are already fixed upstream as `e` and `colorWeak`.  This frame
therefore leaves only endpoint-code readout as mathematical data. -/
def SU7A6ActiveSectorReadoutFrame
    (leftCodeOf rightCodeOf : SU7A6WeightLabel -> Nat) :
    SU7A6SourceReadoutFrame where
  branchOf := fun _ => SU3FlagSchubertCell.e
  incidenceOf := fun _ => (.colorWeak : RunningSigmaBeta.SU7BlockIncidence)
  leftCodeOf := leftCodeOf
  rightCodeOf := rightCodeOf

/-- Active-sector endpoint grammar data below the source/phase cell layer.

The endpoint readout functions are bundled with a root selector depending only
on the A6 source label and positive signed height.  This prevents the repair
root from being chosen ad hoc from the whole produced cell. -/
structure SU7A6ActiveSectorEndpointGrammar where
  leftCodeOf : SU7A6WeightLabel -> Nat
  rightCodeOf : SU7A6WeightLabel -> Nat
  repairRootOf :
    (source : SU7A6WeightLabel) ->
      0 < su7A6SignedHeight source -> Fin 6

namespace SU7A6ActiveSectorEndpointGrammar

/-- The active-sector source readout frame generated by endpoint grammar. -/
def readoutFrame (G : SU7A6ActiveSectorEndpointGrammar) :
    SU7A6SourceReadoutFrame :=
  SU7A6ActiveSectorReadoutFrame G.leftCodeOf G.rightCodeOf

end SU7A6ActiveSectorEndpointGrammar

/-- Finite endpoint core for a concrete endpoint/source label.

This is the reusable filtered-readout reduction: for labels that are already
known to be the endpoint/source encoding of `(left,right,energy)`, the finite
core is exactly the two atomic-code checks plus the raw endpoint-energy
equation.  It does not generate the target; the SU(7) grammar still has to
select such a target and prove these three facts. -/
theorem su7A6EndpointSourceLabel_endpoint_core
    {n left right energy : Nat}
    (hleft : natMultiplicativelyAtomicCheck left = true)
    (hright : natMultiplicativelyAtomicCheck right = true)
    (henergy : rawCodePairResidualEnergy n left right = energy) :
    natMultiplicativelyAtomicCheck
        (su7A6EndpointSourceLeftCodeOf
          (su7A6EndpointSourceLabel left right energy)) = true ∧
      natMultiplicativelyAtomicCheck
          (su7A6EndpointSourceRightCodeOf
            (su7A6EndpointSourceLabel left right energy)) = true ∧
        su7A6SignedHeight (su7A6EndpointSourceLabel left right energy) =
          (rawCodePairResidualEnergy n
            (su7A6EndpointSourceLeftCodeOf
              (su7A6EndpointSourceLabel left right energy))
            (su7A6EndpointSourceRightCodeOf
              (su7A6EndpointSourceLabel left right energy)) : Int) := by
  refine ⟨?_, ?_, ?_⟩
  ·
    simpa [su7A6EndpointSourceLabel_leftCode] using hleft
  ·
    simpa [su7A6EndpointSourceLabel_rightCode] using hright
  ·
    rw [su7A6EndpointSourceLabel_signedHeight,
      su7A6EndpointSourceLabel_leftCode, su7A6EndpointSourceLabel_rightCode]
    exact_mod_cast henergy.symm

/-- The concrete endpoint/source grammar uses the source endpoint-code
coordinates and a fixed simple-root selector.

The fixed root is not claimed to solve filtered connectedness; the remaining
finite-core law below must still prove that this lowered neighbor is realized
by the generated endpoint filter. -/
def su7A6ConcreteEndpointSourceGrammar :
    SU7A6ActiveSectorEndpointGrammar where
  leftCodeOf := su7A6EndpointSourceLeftCodeOf
  rightCodeOf := su7A6EndpointSourceRightCodeOf
  repairRootOf := fun _ _ => ⟨0, by decide⟩

/-- Concrete source label generated from a produced active cell. -/
def su7A6ConcreteEndpointSourceLabelOf
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound) :
    SU7A6WeightLabel :=
  su7A6EndpointSourceLabel
    A.sourceCell.cell.leftWeightCode
    A.sourceCell.cell.rightWeightCode
    A.energy

theorem su7A6ConcreteEndpointSourceLabel_leftCode
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound) :
    su7A6ConcreteEndpointSourceGrammar.leftCodeOf
      (su7A6ConcreteEndpointSourceLabelOf A) =
        A.sourceCell.cell.leftWeightCode := by
  exact
    su7A6EndpointSourceLabel_leftCode
      A.sourceCell.cell.leftWeightCode
      A.sourceCell.cell.rightWeightCode
      A.energy

theorem su7A6ConcreteEndpointSourceLabel_rightCode
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound) :
    su7A6ConcreteEndpointSourceGrammar.rightCodeOf
      (su7A6ConcreteEndpointSourceLabelOf A) =
        A.sourceCell.cell.rightWeightCode := by
  exact
    su7A6EndpointSourceLabel_rightCode
      A.sourceCell.cell.leftWeightCode
      A.sourceCell.cell.rightWeightCode
      A.energy

theorem su7A6ConcreteEndpointSourceLabel_signedHeight
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound) :
    su7A6SignedHeight
      (su7A6ConcreteEndpointSourceLabelOf A) =
        (A.energy : Int) := by
  exact
    su7A6EndpointSourceLabel_signedHeight
      A.sourceCell.cell.leftWeightCode
      A.sourceCell.cell.rightWeightCode
      A.energy

/-- Faithful A6 readout of one produced active cell's source state.

This is one of the two remaining representation-generation gates: the existing
`SU7ProducedActiveCell` must be read as an A6 Dynkin label whose signed height
is exactly the observed residual energy, and whose global source-frame readout
recovers the actual branch/incidence/endpoint-code coordinates of the produced
source path. -/
structure SU7ProducedActiveCellA6SourceReadout
    (Readout : SU7A6SourceReadoutFrame)
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound) where
  source_label : SU7A6WeightLabel
  branch_reads_source :
    Readout.branchOf source_label = A.sourceCell.cell.branch
  incidence_reads_source :
    Readout.incidenceOf source_label = A.sourceCell.cell.incidence
  left_code_reads_source :
    Readout.leftCodeOf source_label = A.sourceCell.cell.leftWeightCode
  right_code_reads_source :
    Readout.rightCodeOf source_label = A.sourceCell.cell.rightWeightCode
  source_height_reads_energy :
    su7A6SignedHeight source_label = (A.energy : Int)

/-- Endpoint-only A6 readout of one produced active cell against the canonical
active-sector frame.

The branch/incidence coordinates are not fields here: they are already fixed
by `SU7ProducedActiveCell.source_branch` and
`SU7ProducedActiveCell.source_incidence`. -/
structure SU7ProducedActiveCellA6EndpointSourceReadout
    (leftCodeOf rightCodeOf : SU7A6WeightLabel -> Nat)
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound) where
  source_label : SU7A6WeightLabel
  left_code_reads_source :
    leftCodeOf source_label = A.sourceCell.cell.leftWeightCode
  right_code_reads_source :
    rightCodeOf source_label = A.sourceCell.cell.rightWeightCode
  source_height_reads_energy :
    su7A6SignedHeight source_label = (A.energy : Int)

namespace SU7ProducedActiveCellA6SourceReadout

variable {Readout : SU7A6SourceReadoutFrame}
variable {K : Type*} [Field K]
variable {σ : K} {hσ : σ ≠ 1} {n bound : Nat}
variable {A : SU7ProducedActiveCell σ hσ n bound}

/-- A faithful A6 source readout preserves the canonical branch coordinate. -/
theorem branch_eq
    (R : SU7ProducedActiveCellA6SourceReadout Readout A) :
    Readout.branchOf R.source_label = SU3FlagSchubertCell.e := by
  rw [R.branch_reads_source, SU7ProducedActiveCell.source_branch A]

/-- A faithful A6 source readout preserves the canonical charged incidence
coordinate. -/
theorem incidence_eq
    (R : SU7ProducedActiveCellA6SourceReadout Readout A) :
    Readout.incidenceOf R.source_label =
      (.colorWeak : RunningSigmaBeta.SU7BlockIncidence) := by
  rw [R.incidence_reads_source, SU7ProducedActiveCell.source_incidence A]

/-- A faithful A6 source readout preserves the raw endpoint-code residual
readout of the produced cell. -/
theorem raw_pair_energy_eq
    (R : SU7ProducedActiveCellA6SourceReadout Readout A) :
    rawCodePairResidualEnergy n
        (Readout.leftCodeOf R.source_label)
        (Readout.rightCodeOf R.source_label) =
      A.energy := by
  rw [R.left_code_reads_source, R.right_code_reads_source]
  exact (SU7ProducedActiveCell.energy_eq_raw_source_pair A).symm

end SU7ProducedActiveCellA6SourceReadout

namespace SU7ProducedActiveCellA6EndpointSourceReadout

variable {leftCodeOf rightCodeOf : SU7A6WeightLabel -> Nat}
variable {K : Type*} [Field K]
variable {σ : K} {hσ : σ ≠ 1} {n bound : Nat}
variable {A : SU7ProducedActiveCell σ hσ n bound}

/-- Endpoint-only source readout upgrades to the full source readout for the
canonical active-sector frame. -/
def toSourceReadout
    (R :
      SU7ProducedActiveCellA6EndpointSourceReadout
        leftCodeOf rightCodeOf A) :
    SU7ProducedActiveCellA6SourceReadout
      (SU7A6ActiveSectorReadoutFrame leftCodeOf rightCodeOf) A where
  source_label := R.source_label
  branch_reads_source :=
    (SU7ProducedActiveCell.source_branch A).symm
  incidence_reads_source :=
    (SU7ProducedActiveCell.source_incidence A).symm
  left_code_reads_source := R.left_code_reads_source
  right_code_reads_source := R.right_code_reads_source
  source_height_reads_energy := R.source_height_reads_energy

/-- Endpoint-only readout preserves the raw endpoint-code residual when viewed
through the active-sector frame. -/
theorem raw_pair_energy_eq
    (R :
      SU7ProducedActiveCellA6EndpointSourceReadout
        leftCodeOf rightCodeOf A) :
    rawCodePairResidualEnergy n
        (leftCodeOf R.source_label)
        (rightCodeOf R.source_label) =
      A.energy :=
  R.toSourceReadout.raw_pair_energy_eq

/-- Membership in the generated raw-code list reads as the endpoint code being
within the source bound. -/
theorem le_bound_of_mem_rawCodeBoundedList
    {code bound : Nat}
    (hmem : code ∈ rawCodeBoundedList bound) :
    code ≤ bound := by
  simpa [rawCodeBoundedList] using hmem

/-- On or above the target hyperplane, raw endpoint residual energy is the
ordinary excess `left + right - 2*n`.

This is a scalar source/readout fact used to rule out the over-target mirror
branch from finite source-room constraints. -/
theorem rawCodePairResidualEnergy_eq_sum_sub_of_target_le_source
    {n left right : Nat}
    (hle : 2 * n ≤ left + right) :
    rawCodePairResidualEnergy n left right = left + right - 2 * n := by
  have hnonneg : 0 ≤ rawCodePairResidual n left right := by
    unfold rawCodePairResidual
    omega
  have hInt :
      ((rawCodePairResidualEnergy n left right : Nat) : Int) =
        ((left + right - 2 * n : Nat) : Int) := by
    unfold rawCodePairResidualEnergy
    rw [Int.ofNat_natAbs_of_nonneg hnonneg]
    unfold rawCodePairResidual
    omega
  exact_mod_cast hInt

/-- The right endpoint code of a produced active source cell is bounded by the
same finite source bound that generated it.

This is a source-list readout, not a filter or repair-cell premise. -/
theorem su7ProducedActiveCell_sourceRight_le_bound
    (A : SU7ProducedActiveCell σ hσ n bound) :
    A.sourceCell.cell.rightWeightCode ≤ bound := by
  have hparts :
      A.sourceCell ∈ booleanAtomicRawBranchingCandidateList n bound ∧
        generatedNoPrimeAllowedPredicate n bound
          A.sourceCell.cell.leftWeightCode
          A.sourceCell.cell.rightWeightCode = true := by
    simpa [SU7ProducedActiveCell.sourceCell,
      SU7ProducedActiveCell.sourceLift,
      gaugeFilteredBooleanAtomicRawBranchingCandidateList]
      using (List.mem_filter.mp A.witness.source_lift.source_mem)
  exact
    le_bound_of_mem_rawCodeBoundedList
      (booleanAtomicCell_right_mem_rawCodeBoundedList_of_mem_generated
        hparts.1)

/-- The left endpoint code of a produced active source cell is bounded by the
same finite source window that generated it.

This is the left-code half of the generated source-list readout.  It does not
use any target endpoint check, projection support, coverage theorem, or repair
cell; it only reopens the source membership proof carried by
`SU7ProducedActiveCell`. -/
theorem su7ProducedActiveCell_sourceLeft_le_bound
    (A : SU7ProducedActiveCell σ hσ n bound) :
    A.sourceCell.cell.leftWeightCode ≤ bound := by
  have hparts :
      A.sourceCell ∈ booleanAtomicRawBranchingCandidateList n bound ∧
        generatedNoPrimeAllowedPredicate n bound
          A.sourceCell.cell.leftWeightCode
          A.sourceCell.cell.rightWeightCode = true := by
    simpa [SU7ProducedActiveCell.sourceCell,
      SU7ProducedActiveCell.sourceLift,
      gaugeFilteredBooleanAtomicRawBranchingCandidateList]
      using (List.mem_filter.mp A.witness.source_lift.source_mem)
  exact
    le_bound_of_mem_rawCodeBoundedList
      (booleanAtomicCell_left_mem_rawCodeBoundedList_of_mem_generated
        hparts.1)

/-- A source window contained in the lower half of the even fiber forces every
produced active source cell to lie under the raw target hyperplane.

Gate classification: selected-family coherence source input.  This is a
finite source-grammar fact: both generated endpoint codes are read from the
same bounded source list, so `bound < n` makes their sum strictly below
`2 * n`.  It is not a projection/coverage/repair theorem. -/
theorem su7ProducedActiveCell_sourceBelow_of_sourceBound_lt_evenHalf
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hbound : bound < n) :
    A.sourceCell.cell.leftWeightCode +
        A.sourceCell.cell.rightWeightCode < 2 * n := by
  have hleft_le :
      A.sourceCell.cell.leftWeightCode ≤ bound :=
    SU7ProducedActiveCellA6EndpointSourceReadout.su7ProducedActiveCell_sourceLeft_le_bound
      A
  have hright_le :
      A.sourceCell.cell.rightWeightCode ≤ bound :=
    SU7ProducedActiveCellA6EndpointSourceReadout.su7ProducedActiveCell_sourceRight_le_bound
      A
  omega

/-- A source window contained in the closed lower half also forces a positive
produced source cell below the raw target hyperplane.

The boundary case `bound = n` is ruled out by the active residual itself: if
both generated endpoint codes saturated the boundary, the raw source residual
would be zero, contradicting `A.energy ≠ 0`.  This is still a source-list /
raw-residual readout fact, not an endpoint projection or coverage premise. -/
theorem su7ProducedActiveCell_sourceBelow_of_sourceBound_le_evenHalf_of_positive
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0)
    (hbound : bound ≤ n) :
    A.sourceCell.cell.leftWeightCode +
        A.sourceCell.cell.rightWeightCode < 2 * n := by
  let left := A.sourceCell.cell.leftWeightCode
  let right := A.sourceCell.cell.rightWeightCode
  have hleft_le :
      left ≤ bound := by
    simpa [left] using
      SU7ProducedActiveCellA6EndpointSourceReadout.su7ProducedActiveCell_sourceLeft_le_bound
        A
  have hright_le :
      right ≤ bound := by
    simpa [right] using
      SU7ProducedActiveCellA6EndpointSourceReadout.su7ProducedActiveCell_sourceRight_le_bound
        A
  by_contra hnot
  have hle : left + right ≤ 2 * n := by
    omega
  have hge : 2 * n ≤ left + right := by
    omega
  have hsum : left + right = 2 * n := by
    omega
  have hraw :
      rawCodePairResidualEnergy n left right = 0 := by
    have hraw' :
        rawCodePairResidualEnergy n left right =
          left + right - 2 * n :=
      rawCodePairResidualEnergy_eq_sum_sub_of_target_le_source hge
    have hzero : left + right - 2 * n = 0 := by
      omega
    rw [hraw', hzero]
  have henergy : A.energy = 0 := by
    rw [SU7ProducedActiveCell.energy_eq_raw_source_pair A]
    simpa [left, right] using hraw
  exact hpos henergy

/-- A finite source room that cannot contain the over-target mirror branch
forces a produced active source cell onto the source-below side.

If the source pair were on or above the target hyperplane, its raw energy would
be `left + right - 2*n`, so the over-target right endpoint would read as
`2*n + energy - left`.  The generated source list bounds the actual right code
by `bound`; a strict bound below that mirror right endpoint rules the branch
out.  This is a source/grammar half-plane theorem, not a target projection or
coverage theorem. -/
theorem su7ProducedActiveCell_sourceBelow_of_sourceBound_lt_overTargetRight
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hbound :
      bound <
        2 * n + A.energy - A.sourceCell.cell.leftWeightCode) :
    A.sourceCell.cell.leftWeightCode +
        A.sourceCell.cell.rightWeightCode < 2 * n := by
  let left := A.sourceCell.cell.leftWeightCode
  let right := A.sourceCell.cell.rightWeightCode
  by_contra hnot
  have hge : 2 * n ≤ left + right := by
    dsimp [left, right] at hnot ⊢
    omega
  have hright_le : right ≤ bound := by
    simpa [right] using
      SU7ProducedActiveCellA6EndpointSourceReadout.su7ProducedActiveCell_sourceRight_le_bound
        A
  have hraw :
      rawCodePairResidualEnergy n left right =
        left + right - 2 * n :=
    rawCodePairResidualEnergy_eq_sum_sub_of_target_le_source hge
  have henergy :
      A.energy = left + right - 2 * n := by
    rw [SU7ProducedActiveCell.energy_eq_raw_source_pair A]
    simpa [left, right] using hraw
  have hbound' :
      bound < 2 * n + (left + right - 2 * n) - left := by
    simpa [left, henergy] using hbound
  omega

/-- Positive produced residual energy reads as positive A6 signed height. -/
theorem source_signedHeight_pos
    (R :
      SU7ProducedActiveCellA6EndpointSourceReadout
        leftCodeOf rightCodeOf A)
    (hpos : A.energy ≠ 0) :
    0 < su7A6SignedHeight R.source_label := by
  rw [R.source_height_reads_energy]
  exact_mod_cast Nat.pos_of_ne_zero hpos

end SU7ProducedActiveCellA6EndpointSourceReadout

/-- Concrete endpoint-source readout generated from a produced active cell. -/
def su7A6ConcreteEndpointSourceReadout
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound) :
    SU7ProducedActiveCellA6EndpointSourceReadout
      su7A6ConcreteEndpointSourceGrammar.leftCodeOf
      su7A6ConcreteEndpointSourceGrammar.rightCodeOf A where
  source_label := su7A6ConcreteEndpointSourceLabelOf A
  left_code_reads_source :=
    su7A6ConcreteEndpointSourceLabel_leftCode A
  right_code_reads_source :=
    su7A6ConcreteEndpointSourceLabel_rightCode A
  source_height_reads_energy :=
    su7A6ConcreteEndpointSourceLabel_signedHeight A

/-! ## Boundary check for the concrete simple-root endpoint readout -/

/-- The P948 boundary source label under the current concrete endpoint/source
encoding. -/
def su7A6P948BoundarySourceLabel : SU7A6WeightLabel :=
  su7A6EndpointSourceLabel 3 3 6

/-- The simple-root target of the P948 boundary source label. -/
def su7A6P948BoundarySimpleRootTarget (i : Fin 6) :
    SU7A6WeightLabel :=
  su7A6LowerBySimpleRoot i su7A6P948BoundarySourceLabel

/-- Explicit integer A6 Cartan-root combination.

This avoids hiding the root-lattice image in a later theorem: a target is in
the integer A6 root-displacement class of a source only when its coordinate
difference is an integer combination of the six simple-root Cartan columns. -/
def su7A6CartanIntegerCombination
    (m : SU7A6WeightLabel) : SU7A6WeightLabel :=
  fun j =>
    m 0 * su7A6CartanEntry 0 j +
      m 1 * su7A6CartanEntry 1 j +
        m 2 * su7A6CartanEntry 2 j +
          m 3 * su7A6CartanEntry 3 j +
            m 4 * su7A6CartanEntry 4 j +
              m 5 * su7A6CartanEntry 5 j

/-- Coordinate `0` of an A6 Cartan integer combination. -/
theorem su7A6CartanIntegerCombination_zero_num
    (m : SU7A6WeightLabel) :
    su7A6CartanIntegerCombination m (0 : Fin 6) =
      2 * m (0 : Fin 6) - m (1 : Fin 6) := by
  simp [su7A6CartanIntegerCombination, su7A6CartanEntry,
    su7A6Adjacent]
  ring_nf

/-- Coordinate `1` of an A6 Cartan integer combination. -/
theorem su7A6CartanIntegerCombination_one_num
    (m : SU7A6WeightLabel) :
    su7A6CartanIntegerCombination m (1 : Fin 6) =
      -m (0 : Fin 6) + 2 * m (1 : Fin 6) - m (2 : Fin 6) := by
  simp [su7A6CartanIntegerCombination, su7A6CartanEntry,
    su7A6Adjacent]
  ring_nf

/-- Coordinate `2` of an A6 Cartan integer combination. -/
theorem su7A6CartanIntegerCombination_two_num
    (m : SU7A6WeightLabel) :
    su7A6CartanIntegerCombination m (2 : Fin 6) =
      -m (1 : Fin 6) + 2 * m (2 : Fin 6) - m (3 : Fin 6) := by
  simp [su7A6CartanIntegerCombination, su7A6CartanEntry,
    su7A6Adjacent]
  ring_nf

/-- Coordinate `3` of an A6 Cartan integer combination. -/
theorem su7A6CartanIntegerCombination_three_num
    (m : SU7A6WeightLabel) :
    su7A6CartanIntegerCombination m (3 : Fin 6) =
      -m (2 : Fin 6) + 2 * m (3 : Fin 6) - m (4 : Fin 6) := by
  simp [su7A6CartanIntegerCombination, su7A6CartanEntry,
    su7A6Adjacent]
  ring_nf

/-- Coordinate `4` of an A6 Cartan integer combination. -/
theorem su7A6CartanIntegerCombination_four_num
    (m : SU7A6WeightLabel) :
    su7A6CartanIntegerCombination m (4 : Fin 6) =
      -m (3 : Fin 6) + 2 * m (4 : Fin 6) - m (5 : Fin 6) := by
  simp [su7A6CartanIntegerCombination, su7A6CartanEntry,
    su7A6Adjacent]
  ring_nf

/-- Coordinate `5` of an A6 Cartan integer combination. -/
theorem su7A6CartanIntegerCombination_five_num
    (m : SU7A6WeightLabel) :
    su7A6CartanIntegerCombination m (5 : Fin 6) =
      -m (4 : Fin 6) + 2 * m (5 : Fin 6) := by
  simp [su7A6CartanIntegerCombination, su7A6CartanEntry,
    su7A6Adjacent]
  ring_nf

/-- Integer root-lattice displacement in the A6 Cartan coordinates used by
this file. -/
def SU7A6IntegerRootLatticeDisplacement
    (source target : SU7A6WeightLabel) : Prop :=
  ∃ m : SU7A6WeightLabel,
    target = fun j => source j - su7A6CartanIntegerCombination m j

/-- A6 center/root-lattice index for the Dynkin-coordinate carrier.

The coefficient vector `(1,2,3,4,5,6)` kills the A6 Cartan image modulo `7`.
Thus this is the missing `Z/7`-style center coordinate behind the P948
boundary obstruction. -/
def su7A6RootLatticeIndex (label : SU7A6WeightLabel) : Int :=
  label 0 + 2 * label 1 + 3 * label 2 +
    4 * label 3 + 5 * label 4 + 6 * label 5

/-- A minimal center-cover generator for the current A6 Dynkin-coordinate
carrier.

It shifts the Cartan-index coordinate by one.  This is deliberately not a
repair law by itself; it is the smallest representation-side coordinate that
can record endpoint-completion moves blocked by the pure A6 root lattice. -/
def su7A6CenterCoverGenerator : SU7A6WeightLabel :=
  fun j => if j = 0 then 1 else 0

/-- A center-cover displacement is an integer A6 Cartan-root displacement plus
one explicit center-cover coordinate.

This is the positive version of the mod-`7` obstruction: before a completed
endpoint repair can be called SU(7)-generated, the grammar must say whether
this center coordinate is a legal representation/encoding move and how it
projects back to the filtered endpoint sector. -/
def SU7A6CenterCoverDisplacement
    (source target : SU7A6WeightLabel) : Prop :=
  ∃ (m : SU7A6WeightLabel) (z : Int),
    target =
      fun j =>
        source j -
          (su7A6CartanIntegerCombination m j +
            z * su7A6CenterCoverGenerator j)

/-- The center-cover generator changes the A6 root-lattice index by one. -/
theorem su7A6CenterCoverGenerator_rootIndex :
    su7A6RootLatticeIndex su7A6CenterCoverGenerator = 1 := by
  simp [su7A6RootLatticeIndex, su7A6CenterCoverGenerator]

/-- A6 Cartan-root combinations have center/root-lattice index divisible by
`7`. -/
theorem su7A6RootLatticeIndex_cartanIntegerCombination
    (m : SU7A6WeightLabel) :
    su7A6RootLatticeIndex (su7A6CartanIntegerCombination m) =
      7 * m 5 := by
  simp [su7A6RootLatticeIndex, su7A6CartanIntegerCombination,
    su7A6CartanEntry, su7A6Adjacent]
  ring

/-- Center-cover displacements account for the root-lattice index difference
as a Cartan multiple of `7` plus the explicit center shift. -/
theorem SU7A6CenterCoverDisplacement.index_difference
    {source target : SU7A6WeightLabel}
    (H : SU7A6CenterCoverDisplacement source target) :
    ∃ (q z : Int),
      su7A6RootLatticeIndex source -
        su7A6RootLatticeIndex target = 7 * q + z := by
  rcases H with ⟨m, z, rfl⟩
  refine ⟨m 5, z, ?_⟩
  simp [su7A6RootLatticeIndex, su7A6CartanIntegerCombination,
    su7A6CenterCoverGenerator, su7A6CartanEntry, su7A6Adjacent]
  ring

/-- Sum of integer simple-root coefficients.  For the signed-height functional,
this is the height spent by the Cartan part of a center-cover displacement. -/
def su7A6CartanCoefficientSum (m : SU7A6WeightLabel) : Int :=
  m 0 + m 1 + m 2 + m 3 + m 4 + m 5

/-- The signed-height functional reads an integer Cartan combination as the
sum of its simple-root coefficients. -/
theorem su7A6SignedHeight_cartanIntegerCombination
    (m : SU7A6WeightLabel) :
    su7A6SignedHeight (su7A6CartanIntegerCombination m) =
      su7A6CartanCoefficientSum m := by
  simp [su7A6SignedHeight, su7A6CartanIntegerCombination,
    su7A6CartanCoefficientSum, su7A6CartanEntry, su7A6Adjacent]
  ring

/-- The center-cover generator carries signed height `3` in the current
coordinate readout. -/
theorem su7A6SignedHeight_centerCoverGenerator :
    su7A6SignedHeight su7A6CenterCoverGenerator = 3 := by
  simp [su7A6SignedHeight, su7A6CenterCoverGenerator]

/-- A center-cover displacement whose combined Cartan plus center spend is
exactly one signed-height unit.

This is the unit-quantized version of the center-cover socket.  It still does
not assert finite endpoint-core realization or filter preservation. -/
structure SU7A6UnitCenterCoverDisplacement
    (source target : SU7A6WeightLabel) where
  root_coefficients : SU7A6WeightLabel
  center_shift : Int
  displacement :
    target =
      fun j =>
        source j -
          (su7A6CartanIntegerCombination root_coefficients j +
            center_shift * su7A6CenterCoverGenerator j)
  height_spend :
    su7A6CartanCoefficientSum root_coefficients +
      3 * center_shift = 1

namespace SU7A6UnitCenterCoverDisplacement

/-- Forget the unit-quantization side condition and keep the underlying
center-cover displacement. -/
theorem toCenterCoverDisplacement
    {source target : SU7A6WeightLabel}
    (X : SU7A6UnitCenterCoverDisplacement source target) :
    SU7A6CenterCoverDisplacement source target := by
  exact ⟨X.root_coefficients, X.center_shift, X.displacement⟩

/-- Unit center-cover displacement is an exact signed-height unit descent. -/
theorem signedHeight_unit_decrement
    {source target : SU7A6WeightLabel}
    (X : SU7A6UnitCenterCoverDisplacement source target) :
    su7A6SignedHeight target + 1 = su7A6SignedHeight source := by
  rcases X with ⟨m, z, hdisp, hspend⟩
  rw [hdisp]
  rw [← hspend]
  simp [su7A6SignedHeight, su7A6CartanIntegerCombination,
    su7A6CenterCoverGenerator, su7A6CartanCoefficientSum,
      su7A6CartanEntry, su7A6Adjacent]
  ring

end SU7A6UnitCenterCoverDisplacement

/-- Coordinate displacement from `source` to `target`. -/
def su7A6Displacement
    (source target : SU7A6WeightLabel) : SU7A6WeightLabel :=
  fun j => source j - target j

/-- Canonical Cartan coefficients for decomposing an arbitrary A6 coordinate
displacement after adjoining the center-cover generator.

The coefficients are obtained by solving the A6 Cartan recurrence from the
right endpoint with `m_5 = 0`; the remaining first-coordinate discrepancy is
then carried by the center-cover generator. -/
def su7A6CenterCoverRootCoefficientsOfDisplacement
    (source target : SU7A6WeightLabel) : SU7A6WeightLabel :=
  let b := su7A6Displacement source target
  fun
    | ⟨0, _⟩ =>
        -(b 1 + 2 * b 2 + 3 * b 3 + 4 * b 4 + 5 * b 5)
    | ⟨1, _⟩ =>
        -(b 2 + 2 * b 3 + 3 * b 4 + 4 * b 5)
    | ⟨2, _⟩ =>
        -(b 3 + 2 * b 4 + 3 * b 5)
    | ⟨3, _⟩ =>
        -(b 4 + 2 * b 5)
    | ⟨4, _⟩ =>
        -b 5
    | _ => 0

theorem su7A6CenterCoverRootCoefficientsOfDisplacement_zero_num
    (source target : SU7A6WeightLabel) :
    su7A6CenterCoverRootCoefficientsOfDisplacement
        source target (0 : Fin 6) =
      -((source (1 : Fin 6) - target (1 : Fin 6)) +
        2 * (source (2 : Fin 6) - target (2 : Fin 6)) +
        3 * (source (3 : Fin 6) - target (3 : Fin 6)) +
        4 * (source (4 : Fin 6) - target (4 : Fin 6)) +
        5 * (source (5 : Fin 6) - target (5 : Fin 6))) := by
  rfl

theorem su7A6CenterCoverRootCoefficientsOfDisplacement_one_num
    (source target : SU7A6WeightLabel) :
    su7A6CenterCoverRootCoefficientsOfDisplacement
        source target (1 : Fin 6) =
      -((source (2 : Fin 6) - target (2 : Fin 6)) +
        2 * (source (3 : Fin 6) - target (3 : Fin 6)) +
        3 * (source (4 : Fin 6) - target (4 : Fin 6)) +
        4 * (source (5 : Fin 6) - target (5 : Fin 6))) := by
  rfl

theorem su7A6CenterCoverRootCoefficientsOfDisplacement_two_num
    (source target : SU7A6WeightLabel) :
    su7A6CenterCoverRootCoefficientsOfDisplacement
        source target (2 : Fin 6) =
      -((source (3 : Fin 6) - target (3 : Fin 6)) +
        2 * (source (4 : Fin 6) - target (4 : Fin 6)) +
        3 * (source (5 : Fin 6) - target (5 : Fin 6))) := by
  rfl

theorem su7A6CenterCoverRootCoefficientsOfDisplacement_three_num
    (source target : SU7A6WeightLabel) :
    su7A6CenterCoverRootCoefficientsOfDisplacement
        source target (3 : Fin 6) =
      -((source (4 : Fin 6) - target (4 : Fin 6)) +
        2 * (source (5 : Fin 6) - target (5 : Fin 6))) := by
  rfl

theorem su7A6CenterCoverRootCoefficientsOfDisplacement_four_num
    (source target : SU7A6WeightLabel) :
    su7A6CenterCoverRootCoefficientsOfDisplacement
        source target (4 : Fin 6) =
      -(source (5 : Fin 6) - target (5 : Fin 6)) := by
  rfl

theorem su7A6CenterCoverRootCoefficientsOfDisplacement_five_num
    (source target : SU7A6WeightLabel) :
    su7A6CenterCoverRootCoefficientsOfDisplacement
        source target (5 : Fin 6) = 0 := by
  rfl

/-- Canonical center shift for decomposing an arbitrary displacement. -/
def su7A6CenterCoverShiftOfDisplacement
    (source target : SU7A6WeightLabel) : Int :=
  su7A6RootLatticeIndex source - su7A6RootLatticeIndex target

/-- The center-cover generator plus the A6 Cartan image spans the full integer
coordinate carrier.

This is an important diagnostic theorem: center-cover representability by
itself is too broad to be a producer law.  The real SU(7) work must still
generate the target and prove its finite filtered endpoint core. -/
theorem su7A6_centerCover_decomposes_any_displacement
    (source target : SU7A6WeightLabel) :
    target =
      fun j =>
        source j -
          (su7A6CartanIntegerCombination
              (su7A6CenterCoverRootCoefficientsOfDisplacement
                source target) j +
            su7A6CenterCoverShiftOfDisplacement source target *
              su7A6CenterCoverGenerator j) := by
  funext j
  fin_cases j <;>
    simp [
      su7A6CartanIntegerCombination_zero_num,
      su7A6CartanIntegerCombination_one_num,
      su7A6CartanIntegerCombination_two_num,
      su7A6CartanIntegerCombination_three_num,
      su7A6CartanIntegerCombination_four_num,
      su7A6CartanIntegerCombination_five_num,
      su7A6CenterCoverRootCoefficientsOfDisplacement_zero_num,
      su7A6CenterCoverRootCoefficientsOfDisplacement_one_num,
      su7A6CenterCoverRootCoefficientsOfDisplacement_two_num,
      su7A6CenterCoverRootCoefficientsOfDisplacement_three_num,
      su7A6CenterCoverRootCoefficientsOfDisplacement_four_num,
      su7A6CenterCoverRootCoefficientsOfDisplacement_five_num,
      su7A6CenterCoverShiftOfDisplacement,
      su7A6RootLatticeIndex, su7A6CenterCoverGenerator] <;>
    ring_nf

namespace SU7A6UnitCenterCoverDisplacement

/-- Canonical center-shift readout of a unit center-cover displacement.

The explicit `center_shift` field is not by itself the canonical source-target
center disposition: the fifth Cartan coefficient contributes an additional
multiple of `7`.  This theorem is the source/phase coordinate readout needed
before the endpoint finite checker can use a canonical shift such as `-29`. -/
theorem canonicalCenterShift
    {source target : SU7A6WeightLabel}
    (X : SU7A6UnitCenterCoverDisplacement source target) :
    su7A6CenterCoverShiftOfDisplacement source target =
      7 * X.root_coefficients 5 + X.center_shift := by
  rcases X with ⟨m, z, hdisp, _hspend⟩
  dsimp
  rw [hdisp]
  unfold su7A6CenterCoverShiftOfDisplacement
  simp [su7A6RootLatticeIndex, su7A6CartanIntegerCombination,
    su7A6CenterCoverGenerator, su7A6CartanEntry, su7A6Adjacent]
  ring

end SU7A6UnitCenterCoverDisplacement

/-- The canonical center-cover decomposition spends exactly the signed-height
difference between source and target. -/
theorem su7A6_centerCoverCanonical_height_spend
    (source target : SU7A6WeightLabel) :
    su7A6CartanCoefficientSum
        (su7A6CenterCoverRootCoefficientsOfDisplacement source target) +
      3 * su7A6CenterCoverShiftOfDisplacement source target =
        su7A6SignedHeight source - su7A6SignedHeight target := by
  rw [su7A6SignedHeight_num source, su7A6SignedHeight_num target]
  simp [su7A6CartanCoefficientSum,
    su7A6CenterCoverRootCoefficientsOfDisplacement_zero_num,
    su7A6CenterCoverRootCoefficientsOfDisplacement_one_num,
    su7A6CenterCoverRootCoefficientsOfDisplacement_two_num,
    su7A6CenterCoverRootCoefficientsOfDisplacement_three_num,
    su7A6CenterCoverRootCoefficientsOfDisplacement_four_num,
    su7A6CenterCoverRootCoefficientsOfDisplacement_five_num,
    su7A6CenterCoverShiftOfDisplacement,
    su7A6RootLatticeIndex]
  ring_nf

/-- Any target with signed height exactly one below the source can be packaged
as a unit center-cover displacement.

This should not be mistaken for a generated repair law: it proves that unit
center-cover algebra is permissive.  The producer gate is therefore target
generation plus finite filtered endpoint realization. -/
def su7A6UnitCenterCoverDisplacement_of_signedHeight_unit
    {source target : SU7A6WeightLabel}
    (hheight :
      su7A6SignedHeight target + 1 = su7A6SignedHeight source) :
    SU7A6UnitCenterCoverDisplacement source target where
  root_coefficients :=
    su7A6CenterCoverRootCoefficientsOfDisplacement source target
  center_shift := su7A6CenterCoverShiftOfDisplacement source target
  displacement :=
    su7A6_centerCover_decomposes_any_displacement source target
  height_spend := by
    rw [su7A6_centerCoverCanonical_height_spend]
    omega

/-- An unfiltered unit center-cover neighbor of an A6 source label.

Unlike `SU7A6UnfilteredUnitDescentNeighbor`, this is not restricted to a
single simple-root lowering.  The move itself carries the center-cover
coordinates and the proof that the combined Cartan-plus-center displacement
spends exactly one signed-height unit. -/
structure SU7A6UnitCenterCoverDescentNeighbor
    (source : SU7A6WeightLabel) where
  target : SU7A6WeightLabel
  move : SU7A6UnitCenterCoverDisplacement source target

namespace SU7A6UnitCenterCoverDescentNeighbor

/-- Unit center-cover neighbors are exact signed-height unit descents. -/
theorem signedHeight_unit
    {source : SU7A6WeightLabel}
    (N : SU7A6UnitCenterCoverDescentNeighbor source) :
    su7A6SignedHeight N.target + 1 =
      su7A6SignedHeight source :=
  N.move.signedHeight_unit_decrement

end SU7A6UnitCenterCoverDescentNeighbor

/-- Active-sector endpoint grammar for unit center-cover moves.

This is stricter than a bare `∃ N`: the grammar owns the endpoint-code readout
and generates the unit center-cover target from the source A6 label plus the
fact that its signed height is positive. -/
structure SU7A6ActiveSectorUnitCenterCoverEndpointGrammar where
  leftCodeOf : SU7A6WeightLabel -> Nat
  rightCodeOf : SU7A6WeightLabel -> Nat
  targetOf :
    (source : SU7A6WeightLabel) ->
      0 < su7A6SignedHeight source -> SU7A6WeightLabel
  moveOf :
    ∀ (source : SU7A6WeightLabel)
      (hpos : 0 < su7A6SignedHeight source),
      SU7A6UnitCenterCoverDisplacement source (targetOf source hpos)

namespace SU7A6ActiveSectorUnitCenterCoverEndpointGrammar

/-- The active-sector source readout frame generated by unit center-cover
endpoint grammar. -/
def readoutFrame
    (G : SU7A6ActiveSectorUnitCenterCoverEndpointGrammar) :
    SU7A6SourceReadoutFrame :=
  SU7A6ActiveSectorReadoutFrame G.leftCodeOf G.rightCodeOf

/-- The grammar-generated unit center-cover neighbor at a source label. -/
def neighborOf
    (G : SU7A6ActiveSectorUnitCenterCoverEndpointGrammar)
    (source : SU7A6WeightLabel)
    (hpos : 0 < su7A6SignedHeight source) :
    SU7A6UnitCenterCoverDescentNeighbor source where
  target := G.targetOf source hpos
  move := G.moveOf source hpos

/-- The grammar-generated unit center-cover neighbor spends exactly one
signed-height unit. -/
theorem neighborOf_signedHeight_unit
    (G : SU7A6ActiveSectorUnitCenterCoverEndpointGrammar)
    (source : SU7A6WeightLabel)
    (hpos : 0 < su7A6SignedHeight source) :
    su7A6SignedHeight (G.neighborOf source hpos).target + 1 =
      su7A6SignedHeight source :=
  (G.neighborOf source hpos).signedHeight_unit

/-- Against a produced active source readout, the grammar-generated unit
center-cover neighbor reads as an `E - 1` signed-height target. -/
theorem neighborOf_signedHeight_reads_energy_unit
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    {A : SU7ProducedActiveCell σ hσ n bound}
    (G : SU7A6ActiveSectorUnitCenterCoverEndpointGrammar)
    (R :
      SU7ProducedActiveCellA6EndpointSourceReadout
        G.leftCodeOf G.rightCodeOf A)
    (hpos : A.energy ≠ 0) :
    su7A6SignedHeight
        (G.neighborOf R.source_label
          (R.source_signedHeight_pos hpos)).target + 1 =
      (A.energy : Int) := by
  rw [G.neighborOf_signedHeight_unit]
  exact R.source_height_reads_energy

end SU7A6ActiveSectorUnitCenterCoverEndpointGrammar

/-- Integer A6 root-lattice displacement preserves the center/root-lattice
index modulo the Cartan index `7`.

This is the invariant version of the P948 obstruction: any proposed endpoint
repair whose index difference is not a multiple of `7` cannot be a faithful A6
root-lattice move under the current encoding. -/
theorem SU7A6IntegerRootLatticeDisplacement.index_difference
    {source target : SU7A6WeightLabel}
    (H : SU7A6IntegerRootLatticeDisplacement source target) :
    ∃ q : Int,
      su7A6RootLatticeIndex source -
        su7A6RootLatticeIndex target = 7 * q := by
  rcases H with ⟨m, rfl⟩
  refine ⟨m 5, ?_⟩
  simp [su7A6RootLatticeIndex, su7A6CartanIntegerCombination,
    su7A6CartanEntry, su7A6Adjacent]
  ring

/-- Root-lattice index of the concrete endpoint/source label. -/
theorem su7A6EndpointSourceLabel_rootIndex
    (left right energy : Nat) :
    su7A6RootLatticeIndex
        (su7A6EndpointSourceLabel left right energy) =
      7 * (left : Int) + 12 * (right : Int) - 2 * (energy : Int) := by
  simp [su7A6RootLatticeIndex, su7A6EndpointSourceLabel,
    su7A6EndpointSourceEnergyCorrection]
  ring

/-- Canonical center-shift between two concrete endpoint/source labels is the
difference of their endpoint root-index readouts.

This exposes the center-cover disposition as arithmetic carried by the
source-label encoding itself: later `(5,7)` target selection can ask the
generated target to realize the right index disposition, not an opaque
center-cover field. -/
theorem su7A6EndpointSourceLabel_centerCoverShift
    (sourceLeft sourceRight sourceEnergy targetLeft targetRight targetEnergy :
      Nat) :
    su7A6CenterCoverShiftOfDisplacement
        (su7A6EndpointSourceLabel sourceLeft sourceRight sourceEnergy)
        (su7A6EndpointSourceLabel targetLeft targetRight targetEnergy) =
      (7 * (sourceLeft : Int) + 12 * (sourceRight : Int) -
          2 * (sourceEnergy : Int)) -
        (7 * (targetLeft : Int) + 12 * (targetRight : Int) -
          2 * (targetEnergy : Int)) := by
  unfold su7A6CenterCoverShiftOfDisplacement
  rw [su7A6EndpointSourceLabel_rootIndex,
    su7A6EndpointSourceLabel_rootIndex]

/-- Under the concrete endpoint readout, no single A6 simple-root lowering of
the P948 boundary source `(3,3,E=6)` satisfies the finite endpoint core.

This is a real filtered-readout obstruction, not a downstream issue: the raw
A6 signed height always drops by one, but the projected endpoint codes either
fail the multiplicative-atomic checker or do not read the target signed height
as the raw endpoint residual. -/
theorem su7A6P948BoundarySimpleRootTarget_no_endpoint_core
    (i : Fin 6) :
    ¬ (natMultiplicativelyAtomicCheck
          (su7A6EndpointSourceLeftCodeOf
            (su7A6P948BoundarySimpleRootTarget i)) = true ∧
        natMultiplicativelyAtomicCheck
          (su7A6EndpointSourceRightCodeOf
            (su7A6P948BoundarySimpleRootTarget i)) = true ∧
        su7A6SignedHeight (su7A6P948BoundarySimpleRootTarget i) =
          (rawCodePairResidualEnergy 6
            (su7A6EndpointSourceLeftCodeOf
              (su7A6P948BoundarySimpleRootTarget i))
            (su7A6EndpointSourceRightCodeOf
              (su7A6P948BoundarySimpleRootTarget i)) : Int)) := by
  fin_cases i
  ·
    norm_num [su7A6P948BoundarySimpleRootTarget,
      su7A6P948BoundarySourceLabel, su7A6EndpointSourceLabel,
      su7A6EndpointSourceEnergyCorrection, su7A6EndpointSourceLeftCodeOf,
      su7A6EndpointSourceRightCodeOf, su7A6LowerBySimpleRoot,
      su7A6CartanEntry, su7A6Adjacent, su7A6SignedHeight,
      natMultiplicativelyAtomicCheck, natHasNontrivialDivisorCheck,
      rawCodePairResidualEnergy, rawCodePairResidual]
  ·
    norm_num [su7A6P948BoundarySimpleRootTarget,
      su7A6P948BoundarySourceLabel, su7A6EndpointSourceLabel,
      su7A6EndpointSourceEnergyCorrection, su7A6EndpointSourceLeftCodeOf,
      su7A6EndpointSourceRightCodeOf, su7A6LowerBySimpleRoot,
      su7A6CartanEntry, su7A6Adjacent, su7A6SignedHeight,
      natMultiplicativelyAtomicCheck, natHasNontrivialDivisorCheck,
      rawCodePairResidualEnergy, rawCodePairResidual]
  ·
    norm_num [su7A6P948BoundarySimpleRootTarget,
      su7A6P948BoundarySourceLabel, su7A6EndpointSourceLabel,
      su7A6EndpointSourceEnergyCorrection, su7A6EndpointSourceLeftCodeOf,
      su7A6EndpointSourceRightCodeOf, su7A6LowerBySimpleRoot,
      su7A6CartanEntry, su7A6Adjacent, su7A6SignedHeight,
      natMultiplicativelyAtomicCheck, natHasNontrivialDivisorCheck,
      rawCodePairResidualEnergy, rawCodePairResidual]
    intro _
    exact ⟨2, by norm_num⟩
  ·
    norm_num [su7A6P948BoundarySimpleRootTarget,
      su7A6P948BoundarySourceLabel, su7A6EndpointSourceLabel,
      su7A6EndpointSourceEnergyCorrection, su7A6EndpointSourceLeftCodeOf,
      su7A6EndpointSourceRightCodeOf, su7A6LowerBySimpleRoot,
      su7A6CartanEntry, su7A6Adjacent, su7A6SignedHeight,
      natMultiplicativelyAtomicCheck, natHasNontrivialDivisorCheck,
      rawCodePairResidualEnergy, rawCodePairResidual]
  ·
    norm_num [su7A6P948BoundarySimpleRootTarget,
      su7A6P948BoundarySourceLabel, su7A6EndpointSourceLabel,
      su7A6EndpointSourceEnergyCorrection, su7A6EndpointSourceLeftCodeOf,
      su7A6EndpointSourceRightCodeOf, su7A6LowerBySimpleRoot,
      su7A6CartanEntry, su7A6Adjacent, su7A6SignedHeight,
      natMultiplicativelyAtomicCheck, natHasNontrivialDivisorCheck,
      rawCodePairResidualEnergy, rawCodePairResidual]
  ·
    norm_num [su7A6P948BoundarySimpleRootTarget,
      su7A6P948BoundarySourceLabel, su7A6EndpointSourceLabel,
      su7A6EndpointSourceEnergyCorrection, su7A6EndpointSourceLeftCodeOf,
      su7A6EndpointSourceRightCodeOf, su7A6LowerBySimpleRoot,
      su7A6CartanEntry, su7A6Adjacent, su7A6SignedHeight,
      natMultiplicativelyAtomicCheck, natHasNontrivialDivisorCheck,
      rawCodePairResidualEnergy, rawCodePairResidual]

/-- The completed P948 repair endpoint label under the current concrete
endpoint/source encoding. -/
def su7A6P948CompletedRepairLabel : SU7A6WeightLabel :=
  su7A6EndpointSourceLabel 2 5 5

/-- The completed P948 endpoint repair label is a valid endpoint finite-core
readout by itself.

This separates the two issues: `(2,5)` is the right completed endpoint repair
for the P948 boundary, but the current concrete A6 source/readout encoding
does not make it an A6 root-lattice move from the source label. -/
theorem su7A6P948CompletedRepairLabel_endpoint_core :
    natMultiplicativelyAtomicCheck
        (su7A6EndpointSourceLeftCodeOf
          su7A6P948CompletedRepairLabel) = true ∧
      natMultiplicativelyAtomicCheck
          (su7A6EndpointSourceRightCodeOf
            su7A6P948CompletedRepairLabel) = true ∧
        su7A6SignedHeight su7A6P948CompletedRepairLabel =
          (rawCodePairResidualEnergy 6
            (su7A6EndpointSourceLeftCodeOf
            su7A6P948CompletedRepairLabel)
            (su7A6EndpointSourceRightCodeOf
              su7A6P948CompletedRepairLabel) : Int) := by
  simpa [su7A6P948CompletedRepairLabel] using
    (su7A6EndpointSourceLabel_endpoint_core
      (n := 6) (left := 2) (right := 5) (energy := 5)
      natMultiplicativelyAtomicCheck_two
      natMultiplicativelyAtomicCheck_five
      rawCodePairResidualEnergy_six_two_five)

/-- The completed P948 endpoint repair label is not in the integer A6
root-lattice displacement class of the P948 source label under the current
concrete endpoint/source encoding.

The mod-`7` Cartan-index obstruction is the important point: endpoint
completion can produce the correct `(2,5)` repair, but this encoding does not
make that repair a faithful A6 root-lattice move. -/
theorem su7A6P948CompletedRepairLabel_not_integerRootLatticeDisplacement :
    ¬ SU7A6IntegerRootLatticeDisplacement
      su7A6P948BoundarySourceLabel su7A6P948CompletedRepairLabel := by
  intro H
  rcases H.index_difference with ⟨q, hq⟩
  have hdiff :
      su7A6RootLatticeIndex su7A6P948BoundarySourceLabel -
        su7A6RootLatticeIndex su7A6P948CompletedRepairLabel =
          (-19 : Int) := by
    rw [show
        su7A6RootLatticeIndex su7A6P948BoundarySourceLabel =
          7 * (3 : Int) + 12 * (3 : Int) - 2 * (6 : Int) by
        simpa [su7A6P948BoundarySourceLabel]
          using su7A6EndpointSourceLabel_rootIndex 3 3 6]
    rw [show
        su7A6RootLatticeIndex su7A6P948CompletedRepairLabel =
          7 * (2 : Int) + 12 * (5 : Int) - 2 * (5 : Int) by
        simpa [su7A6P948CompletedRepairLabel]
          using su7A6EndpointSourceLabel_rootIndex 2 5 5]
    norm_num
  omega

/-- Explicit root coefficients for the P948 completed repair after adding the
center-cover coordinate.

The pure A6 root-lattice solve is fractional.  With center shift `-19`, these
integer coefficients satisfy

```text
source - target =
  CartanCombination(18,16,16,8,0,0) - 19 * centerGenerator.
```
-/
def su7A6P948CenterCoverRootCoefficients : SU7A6WeightLabel :=
  fun
    | ⟨0, _⟩ => 18
    | ⟨1, _⟩ => 16
    | ⟨2, _⟩ => 16
    | ⟨3, _⟩ => 8
    | _ => 0

@[simp] theorem su7A6P948CenterCoverRootCoefficients_zero
    (h : 0 < 6) :
    su7A6P948CenterCoverRootCoefficients ⟨0, h⟩ = 18 := rfl

@[simp] theorem su7A6P948CenterCoverRootCoefficients_one
    (h : 1 < 6) :
    su7A6P948CenterCoverRootCoefficients ⟨1, h⟩ = 16 := rfl

@[simp] theorem su7A6P948CenterCoverRootCoefficients_two
    (h : 2 < 6) :
    su7A6P948CenterCoverRootCoefficients ⟨2, h⟩ = 16 := rfl

@[simp] theorem su7A6P948CenterCoverRootCoefficients_three
    (h : 3 < 6) :
    su7A6P948CenterCoverRootCoefficients ⟨3, h⟩ = 8 := rfl

@[simp] theorem su7A6P948CenterCoverRootCoefficients_four
    (h : 4 < 6) :
    su7A6P948CenterCoverRootCoefficients ⟨4, h⟩ = 0 := rfl

@[simp] theorem su7A6P948CenterCoverRootCoefficients_five
    (h : 5 < 6) :
    su7A6P948CenterCoverRootCoefficients ⟨5, h⟩ = 0 := rfl

@[simp] theorem su7A6P948CenterCoverRootCoefficients_zero_num :
    su7A6P948CenterCoverRootCoefficients (0 : Fin 6) = 18 := rfl

@[simp] theorem su7A6P948CenterCoverRootCoefficients_one_num :
    su7A6P948CenterCoverRootCoefficients (1 : Fin 6) = 16 := rfl

@[simp] theorem su7A6P948CenterCoverRootCoefficients_two_num :
    su7A6P948CenterCoverRootCoefficients (2 : Fin 6) = 16 := rfl

@[simp] theorem su7A6P948CenterCoverRootCoefficients_three_num :
    su7A6P948CenterCoverRootCoefficients (3 : Fin 6) = 8 := rfl

@[simp] theorem su7A6P948CenterCoverRootCoefficients_four_num :
    su7A6P948CenterCoverRootCoefficients (4 : Fin 6) = 0 := rfl

@[simp] theorem su7A6P948CenterCoverRootCoefficients_five_num :
    su7A6P948CenterCoverRootCoefficients (5 : Fin 6) = 0 := rfl

/-- The hand-written P948 center-cover root coefficients are exactly the
canonical coefficients computed from the A6 source-target displacement.

This removes one possible source of fake progress: the P948 completion vector
is not an arbitrary witness payload, but the canonical readout of the
center-cover decomposition for the `(3,3,E=6) -> (2,5,E=5)` displacement. -/
theorem su7A6P948CenterCoverRootCoefficients_eq_canonical :
    su7A6P948CenterCoverRootCoefficients =
      su7A6CenterCoverRootCoefficientsOfDisplacement
        su7A6P948BoundarySourceLabel su7A6P948CompletedRepairLabel := by
  funext j
  fin_cases j
  ·
    change
      su7A6P948CenterCoverRootCoefficients (0 : Fin 6) =
        su7A6CenterCoverRootCoefficientsOfDisplacement
          su7A6P948BoundarySourceLabel su7A6P948CompletedRepairLabel
          (0 : Fin 6)
    rw [su7A6P948CenterCoverRootCoefficients_zero_num,
      su7A6CenterCoverRootCoefficientsOfDisplacement_zero_num]
    norm_num [su7A6Displacement, su7A6P948BoundarySourceLabel,
      su7A6P948CompletedRepairLabel, su7A6EndpointSourceEnergyCorrection]
  ·
    change
      su7A6P948CenterCoverRootCoefficients (1 : Fin 6) =
        su7A6CenterCoverRootCoefficientsOfDisplacement
          su7A6P948BoundarySourceLabel su7A6P948CompletedRepairLabel
          (1 : Fin 6)
    rw [su7A6P948CenterCoverRootCoefficients_one_num,
      su7A6CenterCoverRootCoefficientsOfDisplacement_one_num]
    norm_num [su7A6Displacement, su7A6P948BoundarySourceLabel,
      su7A6P948CompletedRepairLabel, su7A6EndpointSourceEnergyCorrection]
  ·
    change
      su7A6P948CenterCoverRootCoefficients (2 : Fin 6) =
        su7A6CenterCoverRootCoefficientsOfDisplacement
          su7A6P948BoundarySourceLabel su7A6P948CompletedRepairLabel
          (2 : Fin 6)
    rw [su7A6P948CenterCoverRootCoefficients_two_num,
      su7A6CenterCoverRootCoefficientsOfDisplacement_two_num]
    norm_num [su7A6Displacement, su7A6P948BoundarySourceLabel,
      su7A6P948CompletedRepairLabel, su7A6EndpointSourceEnergyCorrection]
  ·
    change
      su7A6P948CenterCoverRootCoefficients (3 : Fin 6) =
        su7A6CenterCoverRootCoefficientsOfDisplacement
          su7A6P948BoundarySourceLabel su7A6P948CompletedRepairLabel
          (3 : Fin 6)
    rw [su7A6P948CenterCoverRootCoefficients_three_num,
      su7A6CenterCoverRootCoefficientsOfDisplacement_three_num]
    norm_num [su7A6Displacement, su7A6P948BoundarySourceLabel,
      su7A6P948CompletedRepairLabel, su7A6EndpointSourceEnergyCorrection]
  ·
    change
      su7A6P948CenterCoverRootCoefficients (4 : Fin 6) =
        su7A6CenterCoverRootCoefficientsOfDisplacement
          su7A6P948BoundarySourceLabel su7A6P948CompletedRepairLabel
          (4 : Fin 6)
    rw [su7A6P948CenterCoverRootCoefficients_four_num,
      su7A6CenterCoverRootCoefficientsOfDisplacement_four_num]
    norm_num [su7A6Displacement, su7A6P948BoundarySourceLabel,
      su7A6P948CompletedRepairLabel, su7A6EndpointSourceEnergyCorrection]
  ·
    change
      su7A6P948CenterCoverRootCoefficients (5 : Fin 6) =
        su7A6CenterCoverRootCoefficientsOfDisplacement
          su7A6P948BoundarySourceLabel su7A6P948CompletedRepairLabel
          (5 : Fin 6)
    rw [su7A6P948CenterCoverRootCoefficients_five_num,
      su7A6CenterCoverRootCoefficientsOfDisplacement_five_num]

/-- The P948 completed endpoint repair as a unit-quantized center-cover
displacement witness. -/
def su7A6P948CompletedRepairLabel_unitCenterCoverDisplacement :
    SU7A6UnitCenterCoverDisplacement
      su7A6P948BoundarySourceLabel su7A6P948CompletedRepairLabel where
  root_coefficients := su7A6P948CenterCoverRootCoefficients
  center_shift := -19
  displacement := by
    funext j
    fin_cases j <;>
      simp [su7A6P948BoundarySourceLabel,
        su7A6P948CompletedRepairLabel, su7A6EndpointSourceLabel,
        su7A6EndpointSourceEnergyCorrection,
        su7A6CartanIntegerCombination, su7A6CartanEntry, su7A6Adjacent,
        su7A6CenterCoverGenerator, Fin.ext_iff]
  height_spend := by
    norm_num [su7A6CartanCoefficientSum]

/-- The completed P948 endpoint repair is representable in the minimal
center-cover of the current A6 coordinate carrier.

This does not prove the full producer law.  It pinpoints the missing upstream
coordinate: the endpoint repair blocked by the pure A6 root lattice becomes an
integer displacement exactly after adjoining the center-cover generator. -/
theorem su7A6P948CompletedRepairLabel_centerCoverDisplacement :
    SU7A6CenterCoverDisplacement
      su7A6P948BoundarySourceLabel su7A6P948CompletedRepairLabel :=
  su7A6P948CompletedRepairLabel_unitCenterCoverDisplacement
    |>.toCenterCoverDisplacement

/-- The P948 center-cover repair spends exactly one signed-height residual
unit. -/
theorem su7A6P948CompletedRepairLabel_centerCover_unitSignedHeight :
    su7A6SignedHeight su7A6P948CompletedRepairLabel + 1 =
      su7A6SignedHeight su7A6P948BoundarySourceLabel :=
  su7A6P948CompletedRepairLabel_unitCenterCoverDisplacement
    |>.signedHeight_unit_decrement

/-- The P948 completed endpoint repair as a unit center-cover neighbor of the
P948 boundary source.

This is a local filtered-weight graph sample: the target is produced by the
center-cover move object, not chosen later only as an endpoint pair. -/
def su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor :
    SU7A6UnitCenterCoverDescentNeighbor su7A6P948BoundarySourceLabel where
  target := su7A6P948CompletedRepairLabel
  move := su7A6P948CompletedRepairLabel_unitCenterCoverDisplacement

/-- The P948 center-cover neighbor target passes the concrete finite endpoint
core.

This is the local positive counterpart to
`su7A6P948BoundarySimpleRootTarget_no_endpoint_core`: pure simple roots fail
the finite readout, while the center-cover repair target passes it. -/
theorem su7A6P948UnitCenterCoverNeighbor_endpoint_core :
    natMultiplicativelyAtomicCheck
        (su7A6EndpointSourceLeftCodeOf
          su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target) =
        true ∧
      natMultiplicativelyAtomicCheck
          (su7A6EndpointSourceRightCodeOf
            su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target) =
          true ∧
        su7A6SignedHeight
            su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target =
          (rawCodePairResidualEnergy 6
            (su7A6EndpointSourceLeftCodeOf
              su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target)
            (su7A6EndpointSourceRightCodeOf
              su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target) :
              Int) := by
  simpa [su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor]
    using su7A6P948CompletedRepairLabel_endpoint_core

/-- The P948 center-cover neighbor projects to a raw endpoint `E - 1`
successor.

This does not prove global filtered connectedness.  It records the exact local
shape the general SU(7) grammar theorem must reproduce for every produced
positive residual. -/
theorem su7A6P948UnitCenterCoverNeighbor_raw_endpoint_energy_unit :
    rawCodePairResidualEnergy 6
        (su7A6EndpointSourceLeftCodeOf
          su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target)
        (su7A6EndpointSourceRightCodeOf
          su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target) +
      1 =
        rawCodePairResidualEnergy 6 3 3 := by
  norm_num [su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor,
    su7A6P948CompletedRepairLabel, su7A6EndpointSourceLabel,
    su7A6EndpointSourceLeftCodeOf, su7A6EndpointSourceRightCodeOf,
    rawCodePairResidualEnergy, rawCodePairResidual]

/-- The generated no-prime lower cell induced by the P948 center-cover target.

This is still only the local boundary sample.  It materializes the endpoint
finite core as an actual generated lower cell, without assuming a repair cell
or a downstream normalizer. -/
def su7A6P948UnitCenterCoverNeighborLowerCell :
    SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding 6 :=
  noPrimeBranchingCellOfBooleanAtomicRawCell
    (booleanAtomicCellOfRawCodePair 6
      (su7A6EndpointSourceLeftCodeOf
        su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target)
      (su7A6EndpointSourceRightCodeOf
        su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target)
      (su7A6P948UnitCenterCoverNeighbor_endpoint_core).1
      (su7A6P948UnitCenterCoverNeighbor_endpoint_core).2.1)

/-- The P948 center-cover lower cell is generated in the computed endpoint
room.

The completed room is computed from the old bound and the target endpoint
codes; it is not supplied as an arbitrary larger table. -/
theorem su7A6P948UnitCenterCoverNeighborLowerCell_mem_generated :
    su7A6P948UnitCenterCoverNeighborLowerCell ∈
      generatedNoPrimeBranchingCells 6
        (computedEndpointRoomBound 3
          (su7A6EndpointSourceLeftCodeOf
            su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target)
          (su7A6EndpointSourceRightCodeOf
            su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target)) := by
  unfold su7A6P948UnitCenterCoverNeighborLowerCell
  exact
    generatedNoPrimeBranchingCellOf_boundedAtomicRawCodePair_mem
      (repairLeft_mem_rawCodeBoundedList_computedEndpointRoomBound
        3
        (su7A6EndpointSourceLeftCodeOf
          su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target)
        (su7A6EndpointSourceRightCodeOf
          su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target))
      (repairRight_mem_rawCodeBoundedList_computedEndpointRoomBound
        3
        (su7A6EndpointSourceLeftCodeOf
          su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target)
        (su7A6EndpointSourceRightCodeOf
          su7A6P948CompletedRepairLabel_unitCenterCoverNeighbor.target))
      (su7A6P948UnitCenterCoverNeighbor_endpoint_core).1
      (su7A6P948UnitCenterCoverNeighbor_endpoint_core).2.1

/-- The generated lower cell from the P948 center-cover target is an exact
endpoint-energy unit successor. -/
theorem su7A6P948UnitCenterCoverNeighborLowerCell_energy_unit :
    noPrimeBranchingEndpointResidualEnergy
        su7A6P948UnitCenterCoverNeighborLowerCell + 1 =
      rawCodePairResidualEnergy 6 3 3 := by
  unfold su7A6P948UnitCenterCoverNeighborLowerCell
