variable {K : Type*} [Field K]
variable {σ : K} {hσ : σ ≠ 1} {n bound : Nat}

/-- The generated source-label endpoint-code law also generates the pointwise
source-label projection-core law.

Here the target source/phase label is the concrete endpoint/source label whose
energy coordinate is the raw endpoint residual of the generated target codes.
The center-cover move is forced by the raw unit readout. -/
def toGeneratedSourceLabelUnitCenterCoverProjectionCoreLaw
    (L : SU7A6GeneratedSourceLabelCodePairUnitTargetLaw σ hσ n bound) :
    SU7A6GeneratedSourceLabelUnitCenterCoverProjectionCoreLaw
      σ hσ n bound where
  targetLabel := fun source hheight =>
    su7A6EndpointSourceLabel
      (L.targetLeft source hheight)
      (L.targetRight source hheight)
      (rawCodePairResidualEnergy n
        (L.targetLeft source hheight)
        (L.targetRight source hheight))
  source_target_core := by
    intro A hpos
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    let left := L.targetLeft R0.source_label hheight
    let right := L.targetRight R0.source_label hheight
    let raw := rawCodePairResidualEnergy n left right
    refine
      { unit_center_cover_move := ?_
        endpoint_projection_core := ?_ }
    ·
      apply su7A6UnitCenterCoverDisplacement_of_signedHeight_unit
      have Hraw := L.raw_unit_reads_sourceSignedHeight A hpos
      have Hheight :
          (raw : Int) + 1 = su7A6SignedHeight R0.source_label := by
        calc
          (raw : Int) + 1 = ((raw + 1 : Nat) : Int) := by norm_num
          _ = su7A6SignedHeight R0.source_label := by
            simpa [R0, hheight, left, right, raw] using Hraw
      simpa [left, right, raw, su7A6EndpointSourceLabel_signedHeight]
        using Hheight
    ·
      refine
        { target_endpoint_shape := ?_
          left_check := ?_
          right_check := ?_ }
      ·
        simp [su7A6ConcreteEndpointSourceGrammar,
          su7A6EndpointSourceLabel_leftCode,
          su7A6EndpointSourceLabel_rightCode]
      ·
        simpa [R0, hheight, left, right, raw,
          su7A6ConcreteEndpointSourceGrammar,
          su7A6EndpointSourceLabel_leftCode] using
          L.left_check A hpos
      ·
        simpa [R0, hheight, left, right, raw,
          su7A6ConcreteEndpointSourceGrammar,
          su7A6EndpointSourceLabel_rightCode] using
          L.right_check A hpos

/-- The source-label endpoint-code law generates canonical center-cover
coordinates for the projection-core move.

This is the coordinate-level form of the producer mouth: once target endpoint
codes are generated and raw `E - 1` is read from the source height, the
source/phase displacement coordinates are the canonical A6 center-cover
coordinates of the generated source-target pair, not an arbitrary field. -/
theorem sourceProjectionCore_canonicalCenterCoverCoordinates
    (L : SU7A6GeneratedSourceLabelCodePairUnitTargetLaw σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    let CoreLaw := L.toGeneratedSourceLabelUnitCenterCoverProjectionCoreLaw
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    let target := CoreLaw.targetLabel R0.source_label hheight
    (CoreLaw.source_target_core A hpos).unit_center_cover_move.root_coefficients =
        su7A6CenterCoverRootCoefficientsOfDisplacement R0.source_label target ∧
      (CoreLaw.source_target_core A hpos).unit_center_cover_move.center_shift =
        su7A6CenterCoverShiftOfDisplacement R0.source_label target := by
  let CoreLaw := L.toGeneratedSourceLabelUnitCenterCoverProjectionCoreLaw
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  let target := CoreLaw.targetLabel R0.source_label hheight
  constructor
  ·
    simp [toGeneratedSourceLabelUnitCenterCoverProjectionCoreLaw,
      su7A6UnitCenterCoverDisplacement_of_signedHeight_unit]
  ·
    simp [toGeneratedSourceLabelUnitCenterCoverProjectionCoreLaw,
      su7A6UnitCenterCoverDisplacement_of_signedHeight_unit]

end SU7A6GeneratedSourceLabelCodePairUnitTargetLaw

/-- Fixed simple-root source-label target for the unfiltered A6 graph.

This is intentionally only the raw weight-graph target.  P948 shows that this
simple-root target need not be endpoint-filter faithful; the matching
`EndpointProjectionLaw` is still a separate hard gate. -/
def su7A6FixedSimpleRootSourceLabelUnitTarget
    (source : SU7A6WeightLabel)
    (_hpos : 0 < su7A6SignedHeight source) :
    SU7A6WeightLabel :=
  su7A6LowerBySimpleRoot (0 : Fin 6) source

/-- The fixed simple-root source-label target is an exact signed-height unit
descent in the unfiltered A6 graph. -/
theorem su7A6FixedSimpleRootSourceLabelUnitTarget_signedHeight_unit
    (source : SU7A6WeightLabel)
    (hpos : 0 < su7A6SignedHeight source) :
    su7A6SignedHeight
        (su7A6FixedSimpleRootSourceLabelUnitTarget source hpos) + 1 =
      su7A6SignedHeight source := by
  exact su7A6SignedHeight_lowerBySimpleRoot source (0 : Fin 6)

/-- The unfiltered A6 source graph supplies the generated-source adjacency half:
every positive produced source label has a simple-root unit descent, packaged as
a unit center-cover move.

This proves only the source/phase adjacency side.  It does not assert that the
lower label is endpoint-shaped, no-prime admissible, or survives the filtered
projection. -/
def su7A6_unfilteredSimpleRoot_sourceLabelUnitCenterCoverAdjacencyLaw
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat} :
    SU7A6GeneratedSourceLabelUnitCenterCoverAdjacencyLaw
      σ hσ n bound where
  targetLabel := su7A6FixedSimpleRootSourceLabelUnitTarget
  unit_center_cover_move := by
    intro A hpos
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    exact
      su7A6UnitCenterCoverDisplacement_of_signedHeight_unit
        (su7A6FixedSimpleRootSourceLabelUnitTarget_signedHeight_unit
          R0.source_label hheight)

/-- A fixed Cartan coefficient vector for a genuine center-cover completion
unit.

Together with center shift `1`, its total signed-height spend is
`(-2) + 3 = 1`.  This gives a source/phase unit move that is visibly not just
a packaged simple-root lowering. -/
def su7A6CanonicalCenterCoverCompletionRootCoefficients :
    SU7A6WeightLabel :=
  fun j => if j = (0 : Fin 6) then (-2 : Int) else 0

/-- The fixed completion root coefficients have Cartan coefficient sum `-2`. -/
theorem su7A6CanonicalCenterCoverCompletionRootCoefficients_sum :
    su7A6CartanCoefficientSum
      su7A6CanonicalCenterCoverCompletionRootCoefficients = -2 := by
  simp [su7A6CartanCoefficientSum,
    su7A6CanonicalCenterCoverCompletionRootCoefficients]

/-- Canonical source/phase completion target using one explicit center-cover
quantum.

This is only an adjacency target.  It does not say the target is endpoint
projectable or no-prime admissible. -/
def su7A6CanonicalCenterCoverCompletionTarget
    (source : SU7A6WeightLabel) : SU7A6WeightLabel :=
  fun j =>
    source j -
      (su7A6CartanIntegerCombination
          su7A6CanonicalCenterCoverCompletionRootCoefficients j +
        su7A6CenterCoverGenerator j)

/-- The canonical completion target is a unit center-cover displacement. -/
def su7A6CanonicalCenterCoverCompletionTarget_unitCenterCoverDisplacement
    (source : SU7A6WeightLabel) :
    SU7A6UnitCenterCoverDisplacement source
      (su7A6CanonicalCenterCoverCompletionTarget source) where
  root_coefficients := su7A6CanonicalCenterCoverCompletionRootCoefficients
  center_shift := 1
  displacement := by
    funext j
    simp [su7A6CanonicalCenterCoverCompletionTarget]
  height_spend := by
    simp [su7A6CanonicalCenterCoverCompletionRootCoefficients_sum]

/-- The canonical center-cover completion target spends exactly one signed
height unit. -/
theorem su7A6CanonicalCenterCoverCompletionTarget_signedHeight_unit
    (source : SU7A6WeightLabel) :
    su7A6SignedHeight
        (su7A6CanonicalCenterCoverCompletionTarget source) + 1 =
      su7A6SignedHeight source :=
  (su7A6CanonicalCenterCoverCompletionTarget_unitCenterCoverDisplacement
    source).signedHeight_unit_decrement

/-- The canonical completion target has root/center index difference `1`.

This records that the target genuinely uses the center-cover coordinate; it is
not in the pure integer A6 root-lattice displacement class. -/
theorem su7A6CanonicalCenterCoverCompletionTarget_rootIndex_difference
    (source : SU7A6WeightLabel) :
    su7A6RootLatticeIndex source -
        su7A6RootLatticeIndex
          (su7A6CanonicalCenterCoverCompletionTarget source) =
      1 := by
  simp [su7A6CanonicalCenterCoverCompletionTarget,
    su7A6CanonicalCenterCoverCompletionRootCoefficients,
    su7A6RootLatticeIndex, su7A6CartanIntegerCombination,
    su7A6CenterCoverGenerator, su7A6CartanEntry, su7A6Adjacent]
  ring

/-- The canonical completion target is not a pure integer A6 root-lattice
displacement from the same source. -/
theorem su7A6CanonicalCenterCoverCompletionTarget_not_integerRootLatticeDisplacement
    (source : SU7A6WeightLabel) :
    ¬ SU7A6IntegerRootLatticeDisplacement source
      (su7A6CanonicalCenterCoverCompletionTarget source) := by
  intro H
  rcases H.index_difference with ⟨q, hq⟩
  have hidx :=
    su7A6CanonicalCenterCoverCompletionTarget_rootIndex_difference source
  rw [hidx] at hq
  omega

/-- Canonical center-cover completion supplies a generated-source adjacency
half.

This is stronger than the fixed simple-root adjacency sample in one specific
sense: the target visibly carries a center-cover quantum.  It is still only
the source/phase adjacency half; endpoint projection/filter preservation is a
separate hard gate. -/
def su7A6_canonicalCenterCoverCompletion_sourceLabelUnitCenterCoverAdjacencyLaw
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat} :
    SU7A6GeneratedSourceLabelUnitCenterCoverAdjacencyLaw
      σ hσ n bound where
  targetLabel := fun source _hpos =>
    su7A6CanonicalCenterCoverCompletionTarget source
  unit_center_cover_move := by
    intro A _hpos
    let R0 := su7A6ConcreteEndpointSourceReadout A
    exact
      su7A6CanonicalCenterCoverCompletionTarget_unitCenterCoverDisplacement
        R0.source_label

/-- Endpoint-shaped completion target obtained from the concrete source-code
readout.

The target shifts endpoint room by one unit of source/phase energy:
`left ↦ left - 1`, `right ↦ right + 2`, and `height ↦ height - 1`.
It is designed as a source/phase target generator, not as a no-prime/filter
theorem: atomic checks and raw endpoint-energy preservation remain separate. -/
def su7A6EndpointShiftCompletionTarget
