  let right := su7A6ConcreteEndpointSourceGrammar.rightCodeOf target
  have hraw_unit :
      (((rawCodePairResidualEnergy 10 left right + 1 : Nat) : Int) =
        su7A6SignedHeight su7A6FiveSevenSourceLabel) := by
    simpa [left, right] using
      su7A6FiveSevenEndpointProjectionCore_rawUnit_reads_sourceSignedHeight
        C hunit
  have hsource_height :
      su7A6SignedHeight su7A6FiveSevenSourceLabel = (8 : Int) := by
    simp [su7A6FiveSevenSourceLabel, su7A6EndpointSourceLabel_signedHeight]
  have hraw : rawCodePairResidualEnergy 10 left right = 7 := by
    have hraw_int :
        ((rawCodePairResidualEnergy 10 left right + 1 : Nat) : Int) =
          (8 : Int) := by
      simpa [hsource_height] using hraw_unit
    omega
  have hcodes :
      (left = 2 ∧ right = 11) ∨ (left = 11 ∧ right = 2) :=
    SU7A6ProducedActiveRawCellCompletionTargetLaw.rawCodePairResidualEnergy_ten_atomic_seven_codes
      (by simpa [left] using C.left_check)
      (by simpa [right] using C.right_check)
      hraw
  rcases hcodes with hcodes | hcodes
  ·
    rcases hcodes with ⟨hleft, hright⟩
    have hraw_211 : rawCodePairResidualEnergy 10 2 11 = 7 := by
      simpa [left, right, hleft, hright] using hraw
    have htarget : target = su7A6FiveSevenCompletedRepairLabel := by
      rw [C.target_endpoint_shape]
      simp [left, right, hleft, hright, hraw_211,
        su7A6FiveSevenCompletedRepairLabel]
    have hshift :
        su7A6CenterCoverShiftOfDisplacement
          su7A6FiveSevenSourceLabel target = -29 := by
      simpa [htarget] using
        su7A6FiveSevenCompletedRepairLabel_canonicalCenterShift
    have hdiff :
        su7A6RootLatticeIndex su7A6FiveSevenSourceLabel -
            su7A6RootLatticeIndex target =
          -29 := by
      simpa [su7A6CenterCoverShiftOfDisplacement] using hshift
    rw [hdiff] at hq
    omega
  ·
    rcases hcodes with ⟨hleft, hright⟩
    have hraw_112 : rawCodePairResidualEnergy 10 11 2 = 7 := by
      simpa [left, right, hleft, hright] using hraw
    have htarget : target = su7A6EndpointSourceLabel 11 2 7 := by
      rw [C.target_endpoint_shape]
      simp [left, right, hleft, hright, hraw_112]
    have hshift :
        su7A6CenterCoverShiftOfDisplacement
          su7A6FiveSevenSourceLabel target = 16 := by
      simpa [htarget] using
        su7A6FiveSevenMirrorRepairLabel_canonicalCenterShift
    have hdiff :
        su7A6RootLatticeIndex su7A6FiveSevenSourceLabel -
            su7A6RootLatticeIndex target =
          16 := by
      simpa [su7A6CenterCoverShiftOfDisplacement] using hshift
    rw [hdiff] at hq
    omega

/-- Source/projection-core target selection from actual center-cover
coordinates.

This is the same finite target selection as
`su7A6FiveSevenEndpointProjectionCore_target_eq_completedRepairLabel`, but the
unit descent and canonical `-29` disposition are read from the generated
source/phase core itself.  The only representation-side coordinates required
at this point are the fifth Cartan coefficient `m_5 = 0` and explicit center
coordinate `z = -29`; the canonical shift then follows from
`SU7A6UnitCenterCoverDisplacement.canonicalCenterShift`. -/
theorem su7A6FiveSevenSourceLabelUnitCenterCoverProjectionCore_target_eq_completedRepairLabel_of_coordinates
    {target : SU7A6WeightLabel}
    (C :
