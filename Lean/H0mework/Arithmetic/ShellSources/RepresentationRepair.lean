    su7A6ConcreteEndpointSourceGrammar,
    su7A6EndpointSourceLabel_leftCode,
    su7A6EndpointSourceLabel_rightCode,
    su7A6EndpointSourceLabel_signedHeight,
    natMultiplicativelyAtomicCheck, natHasNontrivialDivisorCheck,
    rawCodePairResidualEnergy, rawCodePairResidual]
  constructor
  · intro x _hx htwo hlt hdiv
    interval_cases x <;> norm_num at hdiv
  constructor
  · intro x _hx htwo hlt hdiv
    interval_cases x <;> norm_num at hdiv
  constructor
  · exact ⟨2, by norm_num⟩
  · exact ⟨3, by norm_num⟩

/-- The source-oriented fixed target can fail the endpoint projection core on
an actual produced-active source path shape.

For produced active cells whose source endpoint codes are `(5,7)` at `n = 10`,
the sign-oriented raw `E - 1` move chooses target codes `(4,9)`.  Both fail the
Boolean atomic filter, so this target cannot supply
`SU7A6EndpointProjectionCore`.  This is the produced-active version of the
filter-connectedness guardrail: the source/phase move is generated, but the
finite endpoint filter still needs genuine completion room. -/
theorem su7A6ProducedActiveCell_sourceOrientedEndpointTarget_no_endpointProjectionCore_of_five_seven
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {bound : Nat}
    (A : SU7ProducedActiveCell σ hσ 10 bound)
    (hleft : A.sourceCell.cell.leftWeightCode = 5)
    (hright : A.sourceCell.cell.rightWeightCode = 7)
    (hpos : A.energy ≠ 0) :
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    su7A6SourceOrientedEndpointTargetLeft 10 R0.source_label = 4 ∧
      su7A6SourceOrientedEndpointTargetRight 10 R0.source_label = 9 ∧
        natMultiplicativelyAtomicCheck
          (su7A6SourceOrientedEndpointTargetLeft 10 R0.source_label) =
            false ∧
          natMultiplicativelyAtomicCheck
            (su7A6SourceOrientedEndpointTargetRight 10 R0.source_label) =
              false ∧
            ¬ SU7A6EndpointProjectionCore 10
              (su7A6SourceOrientedEndpointTargetLabel
                10 R0.source_label hheight) := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  have henergy : A.energy = rawCodePairResidualEnergy 10 5 7 := by
    rw [SU7ProducedActiveCell.energy_eq_raw_source_pair A, hleft, hright]
  have hsource :
      R0.source_label =
        su7A6EndpointSourceLabel 5 7
          (rawCodePairResidualEnergy 10 5 7) := by
    dsimp [R0, su7A6ConcreteEndpointSourceReadout,
      su7A6ConcreteEndpointSourceLabelOf]
    rw [hleft, hright, henergy]
  have G :=
    su7A6_sourceOrientedEndpointTarget_filter_not_forced_by_source_atomicity
  dsimp at G
  rcases G with
    ⟨_hsourceLeft, _hsourceRight, _hsourcePos,
      htargetLeft, htargetRight, htargetLeftCheck, htargetRightCheck⟩
  have htargetLeft_R :
      su7A6SourceOrientedEndpointTargetLeft 10 R0.source_label = 4 := by
    rw [hsource]
    exact htargetLeft
  have htargetRight_R :
      su7A6SourceOrientedEndpointTargetRight 10 R0.source_label = 9 := by
    rw [hsource]
    exact htargetRight
  have htargetLeftCheck_R :
      natMultiplicativelyAtomicCheck
        (su7A6SourceOrientedEndpointTargetLeft 10 R0.source_label) =
          false := by
    rw [hsource]
    exact htargetLeftCheck
  have htargetRightCheck_R :
      natMultiplicativelyAtomicCheck
        (su7A6SourceOrientedEndpointTargetRight 10 R0.source_label) =
          false := by
    rw [hsource]
    exact htargetRightCheck
  refine
    ⟨htargetLeft_R, htargetRight_R,
      htargetLeftCheck_R, htargetRightCheck_R, ?_⟩
  intro C
  have hcoreLeft :
      natMultiplicativelyAtomicCheck
        (su7A6SourceOrientedEndpointTargetLeft 10 R0.source_label) =
          true := by
    simpa [su7A6SourceOrientedEndpointTargetLabel,
      su7A6ConcreteEndpointSourceGrammar,
      su7A6EndpointSourceLabel_leftCode] using C.left_check
  rw [htargetLeftCheck_R] at hcoreLeft
  cases hcoreLeft

/-- On the produced-active `(5,7)` source path, the source-oriented target is
a genuine raw `E - 1` unit move and nevertheless fails endpoint projection.

This locates the break precisely: the representation/source-phase motion and
unit quantization are present; filtered connectedness fails because the
generated target codes `(4,9)` do not survive the no-prime endpoint filter. -/
theorem su7A6ProducedActiveCell_sourceOrientedEndpointTarget_rawUnit_and_no_endpointProjectionCore_of_five_seven
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {bound : Nat}
    (A : SU7ProducedActiveCell σ hσ 10 bound)
    (hleft : A.sourceCell.cell.leftWeightCode = 5)
    (hright : A.sourceCell.cell.rightWeightCode = 7)
    (hpos : A.energy ≠ 0) :
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    rawCodePairResidualEnergy 10
        (su7A6EndpointSourceLeftCodeOf
          (su7A6SourceOrientedEndpointTargetLabel
            10 R0.source_label hheight))
        (su7A6EndpointSourceRightCodeOf
          (su7A6SourceOrientedEndpointTargetLabel
            10 R0.source_label hheight)) + 1 =
      A.energy ∧
      ¬ SU7A6EndpointProjectionCore 10
        (su7A6SourceOrientedEndpointTargetLabel
          10 R0.source_label hheight) := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  have hraw :
      rawCodePairResidualEnergy 10
          (su7A6EndpointSourceLeftCodeOf
            (su7A6SourceOrientedEndpointTargetLabel
              10 R0.source_label hheight))
          (su7A6EndpointSourceRightCodeOf
            (su7A6SourceOrientedEndpointTargetLabel
              10 R0.source_label hheight)) + 1 =
        A.energy := by
    simpa [R0, hheight] using
      su7A6SourceOrientedEndpointTargetLabel_rawEndpointEnergy_unit
        (n := 10) A hpos
  have Hfail :=
    su7A6ProducedActiveCell_sourceOrientedEndpointTarget_no_endpointProjectionCore_of_five_seven
      A hleft hright hpos
  rcases Hfail with ⟨_, _, _, _, hnoCore⟩
  exact ⟨hraw, hnoCore⟩

