/-- Endpoint-left-anchor completion target.

This is the source/phase completion-room rule suggested by the P948 and
`(5,7)` diagnostics: on the under-target side, spend one signed-height unit,
increase the endpoint sum by one, and place the left endpoint at the prime
anchor `2`.  Thus the right endpoint is generated as `left + right - 1` from
the source endpoint codes.  No filtered repair cell or downstream normalizer is
assumed here. -/
def su7A6EndpointLeftAnchorCompletionTarget
    (source : SU7A6WeightLabel)
    (_hpos : 0 < su7A6SignedHeight source) :
    SU7A6WeightLabel :=
  su7A6EndpointSourceLabel 2
    (su7A6EndpointSourceLeftCodeOf source +
      su7A6EndpointSourceRightCodeOf source - 1)
    (Int.toNat (su7A6SignedHeight source - 1))

/-- Left endpoint readout of the left-anchor completion target. -/
theorem su7A6EndpointLeftAnchorCompletionTarget_leftCode
    (source : SU7A6WeightLabel)
    (hpos : 0 < su7A6SignedHeight source) :
    su7A6EndpointSourceLeftCodeOf
        (su7A6EndpointLeftAnchorCompletionTarget source hpos) = 2 := by
  simp [su7A6EndpointLeftAnchorCompletionTarget,
    su7A6EndpointSourceLabel_leftCode]

/-- Right endpoint readout of the left-anchor completion target. -/
theorem su7A6EndpointLeftAnchorCompletionTarget_rightCode
    (source : SU7A6WeightLabel)
    (hpos : 0 < su7A6SignedHeight source) :
    su7A6EndpointSourceRightCodeOf
        (su7A6EndpointLeftAnchorCompletionTarget source hpos) =
      su7A6EndpointSourceLeftCodeOf source +
        su7A6EndpointSourceRightCodeOf source - 1 := by
  simp [su7A6EndpointLeftAnchorCompletionTarget,
    su7A6EndpointSourceLabel_rightCode]

/-- The left-anchor completion target spends one signed-height unit. -/
theorem su7A6EndpointLeftAnchorCompletionTarget_signedHeight_unit
    (source : SU7A6WeightLabel)
    (hpos : 0 < su7A6SignedHeight source) :
    su7A6SignedHeight
        (su7A6EndpointLeftAnchorCompletionTarget source hpos) + 1 =
      su7A6SignedHeight source := by
  rw [su7A6EndpointLeftAnchorCompletionTarget,
    su7A6EndpointSourceLabel_signedHeight]
  have hnonneg : 0 ≤ su7A6SignedHeight source - 1 := by
    omega
  have hto :
      ((Int.toNat (su7A6SignedHeight source - 1) : Nat) : Int) =
        su7A6SignedHeight source - 1 := by
    exact Int.toNat_of_nonneg hnonneg
  omega

/-- Endpoint-shaped source readout of the left-anchor center-cover shift.

For a concrete endpoint source `(left,right,energy)`, the left-anchor target
`(2,left+right-1,energy-1)` has center/root-index disposition
`-(5 * left + 4)`.  This is the source/phase selector arithmetic behind the
`(5,7)` value `-29`; it is not a downstream repair-cell statement. -/
theorem su7A6EndpointLeftAnchorCompletionTarget_centerCoverShift_of_endpointSourceLabel
    {left right energy : Nat}
    (hsum : 1 ≤ left + right)
    (hpos :
      0 < su7A6SignedHeight
        (su7A6EndpointSourceLabel left right energy)) :
    su7A6CenterCoverShiftOfDisplacement
        (su7A6EndpointSourceLabel left right energy)
        (su7A6EndpointLeftAnchorCompletionTarget
          (su7A6EndpointSourceLabel left right energy) hpos) =
      -((5 * (left : Int)) + 4) := by
  have henergy_pos : 0 < energy := by
    simpa [su7A6EndpointSourceLabel_signedHeight] using hpos
  have htargetEnergy :
      ((Int.toNat
          (su7A6SignedHeight
              (su7A6EndpointSourceLabel left right energy) - 1) : Nat) :
          Int) =
        (energy : Int) - 1 := by
    rw [su7A6EndpointSourceLabel_signedHeight]
    exact Int.toNat_of_nonneg (by omega)
  have hright :
      ((left + right - 1 : Nat) : Int) =
        (left : Int) + (right : Int) - 1 := by
    omega
  rw [su7A6EndpointLeftAnchorCompletionTarget,
    su7A6EndpointSourceLabel_centerCoverShift]
  rw [htargetEnergy]
  simp [su7A6EndpointSourceLabel_leftCode,
    su7A6EndpointSourceLabel_rightCode]
  rw [hright]
  ring

/-- Produced-cell readout of the left-anchor center-cover shift.

For any produced active source, the left-anchor source/phase target has
center/root-index disposition `-(5 * left + 4)`, where `left` is the produced
source endpoint code.  This keeps the selector arithmetic attached to the
generated source path instead of a downstream completed-label shortcut. -/
theorem su7A6ProducedActiveCell_endpointLeftAnchor_centerCoverShift
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    su7A6CenterCoverShiftOfDisplacement R0.source_label
        (su7A6EndpointLeftAnchorCompletionTarget R0.source_label hheight) =
      -((5 * (A.sourceCell.cell.leftWeightCode : Int)) + 4) := by
