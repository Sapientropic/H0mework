finite atomic classification leaves `(2,11)` or its mirror; and the canonical
center-shift `-29` removes the mirror.  Thus the source/phase target itself is
the completed `(2,11,E=7)` label, before invoking any raw-cell completion law. -/
theorem su7A6FiveSevenEndpointProjectionCore_target_eq_completedRepairLabel
    {target : SU7A6WeightLabel}
    (C : SU7A6EndpointProjectionCore 10 target)
    (hunit :
      su7A6SignedHeight target + 1 =
        su7A6SignedHeight su7A6FiveSevenSourceLabel)
    (hshift :
      su7A6CenterCoverShiftOfDisplacement
        su7A6FiveSevenSourceLabel target = -29) :
    target = su7A6FiveSevenCompletedRepairLabel := by
  let left := su7A6ConcreteEndpointSourceGrammar.leftCodeOf target
  let right := su7A6ConcreteEndpointSourceGrammar.rightCodeOf target
  have hraw_unit :
      (((rawCodePairResidualEnergy 10 left right + 1 : Nat) : Int) =
        su7A6SignedHeight su7A6FiveSevenSourceLabel) := by
    simpa [left, right] using
      su7A6FiveSevenEndpointProjectionCore_rawUnit_reads_sourceSignedHeight
        C hunit
  have hsource_height :
      su7A6SignedHeight su7A6FiveSevenSourceLabel = (8 : Int) := by
    simp [su7A6FiveSevenSourceLabel, su7A6EndpointSourceLabel_signedHeight]
  have hraw : rawCodePairResidualEnergy 10 left right = 7 := by
    have hraw_int :
        ((rawCodePairResidualEnergy 10 left right + 1 : Nat) : Int) =
          (8 : Int) := by
      simpa [hsource_height] using hraw_unit
    omega
  have hcodes :
