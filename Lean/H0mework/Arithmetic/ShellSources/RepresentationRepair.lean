    (X : SU7A6UnitCenterCoverComputedEndpointCodeCompletionCore
      Readout A R N) :
    noPrimeBranchingEndpointResidualEnergy X.generatedLowerCell + 1 =
      A.energy := by
  unfold generatedLowerCell
  rw [noPrimeBranchingCellOfBooleanAtomicRawCell_energy_eq,
    booleanAtomicCellOfRawCodePair_energy_eq]
  exact X.raw_endpoint_energy_unit

/-- Finite computed endpoint core materializes the generated lower-cell half
of filtered downward connectivity.

This is the reusable version of the P948 boundary sample: the remaining hard
producer gate is now exactly to prove the finite core for the grammar-selected
target. -/
theorem materializes_generated_lower_cell
    (X : SU7A6UnitCenterCoverComputedEndpointCodeCompletionCore
      Readout A R N) :
    ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
      lower ∈
        generatedNoPrimeBranchingCells n
          (computedEndpointRoomBound bound
            (Readout.leftCodeOf N.target)
            (Readout.rightCodeOf N.target)) ∧
        noPrimeBranchingEndpointResidualEnergy lower + 1 = A.energy :=
  ⟨X.generatedLowerCell,
    X.generatedLowerCell_mem_generated,
    X.generatedLowerCell_energy_unit⟩

/-- Unit-center-cover finite core gives the completed-bound form of filtered
downward connectivity.

This is still before the `SU7GeneratedRepairCell` adapter: it only exposes the
grammar-computed endpoint room, the generated lower no-prime cell, and the
exact `E - 1` residual readout. -/
theorem filtered_weight_graph_downward_connectivity
    (X : SU7A6UnitCenterCoverComputedEndpointCodeCompletionCore
      Readout A R N) :
    ∃ completedBound,
      ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
        bound ≤ completedBound ∧
          lower ∈ generatedNoPrimeBranchingCells n completedBound ∧
            noPrimeBranchingEndpointResidualEnergy lower + 1 =
              A.energy := by
  let completedBound :=
    computedEndpointRoomBound bound
      (Readout.leftCodeOf N.target)
      (Readout.rightCodeOf N.target)
  exact
    ⟨completedBound, X.generatedLowerCell,
      by
        simpa [completedBound] using
          bound_le_computedEndpointRoomBound bound
            (Readout.leftCodeOf N.target)
            (Readout.rightCodeOf N.target),
      by
        simpa [completedBound] using X.generatedLowerCell_mem_generated,
      X.generatedLowerCell_energy_unit⟩

/-- A concrete endpoint/source target satisfying the three finite-core facts
materializes as a generated lower no-prime cell in the computed endpoint room.

This theorem is the filtered-connectivity payoff of the endpoint-source target
reduction.  It still does not assume or construct a downstream repair cell. -/
theorem materializes_concreteEndpointSourceLabel_target
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : Nat}
    {A : SU7ProducedActiveCell σ hσ n bound}
    {R :
      SU7ProducedActiveCellA6SourceReadout
        su7A6ConcreteEndpointSourceGrammar.readoutFrame A}
    {N : SU7A6UnitCenterCoverDescentNeighbor R.source_label}
    {left right energy : Nat}
    (htarget :
      N.target = su7A6EndpointSourceLabel left right energy)
    (hleft : natMultiplicativelyAtomicCheck left = true)
    (hright : natMultiplicativelyAtomicCheck right = true)
    (henergy : rawCodePairResidualEnergy n left right = energy) :
    ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
      lower ∈
        generatedNoPrimeBranchingCells n
          (computedEndpointRoomBound bound left right) ∧
        noPrimeBranchingEndpointResidualEnergy lower + 1 = A.energy := by
  let C :
      SU7A6UnitCenterCoverComputedEndpointCodeCompletionCore
        su7A6ConcreteEndpointSourceGrammar.readoutFrame A R N :=
    of_concreteEndpointSourceLabel_target
      htarget hleft hright henergy
  simpa [htarget, SU7A6ActiveSectorEndpointGrammar.readoutFrame,
    SU7A6ActiveSectorReadoutFrame, su7A6ConcreteEndpointSourceGrammar,
    su7A6EndpointSourceLabel_leftCode, su7A6EndpointSourceLabel_rightCode]
    using C.materializes_generated_lower_cell

/-- The finite computed-endpoint core plus global unit-center-cover sector
preservation reconstructs the full computed endpoint realization. -/
theorem toComputedEndpointCodeCompletionRealizesUnitCenterCoverNeighbor
    (X : SU7A6UnitCenterCoverComputedEndpointCodeCompletionCore
      Readout A R N)
    (S : SU7A6ReadoutUnitCenterCoverSectorPreservationLaw Readout) :
    SU7A6UnitCenterCoverComputedEndpointCodeCompletionRealizesNeighbor
      Readout A R N := by
  exact
    { left_check := X.left_check
      right_check := X.right_check
      target_branch_preserved := S.target_branch_preserved
      target_incidence_preserved := S.target_incidence_preserved
      repair_height_reads_endpoint := X.repair_height_reads_endpoint }

end SU7A6UnitCenterCoverComputedEndpointCodeCompletionCore

/-- Computed endpoint-room finite core for an unfiltered A6 lower neighbor.

Unlike `SU7A6ComputedEndpointCodeCompletionRealizesNeighbor`, this core does
not carry local branch/incidence preservation fields.  Those must come from a
global `SU7A6ReadoutRootSectorPreservationLaw`, making the sector check a
property of the representation readout rather than a one-off witness. -/
structure SU7A6ComputedEndpointCodeCompletionCore
    (Readout : SU7A6SourceReadoutFrame)
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound)
    (R : SU7ProducedActiveCellA6SourceReadout Readout A)
    (N : SU7A6UnfilteredUnitDescentNeighbor R.source_label) : Prop where
  left_check :
    natMultiplicativelyAtomicCheck (Readout.leftCodeOf N.target) = true
  right_check :
    natMultiplicativelyAtomicCheck (Readout.rightCodeOf N.target) = true
  repair_height_reads_endpoint :
    su7A6SignedHeight N.target =
      (rawCodePairResidualEnergy n
        (Readout.leftCodeOf N.target)
        (Readout.rightCodeOf N.target) : Int)

/-- Computed endpoint-room realization of an unfiltered A6 lower neighbor.

This removes the free `completedBound` field from
`SU7A6EndpointCodeCompletionRealizesNeighbor`: the completion room is exactly
`computedEndpointRoomBound bound left right`, where `left/right` are the
endpoint-code readout of the lower A6 label. -/
structure SU7A6ComputedEndpointCodeCompletionRealizesNeighbor
    (Readout : SU7A6SourceReadoutFrame)
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound)
    (R : SU7ProducedActiveCellA6SourceReadout Readout A)
    (N : SU7A6UnfilteredUnitDescentNeighbor R.source_label) where
  left_check :
    natMultiplicativelyAtomicCheck (Readout.leftCodeOf N.target) = true
  right_check :
    natMultiplicativelyAtomicCheck (Readout.rightCodeOf N.target) = true
  target_branch_preserved :
    Readout.branchOf N.target =
      Readout.branchOf R.source_label
  target_incidence_preserved :
    Readout.incidenceOf N.target =
      Readout.incidenceOf R.source_label
  repair_height_reads_endpoint :
    su7A6SignedHeight N.target =
      (rawCodePairResidualEnergy n
        (Readout.leftCodeOf N.target)
        (Readout.rightCodeOf N.target) : Int)

namespace SU7A6ComputedEndpointCodeCompletionRealizesNeighbor

variable {Readout : SU7A6SourceReadoutFrame}
variable {K : Type*} [Field K]
variable {σ : K} {hσ : σ ≠ 1} {n bound : Nat}
variable {A : SU7ProducedActiveCell σ hσ n bound}
variable {R : SU7ProducedActiveCellA6SourceReadout Readout A}
variable {N : SU7A6UnfilteredUnitDescentNeighbor R.source_label}

/-- Computed endpoint-room completion keeps the lower A6 target in the
canonical branch sector. -/
theorem target_branch_eq
    (X :
      SU7A6ComputedEndpointCodeCompletionRealizesNeighbor Readout A R N) :
    Readout.branchOf N.target = SU3FlagSchubertCell.e := by
  rw [X.target_branch_preserved]
  exact R.branch_eq

/-- Computed endpoint-room completion keeps the lower A6 target in the
canonical charged block-incidence sector. -/
theorem target_incidence_eq
    (X :
      SU7A6ComputedEndpointCodeCompletionRealizesNeighbor Readout A R N) :
    Readout.incidenceOf N.target =
      (.colorWeak : RunningSigmaBeta.SU7BlockIncidence) := by
  rw [X.target_incidence_preserved]
  exact R.incidence_eq

/-- Computed endpoint-room completion lowers to endpoint-code completion. -/
def toEndpointCodeCompletionRealizesNeighbor
    (X :
      SU7A6ComputedEndpointCodeCompletionRealizesNeighbor Readout A R N) :
    SU7A6EndpointCodeCompletionRealizesNeighbor Readout A R N where
  completedBound :=
    computedEndpointRoomBound bound
      (Readout.leftCodeOf N.target)
      (Readout.rightCodeOf N.target)
  completion_room :=
    bound_le_computedEndpointRoomBound bound
      (Readout.leftCodeOf N.target)
      (Readout.rightCodeOf N.target)
  left_mem :=
    repairLeft_mem_rawCodeBoundedList_computedEndpointRoomBound
      bound
      (Readout.leftCodeOf N.target)
      (Readout.rightCodeOf N.target)
  right_mem :=
    repairRight_mem_rawCodeBoundedList_computedEndpointRoomBound
      bound
      (Readout.leftCodeOf N.target)
      (Readout.rightCodeOf N.target)
  left_check := X.left_check
  right_check := X.right_check
  target_branch_preserved := X.target_branch_preserved
  target_incidence_preserved := X.target_incidence_preserved
  repair_height_reads_endpoint := X.repair_height_reads_endpoint

end SU7A6ComputedEndpointCodeCompletionRealizesNeighbor

namespace SU7A6ComputedEndpointCodeCompletionCore

variable {Readout : SU7A6SourceReadoutFrame}
variable {K : Type*} [Field K]
variable {σ : K} {hσ : σ ≠ 1} {n bound : Nat}
variable {A : SU7ProducedActiveCell σ hσ n bound}
variable {R : SU7ProducedActiveCellA6SourceReadout Readout A}
variable {N : SU7A6UnfilteredUnitDescentNeighbor R.source_label}

/-- The finite computed-endpoint core turns a simple-root neighbor into an
exact raw endpoint-residual unit successor. -/
theorem raw_endpoint_energy_unit
    (X : SU7A6ComputedEndpointCodeCompletionCore Readout A R N) :
    rawCodePairResidualEnergy n
        (Readout.leftCodeOf N.target)
        (Readout.rightCodeOf N.target) + 1 =
      A.energy := by
  have hint :
      (rawCodePairResidualEnergy n
          (Readout.leftCodeOf N.target)
          (Readout.rightCodeOf N.target) : Int) + 1 =
        (A.energy : Int) := by
    calc
      (rawCodePairResidualEnergy n
          (Readout.leftCodeOf N.target)
          (Readout.rightCodeOf N.target) : Int) + 1 =
          su7A6SignedHeight N.target + 1 := by
            rw [← X.repair_height_reads_endpoint]
      _ = su7A6SignedHeight R.source_label := N.signed_height_unit
      _ = (A.energy : Int) := R.source_height_reads_energy
  exact_mod_cast hint

/-- The generated lower no-prime cell materialized by a simple-root finite
computed-endpoint core.

Branch/incidence preservation is deliberately not used here: filtered
lower-cell generation only needs bounded endpoint room plus the Boolean
atomic checks carried by the finite core. -/
def generatedLowerCell
    (X : SU7A6ComputedEndpointCodeCompletionCore Readout A R N) :
    SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n :=
  noPrimeBranchingCellOfBooleanAtomicRawCell
    (booleanAtomicCellOfRawCodePair n
      (Readout.leftCodeOf N.target)
      (Readout.rightCodeOf N.target)
      X.left_check X.right_check)

/-- The simple-root finite core materializes its lower cell in the computed
endpoint room for the target endpoint codes. -/
theorem generatedLowerCell_mem_generated
    (X : SU7A6ComputedEndpointCodeCompletionCore Readout A R N) :
    X.generatedLowerCell ∈
      generatedNoPrimeBranchingCells n
        (computedEndpointRoomBound bound
          (Readout.leftCodeOf N.target)
          (Readout.rightCodeOf N.target)) := by
  unfold generatedLowerCell
  exact
    generatedNoPrimeBranchingCellOf_boundedAtomicRawCodePair_mem
      (repairLeft_mem_rawCodeBoundedList_computedEndpointRoomBound
        bound (Readout.leftCodeOf N.target) (Readout.rightCodeOf N.target))
      (repairRight_mem_rawCodeBoundedList_computedEndpointRoomBound
        bound (Readout.leftCodeOf N.target) (Readout.rightCodeOf N.target))
      X.left_check X.right_check

/-- The simple-root finite core's generated lower cell has endpoint energy
exactly one unit below the produced active source. -/
theorem generatedLowerCell_energy_unit
    (X : SU7A6ComputedEndpointCodeCompletionCore Readout A R N) :
    noPrimeBranchingEndpointResidualEnergy X.generatedLowerCell + 1 =
      A.energy := by
  unfold generatedLowerCell
  rw [noPrimeBranchingCellOfBooleanAtomicRawCell_energy_eq,
    booleanAtomicCellOfRawCodePair_energy_eq]
  exact X.raw_endpoint_energy_unit

/-- Simple-root finite core materializes the generated lower-cell half of
filtered downward connectivity.

This is the simple-root analogue of the unit-center-cover local theorem: the
hard producer gate is to prove the finite core for the grammar-selected
lowered target. -/
theorem materializes_generated_lower_cell
    (X : SU7A6ComputedEndpointCodeCompletionCore Readout A R N) :
    ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
      lower ∈
        generatedNoPrimeBranchingCells n
          (computedEndpointRoomBound bound
            (Readout.leftCodeOf N.target)
            (Readout.rightCodeOf N.target)) ∧
        noPrimeBranchingEndpointResidualEnergy lower + 1 = A.energy :=
  ⟨X.generatedLowerCell,
    X.generatedLowerCell_mem_generated,
    X.generatedLowerCell_energy_unit⟩

/-- Simple-root finite core gives the completed-bound form of filtered
downward connectivity.

This theorem is the local `SU7FilteredWeightGraphDownwardConnectivity` shape:
finite endpoint core plus computed completion room produces a generated
filtered `E - 1` lower cell, without invoking downstream repair-cell
transport. -/
theorem filtered_weight_graph_downward_connectivity
    (X : SU7A6ComputedEndpointCodeCompletionCore Readout A R N) :
    ∃ completedBound,
      ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
        bound ≤ completedBound ∧
          lower ∈ generatedNoPrimeBranchingCells n completedBound ∧
            noPrimeBranchingEndpointResidualEnergy lower + 1 =
              A.energy := by
  let completedBound :=
    computedEndpointRoomBound bound
      (Readout.leftCodeOf N.target)
      (Readout.rightCodeOf N.target)
  exact
    ⟨completedBound, X.generatedLowerCell,
      by
        simpa [completedBound] using
          bound_le_computedEndpointRoomBound bound
            (Readout.leftCodeOf N.target)
            (Readout.rightCodeOf N.target),
      by
        simpa [completedBound] using X.generatedLowerCell_mem_generated,
      X.generatedLowerCell_energy_unit⟩

/-- The finite computed-endpoint core plus global root-sector preservation
reconstructs the full computed endpoint realization. -/
theorem toComputedEndpointCodeCompletionRealizesNeighbor
    (X : SU7A6ComputedEndpointCodeCompletionCore Readout A R N)
    (S : SU7A6ReadoutRootSectorPreservationLaw Readout) :
    SU7A6ComputedEndpointCodeCompletionRealizesNeighbor
      Readout A R N := by
  exact
    { left_check := X.left_check
      right_check := X.right_check
      target_branch_preserved := S.target_branch_preserved
      target_incidence_preserved := S.target_incidence_preserved
      repair_height_reads_endpoint := X.repair_height_reads_endpoint }

end SU7A6ComputedEndpointCodeCompletionCore

namespace SU7A6SignedHeightFilteredRootRepairMove

variable {K : Type*} [Field K]
variable {σ : K} {hσ : σ ≠ 1} {n bound : Nat}
variable {A : SU7ProducedActiveCell σ hσ n bound}
variable {Readout : SU7A6SourceReadoutFrame}

/-- A source A6 readout plus faithful filtered realization of an unfiltered
A6 neighbor produces the signed-height filtered repair move. -/
def of_sourceReadout_and_filteredCompletion
    (R : SU7ProducedActiveCellA6SourceReadout Readout A)
    (N : SU7A6UnfilteredUnitDescentNeighbor R.source_label)
    (F : SU7A6FilteredCompletionRealizesNeighbor Readout A R N) :
    SU7A6SignedHeightFilteredRootRepairMove A where
  completedBound := F.completedBound
  completion_room := F.completion_room
  source_label := R.source_label
  repair_label := N.target
  root_move := N.root_move
  source_height_reads_energy := R.source_height_reads_energy
  lower := F.lower
  branching_filter_preserved := F.branching_filter_preserved
  repair_height_reads_lower := F.repair_height_reads_lower

end SU7A6SignedHeightFilteredRootRepairMove

/-- Signed-height repair move generated by a unit center-cover displacement.

This is the center-cover receiver socket for the representation track.  It
removes the simple-root restriction while keeping the same obligations that
matter to the existing repair throat: generated completion room, filtered lower
cell membership, faithful signed-height readout, and exact unit descent. -/
structure SU7A6SignedHeightFilteredUnitCenterCoverRepairMove
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound) where
  completedBound : Nat
  completion_room : bound ≤ completedBound
  source_label : SU7A6WeightLabel
  repair_label : SU7A6WeightLabel
  unit_center_cover_move :
    SU7A6UnitCenterCoverDisplacement source_label repair_label
  source_height_reads_energy :
    su7A6SignedHeight source_label = (A.energy : Int)
  lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n
  branching_filter_preserved :
    lower ∈ generatedNoPrimeBranchingCells n completedBound
  repair_height_reads_lower :
    su7A6SignedHeight repair_label =
      (noPrimeBranchingEndpointResidualEnergy lower : Int)

namespace SU7A6SignedHeightFilteredUnitCenterCoverRepairMove

variable {K : Type*} [Field K]
variable {σ : K} {hσ : σ ≠ 1} {n bound : Nat}
variable {A : SU7ProducedActiveCell σ hσ n bound}
variable {Readout : SU7A6SourceReadoutFrame}

/-- The unit center-cover displacement reads back as endpoint-energy `E - 1`.
-/
theorem lower_energy_unit
    (X : SU7A6SignedHeightFilteredUnitCenterCoverRepairMove A) :
    noPrimeBranchingEndpointResidualEnergy X.lower + 1 = A.energy := by
  have hheight :
      ((noPrimeBranchingEndpointResidualEnergy X.lower : Nat) : Int) + 1 =
        (A.energy : Int) := by
    calc
      ((noPrimeBranchingEndpointResidualEnergy X.lower : Nat) : Int) + 1 =
          su7A6SignedHeight X.repair_label + 1 := by
            rw [X.repair_height_reads_lower]
      _ = su7A6SignedHeight X.source_label :=
          X.unit_center_cover_move.signedHeight_unit_decrement
      _ = (A.energy : Int) := X.source_height_reads_energy
  omega

/-- The source signed-height readout of a legal unit center-cover repair move
lives in the nonnegative residual region. -/
theorem source_signedHeight_nonneg
    (X : SU7A6SignedHeightFilteredUnitCenterCoverRepairMove A) :
    0 ≤ su7A6SignedHeight X.source_label := by
  rw [X.source_height_reads_energy]
  exact_mod_cast Nat.zero_le A.energy

/-- The repair signed-height readout of a legal unit center-cover repair move
lives in the nonnegative residual region. -/
theorem repair_signedHeight_nonneg
    (X : SU7A6SignedHeightFilteredUnitCenterCoverRepairMove A) :
    0 ≤ su7A6SignedHeight X.repair_label := by
  rw [X.repair_height_reads_lower]
  exact_mod_cast
    Nat.zero_le (noPrimeBranchingEndpointResidualEnergy X.lower)

/-- On a legal unit center-cover repair move, the integer signed-height readout
is faithful to the source Nat residual shell. -/
theorem source_signedHeightNat_reads_energy
    (X : SU7A6SignedHeightFilteredUnitCenterCoverRepairMove A) :
    su7A6SignedHeightNat X.source_label = A.energy := by
  have hcast :
      ((su7A6SignedHeightNat X.source_label : Nat) : Int) =
        (A.energy : Int) := by
    unfold su7A6SignedHeightNat
    rw [Int.toNat_of_nonneg X.source_signedHeight_nonneg]
    exact X.source_height_reads_energy
  exact_mod_cast hcast

/-- On a legal unit center-cover repair move, the integer signed-height readout
is faithful to the generated lower Nat residual shell. -/
theorem repair_signedHeightNat_reads_lower
    (X : SU7A6SignedHeightFilteredUnitCenterCoverRepairMove A) :
    su7A6SignedHeightNat X.repair_label =
      noPrimeBranchingEndpointResidualEnergy X.lower := by
  have hcast :
      ((su7A6SignedHeightNat X.repair_label : Nat) : Int) =
        (noPrimeBranchingEndpointResidualEnergy X.lower : Int) := by
    unfold su7A6SignedHeightNat
    rw [Int.toNat_of_nonneg X.repair_signedHeight_nonneg]
    exact X.repair_height_reads_lower
  exact_mod_cast hcast

/-- The unit center-cover displacement also reads as a Nat-shell unit
decrement on the legal filtered source/repair region. -/
theorem signedHeightNat_unit_decrement
    (X : SU7A6SignedHeightFilteredUnitCenterCoverRepairMove A) :
    su7A6SignedHeightNat X.repair_label + 1 =
      su7A6SignedHeightNat X.source_label := by
  calc
    su7A6SignedHeightNat X.repair_label + 1 =
        noPrimeBranchingEndpointResidualEnergy X.lower + 1 := by
          rw [X.repair_signedHeightNat_reads_lower]
    _ = A.energy := X.lower_energy_unit
    _ = su7A6SignedHeightNat X.source_label :=
        X.source_signedHeightNat_reads_energy.symm

/-- A signed-height unit center-cover move materializes the generated repair
cell. -/
def to_generatedRepairCell
    (X : SU7A6SignedHeightFilteredUnitCenterCoverRepairMove A)
    (hpos : A.energy ≠ 0) :
    SU7GeneratedRepairCell A (SU7RepairObligation.of_positive A hpos) :=
  generatedRepairCell_of_noPrimeUnitStepAtRepairBound
    (completedBound := X.completedBound) (step := X.lower)
    A hpos X.completion_room X.branching_filter_preserved
    X.lower_energy_unit

/-- Existential completed-bound form for a unit center-cover repair move. -/
theorem exists_generatedRepairCell
    (X : SU7A6SignedHeightFilteredUnitCenterCoverRepairMove A)
    (hpos : A.energy ≠ 0) :
    ∃ completedBound,
      ∃ _repair :
        SU7GeneratedRepairCell A
          (SU7RepairObligation.of_positive A hpos),
        bound ≤ completedBound := by
  exact ⟨X.completedBound, X.to_generatedRepairCell hpos,
    X.completion_room⟩

/-- A source A6 readout plus faithful filtered realization of a unit
center-cover neighbor produces the signed-height center-cover repair move. -/
def of_sourceReadout_and_filteredCompletion
    (R : SU7ProducedActiveCellA6SourceReadout Readout A)
    (N : SU7A6UnitCenterCoverDescentNeighbor R.source_label)
    (F :
      SU7A6FilteredCompletionRealizesUnitCenterCoverNeighbor
        Readout A R N) :
    SU7A6SignedHeightFilteredUnitCenterCoverRepairMove A where
  completedBound := F.completedBound
  completion_room := F.completion_room
  source_label := R.source_label
  repair_label := N.target
  unit_center_cover_move := N.move
  source_height_reads_energy := R.source_height_reads_energy
  lower := F.lower
  branching_filter_preserved := F.branching_filter_preserved
  repair_height_reads_lower := F.repair_height_reads_lower

end SU7A6SignedHeightFilteredUnitCenterCoverRepairMove

/-- Signed-height generated repair law using unit center-cover moves.

This is parallel to `SU7A6SignedHeightGeneratedRepairLaw`, but the generated
move is allowed to use the explicit center-cover coordinate rather than a
single simple-root edge. -/
structure SU7A6SignedHeightUnitCenterCoverGeneratedRepairLaw
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat) : Prop where
  repair_move :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound),
      A.energy ≠ 0 ->
        Nonempty (SU7A6SignedHeightFilteredUnitCenterCoverRepairMove A)

/-- The unit center-cover generated repair law directly produces the completed
repair-cell source target. -/
theorem su7A6_signedHeight_unitCenterCover_generated_repair_law
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (L : SU7A6SignedHeightUnitCenterCoverGeneratedRepairLaw σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    ∃ completedBound,
      ∃ _repair :
        SU7GeneratedRepairCell A
          (SU7RepairObligation.of_positive A hpos),
        bound ≤ completedBound := by
  rcases L.repair_move A hpos with ⟨move⟩
  exact move.exists_generatedRepairCell hpos

/-- Computed-endpoint core law for unit center-cover repair.

This is the current narrow center-cover producer socket.  It does not assume a
repair cell or a filtered lower cell.  The grammar must provide a faithful
source A6 readout, a legal unit center-cover lower neighbor, global
branch/incidence preservation for that move type, and the finite endpoint core
for the computed completion room. -/
structure SU7A6SignedHeightUnitCenterCoverComputedEndpointCoreLaw
    (Readout : SU7A6SourceReadoutFrame)
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat) : Prop where
  source_readout :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound),
      A.energy ≠ 0 ->
        Nonempty (SU7ProducedActiveCellA6SourceReadout Readout A)
  unit_center_cover_sector_preservation :
    SU7A6ReadoutUnitCenterCoverSectorPreservationLaw Readout
  computed_endpoint_core :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (_hpos : A.energy ≠ 0)
      (R : SU7ProducedActiveCellA6SourceReadout Readout A),
        ∃ N : SU7A6UnitCenterCoverDescentNeighbor R.source_label,
          SU7A6UnitCenterCoverComputedEndpointCodeCompletionCore
            Readout A R N

/-- A unit center-cover computed-endpoint core law supplies the generated
unit center-cover repair law. -/
theorem SU7A6SignedHeightUnitCenterCoverComputedEndpointCoreLaw.toUnitCenterCoverGeneratedRepairLaw
