            A.sourceCell.cell.rightWeightCode := by
        exact SU7A6EndpointUnitDescentOrientation.raw_unit O
      _ = A.energy := (SU7ProducedActiveCell.energy_eq_raw_source_pair A).symm
  exact
    ⟨completedBound, lower,
      by
        simpa [completedBound, targetLeft, targetRight] using
          bound_le_computedEndpointRoomBound bound
            (SU7A6EndpointUnitDescentOrientation.targetLeft O)
            (SU7A6EndpointUnitDescentOrientation.targetRight O),
