          0 ≤ su7A6SignedHeight R0.source_label - 1 := by
        rw [R0.source_height_reads_energy]
        have hApos : 0 < (A.energy : Int) := by
          exact_mod_cast Nat.pos_of_ne_zero hpos
        omega
      have hrawNat :
          raw = Int.toNat (su7A6SignedHeight R0.source_label - 1) := by
        apply Int.ofNat.inj
        calc
          (raw : Int) = su7A6SignedHeight R0.source_label - 1 := hrawInt
          _ =
              (Int.toNat (su7A6SignedHeight R0.source_label - 1) :
                Int) := by
            exact (Int.toNat_of_nonneg hnonneg).symm
      simpa [raw] using hrawNat)

/-- Endpoint-backshift source-code atomic checks plus the over-target
raw-energy window imply the finite projection law. -/
theorem su7A6_endpointBackshiftCompletion_endpointProjectionLaw_of_sourceCode_checks_and_sourceAbove
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
