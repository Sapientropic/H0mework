    su7A6EndpointLeftAnchorCompletionTarget_centerCoverShift_of_endpointSourceLabel
      (left := A.sourceCell.cell.leftWeightCode)
      (right := A.sourceCell.cell.rightWeightCode)
      (energy := A.energy)
