  exact hshift

/-- Canonical `(5,7)` source/projection cores with the canonical `-29`
center-cover disposition are forced to choose the left-anchor target.

This is the selector uniqueness statement at the source/phase core layer.  It
does not construct a repair cell and does not use coverage: a core that already
carries endpoint projection plus the SU(7) move coordinates `m_5 = 0, z = -29`
has no remaining freedom to pick a non-left-anchor target. -/
theorem su7A6FiveSevenSourceLabelUnitCenterCoverProjectionCore_target_eq_leftAnchor_of_coordinates
    {target : SU7A6WeightLabel}
    (C :
      SU7A6SourceLabelUnitCenterCoverProjectionCore
        10 su7A6FiveSevenSourceLabel target)
    (hroot_five :
      C.unit_center_cover_move.root_coefficients (5 : Fin 6) = 0)
    (hcenter :
      C.unit_center_cover_move.center_shift = -29) :
    target =
      su7A6EndpointLeftAnchorCompletionTarget
        su7A6FiveSevenSourceLabel
        (by
          norm_num [su7A6FiveSevenSourceLabel,
            su7A6EndpointSourceLabel_signedHeight]) := by
  let hheight : 0 < su7A6SignedHeight su7A6FiveSevenSourceLabel := by
    norm_num [su7A6FiveSevenSourceLabel,
      su7A6EndpointSourceLabel_signedHeight]
  have htarget :
