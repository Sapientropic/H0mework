/-- Raw-cell version of the concrete unit-center-cover endpoint target law.

This is the lower finite-arithmetic socket: instead of separately supplying
`atomic(targetLeft)`, `atomic(targetRight)`, and raw endpoint residual readout,
the grammar supplies a Boolean-atomic raw branching target cell.  The target
cell carries the atomic checks; its raw branching residual is then required to
read the grammar-owned `targetEnergy`.

This still does not assume generated membership, a repair cell, a normalizer,
coverage, or an endpoint shell. -/
structure SU7A6SignedHeightConcreteUnitCenterCoverEndpointRawCellTargetLaw
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat) where
  targetCell :
    (source : SU7A6WeightLabel) ->
      0 < su7A6SignedHeight source -> SU7BooleanAtomicRawBranchingCell n
  targetEnergy :
    (source : SU7A6WeightLabel) ->
      0 < su7A6SignedHeight source -> Nat
  unit_center_cover_move :
    ∀ (source : SU7A6WeightLabel)
      (hheight : 0 < su7A6SignedHeight source),
      SU7A6UnitCenterCoverDisplacement source
        (su7A6EndpointSourceLabel
          ((targetCell source hheight).cell.leftWeightCode)
          ((targetCell source hheight).cell.rightWeightCode)
          (targetEnergy source hheight))
  target_cell_energy_reads :
    ∀ (source : SU7A6WeightLabel)
      (hheight : 0 < su7A6SignedHeight source),
      rawAtomCodeBranchingDecompositionResidualEnergy
        (targetCell source hheight).cell =
          targetEnergy source hheight

namespace SU7A6SignedHeightConcreteUnitCenterCoverEndpointRawCellTargetLaw

variable {K : Type*} [Field K]
variable {σ : K} {hσ : σ ≠ 1} {n bound : Nat}

/-- A raw-cell target law supplies the higher endpoint target law by reading
endpoint codes and atomic checks from the Boolean-atomic target cell. -/
def toEndpointTargetLaw
    (L :
      SU7A6SignedHeightConcreteUnitCenterCoverEndpointRawCellTargetLaw
        σ hσ n bound) :
    SU7A6SignedHeightConcreteUnitCenterCoverEndpointTargetLaw
      σ hσ n bound where
  targetLeft := fun source hheight =>
    (L.targetCell source hheight).cell.leftWeightCode
  targetRight := fun source hheight =>
    (L.targetCell source hheight).cell.rightWeightCode
  targetEnergy := L.targetEnergy
  unit_center_cover_move := L.unit_center_cover_move
  left_check := fun source hheight =>
    (L.targetCell source hheight).left_check
  right_check := fun source hheight =>
    (L.targetCell source hheight).right_check
  raw_energy_reads_target := by
    intro A hpos
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    have hbranch :
        rawAtomCodeBranchingDecompositionResidualEnergy
            (L.targetCell R0.source_label hheight).cell =
          rawCodePairResidualEnergy n
            (L.targetCell R0.source_label hheight).cell.leftWeightCode
            (L.targetCell R0.source_label hheight).cell.rightWeightCode :=
      rawBranchingResidualEnergy_eq_codePair
        (L.targetCell R0.source_label hheight).cell
    have hread :
        rawCodePairResidualEnergy n
            (L.targetCell R0.source_label hheight).cell.leftWeightCode
            (L.targetCell R0.source_label hheight).cell.rightWeightCode =
          L.targetEnergy R0.source_label hheight :=
      hbranch.symm.trans
        (L.target_cell_energy_reads R0.source_label hheight)
    simpa [R0, hheight, su7A6ConcreteEndpointSourceReadout] using hread

/-- A raw-cell completion target law feeds the pointwise source/projection core
mouth.

This is the current cleanest upstream socket after the fixed endpoint-shift
filter obstruction: the SU(7) grammar may choose any Boolean-atomic raw target
cell carrying the unit center-cover move, and this adapter exposes exactly the
source/phase projection core needed for filtered downward connectivity. -/
def toGeneratedSourceLabelUnitCenterCoverProjectionCoreLaw
    (L :
      SU7A6SignedHeightConcreteUnitCenterCoverEndpointRawCellTargetLaw
        σ hσ n bound) :
    SU7A6GeneratedSourceLabelUnitCenterCoverProjectionCoreLaw
      σ hσ n bound :=
  L.toEndpointTargetLaw.toGeneratedSourceLabelUnitCenterCoverProjectionCoreLaw

/-- The raw-cell target law inherits representation-side unit quantization. -/
theorem target_energy_unit
    (L :
      SU7A6SignedHeightConcreteUnitCenterCoverEndpointRawCellTargetLaw
        σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    let source := su7A6ConcreteEndpointSourceLabelOf A
    let hheight :=
      (su7A6ConcreteEndpointSourceReadout A).source_signedHeight_pos hpos
    L.targetEnergy source hheight + 1 = A.energy :=
  L.toEndpointTargetLaw.target_energy_unit A hpos

/-- The raw-cell target law inherits raw endpoint-residual unit readout. -/
theorem target_raw_energy_unit
    (L :
      SU7A6SignedHeightConcreteUnitCenterCoverEndpointRawCellTargetLaw
        σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    let source := su7A6ConcreteEndpointSourceLabelOf A
    let hheight :=
      (su7A6ConcreteEndpointSourceReadout A).source_signedHeight_pos hpos
    rawCodePairResidualEnergy n
      (L.targetCell source hheight).cell.leftWeightCode
      (L.targetCell source hheight).cell.rightWeightCode + 1 =
        A.energy :=
  L.toEndpointTargetLaw.target_raw_energy_unit A hpos

/-- The raw-cell target law materializes the generated lower no-prime cell. -/
theorem materializes_generated_lower_cell
    (L :
      SU7A6SignedHeightConcreteUnitCenterCoverEndpointRawCellTargetLaw
        σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    let source := su7A6ConcreteEndpointSourceLabelOf A
    let hheight :=
      (su7A6ConcreteEndpointSourceReadout A).source_signedHeight_pos hpos
    ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
      lower ∈
        generatedNoPrimeBranchingCells n
          (computedEndpointRoomBound bound
            (L.targetCell source hheight).cell.leftWeightCode
            (L.targetCell source hheight).cell.rightWeightCode) ∧
        noPrimeBranchingEndpointResidualEnergy lower + 1 = A.energy :=
  L.toEndpointTargetLaw.materializes_generated_lower_cell A hpos

/-- Raw-cell completion targets give filtered weight-graph downward
connectivity in a computed endpoint room, before the repair-cell adapter.

This is the desired source-side payoff of a grammar-generated raw target cell:
completed endpoint room, generated lower no-prime cell, and exact `E - 1`
energy readout. -/
theorem filtered_weight_graph_downward_connectivity
    (L :
      SU7A6SignedHeightConcreteUnitCenterCoverEndpointRawCellTargetLaw
        σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    ∃ completedBound,
      ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
        bound ≤ completedBound ∧
          lower ∈ generatedNoPrimeBranchingCells n completedBound ∧
            noPrimeBranchingEndpointResidualEnergy lower + 1 = A.energy :=
  L.toGeneratedSourceLabelUnitCenterCoverProjectionCoreLaw
    |>.filtered_weight_graph_downward_connectivity A hpos

/-- A raw-cell target law is already strong enough to reach the generated
repair-cell source target.

This is still an upstream representation/filter theorem socket: its only
mathematical premise is the grammar-generated raw-cell target law.  It does
not use `F + Q`, coverage, a normalizer, an endpoint shell, or a pre-existing
repair cell. -/
theorem generated_repair_law
    (L :
      SU7A6SignedHeightConcreteUnitCenterCoverEndpointRawCellTargetLaw
        σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    ∃ completedBound,
      ∃ _repair :
        SU7GeneratedRepairCell A
          (SU7RepairObligation.of_positive A hpos),
        bound ≤ completedBound := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  let completedBound :=
    computedEndpointRoomBound bound
      (L.targetCell R0.source_label hheight).cell.leftWeightCode
      (L.targetCell R0.source_label hheight).cell.rightWeightCode
  have Hmat :
      ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
        lower ∈ generatedNoPrimeBranchingCells n completedBound ∧
          noPrimeBranchingEndpointResidualEnergy lower + 1 = A.energy := by
    simpa [R0, hheight, completedBound, su7A6ConcreteEndpointSourceReadout]
      using L.materializes_generated_lower_cell A hpos
  rcases Hmat with ⟨lower, hmem, hunit⟩
  have hbound : bound ≤ completedBound := by
    simpa [completedBound] using
      bound_le_computedEndpointRoomBound bound
        (L.targetCell R0.source_label hheight).cell.leftWeightCode
        (L.targetCell R0.source_label hheight).cell.rightWeightCode
  exact
    ⟨completedBound,
      generatedRepairCell_of_noPrimeUnitStepAtRepairBound
        A hpos hbound hmem hunit,
      hbound⟩

end SU7A6SignedHeightConcreteUnitCenterCoverEndpointRawCellTargetLaw

/-- Produced-active version of the raw-cell completion target law.

This is weaker than `SU7A6SignedHeightConcreteUnitCenterCoverEndpointRawCellTargetLaw`:
the SU(7) completion target is required only for actual produced active
source-path cells, not for every positive A6 label.  This is the better
source-generation mouth for the current producer chain. -/
structure SU7A6ProducedActiveRawCellCompletionTargetLaw
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat) where
  targetCell :
    (A : SU7ProducedActiveCell σ hσ n bound) ->
      A.energy ≠ 0 -> SU7BooleanAtomicRawBranchingCell n
  targetEnergy :
    (A : SU7ProducedActiveCell σ hσ n bound) ->
      A.energy ≠ 0 -> Nat
  unit_center_cover_move :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
      let R0 := su7A6ConcreteEndpointSourceReadout A
      SU7A6UnitCenterCoverDisplacement R0.source_label
        (su7A6EndpointSourceLabel
          ((targetCell A hpos).cell.leftWeightCode)
          ((targetCell A hpos).cell.rightWeightCode)
          (targetEnergy A hpos))
  target_cell_energy_reads :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
      rawAtomCodeBranchingDecompositionResidualEnergy
        (targetCell A hpos).cell =
          targetEnergy A hpos

namespace SU7A6ProducedActiveRawCellCompletionTargetLaw

variable {K : Type*} [Field K]
variable {σ : K} {hσ : σ ≠ 1} {n bound : Nat}

/-- The source/phase endpoint label generated by a produced-active raw-cell
completion target. -/
def targetLabel
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) : SU7A6WeightLabel :=
  su7A6EndpointSourceLabel
    ((L.targetCell A hpos).cell.leftWeightCode)
    ((L.targetCell A hpos).cell.rightWeightCode)
    (L.targetEnergy A hpos)

/-- Produced-active raw-cell completion targets provide the pointwise
source/projection core for their own source path. -/
def sourceProjectionCore
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    SU7A6SourceLabelUnitCenterCoverProjectionCore n
      (su7A6ConcreteEndpointSourceReadout A).source_label
      (L.targetLabel A hpos) := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let left := (L.targetCell A hpos).cell.leftWeightCode
  let right := (L.targetCell A hpos).cell.rightWeightCode
  let energy := L.targetEnergy A hpos
  have hraw :
      rawCodePairResidualEnergy n left right = energy := by
    have hbranch :
        rawAtomCodeBranchingDecompositionResidualEnergy
            (L.targetCell A hpos).cell =
          rawCodePairResidualEnergy n left right := by
      simpa [left, right] using
        rawBranchingResidualEnergy_eq_codePair
          (L.targetCell A hpos).cell
    exact hbranch.symm.trans
      (by
        simpa [energy] using L.target_cell_energy_reads A hpos)
  refine
    { unit_center_cover_move := ?_
      endpoint_projection_core := ?_ }
  ·
    simpa [targetLabel, R0, left, right, energy] using
      L.unit_center_cover_move A hpos
  ·
    refine
      { target_endpoint_shape := ?_
        left_check := ?_
        right_check := ?_ }
    ·
      simp [targetLabel, su7A6ConcreteEndpointSourceGrammar,
        su7A6EndpointSourceLabel_leftCode,
        su7A6EndpointSourceLabel_rightCode, left, right, energy, hraw]
    ·
      simpa [targetLabel, su7A6ConcreteEndpointSourceGrammar,
        su7A6EndpointSourceLabel_leftCode, left, right, energy] using
        (L.targetCell A hpos).left_check
    ·
      simpa [targetLabel, su7A6ConcreteEndpointSourceGrammar,
        su7A6EndpointSourceLabel_rightCode, left, right, energy] using
        (L.targetCell A hpos).right_check

/-- A valid produced-active raw-cell completion target cannot be the concrete
fixed-root lowered neighbor on the P948 source.

The raw-cell completion target law always supplies an endpoint projection core
for its own target label.  If that label were the fixed simple-root neighbor
selected by the concrete endpoint/source grammar, it would contradict the
P948 produced-active no-core obstruction. -/
theorem targetLabel_ne_concreteFixedRootSelectedNeighbor_of_P948
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 6 3)
    (A : SU7ProducedActiveCell σ hσ 6 3)
    (hleft : A.sourceCell.cell.leftWeightCode = 3)
    (hright : A.sourceCell.cell.rightWeightCode = 3)
    (hpos : A.energy ≠ 0) :
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    let N :=
      su7A6UnfilteredUnitDescentNeighborAt R0.source_label
        (su7A6ConcreteEndpointSourceGrammar.repairRootOf
          R0.source_label hheight)
    L.targetLabel A hpos ≠ N.target := by
  dsimp only
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  let N :=
    su7A6UnfilteredUnitDescentNeighborAt R0.source_label
      (su7A6ConcreteEndpointSourceGrammar.repairRootOf
        R0.source_label hheight)
  intro htarget
  have hnoCore :
      ¬ SU7A6EndpointProjectionCore 6 N.target := by
    simpa [R0, hheight, N] using
      su7A6P948ProducedActiveCell_fixedRootSelectedNeighbor_no_endpointProjectionCore
        A hleft hright hpos
  have hcore :
      SU7A6EndpointProjectionCore 6 N.target := by
    have hcore0 :=
      (L.sourceProjectionCore A hpos).endpoint_projection_core
    rw [htarget] at hcore0
    exact hcore0
  exact hnoCore hcore

/-- A valid produced-active raw-cell completion target cannot be the concrete
fixed-root lowered neighbor on the `(5,7)` source.

This lifts the fixed-root selector no-go to the current produced-active
completion socket.  Any `SU7A6ProducedActiveRawCellCompletionTargetLaw`
already carries an endpoint projection core for its target label; the
fixed-root `(5,7)` neighbor reads right endpoint code `8`, whose Boolean
atomic/no-prime check is false. -/
theorem targetLabel_ne_concreteFixedRootSelectedNeighbor_of_fiveSeven
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 10 bound)
    (A : SU7ProducedActiveCell σ hσ 10 bound)
    (hleft : A.sourceCell.cell.leftWeightCode = 5)
    (hright : A.sourceCell.cell.rightWeightCode = 7)
    (hpos : A.energy ≠ 0) :
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    let N :=
      su7A6UnfilteredUnitDescentNeighborAt R0.source_label
        (su7A6ConcreteEndpointSourceGrammar.repairRootOf
          R0.source_label hheight)
    L.targetLabel A hpos ≠ N.target := by
  dsimp only
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  let N :=
    su7A6UnfilteredUnitDescentNeighborAt R0.source_label
      (su7A6ConcreteEndpointSourceGrammar.repairRootOf
        R0.source_label hheight)
  intro htarget
  have hcore :
      SU7A6EndpointProjectionCore 10 N.target := by
    have hcore0 :=
      (L.sourceProjectionCore A hpos).endpoint_projection_core
    rw [htarget] at hcore0
    exact hcore0
  have hsource :
      R0.source_label = su7A6FiveSevenSourceLabel := by
    simpa [R0] using
      su7A6FiveSevenProducedActiveCell_sourceLabel_eq A hleft hright
  have hrightN :
      su7A6ConcreteEndpointSourceGrammar.rightCodeOf N.target = 8 := by
    norm_num [N, hsource, su7A6ConcreteEndpointSourceGrammar,
      su7A6FiveSevenSourceLabel, su7A6UnfilteredUnitDescentNeighborAt,
      su7A6LowerBySimpleRoot, su7A6EndpointSourceLeftCodeOf,
      su7A6EndpointSourceRightCodeOf, su7A6EndpointSourceLabel,
      su7A6EndpointSourceEnergyCorrection, su7A6CartanEntry,
      su7A6Adjacent]
  have hcheck8 : natMultiplicativelyAtomicCheck 8 = false :=
    by
      unfold natMultiplicativelyAtomicCheck natHasNontrivialDivisorCheck
      norm_num
      exact ⟨2, by norm_num⟩
  have hrightTrue :
      natMultiplicativelyAtomicCheck
        (su7A6ConcreteEndpointSourceGrammar.rightCodeOf N.target) = true :=
    hcore.right_check
  rw [hrightN] at hrightTrue
  rw [hcheck8] at hrightTrue
  cases hrightTrue

/-- A valid produced-active raw-cell completion target cannot be the
source-oriented raw unit endpoint target on the `(5,7)` source.

The sign-oriented source/phase move is a real unit descent, but the target
codes `(4,9)` fail the finite endpoint filter.  Any raw-cell completion target
law must therefore choose a different, completion-generated target label on
that source path. -/
theorem targetLabel_ne_sourceOrientedEndpointTarget_of_five_seven
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 10 bound)
    (A : SU7ProducedActiveCell σ hσ 10 bound)
    (hleft : A.sourceCell.cell.leftWeightCode = 5)
    (hright : A.sourceCell.cell.rightWeightCode = 7)
    (hpos : A.energy ≠ 0) :
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    L.targetLabel A hpos ≠
      su7A6SourceOrientedEndpointTargetLabel 10 R0.source_label hheight := by
  dsimp only
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  intro htarget
  have Hfail :=
    su7A6ProducedActiveCell_sourceOrientedEndpointTarget_no_endpointProjectionCore_of_five_seven
      A hleft hright hpos
  rcases Hfail with ⟨_, _, _, _, hnoCore⟩
  have hcore :
      SU7A6EndpointProjectionCore 10
        (su7A6SourceOrientedEndpointTargetLabel 10 R0.source_label hheight) := by
    have hcore0 :=
      (L.sourceProjectionCore A hpos).endpoint_projection_core
    rw [htarget] at hcore0
    exact hcore0
  exact hnoCore hcore

/-- Produced-active raw-cell completion targets spend exactly one residual
unit in the source/phase signed-height readout. -/
theorem target_energy_unit
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    L.targetEnergy A hpos + 1 = A.energy := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  have hunit :
      (L.targetEnergy A hpos : Int) + 1 = (A.energy : Int) := by
    have H :=
      (L.unit_center_cover_move A hpos).signedHeight_unit_decrement
    rw [su7A6EndpointSourceLabel_signedHeight] at H
    rw [R0.source_height_reads_energy] at H
    exact H
  exact_mod_cast hunit

/-- The raw target cell reads as an endpoint-code unit successor for the
produced active source. -/
theorem target_raw_energy_unit
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    rawCodePairResidualEnergy n
      (L.targetCell A hpos).cell.leftWeightCode
      (L.targetCell A hpos).cell.rightWeightCode + 1 =
        A.energy := by
  have hbranch :
      rawAtomCodeBranchingDecompositionResidualEnergy
          (L.targetCell A hpos).cell =
        rawCodePairResidualEnergy n
          (L.targetCell A hpos).cell.leftWeightCode
          (L.targetCell A hpos).cell.rightWeightCode :=
    rawBranchingResidualEnergy_eq_codePair
      (L.targetCell A hpos).cell
  rw [← hbranch, L.target_cell_energy_reads A hpos]
  exact L.target_energy_unit A hpos

/-- A concrete nontrivial divisor makes the Boolean multiplicative-atomic
checker fail.

This is the executable finite-checker direction used below to classify the
remaining P948 adaptive target candidates.  It stays on the information/raw
endpoint side: no `Nat.Prime`, coverage, repair cell, or downstream normalizer
is involved. -/
theorem natMultiplicativelyAtomicCheck_eq_false_of_nontrivial_divisor
    {n d : Nat}
    (hd2 : 2 ≤ d) (hdlt : d < n) (hdiv : d ∣ n) :
    natMultiplicativelyAtomicCheck n = false := by
  unfold natMultiplicativelyAtomicCheck
  have hdivCheck : natHasNontrivialDivisorCheck n = true := by
    unfold natHasNontrivialDivisorCheck
    rw [List.any_eq_true]
    exact
      ⟨d,
        List.mem_range.mpr
          (Nat.lt_trans hdlt (Nat.lt_succ_self n)),
        decide_eq_true_eq.mpr ⟨hd2, hdlt, hdiv⟩⟩
  by_cases hn2 : 2 ≤ n
  · simp [decide_eq_true_eq.mpr hn2, hdivCheck]
  · simp [decide_eq_false_iff_not.mpr hn2]

/-- In the P948 even fiber, raw endpoint energy `5` means the endpoint code sum
is either `7` or `17`.

This isolates the absolute-value arithmetic before the finite atomic checker
removes the spurious `17` branch. -/
theorem rawCodePairResidualEnergy_six_five_sum_eq_seven_or_seventeen
    {left right : Nat}
    (henergy : rawCodePairResidualEnergy 6 left right = 5) :
    left + right = 7 ∨ left + right = 17 := by
  unfold rawCodePairResidualEnergy rawCodePairResidual at henergy
  have h := Int.natAbs_eq_iff.mp henergy
  omega

/-- Boolean-atomic raw endpoint pairs of P948 residual energy `5` are exactly
the two oriented `(2,5)` repairs.

This is a finite target-classification theorem for the adaptive completion
socket.  It does not assert that SU(7) has generated either orientation; it
only says any valid raw-cell target law has already narrowed itself to these
two source/phase endpoint candidates. -/
theorem rawCodePairResidualEnergy_six_atomic_five_codes
    {left right : Nat}
    (hleft : natMultiplicativelyAtomicCheck left = true)
    (hright : natMultiplicativelyAtomicCheck right = true)
    (henergy : rawCodePairResidualEnergy 6 left right = 5) :
    (left = 2 ∧ right = 5) ∨ (left = 5 ∧ right = 2) := by
  have hleft2 : 2 ≤ left :=
    (natMultiplicativelyAtomic_of_check_eq_true hleft).1
  have hright2 : 2 ≤ right :=
    (natMultiplicativelyAtomic_of_check_eq_true hright).1
  have hsum :=
    rawCodePairResidualEnergy_six_five_sum_eq_seven_or_seventeen
      henergy
  have h4 : natMultiplicativelyAtomicCheck 4 = false := by
    exact
      natMultiplicativelyAtomicCheck_eq_false_of_nontrivial_divisor
        (n := 4) (d := 2) (by norm_num) (by norm_num)
        (by norm_num)
  have h6 : natMultiplicativelyAtomicCheck 6 = false := by
    exact
      natMultiplicativelyAtomicCheck_eq_false_of_nontrivial_divisor
        (n := 6) (d := 2) (by norm_num) (by norm_num)
        (by norm_num)
  have h8 : natMultiplicativelyAtomicCheck 8 = false := by
    exact
      natMultiplicativelyAtomicCheck_eq_false_of_nontrivial_divisor
        (n := 8) (d := 2) (by norm_num) (by norm_num)
        (by norm_num)
  have h9 : natMultiplicativelyAtomicCheck 9 = false := by
    exact
      natMultiplicativelyAtomicCheck_eq_false_of_nontrivial_divisor
        (n := 9) (d := 3) (by norm_num) (by norm_num)
        (by norm_num)
  have h10 : natMultiplicativelyAtomicCheck 10 = false := by
    exact
      natMultiplicativelyAtomicCheck_eq_false_of_nontrivial_divisor
        (n := 10) (d := 2) (by norm_num) (by norm_num)
        (by norm_num)
  have h12 : natMultiplicativelyAtomicCheck 12 = false := by
    exact
      natMultiplicativelyAtomicCheck_eq_false_of_nontrivial_divisor
        (n := 12) (d := 2) (by norm_num) (by norm_num)
        (by norm_num)
  have h14 : natMultiplicativelyAtomicCheck 14 = false := by
    exact
      natMultiplicativelyAtomicCheck_eq_false_of_nontrivial_divisor
        (n := 14) (d := 2) (by norm_num) (by norm_num)
        (by norm_num)
  have h15 : natMultiplicativelyAtomicCheck 15 = false := by
    exact
      natMultiplicativelyAtomicCheck_eq_false_of_nontrivial_divisor
        (n := 15) (d := 3) (by norm_num) (by norm_num)
        (by norm_num)
  rcases hsum with hsum | hsum
  · have hleft_le : left ≤ 5 := by omega
    have hright_le : right ≤ 5 := by omega
    interval_cases left
    · have : right = 5 := by omega
      subst right
      exact Or.inl ⟨rfl, rfl⟩
    · have : right = 4 := by omega
      subst right
      simp [h4] at hright
    · simp [h4] at hleft
    · have : right = 2 := by omega
      subst right
      exact Or.inr ⟨rfl, rfl⟩
  · have hleft_le : left ≤ 15 := by omega
    interval_cases left
    · have : right = 15 := by omega
      subst right
      simp [h15] at hright
    · have : right = 14 := by omega
      subst right
      simp [h14] at hright
    · simp [h4] at hleft
    · have : right = 12 := by omega
      subst right
      simp [h12] at hright
    · simp [h6] at hleft
    · have : right = 10 := by omega
      subst right
      simp [h10] at hright
    · simp [h8] at hleft
    · simp [h9] at hleft
    · simp [h10] at hleft
    · have : right = 6 := by omega
      subst right
      simp [h6] at hright
    · simp [h12] at hleft
    · have : right = 4 := by omega
      subst right
      simp [h4] at hright
    · simp [h14] at hleft
    · simp [h15] at hleft

/-- P948 necessary finite-search specification for any valid raw-cell
completion target.

On a produced-active `(3,3)` P948 source, a legal adaptive target is not
arbitrary: its endpoint codes are Boolean-atomic and its raw endpoint residual
is exactly `5`, one below the source residual `6`.  This is the finite target
search problem the SU(7) grammar still has to solve constructively. -/
theorem p948_targetCell_atomic_rawEnergy_five
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 6 3)
    (A : SU7ProducedActiveCell σ hσ 6 3)
    (hleft : A.sourceCell.cell.leftWeightCode = 3)
    (hright : A.sourceCell.cell.rightWeightCode = 3)
    (hpos : A.energy ≠ 0) :
    natMultiplicativelyAtomicCheck
        (L.targetCell A hpos).cell.leftWeightCode = true ∧
      natMultiplicativelyAtomicCheck
        (L.targetCell A hpos).cell.rightWeightCode = true ∧
        rawCodePairResidualEnergy 6
          (L.targetCell A hpos).cell.leftWeightCode
          (L.targetCell A hpos).cell.rightWeightCode = 5 := by
  refine
    ⟨(L.targetCell A hpos).left_check,
      (L.targetCell A hpos).right_check, ?_⟩
  have hunit := L.target_raw_energy_unit A hpos
  have henergy : A.energy = rawCodePairResidualEnergy 6 3 3 := by
    rw [SU7ProducedActiveCell.energy_eq_raw_source_pair A, hleft, hright]
  rw [henergy, rawCodePairResidualEnergy_six_three_three] at hunit
  omega

/-- P948 adaptive raw-cell target codes have only two possible orientations:
`(2,5)` or `(5,2)`.

The previous theorem says the target is Boolean-atomic and has raw endpoint
energy `5`; this theorem runs the finite checker classification.  The
remaining SU(7) grammar problem is now directional/sectorial: explain why the
source path selects the correct oriented completion target, rather than merely
some scalar energy-`5` endpoint pair. -/
theorem p948_targetCell_codes_two_five_or_five_two
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 6 3)
    (A : SU7ProducedActiveCell σ hσ 6 3)
    (hleft : A.sourceCell.cell.leftWeightCode = 3)
    (hright : A.sourceCell.cell.rightWeightCode = 3)
    (hpos : A.energy ≠ 0) :
    ((L.targetCell A hpos).cell.leftWeightCode = 2 ∧
        (L.targetCell A hpos).cell.rightWeightCode = 5) ∨
      ((L.targetCell A hpos).cell.leftWeightCode = 5 ∧
        (L.targetCell A hpos).cell.rightWeightCode = 2) := by
  rcases
      L.p948_targetCell_atomic_rawEnergy_five A hleft hright hpos with
    ⟨hleft_atomic, hright_atomic, henergy⟩
  exact
    rawCodePairResidualEnergy_six_atomic_five_codes
      hleft_atomic hright_atomic henergy

/-- The target-energy field of a P948 adaptive raw-cell completion target is
also forced to be `5`.

This keeps the target-label classification below honest: the endpoint codes
and the source/phase signed-height coordinate are both determined by the
same unit-spend law. -/
theorem p948_targetEnergy_five
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 6 3)
    (A : SU7ProducedActiveCell σ hσ 6 3)
    (hleft : A.sourceCell.cell.leftWeightCode = 3)
    (hright : A.sourceCell.cell.rightWeightCode = 3)
    (hpos : A.energy ≠ 0) :
    L.targetEnergy A hpos = 5 := by
  have hunit := L.target_energy_unit A hpos
  have henergy : A.energy = rawCodePairResidualEnergy 6 3 3 := by
    rw [SU7ProducedActiveCell.energy_eq_raw_source_pair A, hleft, hright]
  rw [henergy, rawCodePairResidualEnergy_six_three_three] at hunit
  omega

/-- P948 adaptive raw-cell completion targets classify to the center-cover
completion label or its endpoint-code mirror.

This is the sharp local diagnostic for the remaining SU(7) producer: any
lawful target must be one of these two endpoint/source labels.  The known
center-cover sample chooses `su7A6P948CompletedRepairLabel = (2,5,5)`;
choosing between it and the mirror still belongs to the representation
grammar/sector/H1 generation theorem, not to P950 or coverage. -/
theorem p948_targetLabel_eq_completedRepairLabel_or_mirror
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 6 3)
    (A : SU7ProducedActiveCell σ hσ 6 3)
    (hleft : A.sourceCell.cell.leftWeightCode = 3)
    (hright : A.sourceCell.cell.rightWeightCode = 3)
    (hpos : A.energy ≠ 0) :
    L.targetLabel A hpos = su7A6P948CompletedRepairLabel ∨
      L.targetLabel A hpos = su7A6EndpointSourceLabel 5 2 5 := by
  have henergy := L.p948_targetEnergy_five A hleft hright hpos
  rcases
      L.p948_targetCell_codes_two_five_or_five_two
        A hleft hright hpos with
    hcodes | hcodes
  · rcases hcodes with ⟨hleft_code, hright_code⟩
    left
    simp [targetLabel, su7A6P948CompletedRepairLabel,
      hleft_code, hright_code, henergy]
  · rcases hcodes with ⟨hleft_code, hright_code⟩
    right
    simp [targetLabel, hleft_code, hright_code, henergy]

/-- The known P948 center-cover completion has canonical center-shift `-19`
from the produced `(3,3,E=6)` source label.

The shift here is not the arbitrary `center_shift` field of a displacement
witness; it is the canonical root-index readout
`su7A6CenterCoverShiftOfDisplacement source target`. -/
theorem p948_completedRepairLabel_canonicalCenterShift
    (_L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 6 3)
    (A : SU7ProducedActiveCell σ hσ 6 3)
    (hleft : A.sourceCell.cell.leftWeightCode = 3)
    (hright : A.sourceCell.cell.rightWeightCode = 3)
    (_hpos : A.energy ≠ 0) :
    su7A6CenterCoverShiftOfDisplacement
      (su7A6ConcreteEndpointSourceReadout A).source_label
      su7A6P948CompletedRepairLabel = -19 := by
  have henergy : A.energy = rawCodePairResidualEnergy 6 3 3 := by
    rw [SU7ProducedActiveCell.energy_eq_raw_source_pair A, hleft, hright]
  rw [rawCodePairResidualEnergy_six_three_three] at henergy
  change
    su7A6CenterCoverShiftOfDisplacement
      (su7A6ConcreteEndpointSourceLabelOf A)
      su7A6P948CompletedRepairLabel = -19
  unfold su7A6CenterCoverShiftOfDisplacement
  have hsource_index :
      su7A6RootLatticeIndex (su7A6ConcreteEndpointSourceLabelOf A) =
        7 * (3 : Int) + 12 * (3 : Int) - 2 * (6 : Int) := by
    unfold su7A6ConcreteEndpointSourceLabelOf
    rw [hleft, hright, henergy]
    simpa using su7A6EndpointSourceLabel_rootIndex 3 3 6
  have htarget_index :
      su7A6RootLatticeIndex su7A6P948CompletedRepairLabel =
        7 * (2 : Int) + 12 * (5 : Int) - 2 * (5 : Int) := by
    simpa [su7A6P948CompletedRepairLabel] using
      su7A6EndpointSourceLabel_rootIndex 2 5 5
  rw [hsource_index, htarget_index]
  norm_num

/-- The P948 mirror candidate has canonical center-shift `-4`, not `-19`.

This shows that the finite target classification still leaves a genuine
representation/sector orientation question: center-cover availability alone
does not choose the known completion; the canonical disposition must be
generated by the SU(7) source path. -/
theorem p948_mirrorRepairLabel_canonicalCenterShift
    (_L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 6 3)
    (A : SU7ProducedActiveCell σ hσ 6 3)
    (hleft : A.sourceCell.cell.leftWeightCode = 3)
    (hright : A.sourceCell.cell.rightWeightCode = 3)
    (_hpos : A.energy ≠ 0) :
    su7A6CenterCoverShiftOfDisplacement
      (su7A6ConcreteEndpointSourceReadout A).source_label
      (su7A6EndpointSourceLabel 5 2 5) = -4 := by
  have henergy : A.energy = rawCodePairResidualEnergy 6 3 3 := by
    rw [SU7ProducedActiveCell.energy_eq_raw_source_pair A, hleft, hright]
  rw [rawCodePairResidualEnergy_six_three_three] at henergy
  change
    su7A6CenterCoverShiftOfDisplacement
      (su7A6ConcreteEndpointSourceLabelOf A)
      (su7A6EndpointSourceLabel 5 2 5) = -4
  unfold su7A6CenterCoverShiftOfDisplacement
  have hsource_index :
      su7A6RootLatticeIndex (su7A6ConcreteEndpointSourceLabelOf A) =
        7 * (3 : Int) + 12 * (3 : Int) - 2 * (6 : Int) := by
    unfold su7A6ConcreteEndpointSourceLabelOf
    rw [hleft, hright, henergy]
    simpa using su7A6EndpointSourceLabel_rootIndex 3 3 6
  have htarget_index :
      su7A6RootLatticeIndex (su7A6EndpointSourceLabel 5 2 5) =
        7 * (5 : Int) + 12 * (2 : Int) - 2 * (5 : Int) := by
    simpa using su7A6EndpointSourceLabel_rootIndex 5 2 5
  rw [hsource_index, htarget_index]
  norm_num

/-- A P948 adaptive target with canonical center-shift `-19` must be the known
center-cover completion label, not the mirror.

This is the narrow next-door interface for the real producer theorem.  The
remaining upstream SU(7) grammar obligation is to generate this canonical
center-shift disposition from the source path/sector/H1 data; once it does,
the finite target classification above selects `(2,5,5)` without invoking
coverage, P950, or a repair-cell premise. -/
theorem p948_targetLabel_eq_completedRepairLabel_of_canonicalCenterShift_neg19
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 6 3)
    (A : SU7ProducedActiveCell σ hσ 6 3)
    (hleft : A.sourceCell.cell.leftWeightCode = 3)
    (hright : A.sourceCell.cell.rightWeightCode = 3)
    (hpos : A.energy ≠ 0)
    (hshift :
      su7A6CenterCoverShiftOfDisplacement
        (su7A6ConcreteEndpointSourceReadout A).source_label
        (L.targetLabel A hpos) = -19) :
    L.targetLabel A hpos = su7A6P948CompletedRepairLabel := by
  rcases
      L.p948_targetLabel_eq_completedRepairLabel_or_mirror
        A hleft hright hpos with
    hcompleted | hmirror
  · exact hcompleted
  · have hmirror_shift :=
      L.p948_mirrorRepairLabel_canonicalCenterShift
        A hleft hright hpos
    rw [hmirror] at hshift
    rw [hmirror_shift] at hshift
    norm_num at hshift

/-- Canonical `-19` center disposition forces the P948 adaptive target codes
to be exactly `(2,5)`.

This removes the last scalar mirror ambiguity from the raw-cell target once the
SU(7) source grammar has generated the center-shift direction. -/
theorem p948_targetCell_codes_two_five_of_canonicalCenterShift_neg19
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 6 3)
    (A : SU7ProducedActiveCell σ hσ 6 3)
    (hleft : A.sourceCell.cell.leftWeightCode = 3)
    (hright : A.sourceCell.cell.rightWeightCode = 3)
    (hpos : A.energy ≠ 0)
