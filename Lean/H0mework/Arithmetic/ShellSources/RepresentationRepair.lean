    (X : SU7A6UnitCenterCoverComputedEndpointCodeCompletionCore
      Readout A R N) :
    SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n :=
  noPrimeBranchingCellOfBooleanAtomicRawCell
    (booleanAtomicCellOfRawCodePair n
      (Readout.leftCodeOf N.target)
      (Readout.rightCodeOf N.target)
      X.left_check X.right_check)

