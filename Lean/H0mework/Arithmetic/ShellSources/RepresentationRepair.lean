/-- Raw endpoint energy for the left-anchor completion is a unit descent on
the under-target side.

The generated endpoint target `(left,right) -> (2,left+right-1)` increases the
endpoint sum by one, so it lowers absolute raw residual by exactly one whenever
the source pair is still below the target hyperplane.  This is the scalar
energy law behind the left-anchor source/phase completion; it does not assert
the new right endpoint is no-prime/atomic. -/
theorem rawCodePairResidualEnergy_endpointLeftAnchor_unit_of_sourceBelow
    {n left right : Nat}
    (hsum : 1 ≤ left + right)
    (hbelow : left + right < 2 * n) :
    rawCodePairResidualEnergy n 2 (left + right - 1) + 1 =
      rawCodePairResidualEnergy n left right := by
  have hsource_nonpos : rawCodePairResidual n left right ≤ 0 := by
    unfold rawCodePairResidual
    omega
  have htarget_nonpos :
      rawCodePairResidual n 2 (left + right - 1) ≤ 0 := by
    unfold rawCodePairResidual
    omega
  have hstep :
      rawCodePairResidual n 2 (left + right - 1) =
        rawCodePairResidual n left right + 1 := by
    unfold rawCodePairResidual
    omega
  have hInt :
      ((rawCodePairResidualEnergy n 2 (left + right - 1) + 1 :
          Nat) : Int) =
        (rawCodePairResidualEnergy n left right : Int) := by
    unfold rawCodePairResidualEnergy
    rw [Nat.cast_add, Nat.cast_one]
    rw [Int.ofNat_natAbs_of_nonpos htarget_nonpos,
      Int.ofNat_natAbs_of_nonpos hsource_nonpos]
    omega
  exact_mod_cast hInt

/-- Left-anchor completion and the ordinary endpoint-shift move lie on the same
raw successor spectrum on the under-target side.

The two targets redistribute endpoint room differently:

```text
(left - 1, right + 2)      -- sign-oriented endpoint shift
(2, left + right - 1)      -- left-anchor completion room
```

Both increase the endpoint sum by one, so they materialize the same raw
`E - 1` residual.  This is the local conservation fact behind treating
left-anchor completion as a source/phase repair-room redistribution rather
than an arbitrary new shell. -/
theorem rawCodePairResidualEnergy_endpointLeftAnchor_sameSpectrum_as_endpointShift_of_sourceBelow
    {n left right : Nat}
    (hleft : 0 < left)
    (hbelow : left + right < 2 * n) :
    rawCodePairResidualEnergy n 2 (left + right - 1) =
      rawCodePairResidualEnergy n (left - 1) (right + 2) := by
  have hsum : 1 ≤ left + right := by omega
  have hanchor :
      rawCodePairResidualEnergy n 2 (left + right - 1) + 1 =
        rawCodePairResidualEnergy n left right :=
    rawCodePairResidualEnergy_endpointLeftAnchor_unit_of_sourceBelow
      hsum hbelow
  have hshift :
      rawCodePairResidualEnergy n (left - 1) (right + 2) + 1 =
        rawCodePairResidualEnergy n left right :=
    rawCodePairResidualEnergy_endpointShift_unit_of_sourceBelow hleft hbelow
  omega

/-- Source-label version of the same-spectrum completion fact: on the
under-target side, the left-anchor completion target and the ordinary
endpoint-shift completion target have the same raw endpoint residual.

This theorem is deliberately before any finite checker or repair-cell adapter:
it says completion room preserves the `E - 1` spectrum while changing the
endpoint-code distribution. -/
theorem su7A6EndpointLeftAnchorCompletionTarget_sameRawEnergy_as_endpointShiftCompletionTarget_of_sourceBelow
    {n : Nat} {source : SU7A6WeightLabel}
    (hpos : 0 < su7A6SignedHeight source)
    (hleft : 0 < su7A6EndpointSourceLeftCodeOf source)
    (hbelow :
      su7A6EndpointSourceLeftCodeOf source +
          su7A6EndpointSourceRightCodeOf source < 2 * n) :
    rawCodePairResidualEnergy n
        (su7A6EndpointSourceLeftCodeOf
          (su7A6EndpointLeftAnchorCompletionTarget source hpos))
        (su7A6EndpointSourceRightCodeOf
          (su7A6EndpointLeftAnchorCompletionTarget source hpos)) =
      rawCodePairResidualEnergy n
        (su7A6EndpointSourceLeftCodeOf
          (su7A6EndpointShiftCompletionTarget source hpos))
        (su7A6EndpointSourceRightCodeOf
          (su7A6EndpointShiftCompletionTarget source hpos)) := by
  simpa [su7A6EndpointLeftAnchorCompletionTarget_leftCode,
    su7A6EndpointLeftAnchorCompletionTarget_rightCode,
    su7A6EndpointShiftCompletionTarget_leftCode,
    su7A6EndpointShiftCompletionTarget_rightCode] using
    rawCodePairResidualEnergy_endpointLeftAnchor_sameSpectrum_as_endpointShift_of_sourceBelow
      (n := n)
      (left := su7A6EndpointSourceLeftCodeOf source)
      (right := su7A6EndpointSourceRightCodeOf source)
      hleft hbelow

/-- Left-anchor completion supplies a generated-source adjacency half.

The rule is source/phase generated: target endpoint codes are computed from
the source endpoint readout.  Finite atomic/no-prime projection remains a
separate filter gate. -/
def su7A6_endpointLeftAnchorCompletion_sourceLabelUnitCenterCoverAdjacencyLaw
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat} :
    SU7A6GeneratedSourceLabelUnitCenterCoverAdjacencyLaw
      σ hσ n bound where
  targetLabel := su7A6EndpointLeftAnchorCompletionTarget
  unit_center_cover_move := by
    intro A hpos
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    exact
      su7A6EndpointLeftAnchorCompletionTarget_unitCenterCoverDisplacement
        R0.source_label hheight

/-- Left-anchor completion becomes an endpoint projection core once the
remaining finite filter facts for the same target are supplied.

The left endpoint is the generated anchor `2`, so its Boolean atomic check is
automatic.  The hard finite gate is the generated right endpoint
`left + right - 1`, plus the raw `E - 1` readout for that same target. -/
theorem su7A6EndpointLeftAnchorCompletionTarget_endpointProjectionCore_of_right_check_and_raw
    {n : Nat} {source : SU7A6WeightLabel}
    (hpos : 0 < su7A6SignedHeight source)
    (hright :
      natMultiplicativelyAtomicCheck
        (su7A6EndpointSourceRightCodeOf
          (su7A6EndpointLeftAnchorCompletionTarget source hpos)) = true)
    (hraw :
      rawCodePairResidualEnergy n
          (su7A6EndpointSourceLeftCodeOf
            (su7A6EndpointLeftAnchorCompletionTarget source hpos))
          (su7A6EndpointSourceRightCodeOf
            (su7A6EndpointLeftAnchorCompletionTarget source hpos)) =
        Int.toNat (su7A6SignedHeight source - 1)) :
    SU7A6EndpointProjectionCore n
      (su7A6EndpointLeftAnchorCompletionTarget source hpos) := by
  refine
    { target_endpoint_shape := ?_
      left_check := ?_
      right_check := hright }
  ·
    change
      su7A6EndpointLeftAnchorCompletionTarget source hpos =
        su7A6EndpointSourceLabel
          (su7A6EndpointSourceLeftCodeOf
            (su7A6EndpointLeftAnchorCompletionTarget source hpos))
          (su7A6EndpointSourceRightCodeOf
            (su7A6EndpointLeftAnchorCompletionTarget source hpos))
          (rawCodePairResidualEnergy n
            (su7A6EndpointSourceLeftCodeOf
              (su7A6EndpointLeftAnchorCompletionTarget source hpos))
            (su7A6EndpointSourceRightCodeOf
              (su7A6EndpointLeftAnchorCompletionTarget source hpos)))
    rw [hraw]
    simp [su7A6EndpointLeftAnchorCompletionTarget,
      su7A6EndpointSourceLabel_leftCode,
      su7A6EndpointSourceLabel_rightCode]
  ·
    simpa [su7A6EndpointLeftAnchorCompletionTarget,
      su7A6ConcreteEndpointSourceGrammar,
      su7A6EndpointSourceLabel_leftCode] using
      natMultiplicativelyAtomicCheck_two

/-- Generated endpoint projection law for the left-anchor target, assuming
only finite filter/readout facts for produced active sources.

This is the exact split target for the left-anchor completion family.  The
source/phase adjacency is already generated by
`su7A6_endpointLeftAnchorCompletion_sourceLabelUnitCenterCoverAdjacencyLaw`;
the remaining finite projection facts are the generated right-anchor Boolean
check and the raw unit readout for the same target. -/
theorem su7A6_endpointLeftAnchorCompletion_endpointProjectionLaw_of_right_check_and_raw
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (Hright :
      ∀ (A : SU7ProducedActiveCell σ hσ n bound)
        (hpos : A.energy ≠ 0),
        let R0 := su7A6ConcreteEndpointSourceReadout A
        let hheight := R0.source_signedHeight_pos hpos
        natMultiplicativelyAtomicCheck
          (su7A6EndpointSourceRightCodeOf
            (su7A6EndpointLeftAnchorCompletionTarget
              R0.source_label hheight)) = true)
    (Hraw :
      ∀ (A : SU7ProducedActiveCell σ hσ n bound)
        (hpos : A.energy ≠ 0),
        let R0 := su7A6ConcreteEndpointSourceReadout A
        let hheight := R0.source_signedHeight_pos hpos
        rawCodePairResidualEnergy n
            (su7A6EndpointSourceLeftCodeOf
              (su7A6EndpointLeftAnchorCompletionTarget
                R0.source_label hheight))
            (su7A6EndpointSourceRightCodeOf
              (su7A6EndpointLeftAnchorCompletionTarget
                R0.source_label hheight)) =
          Int.toNat (su7A6SignedHeight R0.source_label - 1)) :
    SU7A6GeneratedSourceLabelEndpointProjectionLaw
      σ hσ n bound su7A6EndpointLeftAnchorCompletionTarget :=
  SU7A6GeneratedSourceLabelEndpointProjectionLaw.ofLocalCore
    (H := by
      intro A hpos
      let R0 := su7A6ConcreteEndpointSourceReadout A
      let hheight := R0.source_signedHeight_pos hpos
      exact
        su7A6EndpointLeftAnchorCompletionTarget_endpointProjectionCore_of_right_check_and_raw
          (n := n) (source := R0.source_label) hheight
          (by simpa [R0, hheight] using Hright A hpos)
          (by simpa [R0, hheight] using Hraw A hpos))

/-- The left-anchor projection law with the raw unit readout generated from the
under-target source position.

This removes one artificial premise from the split law above: for source
labels whose endpoint-code readout lies below `2n`, the left-anchor target has
raw residual exactly one below the produced source energy.  The only remaining
finite filter premise is the Boolean atomic/no-prime check of the generated
right endpoint `left + right - 1`. -/
theorem su7A6_endpointLeftAnchorCompletion_endpointProjectionLaw_of_sourceBelow_and_rightCheck
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (Hright :
      ∀ (A : SU7ProducedActiveCell σ hσ n bound)
        (hpos : A.energy ≠ 0),
        let R0 := su7A6ConcreteEndpointSourceReadout A
        let hheight := R0.source_signedHeight_pos hpos
        natMultiplicativelyAtomicCheck
          (su7A6EndpointSourceRightCodeOf
            (su7A6EndpointLeftAnchorCompletionTarget
              R0.source_label hheight)) = true)
    (Hbelow :
      ∀ (A : SU7ProducedActiveCell σ hσ n bound)
        (_hpos : A.energy ≠ 0),
        let R0 := su7A6ConcreteEndpointSourceReadout A
        su7A6EndpointSourceLeftCodeOf R0.source_label +
            su7A6EndpointSourceRightCodeOf R0.source_label <
          2 * n) :
    SU7A6GeneratedSourceLabelEndpointProjectionLaw
      σ hσ n bound su7A6EndpointLeftAnchorCompletionTarget := by
  refine
    su7A6_endpointLeftAnchorCompletion_endpointProjectionLaw_of_right_check_and_raw
      (σ := σ) (hσ := hσ) (n := n) (bound := bound)
      Hright ?_
  intro A hpos
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  let left := su7A6EndpointSourceLeftCodeOf R0.source_label
  let right := su7A6EndpointSourceRightCodeOf R0.source_label
  have hbelow : left + right < 2 * n := by
    simpa [R0, left, right] using Hbelow A hpos
  have hsum : 1 ≤ left + right := by
    have hleft_reads :
        left = A.sourceCell.cell.leftWeightCode := by
      simpa [R0, left, su7A6ConcreteEndpointSourceGrammar] using
        R0.left_code_reads_source
    have hleft2 : 2 ≤ left := by
      rw [hleft_reads]
      exact
        (natMultiplicativelyAtomic_of_check_eq_true
          A.sourceCell.left_check).1
    omega
  have hunit :
      rawCodePairResidualEnergy n 2 (left + right - 1) + 1 =
        rawCodePairResidualEnergy n left right :=
    rawCodePairResidualEnergy_endpointLeftAnchor_unit_of_sourceBelow
      (n := n) (left := left) (right := right) hsum hbelow
  have hsource_raw :
      rawCodePairResidualEnergy n left right = A.energy := by
    simpa [R0, left, right, su7A6ConcreteEndpointSourceGrammar] using
      R0.raw_pair_energy_eq
  have htarget_raw :
      rawCodePairResidualEnergy n 2 (left + right - 1) =
        A.energy - 1 := by
    rw [hsource_raw] at hunit
    omega
  have hheight_toNat :
      Int.toNat (su7A6SignedHeight R0.source_label - 1) =
        A.energy - 1 := by
    rw [R0.source_height_reads_energy]
    omega
  have hraw :
      rawCodePairResidualEnergy n
          (su7A6EndpointSourceLeftCodeOf
            (su7A6EndpointLeftAnchorCompletionTarget
              R0.source_label hheight))
          (su7A6EndpointSourceRightCodeOf
            (su7A6EndpointLeftAnchorCompletionTarget
              R0.source_label hheight)) =
        Int.toNat (su7A6SignedHeight R0.source_label - 1) := by
    rw [hheight_toNat]
    simpa [left, right,
      su7A6EndpointLeftAnchorCompletionTarget,
      su7A6EndpointSourceLabel_leftCode,
      su7A6EndpointSourceLabel_rightCode] using htarget_raw
  simpa [R0, hheight] using hraw

/-- Pointwise left-anchor endpoint projection from source-side under-target
orientation and the generated right-anchor Boolean check.

This is the local version of
`su7A6_endpointLeftAnchorCompletion_endpointProjectionLaw_of_sourceBelow_and_rightCheck`:
for one produced source path, raw `E - 1` is generated from endpoint-sum
motion.  The only finite checker input is the right endpoint
`left + right - 1`. -/
theorem su7A6EndpointLeftAnchorCompletionTarget_endpointProjectionCore_of_sourceBelow_and_rightCheck
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0)
    (Hright :
      let R0 := su7A6ConcreteEndpointSourceReadout A
      let hheight := R0.source_signedHeight_pos hpos
      natMultiplicativelyAtomicCheck
        (su7A6EndpointSourceRightCodeOf
          (su7A6EndpointLeftAnchorCompletionTarget
            R0.source_label hheight)) = true)
    (Hbelow :
      let R0 := su7A6ConcreteEndpointSourceReadout A
      su7A6EndpointSourceLeftCodeOf R0.source_label +
          su7A6EndpointSourceRightCodeOf R0.source_label <
        2 * n) :
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    SU7A6EndpointProjectionCore n
      (su7A6EndpointLeftAnchorCompletionTarget
        R0.source_label hheight) := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  let left := su7A6EndpointSourceLeftCodeOf R0.source_label
  let right := su7A6EndpointSourceRightCodeOf R0.source_label
  have hbelow : left + right < 2 * n := by
    simpa [R0, left, right] using Hbelow
  have hsum : 1 ≤ left + right := by
    have hleft_reads :
        left = A.sourceCell.cell.leftWeightCode := by
      simpa [R0, left, su7A6ConcreteEndpointSourceGrammar] using
        R0.left_code_reads_source
    have hleft2 : 2 ≤ left := by
      rw [hleft_reads]
      exact
        (natMultiplicativelyAtomic_of_check_eq_true
          A.sourceCell.left_check).1
    omega
  have hunit :
      rawCodePairResidualEnergy n 2 (left + right - 1) + 1 =
        rawCodePairResidualEnergy n left right :=
    rawCodePairResidualEnergy_endpointLeftAnchor_unit_of_sourceBelow
      (n := n) (left := left) (right := right) hsum hbelow
  have hsource_raw :
      rawCodePairResidualEnergy n left right = A.energy := by
    simpa [R0, left, right, su7A6ConcreteEndpointSourceGrammar] using
      R0.raw_pair_energy_eq
  have htarget_raw :
      rawCodePairResidualEnergy n 2 (left + right - 1) =
        A.energy - 1 := by
    rw [hsource_raw] at hunit
    omega
  have hheight_toNat :
      Int.toNat (su7A6SignedHeight R0.source_label - 1) =
        A.energy - 1 := by
    rw [R0.source_height_reads_energy]
    omega
  have hraw :
      rawCodePairResidualEnergy n
          (su7A6EndpointSourceLeftCodeOf
            (su7A6EndpointLeftAnchorCompletionTarget
              R0.source_label hheight))
          (su7A6EndpointSourceRightCodeOf
            (su7A6EndpointLeftAnchorCompletionTarget
              R0.source_label hheight)) =
        Int.toNat (su7A6SignedHeight R0.source_label - 1) := by
    rw [hheight_toNat]
    simpa [left, right,
      su7A6EndpointLeftAnchorCompletionTarget,
      su7A6EndpointSourceLabel_leftCode,
      su7A6EndpointSourceLabel_rightCode] using htarget_raw
  exact
    su7A6EndpointLeftAnchorCompletionTarget_endpointProjectionCore_of_right_check_and_raw
      (n := n) (source := R0.source_label) hheight
      (by simpa [R0, hheight] using Hright)
      hraw

/-- Pointwise source/projection core for the left-anchor target from the
source-side under-target branch and the generated right-anchor Boolean check.

This packages the generated left-anchor source/phase adjacency with the local
projection core above, still before any repair-cell adapter. -/
def su7A6EndpointLeftAnchorCompletionTarget_sourceProjectionCore_of_sourceBelow_and_rightCheck
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0)
    (Hright :
      let R0 := su7A6ConcreteEndpointSourceReadout A
      let hheight := R0.source_signedHeight_pos hpos
      natMultiplicativelyAtomicCheck
        (su7A6EndpointSourceRightCodeOf
          (su7A6EndpointLeftAnchorCompletionTarget
            R0.source_label hheight)) = true)
    (Hbelow :
      let R0 := su7A6ConcreteEndpointSourceReadout A
      su7A6EndpointSourceLeftCodeOf R0.source_label +
          su7A6EndpointSourceRightCodeOf R0.source_label <
        2 * n) :
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    SU7A6SourceLabelUnitCenterCoverProjectionCore n
      R0.source_label
      (su7A6EndpointLeftAnchorCompletionTarget
        R0.source_label hheight) := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  exact
    { unit_center_cover_move :=
        su7A6EndpointLeftAnchorCompletionTarget_unitCenterCoverDisplacement
          R0.source_label hheight
      endpoint_projection_core :=
        su7A6EndpointLeftAnchorCompletionTarget_endpointProjectionCore_of_sourceBelow_and_rightCheck
          A hpos Hright Hbelow }

/-- Left-anchor completion reaches the generated source/projection-core mouth
from source-side under-target orientation plus the generated right-anchor
Boolean check.

This is the current native source/phase socket for the left-anchor family:
adjacency is generated by the SU(7) source-label completion rule, raw `E - 1`
is generated by under-target endpoint-sum motion, and the only remaining
finite filter fact is that the right anchor `left + right - 1` survives the
Boolean no-prime/atomic checker. -/
def su7A6_endpointLeftAnchorCompletion_sourceLabelUnitCenterCoverProjectionCoreLaw_of_sourceBelow_and_rightCheck
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (Hright :
      ∀ (A : SU7ProducedActiveCell σ hσ n bound)
        (hpos : A.energy ≠ 0),
        let R0 := su7A6ConcreteEndpointSourceReadout A
        let hheight := R0.source_signedHeight_pos hpos
        natMultiplicativelyAtomicCheck
          (su7A6EndpointSourceRightCodeOf
            (su7A6EndpointLeftAnchorCompletionTarget
              R0.source_label hheight)) = true)
    (Hbelow :
      ∀ (A : SU7ProducedActiveCell σ hσ n bound)
        (_hpos : A.energy ≠ 0),
        let R0 := su7A6ConcreteEndpointSourceReadout A
        su7A6EndpointSourceLeftCodeOf R0.source_label +
            su7A6EndpointSourceRightCodeOf R0.source_label <
          2 * n) :
    SU7A6GeneratedSourceLabelUnitCenterCoverProjectionCoreLaw
      σ hσ n bound :=
  SU7A6GeneratedSourceLabelUnitCenterCoverProjectionCoreLaw.of_adjacency_and_projection
    su7A6_endpointLeftAnchorCompletion_sourceLabelUnitCenterCoverAdjacencyLaw
    (su7A6_endpointLeftAnchorCompletion_endpointProjectionLaw_of_sourceBelow_and_rightCheck
      Hright Hbelow)

/-- The left-anchor completion target specializes to the existing P948
completed repair label. -/
theorem su7A6P948EndpointLeftAnchorCompletionTarget_eq_completedRepairLabel
    (hpos : 0 < su7A6SignedHeight su7A6P948BoundarySourceLabel) :
    su7A6EndpointLeftAnchorCompletionTarget
        su7A6P948BoundarySourceLabel hpos =
      su7A6P948CompletedRepairLabel := by
  funext i
  fin_cases i <;>
    norm_num [su7A6EndpointLeftAnchorCompletionTarget,
      su7A6P948BoundarySourceLabel, su7A6P948CompletedRepairLabel,
      su7A6EndpointSourceLabel, su7A6EndpointSourceEnergyCorrection,
      su7A6EndpointSourceLeftCodeOf, su7A6EndpointSourceRightCodeOf,
      su7A6SignedHeight]

/-- Orientation of a one-unit endpoint-code repair move for the scalar raw
residual.

This is not a filter theorem.  It only records which endpoint-code direction
can faithfully materialize an `E - 1` raw residual:

* below the target sum, the repair must increase endpoint sum by one;
* above the target sum, the repair must decrease endpoint sum by one. -/
inductive SU7A6EndpointUnitDescentOrientation
    (n left right : Nat) : Type where
  | sourceBelow :
      0 < left ->
      left + right < 2 * n ->
      SU7A6EndpointUnitDescentOrientation n left right
  | sourceAboveRight :
      2 ≤ right ->
      2 * n < left + right ->
      SU7A6EndpointUnitDescentOrientation n left right

namespace SU7A6EndpointUnitDescentOrientation

/-- Target left endpoint code selected by an oriented unit-descent move. -/
def targetLeft
    {n left right : Nat}
    (O : SU7A6EndpointUnitDescentOrientation n left right) : Nat :=
  match O with
  | sourceBelow _ _ => left - 1
  | sourceAboveRight _ _ => left + 1

/-- Target right endpoint code selected by an oriented unit-descent move. -/
def targetRight
    {n left right : Nat}
    (O : SU7A6EndpointUnitDescentOrientation n left right) : Nat :=
  match O with
  | sourceBelow _ _ => right + 2
  | sourceAboveRight _ _ => right - 2

/-- An oriented endpoint-code move is exactly a raw `E - 1` move. -/
theorem raw_unit
    {n left right : Nat}
    (O : SU7A6EndpointUnitDescentOrientation n left right) :
    rawCodePairResidualEnergy n (targetLeft O) (targetRight O) + 1 =
      rawCodePairResidualEnergy n left right := by
  cases O with
  | sourceBelow hleft hbelow =>
      exact
        rawCodePairResidualEnergy_endpointShift_unit_of_sourceBelow
          hleft hbelow
  | sourceAboveRight hright habove =>
      exact
        rawCodePairResidualEnergy_endpointBackshift_unit_of_sourceAbove
          hright habove

/-- The orientation branch selected by a positive residual is under target. -/
def isSourceBelow
    {n left right : Nat}
    (O : SU7A6EndpointUnitDescentOrientation n left right) : Prop :=
  match O with
  | sourceBelow _ _ => True
  | sourceAboveRight _ _ => False

/-- Under-target orientation carries the corresponding endpoint-sum bound.

This reads source-below from the generated orientation object instead of passing
the endpoint inequality as an unrelated premise. -/
theorem sourceBelow_bound_of_isSourceBelow
    {n left right : Nat}
    (O : SU7A6EndpointUnitDescentOrientation n left right)
    (hbelowO : isSourceBelow O) :
    left + right < 2 * n := by
  cases O with
  | sourceBelow _ hbelow =>
      exact hbelow
  | sourceAboveRight _ _ =>
      simp [isSourceBelow] at hbelowO

/-- The orientation branch selected by a positive residual is over target. -/
def isSourceAboveRight
    {n left right : Nat}
    (O : SU7A6EndpointUnitDescentOrientation n left right) : Prop :=
  match O with
  | sourceBelow _ _ => False
  | sourceAboveRight _ _ => True

/-- Over-target orientation carries the corresponding endpoint-sum bound. -/
theorem sourceAbove_bound_of_isSourceAboveRight
    {n left right : Nat}
    (O : SU7A6EndpointUnitDescentOrientation n left right)
    (haboveO : isSourceAboveRight O) :
    2 * n < left + right := by
  cases O with
  | sourceBelow _ _ =>
      simp [isSourceAboveRight] at haboveO
  | sourceAboveRight _ habove =>
      exact habove

/-- Over-target orientation also carries the right-endpoint room needed by the
backshift branch. -/
theorem sourceAbove_right_room_of_isSourceAboveRight
    {n left right : Nat}
    (O : SU7A6EndpointUnitDescentOrientation n left right)
    (haboveO : isSourceAboveRight O) :
    2 ≤ right := by
  cases O with
  | sourceBelow _ _ =>
      simp [isSourceAboveRight] at haboveO
  | sourceAboveRight hright _ =>
      exact hright

end SU7A6EndpointUnitDescentOrientation

/-- Boolean atomic endpoint checks force the endpoint code into the active
source-code range.

This is a source-side fact, not a target filter theorem: it only reads the
lower bound already built into `natMultiplicativelyAtomicCheck`. -/
theorem two_le_of_natMultiplicativelyAtomicCheck
    {code : Nat}
    (hcheck : natMultiplicativelyAtomicCheck code = true) :
    2 ≤ code :=
  (natMultiplicativelyAtomic_of_check_eq_true hcheck).1

/-- A positive generated source residual chooses the sign-correct endpoint
unit-descent orientation.

The orientation is produced from existing source data: the source cell's
Boolean atomic checks give endpoint-code room, and `A.energy ≠ 0` says the
source sum is not already on the zero-residual hyperplane.  No target atomic
check or repair cell is used here. -/
def su7A6_sourceEndpointUnitDescentOrientation_of_positive
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    SU7A6EndpointUnitDescentOrientation n
      A.sourceCell.cell.leftWeightCode
      A.sourceCell.cell.rightWeightCode := by
  let left := A.sourceCell.cell.leftWeightCode
  let right := A.sourceCell.cell.rightWeightCode
  have hleft2 : 2 ≤ left :=
    two_le_of_natMultiplicativelyAtomicCheck A.sourceCell.left_check
  have hright2 : 2 ≤ right :=
    two_le_of_natMultiplicativelyAtomicCheck A.sourceCell.right_check
  have hraw_ne :
      rawCodePairResidualEnergy n left right ≠ 0 := by
    intro hraw_zero
    exact hpos (by
      rw [SU7ProducedActiveCell.energy_eq_raw_source_pair A]
      simpa [left, right] using hraw_zero)
  have hsum_ne : left + right ≠ 2 * n := by
    intro hsum
    apply hraw_ne
    unfold rawCodePairResidualEnergy rawCodePairResidual
    simp [hsum]
  by_cases hbelow : left + right < 2 * n
  · exact
      SU7A6EndpointUnitDescentOrientation.sourceBelow
        (by omega) hbelow
  · have habove : 2 * n < left + right := by
      omega
    exact
      SU7A6EndpointUnitDescentOrientation.sourceAboveRight
        hright2 habove

/-- Source-label form of the sign-oriented endpoint target's left code. -/
def su7A6SourceOrientedEndpointTargetLeft
    (n : Nat) (source : SU7A6WeightLabel) : Nat :=
  let left := su7A6ConcreteEndpointSourceGrammar.leftCodeOf source
  let right := su7A6ConcreteEndpointSourceGrammar.rightCodeOf source
  if left + right < 2 * n then left - 1 else left + 1

/-- Source-label form of the sign-oriented endpoint target's right code. -/
def su7A6SourceOrientedEndpointTargetRight
    (n : Nat) (source : SU7A6WeightLabel) : Nat :=
  let left := su7A6ConcreteEndpointSourceGrammar.leftCodeOf source
  let right := su7A6ConcreteEndpointSourceGrammar.rightCodeOf source
  if left + right < 2 * n then right + 2 else right - 2

/-- Source-label target generated by the oriented endpoint unit descent.

This is a source/phase label, not a generated lower branch cell.  Its finite
endpoint projection core is still the remaining filter gate. -/
def su7A6SourceOrientedEndpointTargetLabel
    (n : Nat) (source : SU7A6WeightLabel)
    (_hheight : 0 < su7A6SignedHeight source) :
    SU7A6WeightLabel :=
  let left := su7A6SourceOrientedEndpointTargetLeft n source
  let right := su7A6SourceOrientedEndpointTargetRight n source
  su7A6EndpointSourceLabel left right
    (rawCodePairResidualEnergy n left right)

/-- Source-label oriented targets and positive-residual endpoint orientations
choose the same left endpoint code.

This is a source/readout coherence fact, not a filtered-connectivity theorem:
it only says that the source-label target function uses the same sign of the
raw residual as the orientation generated from the produced active cell. -/
theorem su7A6SourceOrientedEndpointTargetLeft_eq_orientationTargetLeft
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    su7A6SourceOrientedEndpointTargetLeft n
        (su7A6ConcreteEndpointSourceReadout A).source_label =
      SU7A6EndpointUnitDescentOrientation.targetLeft
        (su7A6_sourceEndpointUnitDescentOrientation_of_positive A hpos) := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  unfold su7A6SourceOrientedEndpointTargetLeft
  rw [show
      su7A6ConcreteEndpointSourceGrammar.leftCodeOf R0.source_label =
        A.sourceCell.cell.leftWeightCode by
        simpa [R0, su7A6ConcreteEndpointSourceGrammar] using
          R0.left_code_reads_source,
    show
      su7A6ConcreteEndpointSourceGrammar.rightCodeOf R0.source_label =
        A.sourceCell.cell.rightWeightCode by
        simpa [R0, su7A6ConcreteEndpointSourceGrammar] using
          R0.right_code_reads_source]
  unfold su7A6_sourceEndpointUnitDescentOrientation_of_positive
  by_cases hbelow :
      A.sourceCell.cell.leftWeightCode +
        A.sourceCell.cell.rightWeightCode < 2 * n
  ·
    simp [hbelow, SU7A6EndpointUnitDescentOrientation.targetLeft]
  ·
    simp [hbelow, SU7A6EndpointUnitDescentOrientation.targetLeft]

/-- Source-label oriented targets and positive-residual endpoint orientations
choose the same right endpoint code. -/
theorem su7A6SourceOrientedEndpointTargetRight_eq_orientationTargetRight
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    su7A6SourceOrientedEndpointTargetRight n
        (su7A6ConcreteEndpointSourceReadout A).source_label =
      SU7A6EndpointUnitDescentOrientation.targetRight
        (su7A6_sourceEndpointUnitDescentOrientation_of_positive A hpos) := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  unfold su7A6SourceOrientedEndpointTargetRight
  rw [show
      su7A6ConcreteEndpointSourceGrammar.leftCodeOf R0.source_label =
        A.sourceCell.cell.leftWeightCode by
        simpa [R0, su7A6ConcreteEndpointSourceGrammar] using
          R0.left_code_reads_source,
    show
      su7A6ConcreteEndpointSourceGrammar.rightCodeOf R0.source_label =
        A.sourceCell.cell.rightWeightCode by
        simpa [R0, su7A6ConcreteEndpointSourceGrammar] using
          R0.right_code_reads_source]
  unfold su7A6_sourceEndpointUnitDescentOrientation_of_positive
  by_cases hbelow :
      A.sourceCell.cell.leftWeightCode +
        A.sourceCell.cell.rightWeightCode < 2 * n
  ·
    simp [hbelow, SU7A6EndpointUnitDescentOrientation.targetRight]
  ·
    simp [hbelow, SU7A6EndpointUnitDescentOrientation.targetRight]

/-- The sign-oriented source/phase endpoint target is already a raw
endpoint-code `E - 1` unit move.

This is the unit-quantization half of the representation route.  It uses only
the generated positive source orientation and the concrete endpoint/source
readout; no target atomic check, projection core, repair cell, coverage, or
downstream transporter is involved. -/
theorem su7A6SourceOrientedEndpointTargetLabel_rawEndpointEnergy_unit
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    rawCodePairResidualEnergy n
        (su7A6EndpointSourceLeftCodeOf
          (su7A6SourceOrientedEndpointTargetLabel
            n R0.source_label hheight))
        (su7A6EndpointSourceRightCodeOf
          (su7A6SourceOrientedEndpointTargetLabel
            n R0.source_label hheight)) + 1 =
      A.energy := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  let O := su7A6_sourceEndpointUnitDescentOrientation_of_positive A hpos
  have hleft :
      su7A6SourceOrientedEndpointTargetLeft n R0.source_label =
        SU7A6EndpointUnitDescentOrientation.targetLeft O := by
    simpa [R0, O] using
      su7A6SourceOrientedEndpointTargetLeft_eq_orientationTargetLeft
        (n := n) A hpos
  have hright :
      su7A6SourceOrientedEndpointTargetRight n R0.source_label =
        SU7A6EndpointUnitDescentOrientation.targetRight O := by
    simpa [R0, O] using
      su7A6SourceOrientedEndpointTargetRight_eq_orientationTargetRight
        (n := n) A hpos
  have hunit :
      rawCodePairResidualEnergy n
          (SU7A6EndpointUnitDescentOrientation.targetLeft O)
          (SU7A6EndpointUnitDescentOrientation.targetRight O) + 1 =
        A.energy := by
    calc
      rawCodePairResidualEnergy n
            (SU7A6EndpointUnitDescentOrientation.targetLeft O)
            (SU7A6EndpointUnitDescentOrientation.targetRight O) + 1 =
          rawCodePairResidualEnergy n
            A.sourceCell.cell.leftWeightCode
            A.sourceCell.cell.rightWeightCode := by
        simpa [O] using
          SU7A6EndpointUnitDescentOrientation.raw_unit O
      _ = A.energy :=
          (SU7ProducedActiveCell.energy_eq_raw_source_pair A).symm
  simpa [R0, hheight, su7A6SourceOrientedEndpointTargetLabel,
    su7A6EndpointSourceLabel_leftCode, su7A6EndpointSourceLabel_rightCode,
    hleft, hright] using hunit

/-- On the under-target side, the source-oriented target is exactly the
endpoint-shift completion target. -/
theorem su7A6SourceOrientedEndpointTargetLabel_eq_endpointShiftCompletionTarget_of_sourceBelow
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0)
    (hbelow :
      A.sourceCell.cell.leftWeightCode +
          A.sourceCell.cell.rightWeightCode < 2 * n) :
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    su7A6SourceOrientedEndpointTargetLabel n R0.source_label hheight =
      su7A6EndpointShiftCompletionTarget R0.source_label hheight := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  let raw :=
    rawCodePairResidualEnergy n
      (A.sourceCell.cell.leftWeightCode - 1)
      (A.sourceCell.cell.rightWeightCode + 2)
  have hrawUnit : raw + 1 = A.energy := by
    calc
      raw + 1 =
          rawCodePairResidualEnergy n
              A.sourceCell.cell.leftWeightCode
              A.sourceCell.cell.rightWeightCode := by
        exact
          rawCodePairResidualEnergy_endpointShift_unit_of_sourceBelow
            (by
              have hleft2 : 2 ≤ A.sourceCell.cell.leftWeightCode :=
                two_le_of_natMultiplicativelyAtomicCheck
                  A.sourceCell.left_check
              omega)
            hbelow
      _ = A.energy := (SU7ProducedActiveCell.energy_eq_raw_source_pair A).symm
  have hheightNat :
      (su7A6SignedHeight R0.source_label).toNat = A.energy := by
    rw [R0.source_height_reads_energy]
    simp
  have hrawNat :
      raw = (su7A6SignedHeight R0.source_label).toNat - 1 := by
    rw [hheightNat]
    omega
  have hleftRead :
      su7A6EndpointSourceLeftCodeOf R0.source_label =
        A.sourceCell.cell.leftWeightCode := by
    simpa [su7A6ConcreteEndpointSourceGrammar] using
      R0.left_code_reads_source
  have hrightRead :
      su7A6EndpointSourceRightCodeOf R0.source_label =
        A.sourceCell.cell.rightWeightCode := by
    simpa [su7A6ConcreteEndpointSourceGrammar] using
      R0.right_code_reads_source
  have hbelowRead :
      su7A6EndpointSourceLeftCodeOf R0.source_label +
          su7A6EndpointSourceRightCodeOf R0.source_label < 2 * n := by
    rwa [hleftRead, hrightRead]
  have hrawNatRead :
      rawCodePairResidualEnergy n
          (su7A6EndpointSourceLeftCodeOf R0.source_label - 1)
          (su7A6EndpointSourceRightCodeOf R0.source_label + 2) =
        (su7A6SignedHeight R0.source_label).toNat - 1 := by
    rw [hleftRead, hrightRead]
    exact hrawNat
  simp [R0, su7A6SourceOrientedEndpointTargetLabel,
    su7A6SourceOrientedEndpointTargetLeft,
    su7A6SourceOrientedEndpointTargetRight,
    su7A6EndpointShiftCompletionTarget,
    su7A6ConcreteEndpointSourceGrammar,
    hbelowRead, hrawNatRead]

/-- On a produced under-target source, left-anchor completion preserves the same
raw successor spectrum as the sign-oriented source/phase target.

The source-oriented target is the grammar's immediate `E - 1` endpoint shift;
the left-anchor target is the completed endpoint-room redistribution.  This
theorem says they agree on the scalar residual readout before any finite checker
or repair-cell adapter is invoked. -/
theorem su7A6EndpointLeftAnchorCompletionTarget_sameRawEnergy_as_sourceOrientedEndpointTarget_of_sourceBelow
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0)
    (hbelow :
      A.sourceCell.cell.leftWeightCode +
          A.sourceCell.cell.rightWeightCode < 2 * n) :
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    rawCodePairResidualEnergy n
        (su7A6EndpointSourceLeftCodeOf
          (su7A6EndpointLeftAnchorCompletionTarget R0.source_label hheight))
        (su7A6EndpointSourceRightCodeOf
          (su7A6EndpointLeftAnchorCompletionTarget R0.source_label hheight)) =
      rawCodePairResidualEnergy n
        (su7A6EndpointSourceLeftCodeOf
          (su7A6SourceOrientedEndpointTargetLabel n R0.source_label hheight))
        (su7A6EndpointSourceRightCodeOf
          (su7A6SourceOrientedEndpointTargetLabel n R0.source_label hheight)) := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  have hleftRead :
      su7A6EndpointSourceLeftCodeOf R0.source_label =
        A.sourceCell.cell.leftWeightCode := by
    simpa [R0, su7A6ConcreteEndpointSourceGrammar] using
      R0.left_code_reads_source
  have hrightRead :
      su7A6EndpointSourceRightCodeOf R0.source_label =
        A.sourceCell.cell.rightWeightCode := by
    simpa [R0, su7A6ConcreteEndpointSourceGrammar] using
      R0.right_code_reads_source
  have hleftPos :
      0 < su7A6EndpointSourceLeftCodeOf R0.source_label := by
    have hleft2 : 2 ≤ A.sourceCell.cell.leftWeightCode :=
      two_le_of_natMultiplicativelyAtomicCheck A.sourceCell.left_check
    omega
  have hbelowRead :
      su7A6EndpointSourceLeftCodeOf R0.source_label +
          su7A6EndpointSourceRightCodeOf R0.source_label < 2 * n := by
    simpa [hleftRead, hrightRead] using hbelow
  have hsameShift :
      rawCodePairResidualEnergy n
          (su7A6EndpointSourceLeftCodeOf
            (su7A6EndpointLeftAnchorCompletionTarget R0.source_label hheight))
          (su7A6EndpointSourceRightCodeOf
            (su7A6EndpointLeftAnchorCompletionTarget R0.source_label hheight)) =
        rawCodePairResidualEnergy n
          (su7A6EndpointSourceLeftCodeOf
            (su7A6EndpointShiftCompletionTarget R0.source_label hheight))
          (su7A6EndpointSourceRightCodeOf
            (su7A6EndpointShiftCompletionTarget R0.source_label hheight)) :=
    su7A6EndpointLeftAnchorCompletionTarget_sameRawEnergy_as_endpointShiftCompletionTarget_of_sourceBelow
      (n := n) (source := R0.source_label) hheight hleftPos hbelowRead
  have htargetEq :
      su7A6SourceOrientedEndpointTargetLabel n R0.source_label hheight =
        su7A6EndpointShiftCompletionTarget R0.source_label hheight := by
    simpa [R0, hheight] using
      su7A6SourceOrientedEndpointTargetLabel_eq_endpointShiftCompletionTarget_of_sourceBelow
        A hpos hbelow
  change
    rawCodePairResidualEnergy n
        (su7A6EndpointSourceLeftCodeOf
          (su7A6EndpointLeftAnchorCompletionTarget R0.source_label hheight))
        (su7A6EndpointSourceRightCodeOf
          (su7A6EndpointLeftAnchorCompletionTarget R0.source_label hheight)) =
      rawCodePairResidualEnergy n
        (su7A6EndpointSourceLeftCodeOf
          (su7A6SourceOrientedEndpointTargetLabel n R0.source_label hheight))
        (su7A6EndpointSourceRightCodeOf
          (su7A6SourceOrientedEndpointTargetLabel n R0.source_label hheight))
  rw [htargetEq]
  exact hsameShift

/-- Under the source-below orientation, the sign-oriented source/phase target
generates the raw `E - 1` spectrum, and the left-anchor completion target
materializes that same spectrum through the source/projection core.

This is the uniform selector socket below the finite checker: it does not
assert that the sign-oriented endpoint target itself passes the filter, nor
does it invoke a repair-cell adapter.  It only says that source/phase motion
already produced the successor spectrum and that left-anchor endpoint-room
completion is a same-spectrum filtered realization whenever the generated
right endpoint survives the Boolean checker. -/
theorem su7A6EndpointLeftAnchorCompletionTarget_sourceOrientedSameSpectrumProjectionCore_of_sourceBelow_and_rightCheck
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0)
    (Hright :
      let R0 := su7A6ConcreteEndpointSourceReadout A
      let hheight := R0.source_signedHeight_pos hpos
      natMultiplicativelyAtomicCheck
        (su7A6EndpointSourceRightCodeOf
          (su7A6EndpointLeftAnchorCompletionTarget
            R0.source_label hheight)) = true)
    (Hbelow :
      let R0 := su7A6ConcreteEndpointSourceReadout A
      su7A6EndpointSourceLeftCodeOf R0.source_label +
          su7A6EndpointSourceRightCodeOf R0.source_label <
        2 * n) :
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    rawCodePairResidualEnergy n
        (su7A6EndpointSourceLeftCodeOf
          (su7A6SourceOrientedEndpointTargetLabel
            n R0.source_label hheight))
        (su7A6EndpointSourceRightCodeOf
          (su7A6SourceOrientedEndpointTargetLabel
            n R0.source_label hheight)) + 1 =
      A.energy ∧
      rawCodePairResidualEnergy n
          (su7A6EndpointSourceLeftCodeOf
            (su7A6EndpointLeftAnchorCompletionTarget
              R0.source_label hheight))
          (su7A6EndpointSourceRightCodeOf
            (su7A6EndpointLeftAnchorCompletionTarget
              R0.source_label hheight)) =
        rawCodePairResidualEnergy n
          (su7A6EndpointSourceLeftCodeOf
            (su7A6SourceOrientedEndpointTargetLabel
              n R0.source_label hheight))
          (su7A6EndpointSourceRightCodeOf
            (su7A6SourceOrientedEndpointTargetLabel
              n R0.source_label hheight)) ∧
        Nonempty
          (SU7A6SourceLabelUnitCenterCoverProjectionCore n
            R0.source_label
            (su7A6EndpointLeftAnchorCompletionTarget
              R0.source_label hheight)) := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  have hsourceRaw :
      rawCodePairResidualEnergy n
          (su7A6EndpointSourceLeftCodeOf
            (su7A6SourceOrientedEndpointTargetLabel
              n R0.source_label hheight))
          (su7A6EndpointSourceRightCodeOf
            (su7A6SourceOrientedEndpointTargetLabel
              n R0.source_label hheight)) + 1 =
        A.energy := by
    simpa [R0, hheight] using
      su7A6SourceOrientedEndpointTargetLabel_rawEndpointEnergy_unit
        (n := n) A hpos
  have hleftRead :
      su7A6EndpointSourceLeftCodeOf R0.source_label =
        A.sourceCell.cell.leftWeightCode := by
    simpa [R0, su7A6ConcreteEndpointSourceGrammar] using
      R0.left_code_reads_source
  have hrightRead :
      su7A6EndpointSourceRightCodeOf R0.source_label =
        A.sourceCell.cell.rightWeightCode := by
    simpa [R0, su7A6ConcreteEndpointSourceGrammar] using
      R0.right_code_reads_source
  have hbelowRead :
      su7A6EndpointSourceLeftCodeOf R0.source_label +
          su7A6EndpointSourceRightCodeOf R0.source_label <
        2 * n := by
    simpa [R0] using Hbelow
  have hbelowCell :
      A.sourceCell.cell.leftWeightCode +
          A.sourceCell.cell.rightWeightCode < 2 * n := by
    simpa [hleftRead, hrightRead] using hbelowRead
  have hsame :
      rawCodePairResidualEnergy n
          (su7A6EndpointSourceLeftCodeOf
            (su7A6EndpointLeftAnchorCompletionTarget
              R0.source_label hheight))
          (su7A6EndpointSourceRightCodeOf
            (su7A6EndpointLeftAnchorCompletionTarget
              R0.source_label hheight)) =
        rawCodePairResidualEnergy n
          (su7A6EndpointSourceLeftCodeOf
            (su7A6SourceOrientedEndpointTargetLabel
              n R0.source_label hheight))
          (su7A6EndpointSourceRightCodeOf
            (su7A6SourceOrientedEndpointTargetLabel
              n R0.source_label hheight)) := by
    simpa [R0, hheight] using
      su7A6EndpointLeftAnchorCompletionTarget_sameRawEnergy_as_sourceOrientedEndpointTarget_of_sourceBelow
        A hpos hbelowCell
  have hcore :
      SU7A6SourceLabelUnitCenterCoverProjectionCore n
        R0.source_label
        (su7A6EndpointLeftAnchorCompletionTarget
          R0.source_label hheight) := by
    simpa [R0, hheight] using
      su7A6EndpointLeftAnchorCompletionTarget_sourceProjectionCore_of_sourceBelow_and_rightCheck
        A hpos Hright Hbelow
  exact ⟨hsourceRaw, hsame, ⟨hcore⟩⟩

/-- If the positive-residual orientation selects the under-target branch, then
the left-anchor completion target gives the pointwise source/projection core
from only the generated right-anchor Boolean check.

This is the source/phase version of the orientation theorem below: it stops at
the core that carries unit center-cover motion plus endpoint projection, rather
than jumping directly to filtered lower-spectrum connectivity. -/
def su7A6EndpointLeftAnchorCompletionTarget_sourceProjectionCore_of_orientationBelow_and_rightCheck
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0)
    (Hright :
      let R0 := su7A6ConcreteEndpointSourceReadout A
      let hheight := R0.source_signedHeight_pos hpos
      natMultiplicativelyAtomicCheck
        (su7A6EndpointSourceRightCodeOf
          (su7A6EndpointLeftAnchorCompletionTarget
            R0.source_label hheight)) = true)
    (HbelowO :
      SU7A6EndpointUnitDescentOrientation.isSourceBelow
        (su7A6_sourceEndpointUnitDescentOrientation_of_positive A hpos)) :
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    SU7A6SourceLabelUnitCenterCoverProjectionCore n
      R0.source_label
      (su7A6EndpointLeftAnchorCompletionTarget
        R0.source_label hheight) := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  let O := su7A6_sourceEndpointUnitDescentOrientation_of_positive A hpos
  have hbelowCell :
      A.sourceCell.cell.leftWeightCode +
          A.sourceCell.cell.rightWeightCode < 2 * n := by
    simpa [O] using
      SU7A6EndpointUnitDescentOrientation.sourceBelow_bound_of_isSourceBelow
        O HbelowO
  have hleftRead :
      su7A6EndpointSourceLeftCodeOf R0.source_label =
        A.sourceCell.cell.leftWeightCode := by
    simpa [R0, su7A6ConcreteEndpointSourceGrammar] using
      R0.left_code_reads_source
  have hrightRead :
      su7A6EndpointSourceRightCodeOf R0.source_label =
        A.sourceCell.cell.rightWeightCode := by
    simpa [R0, su7A6ConcreteEndpointSourceGrammar] using
      R0.right_code_reads_source
  have Hbelow :
      let R0 := su7A6ConcreteEndpointSourceReadout A
      su7A6EndpointSourceLeftCodeOf R0.source_label +
          su7A6EndpointSourceRightCodeOf R0.source_label <
        2 * n := by
    simpa [R0, hleftRead, hrightRead] using hbelowCell
  simpa [R0, hheight] using
    su7A6EndpointLeftAnchorCompletionTarget_sourceProjectionCore_of_sourceBelow_and_rightCheck
      A hpos Hright Hbelow

