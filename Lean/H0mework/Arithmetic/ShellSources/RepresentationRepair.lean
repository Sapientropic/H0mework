/-- `(5,7)` necessary finite-search specification for any valid raw-cell
completion target.

On a produced-active `(5,7)` source at `n = 10`, a legal adaptive target is
Boolean-atomic and has raw endpoint residual `7`, one below the source residual
`8`. -/
theorem fiveSeven_targetCell_atomic_rawEnergy_seven
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 10 bound)
    (A : SU7ProducedActiveCell σ hσ 10 bound)
    (hleft : A.sourceCell.cell.leftWeightCode = 5)
    (hright : A.sourceCell.cell.rightWeightCode = 7)
    (hpos : A.energy ≠ 0) :
    natMultiplicativelyAtomicCheck
        (L.targetCell A hpos).cell.leftWeightCode = true ∧
      natMultiplicativelyAtomicCheck
        (L.targetCell A hpos).cell.rightWeightCode = true ∧
        rawCodePairResidualEnergy 10
          (L.targetCell A hpos).cell.leftWeightCode
          (L.targetCell A hpos).cell.rightWeightCode = 7 := by
  refine
    ⟨(L.targetCell A hpos).left_check,
      (L.targetCell A hpos).right_check, ?_⟩
  have hunit := L.target_raw_energy_unit A hpos
  have henergy : A.energy = rawCodePairResidualEnergy 10 5 7 := by
    rw [SU7ProducedActiveCell.energy_eq_raw_source_pair A, hleft, hright]
  rw [henergy, rawCodePairResidualEnergy_ten_five_seven] at hunit
  omega

/-- `(5,7)` adaptive raw-cell target codes have only two possible orientations:
`(2,11)` or `(11,2)`. -/
theorem fiveSeven_targetCell_codes_two_eleven_or_eleven_two
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 10 bound)
    (A : SU7ProducedActiveCell σ hσ 10 bound)
    (hleft : A.sourceCell.cell.leftWeightCode = 5)
    (hright : A.sourceCell.cell.rightWeightCode = 7)
    (hpos : A.energy ≠ 0) :
    ((L.targetCell A hpos).cell.leftWeightCode = 2 ∧
        (L.targetCell A hpos).cell.rightWeightCode = 11) ∨
      ((L.targetCell A hpos).cell.leftWeightCode = 11 ∧
        (L.targetCell A hpos).cell.rightWeightCode = 2) := by
  rcases
      L.fiveSeven_targetCell_atomic_rawEnergy_seven A hleft hright hpos with
    ⟨hleft_atomic, hright_atomic, henergy⟩
  exact
    rawCodePairResidualEnergy_ten_atomic_seven_codes
      hleft_atomic hright_atomic henergy

/-- The target-energy field of a `(5,7)` adaptive raw-cell completion target is
forced to be `7`. -/
theorem fiveSeven_targetEnergy_seven
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 10 bound)
    (A : SU7ProducedActiveCell σ hσ 10 bound)
    (hleft : A.sourceCell.cell.leftWeightCode = 5)
    (hright : A.sourceCell.cell.rightWeightCode = 7)
    (hpos : A.energy ≠ 0) :
    L.targetEnergy A hpos = 7 := by
  have hunit := L.target_energy_unit A hpos
  have henergy : A.energy = rawCodePairResidualEnergy 10 5 7 := by
    rw [SU7ProducedActiveCell.energy_eq_raw_source_pair A, hleft, hright]
  rw [henergy, rawCodePairResidualEnergy_ten_five_seven] at hunit
  omega

/-- `(5,7)` adaptive raw-cell completion targets classify to the center-cover
completion label or its endpoint-code mirror. -/
theorem fiveSeven_targetLabel_eq_completedRepairLabel_or_mirror
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 10 bound)
    (A : SU7ProducedActiveCell σ hσ 10 bound)
    (hleft : A.sourceCell.cell.leftWeightCode = 5)
    (hright : A.sourceCell.cell.rightWeightCode = 7)
    (hpos : A.energy ≠ 0) :
    L.targetLabel A hpos = su7A6FiveSevenCompletedRepairLabel ∨
      L.targetLabel A hpos = su7A6EndpointSourceLabel 11 2 7 := by
  have henergy := L.fiveSeven_targetEnergy_seven A hleft hright hpos
  rcases
      L.fiveSeven_targetCell_codes_two_eleven_or_eleven_two
        A hleft hright hpos with
    hcodes | hcodes
  · rcases hcodes with ⟨hleft_code, hright_code⟩
    left
    simp [targetLabel, su7A6FiveSevenCompletedRepairLabel,
      hleft_code, hright_code, henergy]
  · rcases hcodes with ⟨hleft_code, hright_code⟩
    right
    simp [targetLabel, hleft_code, hright_code, henergy]

/-- The `(5,7)` mirror candidate has canonical center-shift `16`, not `-29`. -/
theorem fiveSeven_mirrorRepairLabel_canonicalCenterShift
    (_L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 10 bound)
    (A : SU7ProducedActiveCell σ hσ 10 bound)
    (hleft : A.sourceCell.cell.leftWeightCode = 5)
    (hright : A.sourceCell.cell.rightWeightCode = 7)
    (_hpos : A.energy ≠ 0) :
    su7A6CenterCoverShiftOfDisplacement
      (su7A6ConcreteEndpointSourceReadout A).source_label
      (su7A6EndpointSourceLabel 11 2 7) = 16 := by
  have henergy : A.energy = rawCodePairResidualEnergy 10 5 7 := by
    rw [SU7ProducedActiveCell.energy_eq_raw_source_pair A, hleft, hright]
  rw [rawCodePairResidualEnergy_ten_five_seven] at henergy
  change
    su7A6CenterCoverShiftOfDisplacement
      (su7A6ConcreteEndpointSourceLabelOf A)
      (su7A6EndpointSourceLabel 11 2 7) = 16
  unfold su7A6CenterCoverShiftOfDisplacement
  have hsource_index :
      su7A6RootLatticeIndex (su7A6ConcreteEndpointSourceLabelOf A) =
        7 * (5 : Int) + 12 * (7 : Int) - 2 * (8 : Int) := by
    unfold su7A6ConcreteEndpointSourceLabelOf
    rw [hleft, hright, henergy]
    simpa using su7A6EndpointSourceLabel_rootIndex 5 7 8
  have htarget_index :
      su7A6RootLatticeIndex (su7A6EndpointSourceLabel 11 2 7) =
        7 * (11 : Int) + 12 * (2 : Int) - 2 * (7 : Int) := by
    simpa using su7A6EndpointSourceLabel_rootIndex 11 2 7
  rw [hsource_index, htarget_index]
  norm_num

/-- The canonical center disposition of any valid `(5,7)` produced-active
raw-cell completion target is either the completed value `-29` or the mirror
value `16`.

This lifts the finite projection-core classifier to the raw-cell completion
socket.  The remaining SU(7) selector obligation is therefore not to search an
open target space, but to rule out the mirror disposition generated by the
same source/phase target law. -/
theorem fiveSeven_targetLabel_centerShift_neg29_or_mirror16
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 10 bound)
    (A : SU7ProducedActiveCell σ hσ 10 bound)
    (hleft : A.sourceCell.cell.leftWeightCode = 5)
    (hright : A.sourceCell.cell.rightWeightCode = 7)
    (hpos : A.energy ≠ 0) :
    su7A6CenterCoverShiftOfDisplacement
        (su7A6ConcreteEndpointSourceReadout A).source_label
        (L.targetLabel A hpos) = -29 ∨
      su7A6CenterCoverShiftOfDisplacement
        (su7A6ConcreteEndpointSourceReadout A).source_label
        (L.targetLabel A hpos) = 16 := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  have hsource : R0.source_label = su7A6FiveSevenSourceLabel := by
    simpa [R0] using
      su7A6FiveSevenProducedActiveCell_sourceLabel_eq A hleft hright
  rcases
      L.fiveSeven_targetLabel_eq_completedRepairLabel_or_mirror
        A hleft hright hpos with
    hcompleted | hmirror
  ·
    left
    rw [show (su7A6ConcreteEndpointSourceReadout A).source_label =
        su7A6FiveSevenSourceLabel by simpa [R0] using hsource,
      hcompleted]
    exact su7A6FiveSevenCompletedRepairLabel_canonicalCenterShift
  ·
    right
    rw [hmirror]
    exact L.fiveSeven_mirrorRepairLabel_canonicalCenterShift
      A hleft hright hpos

/-- A `(5,7)` adaptive target with canonical center-shift `-29` must be the
known center-cover completion label, not the mirror. -/
theorem fiveSeven_targetLabel_eq_completedRepairLabel_of_canonicalCenterShift_neg29
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 10 bound)
    (A : SU7ProducedActiveCell σ hσ 10 bound)
    (hleft : A.sourceCell.cell.leftWeightCode = 5)
    (hright : A.sourceCell.cell.rightWeightCode = 7)
    (hpos : A.energy ≠ 0)
    (hshift :
      su7A6CenterCoverShiftOfDisplacement
        (su7A6ConcreteEndpointSourceReadout A).source_label
        (L.targetLabel A hpos) = -29) :
    L.targetLabel A hpos = su7A6FiveSevenCompletedRepairLabel := by
  rcases
      L.fiveSeven_targetLabel_eq_completedRepairLabel_or_mirror
        A hleft hright hpos with
    hcompleted | hmirror
  · exact hcompleted
  · have hmirror_shift :=
      L.fiveSeven_mirrorRepairLabel_canonicalCenterShift
        A hleft hright hpos
    rw [hmirror] at hshift
    rw [hmirror_shift] at hshift
    norm_num at hshift

/-- Excluding the mirror center disposition forces the `(5,7)` completion
target to be the completed `(2,11,E=7)` label.

This is the narrow selector form useful for the next hard gate: SU(7)
source/phase grammar may prove that the generated completion target is not the
mirror branch (`center_shift = 16`), and Lean then recovers the completed
target without invoking coverage, P950, or a repair-cell premise. -/
theorem fiveSeven_targetLabel_eq_completedRepairLabel_of_centerShift_ne_mirror16
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 10 bound)
    (A : SU7ProducedActiveCell σ hσ 10 bound)
    (hleft : A.sourceCell.cell.leftWeightCode = 5)
    (hright : A.sourceCell.cell.rightWeightCode = 7)
    (hpos : A.energy ≠ 0)
    (hmirror_ne :
      su7A6CenterCoverShiftOfDisplacement
        (su7A6ConcreteEndpointSourceReadout A).source_label
        (L.targetLabel A hpos) ≠ 16) :
    L.targetLabel A hpos = su7A6FiveSevenCompletedRepairLabel := by
  have hshift_or :=
    L.fiveSeven_targetLabel_centerShift_neg29_or_mirror16
      A hleft hright hpos
  rcases hshift_or with hshift | hshift
  · exact
      L.fiveSeven_targetLabel_eq_completedRepairLabel_of_canonicalCenterShift_neg29
        A hleft hright hpos hshift
  · exact False.elim (hmirror_ne hshift)

/-- Canonical `-29` center disposition forces the `(5,7)` adaptive target codes
to be exactly `(2,11)`. -/
theorem fiveSeven_targetCell_codes_two_eleven_of_canonicalCenterShift_neg29
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 10 bound)
    (A : SU7ProducedActiveCell σ hσ 10 bound)
    (hleft : A.sourceCell.cell.leftWeightCode = 5)
    (hright : A.sourceCell.cell.rightWeightCode = 7)
    (hpos : A.energy ≠ 0)
    (hshift :
      su7A6CenterCoverShiftOfDisplacement
        (su7A6ConcreteEndpointSourceReadout A).source_label
        (L.targetLabel A hpos) = -29) :
    (L.targetCell A hpos).cell.leftWeightCode = 2 ∧
      (L.targetCell A hpos).cell.rightWeightCode = 11 := by
  have hlabel :=
    L.fiveSeven_targetLabel_eq_completedRepairLabel_of_canonicalCenterShift_neg29
      A hleft hright hpos hshift
  constructor
  ·
    have h :=
      congrArg su7A6EndpointSourceLeftCodeOf hlabel
    simpa [targetLabel, su7A6FiveSevenCompletedRepairLabel,
      su7A6EndpointSourceLabel_leftCode] using h
  ·
    have h :=
      congrArg su7A6EndpointSourceRightCodeOf hlabel
    simpa [targetLabel, su7A6FiveSevenCompletedRepairLabel,
      su7A6EndpointSourceLabel_rightCode] using h

/-- `(5,7)` raw-cell completion targets compute the endpoint room from their
finite target codes. -/
theorem fiveSeven_targetCell_completedBound_spec
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 10 bound)
    (A : SU7ProducedActiveCell σ hσ 10 bound)
    (hpos : A.energy ≠ 0) :
    bound ≤
      computedEndpointRoomBound bound
        (L.targetCell A hpos).cell.leftWeightCode
        (L.targetCell A hpos).cell.rightWeightCode := by
  exact
    bound_le_computedEndpointRoomBound bound
      (L.targetCell A hpos).cell.leftWeightCode
      (L.targetCell A hpos).cell.rightWeightCode

/-- `(5,7)` adaptive raw-cell targets are generated by the computed endpoint
room.

This is the finite checker readout of a valid produced-active raw-cell
completion target at the `(5,7)` diagnostic: once SU(7) has produced the target
cell, its endpoint codes are in the computed room, pass the atomic filter, and
carry raw residual `7`. -/
theorem fiveSeven_targetCell_completedAllowedSpec
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 10 bound)
    (A : SU7ProducedActiveCell σ hσ 10 bound)
    (hleft : A.sourceCell.cell.leftWeightCode = 5)
    (hright : A.sourceCell.cell.rightWeightCode = 7)
    (hpos : A.energy ≠ 0) :
    let left := (L.targetCell A hpos).cell.leftWeightCode
    let right := (L.targetCell A hpos).cell.rightWeightCode
    let completedBound := computedEndpointRoomBound bound left right
    generatedNoPrimeAllowedPredicate 10 completedBound left right = true ∧
      left ∈ rawCodeBoundedList completedBound ∧
        right ∈ rawCodeBoundedList completedBound ∧
          natMultiplicativelyAtomicCheck left = true ∧
            natMultiplicativelyAtomicCheck right = true ∧
              rawCodePairResidualEnergy 10 left right = 7 := by
  let left := (L.targetCell A hpos).cell.leftWeightCode
  let right := (L.targetCell A hpos).cell.rightWeightCode
  let completedBound := computedEndpointRoomBound bound left right
  have hleft_mem :
      left ∈ rawCodeBoundedList completedBound := by
    simpa [left, right, completedBound] using
      repairLeft_mem_rawCodeBoundedList_computedEndpointRoomBound
        bound left right
  have hright_mem :
      right ∈ rawCodeBoundedList completedBound := by
    simpa [left, right, completedBound] using
      repairRight_mem_rawCodeBoundedList_computedEndpointRoomBound
        bound left right
  have Htarget :=
    L.fiveSeven_targetCell_atomic_rawEnergy_seven A hleft hright hpos
  rcases Htarget with ⟨hleft_check, hright_check, henergy⟩
  refine
    ⟨?_, hleft_mem, hright_mem, ?_, ?_, ?_⟩
  ·
    exact
      generatedNoPrimeAllowedPredicate_of_boundedAtomicRawCodePair
        hleft_mem hright_mem hleft_check hright_check
  · simpa [left] using hleft_check
  · simpa [right] using hright_check
  · simpa [left, right] using henergy

/-- Canonical `-29` center disposition fixes the `(5,7)` completed endpoint
room to bound `11`, provided the old bound does not already exceed `11`.

The room is still computed from the generated target codes; the hypothesis only
says the previous finite box was not larger than the newly required endpoint
room. -/
theorem fiveSeven_targetCell_completedBound_eq_eleven_of_canonicalCenterShift_neg29
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 10 bound)
    (A : SU7ProducedActiveCell σ hσ 10 bound)
    (hleft : A.sourceCell.cell.leftWeightCode = 5)
    (hright : A.sourceCell.cell.rightWeightCode = 7)
    (hpos : A.energy ≠ 0)
    (hbound : bound ≤ 11)
    (hshift :
      su7A6CenterCoverShiftOfDisplacement
        (su7A6ConcreteEndpointSourceReadout A).source_label
        (L.targetLabel A hpos) = -29) :
    computedEndpointRoomBound bound
      (L.targetCell A hpos).cell.leftWeightCode
      (L.targetCell A hpos).cell.rightWeightCode = 11 := by
  rcases
      L.fiveSeven_targetCell_codes_two_eleven_of_canonicalCenterShift_neg29
        A hleft hright hpos hshift with
    ⟨hleft_target, hright_target⟩
  unfold computedEndpointRoomBound
  rw [hleft_target, hright_target]
  omega

/-- With canonical `-29` center disposition, the `(5,7)` adaptive target is
generated by the exact bound-`11` raw endpoint predicate.

This is the sharp finite target specification the SU(7) completion grammar must
materialize after producing the `-29` center-cover disposition. -/
theorem fiveSeven_targetCell_exactBoundElevenAllowed_of_canonicalCenterShift_neg29
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 10 bound)
    (A : SU7ProducedActiveCell σ hσ 10 bound)
    (hleft : A.sourceCell.cell.leftWeightCode = 5)
    (hright : A.sourceCell.cell.rightWeightCode = 7)
    (hpos : A.energy ≠ 0)
    (hshift :
      su7A6CenterCoverShiftOfDisplacement
        (su7A6ConcreteEndpointSourceReadout A).source_label
        (L.targetLabel A hpos) = -29) :
    let left := (L.targetCell A hpos).cell.leftWeightCode
    let right := (L.targetCell A hpos).cell.rightWeightCode
    generatedNoPrimeAllowedPredicate 10 11 left right = true ∧
      left ∈ rawCodeBoundedList 11 ∧
        right ∈ rawCodeBoundedList 11 ∧
          natMultiplicativelyAtomicCheck left = true ∧
            natMultiplicativelyAtomicCheck right = true ∧
              rawCodePairResidualEnergy 10 left right = 7 := by
  dsimp only
  rcases
      L.fiveSeven_targetCell_codes_two_eleven_of_canonicalCenterShift_neg29
        A hleft hright hpos hshift with
    ⟨hleft_target, hright_target⟩
  rw [hleft_target, hright_target]
  exact
    ⟨generatedNoPrimeAllowedPredicate_ten_two_eleven le_rfl,
      two_mem_rawCodeBoundedList (by norm_num),
      eleven_mem_rawCodeBoundedList le_rfl,
      natMultiplicativelyAtomicCheck_two,
      natMultiplicativelyAtomicCheck_eleven,
      rawCodePairResidualEnergy_ten_two_eleven⟩

/-- P948 raw-cell completion targets compute the endpoint room from their
finite target codes.

Together with `p948_targetCell_atomic_rawEnergy_five`, this states the exact
room object the adaptive SU(7) completion theorem must generate: a Boolean
atomic raw pair at residual `5`, with completed bound given by
`computedEndpointRoomBound 3 left right`. -/
theorem p948_targetCell_completedBound_spec
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 6 3)
    (A : SU7ProducedActiveCell σ hσ 6 3)
    (hpos : A.energy ≠ 0) :
    3 ≤
      computedEndpointRoomBound 3
        (L.targetCell A hpos).cell.leftWeightCode
        (L.targetCell A hpos).cell.rightWeightCode := by
  exact
    bound_le_computedEndpointRoomBound 3
      (L.targetCell A hpos).cell.leftWeightCode
      (L.targetCell A hpos).cell.rightWeightCode

/-- P948 adaptive raw-cell targets are generated by the computed endpoint room.

This is the finite checker readout of a valid produced-active raw-cell
completion target: once SU(7) has produced the target cell, its endpoint codes
are in the computed room, pass the atomic filter, and are marked by
`generatedNoPrimeAllowedPredicate`; the raw energy remains exactly `5`. -/
theorem p948_targetCell_completedAllowedSpec
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ 6 3)
    (A : SU7ProducedActiveCell σ hσ 6 3)
    (hleft : A.sourceCell.cell.leftWeightCode = 3)
    (hright : A.sourceCell.cell.rightWeightCode = 3)
    (hpos : A.energy ≠ 0) :
    let left := (L.targetCell A hpos).cell.leftWeightCode
    let right := (L.targetCell A hpos).cell.rightWeightCode
    let completedBound := computedEndpointRoomBound 3 left right
    generatedNoPrimeAllowedPredicate 6 completedBound left right = true ∧
      left ∈ rawCodeBoundedList completedBound ∧
        right ∈ rawCodeBoundedList completedBound ∧
          natMultiplicativelyAtomicCheck left = true ∧
            natMultiplicativelyAtomicCheck right = true ∧
              rawCodePairResidualEnergy 6 left right = 5 := by
  let left := (L.targetCell A hpos).cell.leftWeightCode
  let right := (L.targetCell A hpos).cell.rightWeightCode
  let completedBound := computedEndpointRoomBound 3 left right
  have hleft_mem :
      left ∈ rawCodeBoundedList completedBound := by
    simpa [left, right, completedBound] using
      repairLeft_mem_rawCodeBoundedList_computedEndpointRoomBound
        3 left right
  have hright_mem :
      right ∈ rawCodeBoundedList completedBound := by
    simpa [left, right, completedBound] using
      repairRight_mem_rawCodeBoundedList_computedEndpointRoomBound
        3 left right
  have Htarget :=
    L.p948_targetCell_atomic_rawEnergy_five A hleft hright hpos
  rcases Htarget with ⟨hleft_check, hright_check, henergy⟩
  refine
    ⟨?_, hleft_mem, hright_mem, ?_, ?_, ?_⟩
  ·
    exact
      generatedNoPrimeAllowedPredicate_of_boundedAtomicRawCodePair
        hleft_mem hright_mem hleft_check hright_check
  · simpa [left] using hleft_check
  · simpa [right] using hright_check
  · simpa [left, right] using henergy

/-- Produced-active raw-cell completion targets materialize the generated
lower no-prime cell in the computed endpoint room. -/
theorem materializes_generated_lower_cell
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
      lower ∈
        generatedNoPrimeBranchingCells n
          (computedEndpointRoomBound bound
            (L.targetCell A hpos).cell.leftWeightCode
            (L.targetCell A hpos).cell.rightWeightCode) ∧
        noPrimeBranchingEndpointResidualEnergy lower + 1 = A.energy := by
  let left := (L.targetCell A hpos).cell.leftWeightCode
  let right := (L.targetCell A hpos).cell.rightWeightCode
  let lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n :=
    noPrimeBranchingCellOfBooleanAtomicRawCell
      (booleanAtomicCellOfRawCodePair n left right
        (by
          simpa [left] using (L.targetCell A hpos).left_check)
        (by
          simpa [right] using (L.targetCell A hpos).right_check))
  refine ⟨lower, ?_, ?_⟩
  ·
    unfold lower
    exact
      generatedNoPrimeBranchingCellOf_boundedAtomicRawCodePair_mem
        (repairLeft_mem_rawCodeBoundedList_computedEndpointRoomBound
          bound left right)
        (repairRight_mem_rawCodeBoundedList_computedEndpointRoomBound
          bound left right)
        (by
          simpa [left] using (L.targetCell A hpos).left_check)
        (by
          simpa [right] using (L.targetCell A hpos).right_check)
  ·
    unfold lower
    rw [noPrimeBranchingCellOfBooleanAtomicRawCell_energy_eq,
      booleanAtomicCellOfRawCodePair_energy_eq]
    simpa [left, right] using L.target_raw_energy_unit A hpos

/-- Produced-active raw-cell completion targets give filtered weight-graph
downward connectivity without an all-label target witness. -/
theorem filtered_weight_graph_downward_connectivity
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    ∃ completedBound,
      ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
        bound ≤ completedBound ∧
          lower ∈ generatedNoPrimeBranchingCells n completedBound ∧
            noPrimeBranchingEndpointResidualEnergy lower + 1 = A.energy := by
  let left := (L.targetCell A hpos).cell.leftWeightCode
  let right := (L.targetCell A hpos).cell.rightWeightCode
  let completedBound := computedEndpointRoomBound bound left right
  have Hmat :
      ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
        lower ∈ generatedNoPrimeBranchingCells n completedBound ∧
          noPrimeBranchingEndpointResidualEnergy lower + 1 = A.energy := by
    simpa [left, right, completedBound] using
      L.materializes_generated_lower_cell A hpos
  rcases Hmat with ⟨lower, hmem, hunit⟩
  exact
    ⟨completedBound, lower,
      by
        simpa [completedBound] using
           bound_le_computedEndpointRoomBound bound left right,
       hmem, hunit⟩

/-- Produced-active raw-cell completion targets directly reach the generated
repair-cell source target.

This is the narrow produced-active repair throat: the premise is not a repair
cell, coverage, a normalizer, or an endpoint shell.  It is exactly a
grammar-generated Boolean-atomic raw target cell with unit center-cover
transport and faithful target-energy readout for the produced source path. -/
theorem generated_repair_law
    (L : SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    ∃ completedBound,
      ∃ _repair :
        SU7GeneratedRepairCell A
          (SU7RepairObligation.of_positive A hpos),
        bound ≤ completedBound := by
  let left := (L.targetCell A hpos).cell.leftWeightCode
  let right := (L.targetCell A hpos).cell.rightWeightCode
  let completedBound := computedEndpointRoomBound bound left right
  have Hmat :
      ∃ lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
        lower ∈ generatedNoPrimeBranchingCells n completedBound ∧
          noPrimeBranchingEndpointResidualEnergy lower + 1 = A.energy := by
    simpa [left, right, completedBound] using
      L.materializes_generated_lower_cell A hpos
  rcases Hmat with ⟨lower, hmem, hunit⟩
  have hbound : bound ≤ completedBound := by
    simpa [completedBound] using
      bound_le_computedEndpointRoomBound bound left right
  exact
    ⟨completedBound,
      generatedRepairCell_of_noPrimeUnitStepAtRepairBound
        A hpos hbound hmem hunit,
      hbound⟩

/-- Endpoint-code target laws are the upstream finite-checker mouth for the
produced-active raw-cell completion law.

This removes the raw target cell as an independent producer premise: once
SU(7) grammar supplies target endpoint codes, Boolean no-prime checks, and the
raw `E - 1` readout, the Boolean-atomic raw target cell is constructed by the
canonical raw-code lift. -/
def ofConcreteEndpointCodePair
    (L : SU7A6ConcreteEndpointCodePairUnitTargetLaw σ hσ n bound) :
    SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ n bound where
  targetCell := fun A hpos =>
    booleanAtomicCellOfRawCodePair n
      (L.targetLeft A hpos)
      (L.targetRight A hpos)
      (L.left_check A hpos)
      (L.right_check A hpos)
  targetEnergy := fun A hpos =>
    rawCodePairResidualEnergy n
      (L.targetLeft A hpos)
      (L.targetRight A hpos)
  unit_center_cover_move := by
    intro A hpos
    let R0 := su7A6ConcreteEndpointSourceReadout A
    simpa [R0, su7A6ConcreteEndpointSourceReadout,
      booleanAtomicCellOfRawCodePair] using
      L.unitCenterCoverDisplacement A hpos
  target_cell_energy_reads := by
    intro A hpos
    simpa using
      booleanAtomicCellOfRawCodePair_energy_eq n
        (L.targetLeft A hpos)
        (L.targetRight A hpos)
        (L.left_check A hpos)
        (L.right_check A hpos)

/-- The previous all-label raw-cell target law restricts to the weaker
produced-active completion law. -/
def ofAllLabel
    (L :
      SU7A6SignedHeightConcreteUnitCenterCoverEndpointRawCellTargetLaw
        σ hσ n bound) :
    SU7A6ProducedActiveRawCellCompletionTargetLaw σ hσ n bound where
  targetCell := fun A hpos =>
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    L.targetCell R0.source_label hheight
  targetEnergy := fun A hpos =>
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    L.targetEnergy R0.source_label hheight
  unit_center_cover_move := by
    intro A hpos
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    simpa [R0, hheight] using
      L.unit_center_cover_move R0.source_label hheight
  target_cell_energy_reads := by
    intro A hpos
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    simpa [R0, hheight] using
      L.target_cell_energy_reads R0.source_label hheight

end SU7A6ProducedActiveRawCellCompletionTargetLaw

/-- The current concrete endpoint/source grammar's fixed-root selector reads
the `(5,7)` source as endpoint codes `(3,8)`, hence endpoint-code index `117`.

This is a source/phase grammar diagnostic, not a downstream obstruction: it
