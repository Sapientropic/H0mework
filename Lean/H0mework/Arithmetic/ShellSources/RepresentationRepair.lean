/-- Raw endpoint energy for the endpoint-shift code move is a unit descent on
the under-target side of the absolute residual.

This is the scalar-energy guardrail behind the endpoint-shift completion:
`left - 1, right + 2` increases the endpoint sum by one, so it lowers absolute
residual by one exactly when the produced source pair still satisfies
`left + right < 2 * n`.  Outside that window the same code move is not a
faithful `E - 1` projection. -/
theorem rawCodePairResidualEnergy_endpointShift_unit_of_sourceBelow
    {n left right : Nat}
    (hleft : 0 < left)
    (hbelow : left + right < 2 * n) :
    rawCodePairResidualEnergy n (left - 1) (right + 2) + 1 =
      rawCodePairResidualEnergy n left right := by
  have hsource_nonpos : rawCodePairResidual n left right ≤ 0 := by
    unfold rawCodePairResidual
    omega
  have htarget_nonpos :
      rawCodePairResidual n (left - 1) (right + 2) ≤ 0 := by
    unfold rawCodePairResidual
    omega
  have hstep :
      rawCodePairResidual n (left - 1) (right + 2) =
        rawCodePairResidual n left right + 1 := by
    unfold rawCodePairResidual
    omega
  have hInt :
      ((rawCodePairResidualEnergy n (left - 1) (right + 2) + 1 : Nat) :
          Int) =
        (rawCodePairResidualEnergy n left right : Int) := by
    unfold rawCodePairResidualEnergy
    rw [Nat.cast_add, Nat.cast_one]
    rw [Int.ofNat_natAbs_of_nonpos htarget_nonpos,
      Int.ofNat_natAbs_of_nonpos hsource_nonpos]
    omega
  exact_mod_cast hInt

/-- Raw endpoint energy for the opposite endpoint-code shift is a unit descent
on the over-target side of the absolute residual.

The move `left + 1, right - 2` decreases the endpoint sum by one when
`2 ≤ right`; hence it lowers absolute residual by one exactly when the source
pair lies above the target sum `2 * n`. -/
theorem rawCodePairResidualEnergy_endpointBackshift_unit_of_sourceAbove
    {n left right : Nat}
    (hright : 2 ≤ right)
    (habove : 2 * n < left + right) :
    rawCodePairResidualEnergy n (left + 1) (right - 2) + 1 =
      rawCodePairResidualEnergy n left right := by
  have hsource_nonneg : 0 ≤ rawCodePairResidual n left right := by
    unfold rawCodePairResidual
    omega
  have htarget_nonneg :
      0 ≤ rawCodePairResidual n (left + 1) (right - 2) := by
    unfold rawCodePairResidual
    omega
  have hstep :
      rawCodePairResidual n (left + 1) (right - 2) =
        rawCodePairResidual n left right - 1 := by
    unfold rawCodePairResidual
    omega
  have hInt :
      ((rawCodePairResidualEnergy n (left + 1) (right - 2) + 1 :
          Nat) : Int) =
        (rawCodePairResidualEnergy n left right : Int) := by
    unfold rawCodePairResidualEnergy
    rw [Nat.cast_add, Nat.cast_one]
    rw [Int.natAbs_of_nonneg htarget_nonneg,
      Int.natAbs_of_nonneg hsource_nonneg]
    omega
  exact_mod_cast hInt

