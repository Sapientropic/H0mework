  have H := L.generated_repair_law A hpos
  exact Or.inl (by
    simpa [A, canonicalRichWitness_repairObligation] using H)

/-- Witness-local repair/static branch from the raw-cell target law.

This all-label form is stronger than the produced-active raw-cell target law
above: the grammar target is required for every positive A6 source label, not
only actual produced active source paths.  The static branch is kept only to
match the Truth-Formula terminal pipeline shape; under this premise the repair
branch is constructed directly. -/
theorem canonicalRichWitness_su7A6ConcreteUnitCenterCoverRawCellTarget_repair_or_scalarStatic
    {σ : ℝ} (hσ0 : σ ≠ 0) {hσ1 : σ ≠ 1}
    {n bound : Nat} {p : Nat × Nat}
    (L :
      SU7A6SignedHeightConcreteUnitCenterCoverEndpointRawCellTargetLaw
        σ hσ1 n bound)
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ1 n bound p) :
    (∃ completedBound,
      ∃ _repair :
        SU7GeneratedRepairCell
          (producedActiveCell_of_canonicalRichHolonomyWitness W)
          (canonicalRichWitness_repairObligation W),
        bound ≤ completedBound) ∨
      CanonicalRichWitnessScalarActiveSigmaStaticTrace hσ0 W := by
  let A := producedActiveCell_of_canonicalRichHolonomyWitness W
  have hpos : A.energy ≠ 0 :=
    canonicalRichWitness_producedActiveCell_energy_ne_zero W
  have H := L.generated_repair_law A hpos
  exact Or.inl (by
    simpa [A, canonicalRichWitness_repairObligation] using H)

/-- The actual upstream law still to be proved from SU(7) representation
grammar.

It says every positive produced active cell has a representation-generated
filtered repair move.  Proving this law is where the hard mathematics sits:
weight-lattice adjacency, branching preservation, filtered connectedness, unit
quantization, and grammar-generated completion room. -/
structure SU7RepresentationGeneratedRepairLaw
    (M : SU7RepresentationWeightGraphModel)
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat) : Prop where
  repair_move :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound),
      A.energy ≠ 0 ->
        Nonempty (SU7RepresentationFilteredRepairMove M A)

/-- If the representation graph law is available, it directly lowers to the
completed-bound generated repair-cell source target. -/
theorem su7_representation_generated_repair_law
    {M : SU7RepresentationWeightGraphModel}
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (L : SU7RepresentationGeneratedRepairLaw M σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    ∃ completedBound,
      ∃ _repair :
        SU7GeneratedRepairCell A
          (SU7RepairObligation.of_positive A hpos),
        bound ≤ completedBound := by
  rcases L.repair_move A hpos with ⟨move⟩
  exact move.exists_generatedRepairCell hpos

/-- Canonical-rich witness form over the active sigma scalar branch.

The static branch is kept only to match the current `repair or static` shape;
this theorem takes the generated repair branch as soon as the representation
repair law is supplied. -/
theorem canonicalRichWitness_su7Representation_repair_or_scalarStatic
    {M : SU7RepresentationWeightGraphModel}
    {σ : ℝ} (hσ0 : σ ≠ 0) {hσ1 : σ ≠ 1}
    {n bound : Nat} {p : Nat × Nat}
    (L : SU7RepresentationGeneratedRepairLaw M σ hσ1 n bound)
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ1 n bound p) :
    (∃ completedBound,
      ∃ _repair :
        SU7GeneratedRepairCell
          (producedActiveCell_of_canonicalRichHolonomyWitness W)
          (canonicalRichWitness_repairObligation W),
        bound ≤ completedBound) ∨
      CanonicalRichWitnessScalarActiveSigmaStaticTrace hσ0 W := by
  let A := producedActiveCell_of_canonicalRichHolonomyWitness W
  have hpos : A.energy ≠ 0 :=
    canonicalRichWitness_producedActiveCell_energy_ne_zero W
  have H :=
    su7_representation_generated_repair_law L A hpos
  exact Or.inl (by
    simpa [A, canonicalRichWitness_repairObligation] using H)

/-- Concrete A6/SU(7) version of the upstream repair law.

This is the next mathematical target below the abstract representation graph
law: every positive produced active cell must obtain a simple-root repair move
whose lowered cell survives branching, filtering, and completed endpoint room. -/
structure SU7A6GeneratedRepairLaw
    (C : SU7A6UnitDescentCodeFunctional)
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat) : Prop where
  repair_move :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound),
      A.energy ≠ 0 ->
        Nonempty (SU7A6FilteredRootRepairMove C A)

/-- A concrete A6 generated repair law supplies the generic representation
generated repair law. -/
theorem SU7A6GeneratedRepairLaw.toRepresentationGeneratedRepairLaw
    {C : SU7A6UnitDescentCodeFunctional}
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (L : SU7A6GeneratedRepairLaw C σ hσ n bound) :
    SU7RepresentationGeneratedRepairLaw
      (su7A6WeightGraphModel C) σ hσ n bound := by
  refine ⟨?_⟩
  ·
    intro A hpos
    rcases L.repair_move A hpos with ⟨move⟩
    exact ⟨move.toRepresentationFilteredRepairMove⟩

/-- Concrete A6/SU(7) generated repair law directly produces the completed
repair-cell source target. -/
theorem su7A6_representation_generated_repair_law
    {C : SU7A6UnitDescentCodeFunctional}
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (L : SU7A6GeneratedRepairLaw C σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    ∃ completedBound,
      ∃ _repair :
        SU7GeneratedRepairCell A
          (SU7RepairObligation.of_positive A hpos),
        bound ≤ completedBound :=
  su7_representation_generated_repair_law
    L.toRepresentationGeneratedRepairLaw A hpos

/-- Concrete A6 signed-height generated repair law.

This is the sharpest current source target: SU(7) grammar must generate a
simple-root repair move whose A6 signed-height readout is faithful to source
residual energy and whose lower cell survives the generated filtered sector at
some grammar-completed bound. -/
structure SU7A6SignedHeightGeneratedRepairLaw
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat) : Prop where
  repair_move :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound),
      A.energy ≠ 0 ->
        Nonempty (SU7A6SignedHeightFilteredRootRepairMove A)

/-- The concrete signed-height law directly produces the completed repair-cell
source target. -/
theorem su7A6_signedHeight_generated_repair_law
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (L : SU7A6SignedHeightGeneratedRepairLaw σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    ∃ completedBound,
      ∃ _repair :
        SU7GeneratedRepairCell A
          (SU7RepairObligation.of_positive A hpos),
        bound ≤ completedBound := by
  rcases L.repair_move A hpos with ⟨move⟩
  exact move.exists_generatedRepairCell hpos

/-- Witness-local signed-height repair/static branch.  As with the abstract
representation version, the static branch is present only to match the current
Truth-Formula fork; the signed-height repair law takes the generated repair
branch. -/
theorem canonicalRichWitness_su7A6SignedHeight_repair_or_scalarStatic
    {σ : ℝ} (hσ0 : σ ≠ 0) {hσ1 : σ ≠ 1}
    {n bound : Nat} {p : Nat × Nat}
    (L : SU7A6SignedHeightGeneratedRepairLaw σ hσ1 n bound)
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ1 n bound p) :
    (∃ completedBound,
      ∃ _repair :
        SU7GeneratedRepairCell
          (producedActiveCell_of_canonicalRichHolonomyWitness W)
          (canonicalRichWitness_repairObligation W),
        bound ≤ completedBound) ∨
      CanonicalRichWitnessScalarActiveSigmaStaticTrace hσ0 W := by
  let A := producedActiveCell_of_canonicalRichHolonomyWitness W
  have hpos : A.energy ≠ 0 :=
    canonicalRichWitness_producedActiveCell_energy_ne_zero W
  have H := su7A6_signedHeight_generated_repair_law L A hpos
  exact Or.inl (by
    simpa [A, canonicalRichWitness_repairObligation] using H)

/-- The signed-height generated repair law factored into the two remaining
source-generation gates:

1. produced active cells have faithful A6 source readout;
2. an unfiltered A6 unit-descent neighbor is faithfully realized after
   branching, filtering, and grammar-generated completion.

The raw unfiltered A6 unit-descent neighbor is supplied by
`su7A6_unfiltered_positive_unit_descent_neighbor`; this law does not ask for
`F + Q`, coverage, P950, a normalizer, or a pre-existing repair cell. -/
structure SU7A6SignedHeightReadoutCompletionLaw
    (Readout : SU7A6SourceReadoutFrame)
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat) : Prop where
  source_readout :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound),
      A.energy ≠ 0 ->
        Nonempty (SU7ProducedActiveCellA6SourceReadout Readout A)
  filtered_completion :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (_hpos : A.energy ≠ 0)
      (R : SU7ProducedActiveCellA6SourceReadout Readout A),
        Nonempty
          (Sigma
            (fun N : SU7A6UnfilteredUnitDescentNeighbor R.source_label =>
              SU7A6FilteredCompletionRealizesNeighbor Readout A R N))

/-- Endpoint-code form of the readout/completion law.

This is the current finite-grammar target below filtered completion: the
grammar must supply faithful A6 source readout and completed endpoint-code room
for the unfiltered A6 lower neighbor. -/
structure SU7A6SignedHeightEndpointCodeCompletionLaw
    (Readout : SU7A6SourceReadoutFrame)
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat) : Prop where
  source_readout :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound),
      A.energy ≠ 0 ->
        Nonempty (SU7ProducedActiveCellA6SourceReadout Readout A)
  endpoint_completion :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (_hpos : A.energy ≠ 0)
      (R : SU7ProducedActiveCellA6SourceReadout Readout A),
        Nonempty
          (Sigma
            (fun N : SU7A6UnfilteredUnitDescentNeighbor R.source_label =>
              SU7A6EndpointCodeCompletionRealizesNeighbor Readout A R N))

/-- Computed-endpoint-room form of the completion law.

This is narrower than `SU7A6SignedHeightEndpointCodeCompletionLaw`: the
completed room is not supplied by a field, but computed from the lower
endpoint-code readout itself. -/
structure SU7A6SignedHeightComputedEndpointCompletionLaw
    (Readout : SU7A6SourceReadoutFrame)
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat) : Prop where
  source_readout :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound),
      A.energy ≠ 0 ->
        Nonempty (SU7ProducedActiveCellA6SourceReadout Readout A)
  computed_endpoint_completion :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (_hpos : A.energy ≠ 0)
      (R : SU7ProducedActiveCellA6SourceReadout Readout A),
        ∃ N : SU7A6UnfilteredUnitDescentNeighbor R.source_label,
          SU7A6ComputedEndpointCodeCompletionRealizesNeighbor
            Readout A R N

/-- Computed-endpoint core law with global root-sector preservation.

This is the narrower upstream target after factoring: the per-neighbor finite
core supplies endpoint-code checks and the height readout, while branch and
incidence preservation are generated once by the global A6 readout/root
sector-preservation law. -/
structure SU7A6SignedHeightComputedEndpointCoreLaw
    (Readout : SU7A6SourceReadoutFrame)
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat) : Prop where
  source_readout :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound),
      A.energy ≠ 0 ->
        Nonempty (SU7ProducedActiveCellA6SourceReadout Readout A)
  root_sector_preservation :
    SU7A6ReadoutRootSectorPreservationLaw Readout
  computed_endpoint_core :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (_hpos : A.energy ≠ 0)
      (R : SU7ProducedActiveCellA6SourceReadout Readout A),
        ∃ N : SU7A6UnfilteredUnitDescentNeighbor R.source_label,
          SU7A6ComputedEndpointCodeCompletionCore Readout A R N

/-- Rooted-source computed endpoint core law.

This is stricter, and closer to a generated SU(7) grammar, than
`SU7A6SignedHeightComputedEndpointCoreLaw`: the grammar chooses the faithful
source A6 readout and the simple root used for repair.  The remaining hard
field is then only the finite endpoint core for that concrete Cartan-lowered
neighbor. -/
structure SU7A6SignedHeightRootedSourceComputedEndpointCoreLaw
    (Readout : SU7A6SourceReadoutFrame)
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat) where
  source_readout :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound),
      A.energy ≠ 0 ->
        SU7ProducedActiveCellA6SourceReadout Readout A
  root_sector_preservation :
    SU7A6ReadoutRootSectorPreservationLaw Readout
  repair_root :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound),
      A.energy ≠ 0 -> Fin 6
  computed_endpoint_core :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
        SU7A6ComputedEndpointCodeCompletionCore Readout A
          (source_readout A hpos)
          (su7A6UnfilteredUnitDescentNeighborAt
            (source_readout A hpos).source_label
            (repair_root A hpos))

/-- Active-sector rooted endpoint-core law.

This removes `root_sector_preservation` from the producer payload for the
canonical active sector.  The grammar still has to generate endpoint readout,
the repair root, and the finite endpoint core for the concrete lowered
neighbor; branch/incidence preservation is now a theorem of the active-sector
readout frame. -/
structure SU7A6SignedHeightActiveSectorRootedEndpointCoreLaw
    (leftCodeOf rightCodeOf : SU7A6WeightLabel -> Nat)
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat) where
  source_readout :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound),
      A.energy ≠ 0 ->
        SU7ProducedActiveCellA6EndpointSourceReadout
          leftCodeOf rightCodeOf A
  repair_root :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound),
      A.energy ≠ 0 -> Fin 6
  computed_endpoint_core :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
        SU7A6ComputedEndpointCodeCompletionCore
          (SU7A6ActiveSectorReadoutFrame leftCodeOf rightCodeOf) A
          ((source_readout A hpos).toSourceReadout)
          (su7A6UnfilteredUnitDescentNeighborAt
            (source_readout A hpos).source_label
            (repair_root A hpos))

/-- Active-sector endpoint-grammar law.

Compared with `SU7A6SignedHeightActiveSectorRootedEndpointCoreLaw`, this does
not choose `repair_root` from the whole produced cell.  The root is generated
by the endpoint grammar's selector from the source A6 label and its positive
signed height. -/
structure SU7A6SignedHeightActiveSectorEndpointGrammarLaw
    (G : SU7A6ActiveSectorEndpointGrammar)
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat) where
  source_readout :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound),
      A.energy ≠ 0 ->
        SU7ProducedActiveCellA6EndpointSourceReadout
          G.leftCodeOf G.rightCodeOf A
  computed_endpoint_core :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
        SU7A6ComputedEndpointCodeCompletionCore G.readoutFrame A
          ((source_readout A hpos).toSourceReadout)
          (su7A6UnfilteredUnitDescentNeighborAt
            (source_readout A hpos).source_label
            (G.repairRootOf
              (source_readout A hpos).source_label
              ((source_readout A hpos).source_signedHeight_pos hpos)))

/-- Active-sector generated-source endpoint-grammar law.

This is narrower than `SU7A6SignedHeightActiveSectorEndpointGrammarLaw`: it
does not receive a ready-made endpoint source readout.  Instead, the grammar
provides a source A6 label generator and proofs that this generated label reads
the produced source endpoint codes and signed-height residual. -/
structure SU7A6SignedHeightActiveSectorGeneratedSourceEndpointGrammarLaw
    (G : SU7A6ActiveSectorEndpointGrammar)
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat) where
  sourceLabelOf :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound),
      A.energy ≠ 0 -> SU7A6WeightLabel
  left_code_reads_source :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
        G.leftCodeOf (sourceLabelOf A hpos) =
          A.sourceCell.cell.leftWeightCode
  right_code_reads_source :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
        G.rightCodeOf (sourceLabelOf A hpos) =
          A.sourceCell.cell.rightWeightCode
  source_height_reads_energy :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
        su7A6SignedHeight (sourceLabelOf A hpos) =
          (A.energy : Int)
  computed_endpoint_core :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
        SU7A6ComputedEndpointCodeCompletionCore G.readoutFrame A
          ({ source_label := sourceLabelOf A hpos
             left_code_reads_source := left_code_reads_source A hpos
             right_code_reads_source := right_code_reads_source A hpos
             source_height_reads_energy :=
               source_height_reads_energy A hpos } :
            SU7ProducedActiveCellA6EndpointSourceReadout
              G.leftCodeOf G.rightCodeOf A).toSourceReadout
          (su7A6UnfilteredUnitDescentNeighborAt
            (sourceLabelOf A hpos)
            (G.repairRootOf
              (sourceLabelOf A hpos)
              (su7A6SignedHeight_pos_of_nat_readout
                (source_height_reads_energy A hpos) hpos)))

/-- Concrete endpoint/source grammar law.

This fixes the source-label generator to `su7A6ConcreteEndpointSourceLabelOf`
and the endpoint grammar to `su7A6ConcreteEndpointSourceGrammar`.  The only
remaining premise is the finite endpoint core for the concrete lowered
neighbor. -/
structure SU7A6SignedHeightConcreteEndpointSourceGrammarLaw
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : Nat) where
  computed_endpoint_core :
    ∀ (A : SU7ProducedActiveCell σ hσ n bound)
      (hpos : A.energy ≠ 0),
        SU7A6ComputedEndpointCodeCompletionCore
          su7A6ConcreteEndpointSourceGrammar.readoutFrame A
          (su7A6ConcreteEndpointSourceReadout A).toSourceReadout
          (su7A6UnfilteredUnitDescentNeighborAt
            (su7A6ConcreteEndpointSourceLabelOf A)
            (su7A6ConcreteEndpointSourceGrammar.repairRootOf
              (su7A6ConcreteEndpointSourceLabelOf A)
              ((su7A6ConcreteEndpointSourceReadout A).source_signedHeight_pos
                hpos)))

/-- The computed endpoint finite core plus global root-sector preservation
reconstructs the previous computed-endpoint completion law. -/
theorem SU7A6SignedHeightComputedEndpointCoreLaw.toComputedEndpointCompletionLaw
    {Readout : SU7A6SourceReadoutFrame}
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (L : SU7A6SignedHeightComputedEndpointCoreLaw
      Readout σ hσ n bound) :
    SU7A6SignedHeightComputedEndpointCompletionLaw
      Readout σ hσ n bound := by
  refine ⟨L.source_readout, ?_⟩
  intro A hpos R
  rcases L.computed_endpoint_core A hpos R with ⟨N, C⟩
  exact
    ⟨N,
      C.toComputedEndpointCodeCompletionRealizesNeighbor
        L.root_sector_preservation⟩

/-- Active-sector rooted endpoint core lowers to the rooted-source computed
endpoint core law. -/
def SU7A6SignedHeightActiveSectorRootedEndpointCoreLaw.toRootedSourceComputedEndpointCoreLaw
    {leftCodeOf rightCodeOf : SU7A6WeightLabel -> Nat}
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (L : SU7A6SignedHeightActiveSectorRootedEndpointCoreLaw
      leftCodeOf rightCodeOf σ hσ n bound) :
    SU7A6SignedHeightRootedSourceComputedEndpointCoreLaw
      (SU7A6ActiveSectorReadoutFrame leftCodeOf rightCodeOf)
      σ hσ n bound where
  source_readout := fun A hpos =>
    (L.source_readout A hpos).toSourceReadout
  root_sector_preservation :=
    su7A6ActiveSector_readoutRootSectorPreservationLaw
      leftCodeOf rightCodeOf
  repair_root := L.repair_root
  computed_endpoint_core := by
    intro A hpos
    exact L.computed_endpoint_core A hpos

/-- Endpoint-grammar law lowers to active-sector rooted endpoint-core law. -/
def SU7A6SignedHeightActiveSectorEndpointGrammarLaw.toActiveSectorRootedEndpointCoreLaw
    {G : SU7A6ActiveSectorEndpointGrammar}
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (L : SU7A6SignedHeightActiveSectorEndpointGrammarLaw
      G σ hσ n bound) :
    SU7A6SignedHeightActiveSectorRootedEndpointCoreLaw
      G.leftCodeOf G.rightCodeOf σ hσ n bound where
  source_readout := L.source_readout
  repair_root := fun A hpos =>
    let R := L.source_readout A hpos
    G.repairRootOf R.source_label (R.source_signedHeight_pos hpos)
  computed_endpoint_core := by
    intro A hpos
    let R := L.source_readout A hpos
    let hheight := R.source_signedHeight_pos hpos
    let root := G.repairRootOf R.source_label hheight
    simpa [R, hheight, root, SU7A6ActiveSectorEndpointGrammar.readoutFrame]
      using L.computed_endpoint_core A hpos

/-- Generated-source endpoint-grammar law lowers to endpoint-grammar law. -/
def SU7A6SignedHeightActiveSectorGeneratedSourceEndpointGrammarLaw.toEndpointGrammarLaw
    {G : SU7A6ActiveSectorEndpointGrammar}
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (L : SU7A6SignedHeightActiveSectorGeneratedSourceEndpointGrammarLaw
      G σ hσ n bound) :
    SU7A6SignedHeightActiveSectorEndpointGrammarLaw
      G σ hσ n bound where
  source_readout := fun A hpos =>
    { source_label := L.sourceLabelOf A hpos
      left_code_reads_source := L.left_code_reads_source A hpos
      right_code_reads_source := L.right_code_reads_source A hpos
      source_height_reads_energy := L.source_height_reads_energy A hpos }
  computed_endpoint_core := by
    intro A hpos
    simpa [SU7A6ActiveSectorEndpointGrammar.readoutFrame]
      using L.computed_endpoint_core A hpos

/-- Concrete endpoint/source grammar law lowers to generated-source endpoint
grammar law. -/
def SU7A6SignedHeightConcreteEndpointSourceGrammarLaw.toGeneratedSourceEndpointGrammarLaw
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (L : SU7A6SignedHeightConcreteEndpointSourceGrammarLaw
      σ hσ n bound) :
    SU7A6SignedHeightActiveSectorGeneratedSourceEndpointGrammarLaw
      su7A6ConcreteEndpointSourceGrammar σ hσ n bound where
  sourceLabelOf := fun A _hpos => su7A6ConcreteEndpointSourceLabelOf A
  left_code_reads_source := fun A _hpos =>
    su7A6ConcreteEndpointSourceLabel_leftCode A
  right_code_reads_source := fun A _hpos =>
    su7A6ConcreteEndpointSourceLabel_rightCode A
  source_height_reads_energy := fun A _hpos =>
    su7A6ConcreteEndpointSourceLabel_signedHeight A
  computed_endpoint_core := by
    intro A hpos
    simpa [su7A6ConcreteEndpointSourceReadout]
      using L.computed_endpoint_core A hpos

/-- Endpoint projection for the concrete grammar-selected lowered neighbor
supplies the concrete endpoint/source grammar law.

This is the current finite-filter producer gate in its narrowest form: the
simple-root grammar already selects the lowered A6 neighbor and supplies unit
signed-height descent; the remaining source theorem must prove that this same
target is endpoint-shaped and survives the Boolean no-prime endpoint filter. -/
theorem SU7A6SignedHeightConcreteEndpointSourceGrammarLaw.of_endpointProjectionCore
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : Nat}
    (H :
      ∀ (A : SU7ProducedActiveCell σ hσ n bound)
        (hpos : A.energy ≠ 0),
        let R0 := su7A6ConcreteEndpointSourceReadout A
        let hheight := R0.source_signedHeight_pos hpos
        let N :=
          su7A6UnfilteredUnitDescentNeighborAt R0.source_label
            (su7A6ConcreteEndpointSourceGrammar.repairRootOf
              R0.source_label hheight)
        SU7A6EndpointProjectionCore n N.target) :
    SU7A6SignedHeightConcreteEndpointSourceGrammarLaw σ hσ n bound where
