  · rcases hcodes with ⟨hleft, hright⟩
    have hraw_211 : rawCodePairResidualEnergy 10 2 11 = 7 := by
      simpa [left, right, hleft, hright] using hraw
    rw [C.target_endpoint_shape]
    simp [left, right, hleft, hright, hraw_211,
      su7A6FiveSevenCompletedRepairLabel]
  · rcases hcodes with ⟨hleft, hright⟩
    have hraw_112 : rawCodePairResidualEnergy 10 11 2 = 7 := by
      simpa [left, right, hleft, hright] using hraw
    have htarget :
        target = su7A6EndpointSourceLabel 11 2 7 := by
      rw [C.target_endpoint_shape]
      simp [left, right, hleft, hright, hraw_112]
    rw [htarget] at hshift
    rw [su7A6FiveSevenMirrorRepairLabel_canonicalCenterShift] at hshift
    norm_num at hshift

/-- Any filtered endpoint-projection unit successor of the `(5,7,E=8)` source
must use the center-cover coordinate.

The finite endpoint core and one-unit signed-height descent force the target
codes to be `(2,11)` or `(11,2)`.  Their center/root-index differences are
`-29` and `16`, respectively, neither divisible by the A6 Cartan index `7`.
