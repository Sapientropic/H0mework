/-- Concrete endpoint/source target readout supplies the finite computed
endpoint core for a unit center-cover neighbor.

This is still upstream of repair-cell generation.  The grammar must prove that
its unit center-cover target is the concrete endpoint/source label and must
prove the three arithmetic readout facts for that label. -/
theorem of_concreteEndpointSourceLabel_target
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : Nat}
    {A : SU7ProducedActiveCell σ hσ n bound}
    {R :
      SU7ProducedActiveCellA6SourceReadout
        su7A6ConcreteEndpointSourceGrammar.readoutFrame A}
    {N : SU7A6UnitCenterCoverDescentNeighbor R.source_label}
    {left right energy : Nat}
    (htarget :
      N.target = su7A6EndpointSourceLabel left right energy)
    (hleft : natMultiplicativelyAtomicCheck left = true)
    (hright : natMultiplicativelyAtomicCheck right = true)
    (henergy : rawCodePairResidualEnergy n left right = energy) :
    SU7A6UnitCenterCoverComputedEndpointCodeCompletionCore
      su7A6ConcreteEndpointSourceGrammar.readoutFrame A R N := by
  have H :=
    su7A6EndpointSourceLabel_endpoint_core
      (n := n) (left := left) (right := right) (energy := energy)
      hleft hright henergy
  refine ⟨?_, ?_, ?_⟩
  ·
    simpa [htarget, SU7A6ActiveSectorEndpointGrammar.readoutFrame,
      SU7A6ActiveSectorReadoutFrame, su7A6ConcreteEndpointSourceGrammar]
      using H.1
  ·
    simpa [htarget, SU7A6ActiveSectorEndpointGrammar.readoutFrame,
      SU7A6ActiveSectorReadoutFrame, su7A6ConcreteEndpointSourceGrammar]
      using H.2.1
  ·
    simpa [htarget, SU7A6ActiveSectorEndpointGrammar.readoutFrame,
      SU7A6ActiveSectorReadoutFrame, su7A6ConcreteEndpointSourceGrammar]
      using H.2.2

/-- The finite endpoint core turns a unit center-cover neighbor into an exact
raw endpoint-residual unit successor.

This is the local filtered-readout gate: before constructing any generated
repair cell, the finite core already proves that the projected endpoint
residual is exactly one below the produced active source energy. -/
theorem raw_endpoint_energy_unit
    (X : SU7A6UnitCenterCoverComputedEndpointCodeCompletionCore
      Readout A R N) :
    rawCodePairResidualEnergy n
        (Readout.leftCodeOf N.target)
        (Readout.rightCodeOf N.target) + 1 =
      A.energy := by
  have hint :
      (rawCodePairResidualEnergy n
          (Readout.leftCodeOf N.target)
          (Readout.rightCodeOf N.target) : Int) + 1 =
        (A.energy : Int) := by
    rw [← X.repair_height_reads_endpoint]
    rw [N.signedHeight_unit]
    exact R.source_height_reads_energy
  exact_mod_cast hint

