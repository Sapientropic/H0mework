/-- The concrete endpoint-source target law generates the pointwise
source-label projection-core law.

This lowers the newest producer mouth to the concrete target data:
endpoint/source target label, unit center-cover displacement, atomic endpoint
checks, and raw residual readout. -/
def toGeneratedSourceLabelUnitCenterCoverProjectionCoreLaw
    (L :
      SU7A6SignedHeightConcreteUnitCenterCoverEndpointTargetLaw
        σ hσ n bound) :
    SU7A6GeneratedSourceLabelUnitCenterCoverProjectionCoreLaw
      σ hσ n bound where
  targetLabel := fun source hheight =>
    su7A6EndpointSourceLabel
      (L.targetLeft source hheight)
      (L.targetRight source hheight)
      (L.targetEnergy source hheight)
  source_target_core := by
    intro A hpos
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    refine
      { unit_center_cover_move :=
          L.unit_center_cover_move R0.source_label hheight
        endpoint_projection_core := ?_ }
    refine
      { target_endpoint_shape := ?_
        left_check := ?_
        right_check := ?_ }
    ·
      have henergy := L.raw_energy_reads_target A hpos
      simp [su7A6ConcreteEndpointSourceReadout,
        su7A6ConcreteEndpointSourceGrammar,
        su7A6EndpointSourceLabel_leftCode,
        su7A6EndpointSourceLabel_rightCode, henergy]
    ·
      simpa [R0, hheight, su7A6ConcreteEndpointSourceGrammar,
        su7A6EndpointSourceLabel_leftCode] using
        L.left_check R0.source_label hheight
    ·
      simpa [R0, hheight, su7A6ConcreteEndpointSourceGrammar,
        su7A6EndpointSourceLabel_rightCode] using
        L.right_check R0.source_label hheight

end SU7A6SignedHeightConcreteUnitCenterCoverEndpointTargetLaw

