  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  simpa [R0, hheight] using
    (L.source_target_core A hpos).endpointCode_atomic_rawUnit

/-- The Boolean raw cell derived from a generated source/projection core reads
exactly one residual unit below the source signed-height. -/
