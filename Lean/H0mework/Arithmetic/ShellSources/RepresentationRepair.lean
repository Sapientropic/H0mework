          (raw : Int) = su7A6SignedHeight R0.source_label - 1 := by
        rw [R0.source_height_reads_energy]
        have hcast : ((raw + 1 : Nat) : Int) = (A.energy : Int) := by
          exact_mod_cast hrawUnit
        omega
