      su7A6SourceOrientedEndpointTargetLeft 10 source = 4 ∧
      su7A6SourceOrientedEndpointTargetRight 10 source = 9 ∧
      natMultiplicativelyAtomicCheck
        (su7A6SourceOrientedEndpointTargetLeft 10 source) = false ∧
