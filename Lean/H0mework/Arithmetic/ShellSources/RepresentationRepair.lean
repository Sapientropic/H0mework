/-- Representation unit quantization plus endpoint-shape faithfulness derives
the raw code-pair `E - 1` readout for generated source labels. -/
theorem raw_unit_reads_sourceSignedHeight
    (L :
      SU7A6GeneratedSourceLabelUnitCenterCoverEndpointTargetLaw
        σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    let target := L.targetLabel R0.source_label hheight
    ((rawCodePairResidualEnergy n
        (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
        (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target) + 1 :
          Nat) : Int) =
      su7A6SignedHeight R0.source_label := by
  dsimp
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  let target := L.targetLabel R0.source_label hheight
  let left := su7A6ConcreteEndpointSourceGrammar.leftCodeOf target
  let right := su7A6ConcreteEndpointSourceGrammar.rightCodeOf target
  let raw := rawCodePairResidualEnergy n left right
  have Hshape :
      target =
        su7A6EndpointSourceLabel left right raw := by
    simpa [R0, hheight, target, left, right, raw] using
      L.target_endpoint_shape A hpos
  have Htarget :
      su7A6SignedHeight target = (raw : Int) := by
    rw [Hshape, su7A6EndpointSourceLabel_signedHeight]
  have Hmove :
      su7A6SignedHeight target + 1 =
        su7A6SignedHeight R0.source_label := by
    simpa [R0, hheight, target] using
      (L.unit_center_cover_move A hpos).signedHeight_unit_decrement
  calc
    ((raw + 1 : Nat) : Int) = (raw : Int) + 1 := by norm_num
    _ = su7A6SignedHeight target + 1 := by rw [← Htarget]
    _ = su7A6SignedHeight R0.source_label := Hmove

/-- Nat residual-code form of the endpoint-target raw-unit readout.

This is the source/phase version closest to the representation move: the unit
center-cover displacement and endpoint-shape faithfulness first produce the
integer signed-height raw-unit equation, and the positive source state then
reads that equation in the Nat residual-code coordinate. -/
theorem raw_unit_reads_sourceSignedHeightNat
    (L :
      SU7A6GeneratedSourceLabelUnitCenterCoverEndpointTargetLaw
        σ hσ n bound)
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    let R0 := su7A6ConcreteEndpointSourceReadout A
    let hheight := R0.source_signedHeight_pos hpos
    let target := L.targetLabel R0.source_label hheight
    rawCodePairResidualEnergy n
        (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
        (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target) + 1 =
      su7A6SignedHeightNat R0.source_label := by
  let R0 := su7A6ConcreteEndpointSourceReadout A
  let hheight := R0.source_signedHeight_pos hpos
  let target := L.targetLabel R0.source_label hheight
  let raw :=
    rawCodePairResidualEnergy n
      (su7A6ConcreteEndpointSourceGrammar.leftCodeOf target)
      (su7A6ConcreteEndpointSourceGrammar.rightCodeOf target)
  have H :
      ((raw + 1 : Nat) : Int) =
        su7A6SignedHeight R0.source_label := by
    simpa [R0, hheight, target, raw] using
      L.raw_unit_reads_sourceSignedHeight A hpos
  have hnonneg : 0 ≤ su7A6SignedHeight R0.source_label :=
    le_of_lt hheight
  unfold su7A6SignedHeightNat
  have htarget_cast :
      (((su7A6SignedHeight R0.source_label).toNat : Nat) : Int) =
        su7A6SignedHeight R0.source_label :=
    Int.toNat_of_nonneg hnonneg
  have hcast :
      ((raw + 1 : Nat) : Int) =
        ((su7A6SignedHeight R0.source_label).toNat : Nat) := by
    rw [htarget_cast]
    exact H
  exact_mod_cast hcast

/-- A generated source-label unit center-cover endpoint target law lowers to the
generated endpoint-code target law. -/
