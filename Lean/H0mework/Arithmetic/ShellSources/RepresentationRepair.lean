      su7A6CenterCoverShiftOfDisplacement
        (su7A6ConcreteEndpointSourceReadout A).source_label
        (L.targetLabel A hpos) = -19) :
    (L.targetCell A hpos).cell.leftWeightCode = 2 ∧
      (L.targetCell A hpos).cell.rightWeightCode = 5 := by
  have hlabel :=
    L.p948_targetLabel_eq_completedRepairLabel_of_canonicalCenterShift_neg19
      A hleft hright hpos hshift
  constructor
  ·
    have h :=
      congrArg su7A6EndpointSourceLeftCodeOf hlabel
    simpa [targetLabel, su7A6P948CompletedRepairLabel,
      su7A6EndpointSourceLabel_leftCode] using h
  ·
    have h :=
      congrArg su7A6EndpointSourceRightCodeOf hlabel
    simpa [targetLabel, su7A6P948CompletedRepairLabel,
      su7A6EndpointSourceLabel_rightCode] using h

/-- Canonical `-19` center disposition fixes the P948 completed endpoint room
to bound `5`.

The room is still computed from the generated target codes; it is not supplied
