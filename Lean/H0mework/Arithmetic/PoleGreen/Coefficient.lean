import H0mework.Arithmetic.PoleGreen.Kernel

/-!
# The centered quadratic coefficient of the pole Green kernel

The source normalization is the Helmholtz spectral polynomial centered at
the quarter line.  Conjugate--Tate reversal negates and conjugates the
centered parameter, so both faces are generated by the same real quadratic.
-/

set_option autoImplicit false

namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace NoIslandNoMagic.CanonicalRiemann

open Complex

noncomputable section

def clozelPoleCenteredParameter (z : ℂ) : ℂ :=
  z - 1 / 4

def clozelPoleGreenQuadratic (z : ℂ) : ℂ :=
  1 / 8 - 2 * clozelPoleCenteredParameter z ^ 2

theorem sourceModifiedUnitCoefficient_eq_greenQuadratic (z : ℂ) :
    sourceModifiedUnitCoefficient z = clozelPoleGreenQuadratic z := by
  simp only [sourceModifiedUnitCoefficient, clozelPoleGreenQuadratic,
    clozelPoleCenteredParameter]
  ring

theorem clozelPoleCenteredParameter_conjugateTate (z : ℂ) :
    clozelPoleCenteredParameter ((1 / 2 : ℂ) - star z) =
      -star (clozelPoleCenteredParameter z) := by
  simp [clozelPoleCenteredParameter]
  ring

theorem clozelPoleGreenQuadratic_conjugateTate (z : ℂ) :
    clozelPoleGreenQuadratic ((1 / 2 : ℂ) - star z) =
      star (clozelPoleGreenQuadratic z) := by
  rw [clozelPoleGreenQuadratic, clozelPoleGreenQuadratic,
    clozelPoleCenteredParameter_conjugateTate]
  simp

theorem sourceModifiedUnitCoefficient_conjugateTate_greenQuadratic
    (z : ℂ) :
    sourceModifiedUnitCoefficient ((1 / 2 : ℂ) - star z) =
      star (sourceModifiedUnitCoefficient z) := by
  rw [sourceModifiedUnitCoefficient_eq_greenQuadratic,
    sourceModifiedUnitCoefficient_eq_greenQuadratic,
    clozelPoleGreenQuadratic_conjugateTate]

end
end NoIslandNoMagic.CanonicalRiemann
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
