import H0mework.Arithmetic.PrimeShadow.P625
import H0mework.Realization.Residual.P745

/-!
# Proposition 746: prime-indexed shadow realization in the Euler pullback

P518 says a non-tautological prime shadow must at least inject the prime
exponents into the common shadow.  This file moves that gate one step closer to
the actual Euler-coupled carrier.

A prime-indexed realization is not only an injection

`PrimeExponent -> PrimeShadow`.

It also supplies, for every prime exponent, an arithmetic half-sigma point and
an H1-spectral point whose shadows are that same prime code.  P324's pullback
carrier then contains a canonical point for each prime exponent, and Lean
proves those prime carrier points are injective.

This is the non-tautological support that the mathematical holy-grail bridge
has to carry before any Goldbach/H1 synchronization can become a genuine
descent theorem rather than a truth-value restatement.
-/

noncomputable section

namespace SaturationMonoid
namespace AffineRelaxation

/-! ## Prime arithmetic support at the self-dual sigma point -/

/-- The half-sigma arithmetic point generated by a prime exponent. -/
def halfSigmaPrimeArithmeticImage (p : PrimeExponent) :
    HalfSigmaArithmeticImage :=
  SigmaExponentImage.ofNat (1 / 2 : ℝ) p.1

/-- THEOREM 1: the chosen exponent of the prime arithmetic image is the prime
exponent itself. -/
theorem halfSigmaPrimeArithmeticImage_exponent
    (p : PrimeExponent) :
    SigmaExponentImage.exponent (halfSigmaPrimeArithmeticImage p) = p.1 :=
  SigmaExponentImage.exponent_ofNat_of_mem_Ioo
    halfSigma_mem_Ioo.1 halfSigma_mem_Ioo.2 p.1

/-! ## Realizing prime codes on both sides of the Euler pullback -/

/-- A structured bridge whose prime codes are actually realized by arithmetic
and H1-spectral points, not merely injected into an abstract shadow type. -/
structure PrimeIndexedShadowRealization
    (P : EulerPrimeCouplingProducers) where
  structured : StructuredConcreteAdmissiblePrimeShadowBridge P
  spectralPrime : PrimeExponent -> H1SpectralProjection (1 / 2 : ℝ)
  arithmetic_prime_shadow :
    ∀ p : PrimeExponent,
      P.arithmeticShadow (halfSigmaPrimeArithmeticImage p) =
        structured.prime_indexed.primeCode p
  spectral_prime_shadow :
    ∀ p : PrimeExponent,
      P.spectralShadow (spectralPrime p) =
        structured.prime_indexed.primeCode p

namespace PrimeIndexedShadowRealization

/-- Forgetting realization data leaves the P518 structured bridge. -/
def toStructured {P : EulerPrimeCouplingProducers}
    (B : PrimeIndexedShadowRealization P) :
    StructuredConcreteAdmissiblePrimeShadowBridge P :=
  B.structured

/-- Forgetting further leaves the P325 concrete admissible bridge. -/
def toConcrete {P : EulerPrimeCouplingProducers}
    (B : PrimeIndexedShadowRealization P) :
    ArithmeticAdmissibleSevenFacet.ConcreteAdmissiblePrimeShadowBridge P :=
  B.structured.toConcrete

/-- The canonical Euler-pullback carrier point indexed by a prime exponent. -/
def primeCarrierPoint {P : EulerPrimeCouplingProducers}
    (B : PrimeIndexedShadowRealization P) (p : PrimeExponent) :
    P.Carrier :=
  ⟨(halfSigmaPrimeArithmeticImage p, B.spectralPrime p), by
    rw [B.arithmetic_prime_shadow p, B.spectral_prime_shadow p]⟩

/-- THEOREM 2: the prime carrier point has the expected arithmetic projection.
-/
theorem primeCarrierPoint_arithmetic
    {P : EulerPrimeCouplingProducers}
    (B : PrimeIndexedShadowRealization P) (p : PrimeExponent) :
    EulerPrimeCouplingProducers.Carrier.arithmetic
        (B.primeCarrierPoint p) =
      halfSigmaPrimeArithmeticImage p :=
  rfl

/-- THEOREM 3: the prime carrier point has the expected H1-spectral projection.
-/
theorem primeCarrierPoint_spectral
    {P : EulerPrimeCouplingProducers}
    (B : PrimeIndexedShadowRealization P) (p : PrimeExponent) :
    EulerPrimeCouplingProducers.Carrier.spectral
        (B.primeCarrierPoint p) =
      B.spectralPrime p :=
  rfl

/-- THEOREM 4: the arithmetic shadow of the prime carrier point is the prime
code. -/
theorem primeCarrierPoint_arithmetic_shadow
    {P : EulerPrimeCouplingProducers}
    (B : PrimeIndexedShadowRealization P) (p : PrimeExponent) :
    P.arithmeticShadow
        (EulerPrimeCouplingProducers.Carrier.arithmetic
          (B.primeCarrierPoint p)) =
      B.structured.prime_indexed.primeCode p := by
  exact B.arithmetic_prime_shadow p

/-- THEOREM 5: the spectral shadow of the prime carrier point is the same prime
code. -/
theorem primeCarrierPoint_spectral_shadow
    {P : EulerPrimeCouplingProducers}
    (B : PrimeIndexedShadowRealization P) (p : PrimeExponent) :
    P.spectralShadow
        (EulerPrimeCouplingProducers.Carrier.spectral
          (B.primeCarrierPoint p)) =
      B.structured.prime_indexed.primeCode p := by
  exact B.spectral_prime_shadow p

/-- THEOREM 6: different prime exponents give different Euler-pullback carrier
points. -/
theorem primeCarrierPoint_injective
    {P : EulerPrimeCouplingProducers}
    (B : PrimeIndexedShadowRealization P) :
    Function.Injective B.primeCarrierPoint := by
  intro p q h
  apply B.structured.prime_indexed.primeCode_injective
  calc
    B.structured.prime_indexed.primeCode p =
        P.arithmeticShadow
          (EulerPrimeCouplingProducers.Carrier.arithmetic
            (B.primeCarrierPoint p)) := by
          exact (B.primeCarrierPoint_arithmetic_shadow p).symm
    _ =
        P.arithmeticShadow
          (EulerPrimeCouplingProducers.Carrier.arithmetic
            (B.primeCarrierPoint q)) := by
          rw [h]
    _ = B.structured.prime_indexed.primeCode q := by
          exact B.primeCarrierPoint_arithmetic_shadow q

/-- THEOREM 7: equivalently, unequal prime exponents remain unequal as
carrier points. -/
theorem primeCarrierPoint_ne_of_ne
    {P : EulerPrimeCouplingProducers}
    (B : PrimeIndexedShadowRealization P)
    {p q : PrimeExponent} (hpq : p ≠ q) :
    B.primeCarrierPoint p ≠ B.primeCarrierPoint q := by
  intro h
  exact hpq (B.primeCarrierPoint_injective h)

/-- THEOREM 8: a realization still gives the concrete Goldbach/H1
synchronization supplied by its concrete bridge. -/
theorem goldbach_iff_h1_no_obstruction
    {P : EulerPrimeCouplingProducers}
    (B : PrimeIndexedShadowRealization P)
    (x : ArithmeticAdmissibleSevenFacet) :
    HalfSigmaImageGoldbachComplete x.arithmetic ↔
      H1SpectralNoObstructionComplete x.spectral :=
  B.structured.goldbach_iff_h1_no_obstruction x

end PrimeIndexedShadowRealization

/-! ## Tautological shadows still cannot pass the realized gate -/

/-- THEOREM 9: the truth-value shadow cannot carry a prime-indexed realization.
-/
theorem truthValuePrimeShadowProducer_not_realized :
    Not
      (Nonempty
        (PrimeIndexedShadowRealization truthValuePrimeShadowProducer)) := by
  rintro ⟨B⟩
  exact truthValuePrimeShadowProducer_not_structuredBridge
    ⟨B.toStructured⟩

/-! ## Concrete nontriviality: the shadow really carries distinct primes -/

private theorem primeTwo_ne_primeThree_P746 : primeTwo ≠ primeThree := by
  intro h
  have hval :
      (primeTwo : PrimeExponent).1 = (primeThree : PrimeExponent).1 :=
    congrArg Subtype.val h
  norm_num [primeTwo, primeThree] at hval

private theorem primeTwo_ne_primeFive_P746 : primeTwo ≠ primeFive := by
  intro h
  have hval :
      (primeTwo : PrimeExponent).1 = (primeFive : PrimeExponent).1 :=
    congrArg Subtype.val h
  norm_num [primeTwo, primeFive] at hval

private theorem primeThree_ne_primeFive_P746 : primeThree ≠ primeFive := by
  intro h
  have hval :
      (primeThree : PrimeExponent).1 = (primeFive : PrimeExponent).1 :=
    congrArg Subtype.val h
  norm_num [primeThree, primeFive] at hval

/-- THEOREM 10: any prime-indexed shadow structure contains three distinct
prime codes.  This is the small but hard non-tautological witness: a `Prop`
shadow cannot do it, while coded descent can. -/
theorem primeIndexedShadowStructure_three_distinct_codes
    {P : EulerPrimeCouplingProducers}
    (S : PrimeIndexedShadowStructure P) :
    ∃ a b c : P.PrimeShadow, a ≠ b ∧ a ≠ c ∧ b ≠ c := by
  refine ⟨S.primeCode primeTwo, S.primeCode primeThree,
    S.primeCode primeFive, ?_, ?_, ?_⟩
  · intro h
    exact primeTwo_ne_primeThree_P746 (S.primeCode_injective h)
  · intro h
    exact primeTwo_ne_primeFive_P746 (S.primeCode_injective h)
  · intro h
    exact primeThree_ne_primeFive_P746 (S.primeCode_injective h)

/-- THEOREM 11: the canonical coded-descent producer has three distinct prime
codes for every spectral exponent adapter. -/
theorem codedDescentEulerPrimeCouplingProducer_three_distinct_prime_codes
    (A : SpectralExponentCodeAdapter) :
    ∃ a b c : (codedDescentEulerPrimeCouplingProducer A).PrimeShadow,
      a ≠ b ∧ a ≠ c ∧ b ≠ c :=
  primeIndexedShadowStructure_three_distinct_codes
    (codedDescentPrimeIndexedShadowStructure A)

/-! ## Packaged certificate -/

/-- P746 certificate for any realized prime-indexed Euler shadow. -/
structure PrimeIndexedShadowRealizationCertificate
    (P : EulerPrimeCouplingProducers)
    (B : PrimeIndexedShadowRealization P) where
  to_structured :
    StructuredConcreteAdmissiblePrimeShadowBridge P
  to_concrete :
    ArithmeticAdmissibleSevenFacet.ConcreteAdmissiblePrimeShadowBridge P
  prime_arithmetic_image :
    PrimeExponent -> HalfSigmaArithmeticImage
  prime_spectral_image :
    PrimeExponent -> H1SpectralProjection (1 / 2 : ℝ)
  prime_carrier_point :
    PrimeExponent -> P.Carrier
  prime_carrier_arithmetic :
    ∀ p : PrimeExponent,
      EulerPrimeCouplingProducers.Carrier.arithmetic
          (prime_carrier_point p) =
        prime_arithmetic_image p
  prime_carrier_spectral :
    ∀ p : PrimeExponent,
      EulerPrimeCouplingProducers.Carrier.spectral
          (prime_carrier_point p) =
        prime_spectral_image p
  prime_carrier_shadow :
    ∀ p : PrimeExponent,
      P.arithmeticShadow
          (EulerPrimeCouplingProducers.Carrier.arithmetic
            (prime_carrier_point p)) =
        P.spectralShadow
          (EulerPrimeCouplingProducers.Carrier.spectral
            (prime_carrier_point p))
  prime_carrier_injective :
    Function.Injective prime_carrier_point
  realization_syncs_goldbach_h1 :
    ∀ x : ArithmeticAdmissibleSevenFacet,
      HalfSigmaImageGoldbachComplete x.arithmetic ↔
        H1SpectralNoObstructionComplete x.spectral

/-- THEOREM 12: every prime-indexed realization gives an injective prime
support inside the Euler-coupled carrier. -/
def primeIndexedShadowRealizationCertificate
    {P : EulerPrimeCouplingProducers}
    (B : PrimeIndexedShadowRealization P) :
    PrimeIndexedShadowRealizationCertificate P B where
  to_structured := B.toStructured
  to_concrete := B.toConcrete
  prime_arithmetic_image := halfSigmaPrimeArithmeticImage
  prime_spectral_image := B.spectralPrime
  prime_carrier_point := B.primeCarrierPoint
  prime_carrier_arithmetic := by
    intro p
    exact B.primeCarrierPoint_arithmetic p
  prime_carrier_spectral := by
    intro p
    exact B.primeCarrierPoint_spectral p
  prime_carrier_shadow := by
    intro p
    exact EulerPrimeCouplingProducers.Carrier.shadow_agreement
      (B.primeCarrierPoint p)
  prime_carrier_injective :=
    B.primeCarrierPoint_injective
  realization_syncs_goldbach_h1 := by
    intro x
    exact B.goldbach_iff_h1_no_obstruction x

/-- P746 certificate for the concrete coded-descent prime-code
nontriviality. -/
structure CodedDescentPrimeCodeNontrivialityCertificate
    (A : SpectralExponentCodeAdapter) where
  structured :
    PrimeIndexedShadowStructure (codedDescentEulerPrimeCouplingProducer A)
  three_distinct_codes :
    ∃ a b c : (codedDescentEulerPrimeCouplingProducer A).PrimeShadow,
      a ≠ b ∧ a ≠ c ∧ b ≠ c

/-- THEOREM 12: coded descent discharges the nontrivial-prime-code producer
gate. -/
def codedDescentPrimeCodeNontrivialityCertificate
    (A : SpectralExponentCodeAdapter) :
    CodedDescentPrimeCodeNontrivialityCertificate A where
  structured := codedDescentPrimeIndexedShadowStructure A
  three_distinct_codes :=
    codedDescentEulerPrimeCouplingProducer_three_distinct_prime_codes A

end AffineRelaxation
end SaturationMonoid
