import Mathlib.LinearAlgebra.Finsupp.LSum
import H0mework.Realization.Topology.HilbertCokernelAction
import H0mework.Arithmetic.BurnolCarrier.CompactAnnulusFourierLanding

/-!
# Source-generated additive Burnol co-Poisson closed range

All compact-annulus co-Poisson landings and their ordinary Fourier siblings
generate one linear source map.  Its Hilbert closed range is the actual
`P_a` face available at the unscaled radius.  The source involution and
ordinary Fourier form an exact action square.
-/

set_option autoImplicit false

namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.BurnolPhysicalState

open SourceGeneratedHilbertCokernel

noncomputable section

def burnolCompactAdditivePhysicalState
    (source : burnolCompactAnnulusSource) :
    EvenBurnolPhysicalCarrier burnolUnscaledCommonGapRadius :=
  ⟨burnolCompactAdditiveL2 source,
    burnolCompactAdditiveL2_mem_evenBurnolClosedFace source⟩

abbrev BurnolCompactCoPoissonGeneratorIndex :=
  burnolCompactAnnulusSource × Fin 2

abbrev BurnolCompactCoPoissonLinearSource :=
  BurnolCompactCoPoissonGeneratorIndex →₀ ℂ

def burnolCompactCoPoissonGenerator
    (index : BurnolCompactCoPoissonGeneratorIndex) :
    EvenBurnolPhysicalCarrier burnolUnscaledCommonGapRadius :=
  if index.2 = 0 then burnolCompactAdditivePhysicalState index.1
  else evenFaceFourierEquiv burnolUnscaledCommonGapRadius
    (burnolCompactAdditivePhysicalState index.1)

def burnolCompactCoPoissonLanding :
    BurnolCompactCoPoissonLinearSource →ₗ[ℂ]
      EvenBurnolPhysicalCarrier burnolUnscaledCommonGapRadius :=
  Finsupp.lsum ℂ fun index =>
    LinearMap.toSpanSingleton ℂ _ (burnolCompactCoPoissonGenerator index)

@[simp] theorem burnolCompactCoPoissonLanding_single
    (index : BurnolCompactCoPoissonGeneratorIndex) (coefficient : ℂ) :
    burnolCompactCoPoissonLanding (Finsupp.single index coefficient) =
      coefficient • burnolCompactCoPoissonGenerator index := by
  simp [burnolCompactCoPoissonLanding]

def burnolCompactCoPoissonIndexFourier :
    BurnolCompactCoPoissonGeneratorIndex ≃
      BurnolCompactCoPoissonGeneratorIndex :=
  Equiv.prodCongr (Equiv.refl _) (Equiv.swap 0 1)

theorem burnolCompactCoPoissonIndexFourier_involutive
    (index : BurnolCompactCoPoissonGeneratorIndex) :
    burnolCompactCoPoissonIndexFourier
        (burnolCompactCoPoissonIndexFourier index) = index := by
  rcases index with ⟨source, parity⟩
  fin_cases parity <;> rfl

def burnolCompactCoPoissonSourceFourier :
    BurnolCompactCoPoissonLinearSource ≃ₗ[ℂ]
      BurnolCompactCoPoissonLinearSource :=
  Finsupp.domLCongr burnolCompactCoPoissonIndexFourier

theorem burnolCompactCoPoissonGenerator_fourier
    (index : BurnolCompactCoPoissonGeneratorIndex) :
    evenFaceFourierEquiv burnolUnscaledCommonGapRadius
        (burnolCompactCoPoissonGenerator index) =
      burnolCompactCoPoissonGenerator
        (burnolCompactCoPoissonIndexFourier index) := by
  rcases index with ⟨source, parity⟩
  fin_cases parity
  · rfl
  · simp only [burnolCompactCoPoissonGenerator, Fin.isValue,
      burnolCompactCoPoissonIndexFourier, Equiv.prodCongr_apply]
    exact evenFaceFourier_involutive burnolUnscaledCommonGapRadius
      (burnolCompactAdditivePhysicalState source)

theorem burnolCompactCoPoissonLanding_fourier
    (source : BurnolCompactCoPoissonLinearSource) :
    evenFaceFourierEquiv burnolUnscaledCommonGapRadius
        (burnolCompactCoPoissonLanding source) =
      burnolCompactCoPoissonLanding
        (burnolCompactCoPoissonSourceFourier source) := by
  induction source using Finsupp.induction_linear with
  | zero => simp
  | add left right leftLaw rightLaw =>
      simp only [map_add, leftLaw, rightLaw]
  | single index coefficient =>
      rw [burnolCompactCoPoissonLanding_single, map_smul,
        burnolCompactCoPoissonGenerator_fourier,
        burnolCompactCoPoissonSourceFourier, Finsupp.domLCongr_single,
        burnolCompactCoPoissonLanding_single]

def burnolCompactCoPoissonActionSquare :
    SourceGeneratedHilbertCokernel.ActionSquare
      burnolCompactCoPoissonLanding where
  sourceAction := burnolCompactCoPoissonSourceFourier
  targetAction := evenFaceFourierEquiv burnolUnscaledCommonGapRadius
  commutes := burnolCompactCoPoissonLanding_fourier

/-- The full closed range generated by every compact-annulus additive
co-Poisson landing and its Fourier sibling. -/
def burnolCompactCoPoissonClosedRange :
    ClosedSubmodule ℂ
      (EvenBurnolPhysicalCarrier burnolUnscaledCommonGapRadius) :=
  SourceGeneratedHilbertCokernel.closedRange burnolCompactCoPoissonLanding

theorem burnolCompactCoPoissonClosedRange_fourier_invariant :
    burnolCompactCoPoissonClosedRange.mapEquiv
        (evenFaceFourierEquiv burnolUnscaledCommonGapRadius).toContinuousLinearEquiv =
      burnolCompactCoPoissonClosedRange :=
  burnolCompactCoPoissonActionSquare.closedRange_invariant

theorem burnolCompactCoPoissonGenerator_mem_closedRange
    (index : BurnolCompactCoPoissonGeneratorIndex) :
    burnolCompactCoPoissonGenerator index ∈
      burnolCompactCoPoissonClosedRange := by
  apply (LinearMap.range burnolCompactCoPoissonLanding).le_topologicalClosure
  refine ⟨Finsupp.single index 1, ?_⟩
  simp

end
end NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.BurnolPhysicalState
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
