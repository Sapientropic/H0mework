import H0mework.Arithmetic.RiemannCharacter.ZeroRieszPrimeCurrentCoupling

/-!
# Full integral character generated by the same-zero Riesz pair

At a positive unit `a`, apply the actual Riesz dilation at scale `a²` and
remove the generated quarter-density weight.  The resulting source.2
readback is exactly `a⁻ˢ` (and its reversal partner).  Extending these basis
values linearly recovers the existing integral group-ring evaluations without
feeding a target character into the test section.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalRiemann
namespace Character
namespace GlobalCoPoissonCurrent

open CanonicalUnitArithmeticCoordinateProjectionObstruction
open SourceGeneratedIntegralCharacterGroupRing
open SourceGeneratedPositiveRealCharacter
open IntegralCharacterGroupRing
open ClozelGeneralizedDual
open ClozelGeneralizedDual.ThetaJRoleRepresentation

noncomputable section

def scaleSquare (scale : Units NNReal) : ℝ :=
  (scaleValue scale) ^ 2

theorem scaleSquare_pos (scale : Units NNReal) :
    0 < scaleSquare scale :=
  sq_pos_of_pos (scaleValue_pos scale)

/-- Half-density-removed selected Riesz readback at the squared scale. -/
def sourceSelectedRieszFullCharacterValue
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (source : ZeroOwnedCharacterMuntzCokernelPayload observation nontrivial)
    (scale : Units NNReal) : ℂ :=
  selectedNormalizedDilationTrace observation nontrivial source
    (scaleSquare scale) (scaleSquare_pos scale)

def sourceReversalRieszFullCharacterValue
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (source : ZeroOwnedCharacterMuntzCokernelPayload observation nontrivial)
    (scale : Units NNReal) : ℂ :=
  reversalNormalizedDilationTrace observation nontrivial source
    (scaleSquare scale) (scaleSquare_pos scale)

theorem occurrence_selectedFullCharacterValue_eq_sourceCharacter
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (scale : Units NNReal) :
    sourceSelectedRieszFullCharacterValue observation nontrivial
        (zeroOwnedCharacterMuntzCokernelOccurrence
          observation nontrivial).root scale =
      characterEvaluation
        (zeroOwnedCharacterMuntzCokernelOccurrence
          observation nontrivial).root.1.2.selected (delta scale) := by
  rw [sourceSelectedRieszFullCharacterValue,
    occurrence_selectedNormalizedDilationTrace_eq_character,
    characterEvaluation_delta]
  change (scaleSquare scale : ℂ) ^
      (-(observation.coordinate / 2)) =
    (scaleValue scale : ℂ) ^ (-observation.coordinate)
  exact positive_square_cpow_neg_half (scaleValue scale)
    (scaleValue_pos scale) observation.coordinate

theorem occurrence_reversalFullCharacterValue_eq_sourceCharacter
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (scale : Units NNReal) :
    sourceReversalRieszFullCharacterValue observation nontrivial
        (zeroOwnedCharacterMuntzCokernelOccurrence
          observation nontrivial).root scale =
      characterEvaluation
        (zeroOwnedCharacterMuntzCokernelOccurrence
          observation nontrivial).root.1.2.reversal (delta scale) := by
  rw [sourceReversalRieszFullCharacterValue,
    occurrence_reversalNormalizedDilationTrace_eq_character,
    characterEvaluation_delta]
  change (scaleSquare scale : ℂ) ^
      (-(coordinateReversal observation.coordinate / 2)) =
    (scaleValue scale : ℂ) ^
      (-coordinateReversal observation.coordinate)
  exact positive_square_cpow_neg_half (scaleValue scale)
    (scaleValue_pos scale) (coordinateReversal observation.coordinate)

/-- Integral-linear extension of the selected source.2 Riesz character. -/
def selectedRieszFullEvaluation
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    IntegralScaleCarrier →ₗ[ℤ] ℂ :=
  canonicalBasis.constr ℤ fun scale =>
    sourceSelectedRieszFullCharacterValue observation nontrivial
      (zeroOwnedCharacterMuntzCokernelOccurrence
        observation nontrivial).root scale

def reversalRieszFullEvaluation
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    IntegralScaleCarrier →ₗ[ℤ] ℂ :=
  canonicalBasis.constr ℤ fun scale =>
    sourceReversalRieszFullCharacterValue observation nontrivial
      (zeroOwnedCharacterMuntzCokernelOccurrence
        observation nontrivial).root scale

@[simp] theorem selectedRieszFullEvaluation_delta
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (scale : Units NNReal) :
    selectedRieszFullEvaluation observation nontrivial (delta scale) =
      sourceSelectedRieszFullCharacterValue observation nontrivial
        (zeroOwnedCharacterMuntzCokernelOccurrence
          observation nontrivial).root scale := by
  rw [← canonicalBasis_apply scale]
  exact canonicalBasis.constr_basis ℤ _ scale

@[simp] theorem reversalRieszFullEvaluation_delta
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (scale : Units NNReal) :
    reversalRieszFullEvaluation observation nontrivial (delta scale) =
      sourceReversalRieszFullCharacterValue observation nontrivial
        (zeroOwnedCharacterMuntzCokernelOccurrence
          observation nontrivial).root scale := by
  rw [← canonicalBasis_apply scale]
  exact canonicalBasis.constr_basis ℤ _ scale

theorem selectedRieszFullEvaluation_eq_sourceCharacter
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    selectedRieszFullEvaluation observation nontrivial =
      characterEvaluation
        (zeroOwnedCharacterMuntzCokernelOccurrence
          observation nontrivial).root.1.2.selected := by
  apply MonoidAlgebra.lhom_ext'
  intro scale
  apply LinearMap.ext
  intro coefficient
  simp only [LinearMap.comp_apply, MonoidAlgebra.lsingle_apply]
  rw [show MonoidAlgebra.single scale coefficient =
      coefficient • delta scale by simp [delta]]
  rw [map_smul, map_smul, selectedRieszFullEvaluation_delta,
    occurrence_selectedFullCharacterValue_eq_sourceCharacter]

theorem reversalRieszFullEvaluation_eq_sourceCharacter
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    reversalRieszFullEvaluation observation nontrivial =
      characterEvaluation
        (zeroOwnedCharacterMuntzCokernelOccurrence
          observation nontrivial).root.1.2.reversal := by
  apply MonoidAlgebra.lhom_ext'
  intro scale
  apply LinearMap.ext
  intro coefficient
  simp only [LinearMap.comp_apply, MonoidAlgebra.lsingle_apply]
  rw [show MonoidAlgebra.single scale coefficient =
      coefficient • delta scale by simp [delta]]
  rw [map_smul, map_smul, reversalRieszFullEvaluation_delta,
    occurrence_reversalFullCharacterValue_eq_sourceCharacter]

end

