import H0mework.Arithmetic.RiemannCharacter.ZeroMultiplicativeCharacterOccurrence
import H0mework.Arithmetic.Muntz.CoPoissonMuntzZeroAnnihilation
import H0mework.Arithmetic.MuntzAction.CoPoissonMuntzGraphCokernel

/-!
# Same-zero graph-cokernel and Riesz pair

The selected and reversal annihilation laws generated by one nontrivial zero
are consumed by the generic graph-cokernel.  Both canonical Riesz vectors are
nonzero, kill every actual Schwartz relation class, and are installed as a
dependent face of the already generated multiplicative-character occurrence.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalRiemann
namespace ClozelGeneralizedDual

open CanonicalUnitArithmeticCoordinateProjectionObstruction
open RootedAccountedUnfolding
open SourceGeneratedFunctionalGraphCokernel
open scoped InnerProductSpace

noncomputable section

def selectedCoPoissonMuntzParameter
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner) : ℂ :=
  observation.coordinate / 2

def reversalCoPoissonMuntzParameter
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner) : ℂ :=
  coordinateReversal observation.coordinate / 2

theorem selectedCoPoissonMuntzParameter_re_pos
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    0 < (selectedCoPoissonMuntzParameter observation).re := by
  exact selectedPositiveParameter_re_pos observation nontrivial

theorem selectedCoPoissonMuntzParameter_re_lt_half
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (_nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    (selectedCoPoissonMuntzParameter observation).re < (1 / 2 : ℝ) := by
  have strip := observation.coordinate_re_lt_one
  unfold selectedCoPoissonMuntzParameter
  rw [Complex.div_re]
  norm_num
  linarith

theorem reversalCoPoissonMuntzParameter_re_pos
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    0 < (reversalCoPoissonMuntzParameter observation).re := by
  exact reversalPositiveParameter_re_pos observation nontrivial

theorem reversalCoPoissonMuntzParameter_re_lt_half
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    (reversalCoPoissonMuntzParameter observation).re < (1 / 2 : ℝ) := by
  have strip :=
    observation.coordinate_mem_openCriticalStrip_of_nontrivial nontrivial
  unfold reversalCoPoissonMuntzParameter
  rw [Complex.div_re]
  norm_num
  simp [coordinateReversal]
  linarith

abbrev SelectedCoPoissonMuntzGraphCokernel
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :=
  CoPoissonMuntzGraphCokernel
    (selectedCoPoissonMuntzParameter observation)
    (selectedCoPoissonMuntzParameter_re_pos observation nontrivial)
    (selectedCoPoissonMuntzParameter_re_lt_half observation nontrivial)

abbrev ReversalCoPoissonMuntzGraphCokernel
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :=
  CoPoissonMuntzGraphCokernel
    (reversalCoPoissonMuntzParameter observation)
    (reversalCoPoissonMuntzParameter_re_pos observation nontrivial)
    (reversalCoPoissonMuntzParameter_re_lt_half observation nontrivial)

def selectedCoPoissonMuntzRieszVector
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    SelectedCoPoissonMuntzGraphCokernel observation nontrivial :=
  descendedRieszVector
    (quarterMellinL2Feature (selectedCoPoissonMuntzParameter observation))
    (quarterMellinL2Functional (selectedCoPoissonMuntzParameter observation))
    (coPoissonQuarterMellinConvergentMap
      (selectedCoPoissonMuntzParameter observation)
      (selectedCoPoissonMuntzParameter_re_pos observation nontrivial)
      (selectedCoPoissonMuntzParameter_re_lt_half observation nontrivial))
    (selectedZero_quarterMellinL2Functional_comp_coPoissonQuarterMellinConvergentMap_eq_zero
      observation nontrivial)

def reversalCoPoissonMuntzRieszVector
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    ReversalCoPoissonMuntzGraphCokernel observation nontrivial :=
  descendedRieszVector
    (quarterMellinL2Feature (reversalCoPoissonMuntzParameter observation))
    (quarterMellinL2Functional (reversalCoPoissonMuntzParameter observation))
    (coPoissonQuarterMellinConvergentMap
      (reversalCoPoissonMuntzParameter observation)
      (reversalCoPoissonMuntzParameter_re_pos observation nontrivial)
      (reversalCoPoissonMuntzParameter_re_lt_half observation nontrivial))
    (reversalZero_quarterMellinL2Functional_comp_coPoissonQuarterMellinConvergentMap_eq_zero
      observation nontrivial)

theorem selectedCoPoissonMuntzRieszVector_ne_zero
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    selectedCoPoissonMuntzRieszVector observation nontrivial ≠ 0 := by
  apply descendedRieszVector_ne_zero
  exact quarterMellinL2Functional_ne_zero _
    (selectedCoPoissonMuntzParameter_re_pos observation nontrivial)

theorem reversalCoPoissonMuntzRieszVector_ne_zero
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    reversalCoPoissonMuntzRieszVector observation nontrivial ≠ 0 := by
  apply descendedRieszVector_ne_zero
  exact quarterMellinL2Functional_ne_zero _
    (reversalCoPoissonMuntzParameter_re_pos observation nontrivial)

theorem selectedCoPoissonMuntzRieszVector_source_readback
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (value : QuarterMellinL2Test
      (selectedCoPoissonMuntzParameter observation)) :
    ⟪selectedCoPoissonMuntzRieszVector observation nontrivial,
      coPoissonMuntzGraphSourceMap
        (selectedCoPoissonMuntzParameter observation)
        (selectedCoPoissonMuntzParameter_re_pos observation nontrivial)
        (selectedCoPoissonMuntzParameter_re_lt_half observation nontrivial)
        value⟫_ℂ =
      quarterMellinL2Functional
        (selectedCoPoissonMuntzParameter observation) value := by
  exact descendedRieszVector_source_readback _ _ _ _ value

theorem reversalCoPoissonMuntzRieszVector_source_readback
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (value : QuarterMellinL2Test
      (reversalCoPoissonMuntzParameter observation)) :
    ⟪reversalCoPoissonMuntzRieszVector observation nontrivial,
      coPoissonMuntzGraphSourceMap
        (reversalCoPoissonMuntzParameter observation)
        (reversalCoPoissonMuntzParameter_re_pos observation nontrivial)
        (reversalCoPoissonMuntzParameter_re_lt_half observation nontrivial)
        value⟫_ℂ =
      quarterMellinL2Functional
        (reversalCoPoissonMuntzParameter observation) value := by
  exact descendedRieszVector_source_readback _ _ _ _ value

def zeroOwnedCoPoissonMuntzRieszPair
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :=
  (selectedCoPoissonMuntzRieszVector observation nontrivial,
    reversalCoPoissonMuntzRieszVector observation nontrivial)

abbrev ZeroOwnedCharacterMuntzCokernelPayload
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :=
  Σ _character : Character.ZeroMultiplicativeCharacterPayload,
    SelectedCoPoissonMuntzGraphCokernel observation nontrivial ×
      ReversalCoPoissonMuntzGraphCokernel observation nontrivial

/-- The nonzero Riesz pair remains a dependent face of the common
multiplicative-character occurrence. -/
def zeroOwnedCharacterMuntzCokernelOccurrence
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    RootedAccountedUnfolding
      (ZeroOwnedCharacterMuntzCokernelPayload observation nontrivial) :=
  (Character.zeroOwnedMultiplicativeCharacterOccurrence observation).map
    fun character =>
      ⟨character, zeroOwnedCoPoissonMuntzRieszPair observation nontrivial⟩

theorem zeroOwnedCharacterMuntzCokernelOccurrence_projects
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    (zeroOwnedCharacterMuntzCokernelOccurrence observation nontrivial).map
        Sigma.fst =
      Character.zeroOwnedMultiplicativeCharacterOccurrence observation := by
  rw [zeroOwnedCharacterMuntzCokernelOccurrence,
    RootedAccountedUnfolding.map_map]
  change (Character.zeroOwnedMultiplicativeCharacterOccurrence observation).map id = _
  exact RootedAccountedUnfolding.map_id _

theorem zeroOwnedCharacterMuntzCokernelOccurrence_projects_to_seed
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    ((((((zeroOwnedCharacterMuntzCokernelOccurrence observation nontrivial).map
        Sigma.fst).map Sigma.fst).map Sigma.fst).map Sigma.fst).map Prod.fst) =
      CanonicalUnitArithmeticFactorizationEulerDependentDiagram.seedOccurrence := by
  rw [zeroOwnedCharacterMuntzCokernelOccurrence_projects,
    Character.zeroOwnedMultiplicativeCharacterOccurrence_projects_to_seed]

theorem zeroOwnedCharacterMuntzCokernelOccurrence_selected_ne_zero
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    (zeroOwnedCharacterMuntzCokernelOccurrence observation nontrivial).root.2.1 ≠ 0 :=
  selectedCoPoissonMuntzRieszVector_ne_zero observation nontrivial

theorem zeroOwnedCharacterMuntzCokernelOccurrence_reversal_ne_zero
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    (zeroOwnedCharacterMuntzCokernelOccurrence observation nontrivial).root.2.2 ≠ 0 :=
  reversalCoPoissonMuntzRieszVector_ne_zero observation nontrivial

end

