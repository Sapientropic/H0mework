import H0mework.Arithmetic.CoPoisson.LogOrbit

/-!
# Actual co-Poisson translation carrier

The literal range of `coPoissonLogOrbitMap` is closed under the half-weighted
log translation induced by positive scaling of Schwartz tests.  The action
has strict zero/add laws, and its source square is proved directly from the
existing scaled-test construction.

This file constructs only the target carrier and its actual action.  It does
not provide a Mellin-quotient landing or a source-admission witness.
-/

set_option autoImplicit false
set_option maxHeartbeats 3000000

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalRiemann
namespace ClozelGeneralizedDual

open Complex
open ClozelEndpointSourceEffect
open scoped SchwartzMap

noncomputable section

/-- The literal range generated by the actual co-Poisson log-orbit map. -/
abbrev CoPoissonLogTranslationCarrier :=
  LinearMap.range coPoissonLogOrbitMap

/-- Scale-zero readout on the actual co-Poisson range. -/
def coPoissonCarrierEvaluationZero :
    CoPoissonLogTranslationCarrier →ₗ[ℂ] ℂ where
  toFun orbit := orbit.1 0
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- Half-weighted log translation on additive orbit functions. -/
def coPoissonHalfWeightedTranslation (shift : ℝ) :
    (ℝ → ℂ) →ₗ[ℂ] (ℝ → ℂ) where
  toFun orbit x :=
    (Real.exp shift : ℂ) ^ (-(1 / 2 : ℂ)) * orbit (x + shift)
  map_add' left right := by
    funext x
    simp only [Pi.add_apply]
    ring
  map_smul' coefficient orbit := by
    funext x
    simp only [Pi.smul_apply, RingHom.id_apply, smul_eq_mul]
    ring

@[simp]
theorem coPoissonHalfWeightedTranslation_zero :
    coPoissonHalfWeightedTranslation 0 = LinearMap.id := by
  apply LinearMap.ext
  intro orbit
  funext x
  simp [coPoissonHalfWeightedTranslation]

theorem coPoissonHalfWeightedTranslation_add (left right : ℝ) :
    coPoissonHalfWeightedTranslation (left + right) =
      (coPoissonHalfWeightedTranslation left).comp
        (coPoissonHalfWeightedTranslation right) := by
  apply LinearMap.ext
  intro orbit
  funext x
  change
    (Real.exp (left + right) : ℂ) ^ (-(1 / 2 : ℂ)) *
        orbit (x + (left + right)) =
      (Real.exp left : ℂ) ^ (-(1 / 2 : ℂ)) *
        ((Real.exp right : ℂ) ^ (-(1 / 2 : ℂ)) *
          orbit ((x + left) + right))
  rw [Real.exp_add, Complex.ofReal_mul,
    Complex.mul_cpow_ofReal_nonneg
      (Real.exp_nonneg left) (Real.exp_nonneg right)]
  rw [← add_assoc x left right, mul_assoc]

/-- Half-weighted translation is exactly positive scaling of the actual
Schwartz source test. -/
theorem coPoissonHalfWeightedTranslation_orbit
    (shift : ℝ) (test : SchwartzMap ℝ ℂ) :
    coPoissonHalfWeightedTranslation shift
        (coPoissonLogOrbitMap test) =
      coPoissonLogOrbitMap
        (scaledSchwartzTest (Real.exp shift)
          (Real.exp_ne_zero shift) test) := by
  funext x
  change
    (Real.exp shift : ℂ) ^ (-(1 / 2 : ℂ)) *
        ((Real.exp (x + shift) : ℂ) ^ (1 / 2 : ℂ) *
          clozelTemperedRemainder
            (scaledSchwartzTest (Real.exp (x + shift))
              (Real.exp_ne_zero (x + shift)) test)) =
      (Real.exp x : ℂ) ^ (1 / 2 : ℂ) *
        clozelTemperedRemainder
          (scaledSchwartzTest (Real.exp x) (Real.exp_ne_zero x)
            (scaledSchwartzTest (Real.exp shift)
              (Real.exp_ne_zero shift) test))
  have scaledTestEq :
      scaledSchwartzTest (Real.exp (x + shift))
          (Real.exp_ne_zero (x + shift)) test =
        scaledSchwartzTest (Real.exp x) (Real.exp_ne_zero x)
          (scaledSchwartzTest (Real.exp shift)
            (Real.exp_ne_zero shift) test) := by
    apply SchwartzMap.ext
    intro y
    simp only [scaledSchwartzTest_apply]
    congr 1
    rw [Real.exp_add]
    ring
  have weightEq :
      (Real.exp shift : ℂ) ^ (-(1 / 2 : ℂ)) *
          (Real.exp (x + shift) : ℂ) ^ (1 / 2 : ℂ) =
        (Real.exp x : ℂ) ^ (1 / 2 : ℂ) := by
    rw [Real.exp_add, Complex.ofReal_mul,
      Complex.mul_cpow_ofReal_nonneg
        (Real.exp_nonneg x) (Real.exp_nonneg shift)]
    have weightCancellation :
        (Real.exp shift : ℂ) ^ (-(1 / 2 : ℂ)) *
            (Real.exp shift : ℂ) ^ (1 / 2 : ℂ) = 1 := by
      rw [← Complex.cpow_add _ _
        (Complex.ofReal_ne_zero.mpr (Real.exp_ne_zero shift))]
      norm_num
    rw [mul_left_comm _ ((Real.exp x : ℂ) ^ (1 / 2 : ℂ)),
      weightCancellation, mul_one]
  rw [scaledTestEq, ← mul_assoc, weightEq]

/-- The generated target range is closed under half-weighted translation. -/
def coPoissonCarrierTranslation (shift : ℝ) :
    CoPoissonLogTranslationCarrier →ₗ[ℂ]
      CoPoissonLogTranslationCarrier where
  toFun orbit := ⟨coPoissonHalfWeightedTranslation shift orbit.1, by
    rcases orbit.2 with ⟨test, testImage⟩
    refine ⟨scaledSchwartzTest (Real.exp shift)
      (Real.exp_ne_zero shift) test, ?_⟩
    rw [← testImage]
    exact (coPoissonHalfWeightedTranslation_orbit shift test).symm⟩
  map_add' _ _ := by
    apply Subtype.ext
    exact map_add (coPoissonHalfWeightedTranslation shift) _ _
  map_smul' _ _ := by
    apply Subtype.ext
    exact map_smul (coPoissonHalfWeightedTranslation shift) _ _

@[simp]
theorem coPoissonCarrierTranslation_zero :
    coPoissonCarrierTranslation 0 = LinearMap.id := by
  apply LinearMap.ext
  intro orbit
  apply Subtype.ext
  exact LinearMap.congr_fun coPoissonHalfWeightedTranslation_zero orbit.1

theorem coPoissonCarrierTranslation_add (left right : ℝ) :
    coPoissonCarrierTranslation (left + right) =
      (coPoissonCarrierTranslation left).comp
        (coPoissonCarrierTranslation right) := by
  apply LinearMap.ext
  intro orbit
  apply Subtype.ext
  exact LinearMap.congr_fun
    (coPoissonHalfWeightedTranslation_add left right) orbit.1

@[simp]
theorem coPoissonCarrierTranslation_orbit
    (shift : ℝ) (test : SchwartzMap ℝ ℂ) :
    coPoissonCarrierTranslation shift
        ⟨coPoissonLogOrbitMap test, ⟨test, rfl⟩⟩ =
      ⟨coPoissonLogOrbitMap
          (scaledSchwartzTest (Real.exp shift)
            (Real.exp_ne_zero shift) test),
        ⟨scaledSchwartzTest (Real.exp shift)
            (Real.exp_ne_zero shift) test, rfl⟩⟩ := by
  apply Subtype.ext
  exact coPoissonHalfWeightedTranslation_orbit shift test

end

end ClozelGeneralizedDual
end CanonicalRiemann
end NoIslandNoMagic
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
