import H0mework.Arithmetic.FockResponsibility.AtomicDebtRuntime
import H0mework.Arithmetic.FockResponsibility.DirectActuality

/-!
# Process action and terminal readout

An action receipt contains only the already compiled atomic-process step.  In
particular it stores no terminal, fibre, settlement, occupation, or
nonvanishing field.  A separate target readout runs the existing physical
classifier; only that readout can materialize the prime-pair fibre and settle
actuality.
-/

set_option autoImplicit false
set_option maxHeartbeats 1000000

namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace NoIslandNoMagic.CanonicalArithmeticState
namespace ParticleWaveFockPrimePairActualityProcessAction

open CanonicalUnitArithmeticEffectiveAdditiveProducer
open CanonicalUnitArithmeticEffectiveFactorRepairOrbitProducer
open CanonicalUnitArithmeticFullFactorEmissionProducer
open CanonicalUnitArithmeticFullFactorRepairReachabilityProducer
open ParticleWaveFockAtomicDebtRuntime
open ParticleWaveFockAtomicProcess
open ParticleWaveFockPrimePairActuality
open ParticleWaveFockPrimePairActualityDirect

noncomputable section

/-- The base action receipt extracts only the actual process step and target.
The compiler's whole-ledger wrapper and old runtime pointers are not retained
in this payload. -/
structure GeneratedActionReceiptAt (depth : Nat) : Type where
  private mk ::
  target : RuntimeDebtState depth
  step : ParticleWaveFockAtomicSectorDebt.StepAt
    (runtimeDebtState depth) target
  source_eq : ParticleWaveFockAtomicSectorDebt.generateDisposition
    (runtimeDebtState depth) = .step step

def GeneratedActionReceiptAt.ofCompiled
    {depth : Nat} (compiled : CompiledStepAt depth) :
    GeneratedActionReceiptAt depth :=
  ⟨compiled.target, compiled.step, compiled.source_eq⟩

namespace GeneratedActionReceiptAt

abbrev sourceStep {depth : Nat} (action : GeneratedActionReceiptAt depth) :=
  action.step.generated

abbrev sourceEffect {depth : Nat} (action : GeneratedActionReceiptAt depth) :=
  action.step.effect

/-- The compiled target is literally the target generated by the source
process step. -/
theorem sourceStep_target_eq
    {depth : Nat} (action : GeneratedActionReceiptAt depth) :
    action.sourceStep.target = action.target.1 := by
  have targetRead := congrArg Prod.fst action.step.target_eq
  exact targetRead.symm

end GeneratedActionReceiptAt

/-- A target prime pair forces the existing physical source classifier onto
its terminal branch. -/
def generatedTargetTerminalOfPrimePair
    {depth : Nat} (action : GeneratedActionReceiptAt depth)
    (terminal : PrimePairTerminalAt action.target.1.current) :
    Sigma fun generated : GeneratedTerminalAt action.target.1
        (generateEvent action.target.1) =>
      Sigma fun species : GeneratedTerminalSpeciesAt action.target.1
          generated.terminal =>
        PLift (generateDynamics action.target.1 =
          .terminal generated species) := by
  generalize dynamics_eq : generateDynamics action.target.1 = dynamics
  cases dynamics with
  | terminal generated species =>
      exact ⟨generated, species, PLift.up rfl⟩
  | step generated effect =>
      have generatedClassifier := generated.sourceClassifier_eq
      have terminalClassifier :
          (fullFactorDecayLaw (RuntimeIndex depth)).classify
              action.target.1.current = .inl terminal := by
        change fullFactorDecayClassify action.target.1.current =
          Sum.inl terminal
        unfold fullFactorDecayClassify
        simp [fullFactorRepairLaw, terminal.leftPrime, terminal.rightPrime]
      rw [terminalClassifier] at generatedClassifier
      contradiction

/-- Terminality is a downstream dependent read of an action target. -/
structure TerminalReadoutAt
    {depth : Nat} (action : GeneratedActionReceiptAt depth) : Type where
  private mk ::
  targetTerminal : GeneratedTerminalAt action.target.1
    (generateEvent action.target.1)
  targetSpecies : GeneratedTerminalSpeciesAt action.target.1
    targetTerminal.terminal
  targetDynamics_eq : generateDynamics action.target.1 =
    .terminal targetTerminal targetSpecies

def TerminalReadoutAt.ofPrimePair
    {depth : Nat} (action : GeneratedActionReceiptAt depth)
    (terminal : PrimePairTerminalAt action.target.1.current) :
    TerminalReadoutAt action := by
  let generated := generatedTargetTerminalOfPrimePair action terminal
  exact
    { targetTerminal := generated.1
      targetSpecies := generated.2.1
      targetDynamics_eq := generated.2.2.down }

namespace TerminalReadoutAt

/-- The atomic-dynamics runtime and the fixed occurrence runtime expose the
same generated even target index. -/
theorem runtimeIndex_eq_actualityIndex (depth : Nat) :
    RuntimeIndex depth =
      CanonicalUnitArithmeticOperationalGoldbachRuntime.scanIndex
        (ParticleWaveFockOccurrenceResponsibilityRuntime.runtimeAt depth
          ).current.visit.current := by
  calc
    RuntimeIndex depth = depth + 1 :=
      ParticleWaveFockAtomicDynamicsRuntime.runtimeAt_scanIndex depth
    _ = _ :=
      (ParticleWaveFockOccurrenceResponsibilityRuntime.runtimeAt_scanIndex
        depth).symm

def effectiveFibre
    {depth : Nat} {action : GeneratedActionReceiptAt depth}
    (readout : TerminalReadoutAt action) :
    EffectiveAdditiveFibreAt (RuntimeIndex depth) :=
  fibreOfTerminal readout.targetTerminal.terminal

def actualitySettlement
    {depth : Nat} {action : GeneratedActionReceiptAt depth}
    (readout : TerminalReadoutAt action) :
    PrimePairActualitySettlementAt (directRuntimeActuality depth) :=
  PrimePairActualitySettlementAt.ofFibre
    (directRuntimeActuality depth) <| by
      rw [← runtimeIndex_eq_actualityIndex depth]
      exact readout.effectiveFibre

theorem occupation_ne_zero
    {depth : Nat} {action : GeneratedActionReceiptAt depth}
    (readout : TerminalReadoutAt action) :
    (directRuntimeActuality depth).occupation ≠ 0 :=
  readout.actualitySettlement.occupation_ne_zero

/-- Direct chain: the target classifier read generates the fibre and the
actuality settlement. -/
theorem terminal_to_settlement_directConsumer
    {depth : Nat} {action : GeneratedActionReceiptAt depth}
    (readout : TerminalReadoutAt action) :
    Nonempty (EffectiveAdditiveFibreAt (RuntimeIndex depth)) ∧
      Nonempty (PrimePairActualitySettlementAt
        (directRuntimeActuality depth)) ∧
      (directRuntimeActuality depth).occupation ≠ 0 :=
  ⟨⟨readout.effectiveFibre⟩, ⟨readout.actualitySettlement⟩,
    readout.occupation_ne_zero⟩

end TerminalReadoutAt

end


end ParticleWaveFockPrimePairActualityProcessAction
