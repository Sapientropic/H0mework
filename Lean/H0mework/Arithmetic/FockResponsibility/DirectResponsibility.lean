import H0mework.Foundation.Inquiry.EmptyObstruction
import H0mework.Foundation.Responsibility.DebtCompiler
import H0mework.Realization.Audit.DebtFirstWrite
import H0mework.Arithmetic.FockResponsibility.DirectActuality

/-!
# Direct live responsibility for one Goldbach actuality occurrence

The fixed lower Goldbach occurrence generates its existing actuality debt law,
open state, and disposition.  The generic direct compiler consumes that
disposition before any root emitter is installed.  This file creates no root,
process, gate, or second classifier.
-/

set_option autoImplicit false

namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace NoIslandNoMagic.CanonicalArithmeticState
namespace ParticleWaveFockPrimePairActualityDirectResponsibility

open CanonicalUnitArithmeticRoot
open DebtActivationLedger
open DebtActivationWorld
open DebtAdmissionFirstWrite
open ParticleWaveFockOccurrenceResponsibilityRuntime
open ParticleWaveFockPrimePairActuality
open ParticleWaveFockPrimePairActualityDebt
open ParticleWaveFockPrimePairActualityDirect
open RootGeneratedDebtActivationDirect
open RootGeneratedEmptyObstructionU7

noncomputable section

abbrev LowerRoot :=
  ParticleWaveFockOccurrenceResponsibilityRuntime.authoritativeRoot.toLedgerRoot

abbrev LowerCurrent (depth : Nat) :=
  (ParticleWaveFockOccurrenceResponsibilityRuntime.runtimeAt depth
    ).current.visit.current

abbrev Actuality (depth : Nat) := directRuntimeActuality depth

abbrev Law (depth : Nat) := activationLaw (Actuality depth)

abbrev OpenState (depth : Nat) : (Law depth).DebtState :=
  StateAt.pending

/-- Translate only the disposition already generated by the actuality debt
law.  No branch is recomputed here. -/
def translatedDispositionAt (depth : Nat) (state : (Law depth).DebtState) :
    RootGeneratedDebtActivationDirect.GeneratedDispositionAt (Law depth) state :=
  match ParticleWaveFockPrimePairActualityDebt.generateDisposition state with
  | .settlement settled => .supportTerminal settled
  | .payment paid => .step paid
  | .obstruction blocked => .obstruction blocked

/-- The occurrence-indexed domain source is fixed to the already emitted lower
occurrence and its open actuality state. -/
def source (depth : Nat) :
    OccurrenceIndexedSourceAt LowerRoot (LowerCurrent depth) where
  Event := PUnit
  generate := PUnit.unit
  lawAt := fun _ => Law depth
  stateAt := fun _ => OpenState depth
  dispositionAt := fun _ => translatedDispositionAt depth (OpenState depth)

/-- The base arithmetic obstruction surface is empty; its canonical vacuous
U7 calculus is the one extended by the direct compiler. -/
def oldU7 : U7ProducerCalculus N :=
  RootGeneratedEmptyObstructionU7.producer N rootObstructionAt_isEmpty

def oldU7Calculus : U7ObstructionEvolutionCalculus N oldU7 :=
  RootGeneratedEmptyObstructionU7.calculus N rootObstructionAt_isEmpty

/-- Canonical direct compiler image of the fixed occurrence's open row. -/
def compiled (depth : Nat) :=
  RootGeneratedDebtActivationDirect.compile
    (source depth) oldU7 oldU7Calculus

/-- The direct source is attached to exactly the occurrence which generated
the actuality payload. -/
theorem lowerOccurrence_eq_actualitySource (depth : Nat) :
    (source depth).lowerOccurrence = (Actuality depth).sourceOccurrence := by
  exact (Actuality depth).sourceOccurrence_eq.symm

/-- The actuality claim is now the literal claim of the live whole-ledger row. -/
@[simp] theorem liveDebtEntry_claim (depth : Nat) :
    (source depth).liveDebtEntry.claim = .inr (Actuality depth).claim :=
  rfl

/-- The open actuality row carries its source-owned unit budget. -/
@[simp] theorem liveDebtEntry_budget (depth : Nat) :
    (source depth).liveDebtEntry.progressBudget = 1 :=
  rfl

/-- The generic compiler reads exactly the translated source disposition. -/
theorem compiled_disposition_eq_source (depth : Nat) :
    (compiled depth).disposition = (source depth).generatedDisposition :=
  (compiled depth).generated_eq

/-- The open state cannot already emit its later support terminal. -/
theorem open_supportTerminal_isEmpty (depth : Nat) :
    IsEmpty ((Law depth).SupportTerminalAt (OpenState depth)) := by
  constructor
  intro terminal
  exact nomatch terminal

/-- An exact prime-pair residual rules out every strict payment from this open
row: each such payment already contains an actual settlement fibre. -/
theorem open_step_isEmpty_of_residual
    (depth : Nat)
    (residual : PrimePairActualityObstructionAt (Actuality depth)) :
    IsEmpty (Sigma fun target : (Law depth).DebtState =>
      (Law depth).StepAt (OpenState depth) target) := by
  constructor
  rintro ⟨_target, payment⟩
  exact residual.residual.fibre_is_empty.false payment.receipt.fibre

/-- Recover the obstruction result from the generic compiler's dependent
image; it is a same-row U7 audit, not an ordinary successor. -/
def compiledAuditAt
    {depth : Nat}
    {obstruction : (Law depth).ObstructionAt (OpenState depth)}
    (compiled_eq : (compiled depth).disposition = .obstruction obstruction) :
    SameRowTheoryAuditAt (source depth) oldU7 oldU7Calculus obstruction := by
  have result := (compiled depth).result
  rw [compiled_eq] at result
  exact result

/-- A faithful residual leaves the direct compiler exactly one branch: the
same-row U7 theory audit. -/
def generateObstructionAudit
    (depth : Nat)
    (residual : PrimePairActualityObstructionAt (Actuality depth)) :
    Sigma fun obstruction : (Law depth).ObstructionAt (OpenState depth) =>
      SameRowTheoryAuditAt
        (source depth) oldU7 oldU7Calculus obstruction := by
  generalize sourceGenerated :
    (source depth).generatedDisposition = disposition
  cases disposition with
  | supportTerminal terminal =>
      exact False.elim ((open_supportTerminal_isEmpty depth).false terminal)
  | step payment =>
      exact False.elim <| (open_step_isEmpty_of_residual depth residual).false
        ⟨_, payment⟩
  | obstruction obstruction =>
      have compilerGenerated :
          (compiled depth).disposition = .obstruction obstruction :=
        (compiled depth).generated_eq.trans sourceGenerated
      exact ⟨obstruction, compiledAuditAt compilerGenerated⟩

/-- The same live row cannot be installed after the fact by an ordinary
old-origin ledger write.  It must already be present at the direct compiler
mouth. -/
theorem no_ordinary_installation (depth : Nat) :
    ¬ Nonempty
      (LedgerWriteEvolutionAt (source depth).World
        (inactiveLedger
          (N := N) (law := Law depth) (source depth).lowerSupport)
        (source depth).liveLedger) :=
  ordinaryEvolution_cannot_admit
    (N := N) (law := Law depth) (source depth).lowerSupport (OpenState depth)

end

end ParticleWaveFockPrimePairActualityDirectResponsibility
end NoIslandNoMagic.CanonicalArithmeticState
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
