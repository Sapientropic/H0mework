import H0mework.Arithmetic.FockResponsibility.OccurrenceSector

/-!
# Observer responsibility generated by an exact occurrence history

The finite inventory is not advanced independently of provenance.  It is
folded along the exact dependent event path: every visited structural channel
key is erased, while the physical current is the full occurrence represented
by that same path.  Reappearance of an erased key is therefore an observer
residual generated by history, not a caller-selected empty inventory.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalArithmeticState
namespace ParticleWaveFockOccurrenceHistoryResponsibility

open CanonicalUnitArithmeticEffectiveFactorRepairOrbitProducer
open CanonicalUnitArithmeticOperationalFactorDecayProducer
open ParticleWaveFockOccurrencePhysicalProcess
open ParticleWaveFockOccurrenceResponsibility
open SourceGeneratedFiniteEventIndexedResidualProcess

noncomputable section

noncomputable local instance structuralKeyDecidableEq (index : Nat) :
    DecidableEq (FactorDecayStructuralChannelKeyAt index) :=
  Classical.decEq _

/-- Erase exactly the finite observer projections visited by one actual path. -/
def remainingAfterPath {index : Nat} {origin target : EffectiveSplitAt index}
    (path : GeneratedPathAt (factorDecayProcess index) origin target)
    (remaining : Finset (FactorDecayStructuralChannelKeyAt index)) :
    Finset (FactorDecayStructuralChannelKeyAt index) :=
  path.events.foldl (fun inventory key => inventory.erase key) remaining

private theorem foldErase_subset {index : Nat}
    (events : List (FactorDecayStructuralChannelKeyAt index))
    (remaining : Finset (FactorDecayStructuralChannelKeyAt index)) :
    events.foldl (fun inventory key => inventory.erase key) remaining ⊆
      remaining := by
  induction events generalizing remaining with
  | nil => exact Finset.Subset.rfl
  | cons key rest inductionHypothesis =>
      exact (inductionHypothesis (remaining.erase key)).trans
        (Finset.erase_subset key remaining)

theorem remainingAfterPath_subset {index : Nat}
    {origin target : EffectiveSplitAt index}
    (path : GeneratedPathAt (factorDecayProcess index) origin target)
    (remaining : Finset (FactorDecayStructuralChannelKeyAt index)) :
    remainingAfterPath path remaining ⊆ remaining :=
  foldErase_subset path.events remaining

private theorem not_mem_foldErase_of_mem {index : Nat}
    (events : List (FactorDecayStructuralChannelKeyAt index))
    (remaining : Finset (FactorDecayStructuralChannelKeyAt index))
    (key : FactorDecayStructuralChannelKeyAt index)
    (membership : key ∈ events) :
    key ∉ events.foldl (fun inventory coordinate =>
      inventory.erase coordinate) remaining := by
  induction events generalizing remaining with
  | nil => simp at membership
  | cons head rest inductionHypothesis =>
      simp only [List.foldl_cons]
      rcases List.mem_cons.mp membership with head_eq | tail_mem
      · subst head
        intro final_mem
        have erased_mem : key ∈ remaining.erase key :=
          foldErase_subset rest (remaining.erase key) final_mem
        exact (Finset.mem_erase.mp erased_mem).1 rfl
      · exact inductionHypothesis (remaining.erase head) tail_mem

theorem visitedKey_not_mem_remainingAfterPath {index : Nat}
    {origin target : EffectiveSplitAt index}
    (path : GeneratedPathAt (factorDecayProcess index) origin target)
    (key : FactorDecayStructuralChannelKeyAt index)
    (visited : key ∈ path.events)
    (remaining : Finset (FactorDecayStructuralChannelKeyAt index)) :
    key ∉ remainingAfterPath path remaining :=
  not_mem_foldErase_of_mem path.events remaining key visited

/-- The full path occurrence and its path-generated observer inventory are one
state. -/
def stateAfterPath {index : Nat}
    {origin target : EffectiveSplitAt index}
    (path : GeneratedPathAt (factorDecayProcess index) origin target) :
    ParticleWaveFockOccurrenceResponsibility.State index :=
  (ofOccurrence
      (SourceGeneratedFiniteEventIndexedProvenanceFlux.ofPath path),
    remainingAfterPath path Finset.univ)

@[simp] theorem stateAfterPath_origin {index : Nat}
    {origin target : EffectiveSplitAt index}
    (path : GeneratedPathAt (factorDecayProcess index) origin target) :
    (stateAfterPath path).1.origin = origin :=
  rfl

@[simp] theorem stateAfterPath_occurrence_state {index : Nat}
    {origin target : EffectiveSplitAt index}
    (path : GeneratedPathAt (factorDecayProcess index) origin target) :
    (stateAfterPath path).1.occurrence.state = target :=
  rfl

@[simp] theorem stateAfterPath_occurrence_depth {index : Nat}
    {origin target : EffectiveSplitAt index}
    (path : GeneratedPathAt (factorDecayProcess index) origin target) :
    (stateAfterPath path).1.occurrence.depth = path.length :=
  rfl

theorem visitedKey_absent_from_stateAfterPath {index : Nat}
    {origin target : EffectiveSplitAt index}
    (path : GeneratedPathAt (factorDecayProcess index) origin target)
    (key : FactorDecayStructuralChannelKeyAt index)
    (visited : key ∈ path.events) :
    key ∉ (stateAfterPath path).2 :=
  visitedKey_not_mem_remainingAfterPath path key visited Finset.univ

end

