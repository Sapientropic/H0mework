import H0mework.Arithmetic.PoleOrbit.GlobalGermArithmeticCounterterm
import H0mework.Arithmetic.PoleGreen.OriginDescentNoGo

/-!
# All-place origin mapping cone

The Archimedean origin coordinate alone does not annihilate the actual
Müntz relation.  Pairing it with the arithmetic counterterm generated by the
same global-germ owner gives one joint relation map whose signed defect does
annihilate every actual relation.  This is the first legal descent mouth;
no radial, separator, trace-balance, or critical-line statement is used.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalRiemann
namespace AllPlaceOriginDefect

open CanonicalUnitArithmeticFactorizationGlobalDeterminantCoordinateRealization
open NoIslandNoMagic.CanonicalArithmeticState.AllPlaceEulerLog
open ClozelGeneralizedDual

noncomputable section

abbrev AllPlaceOriginJointCarrier (z : ℂ) :=
  QuarterMellinL2Test z × ℂ

/-- One actual Schwartz source writes both the Archimedean relation value
and its owner-generated arithmetic counterterm. -/
def allPlaceOriginRelationMap
    (owner : GlobalGermOwner)
    (z : ℂ) (positive : 0 < z.re)
    (belowHalf : z.re < (1 / 2 : ℝ)) :
    SchwartzMap ℝ ℂ →ₗ[ℂ] AllPlaceOriginJointCarrier z :=
  (coPoissonQuarterMellinConvergentMap z positive belowHalf).prod
    (ownerArithmeticCounterterm owner)

/-- The signed all-place origin defect.  Its arithmetic component is an
independent owner read, not a restatement of the Archimedean origin. -/
def allPlaceOriginDefect
    (_owner : GlobalGermOwner) (z : ℂ) :
    AllPlaceOriginJointCarrier z →ₗ[ℂ] ℂ :=
  (quarterLogOriginRead z).coprod
    (-LinearMap.id (R := ℂ) (M := ℂ))

@[simp] theorem allPlaceOriginDefect_apply
    (owner : GlobalGermOwner) (z : ℂ)
    (value : QuarterMellinL2Test z) (arithmetic : ℂ) :
    allPlaceOriginDefect owner z (value, arithmetic) =
      quarterLogOriginRead z value - arithmetic := by
  rfl

theorem quarterLogOriginRead_actualRelation
    (z : ℂ) (positive : 0 < z.re)
    (belowHalf : z.re < (1 / 2 : ℝ))
    (test : SchwartzMap ℝ ℂ) :
    quarterLogOriginRead z
        (coPoissonQuarterMellinConvergentMap z positive belowHalf test) =
      coPoissonLogOrbitMap test 0 := by
  change positiveMellinLogQuarterTransform
      (coPoissonQuarterMellinConvergentMap z positive belowHalf test).1 0 = _
  rw [coPoissonQuarterMellinConvergentMap_value,
    positiveMellinLogQuarterTransform_coPoissonQuarterMellinMap]
  norm_num

/-- The owner-generated counterterm exactly repairs the origin-descent
failure on every actual co-Poisson--Müntz relation. -/
theorem allPlaceOriginDefect_relation_eq_zero
    (owner : GlobalGermOwner)
    (z : ℂ) (positive : 0 < z.re)
    (belowHalf : z.re < (1 / 2 : ℝ))
    (test : SchwartzMap ℝ ℂ) :
    allPlaceOriginDefect owner z
        (allPlaceOriginRelationMap owner z positive belowHalf test) = 0 := by
  rw [allPlaceOriginDefect_apply]
  change quarterLogOriginRead z
        (coPoissonQuarterMellinConvergentMap z positive belowHalf test) -
      ownerArithmeticCounterterm owner test = 0
  rw [quarterLogOriginRead_actualRelation,
    ownerArithmeticCounterterm_eq_remainder,
    coPoissonLogOrbitMap_zero]
  exact sub_self _

theorem allPlaceOriginRelation_range_le_defect_ker
    (owner : GlobalGermOwner)
    (z : ℂ) (positive : 0 < z.re)
    (belowHalf : z.re < (1 / 2 : ℝ)) :
    LinearMap.range
        (allPlaceOriginRelationMap owner z positive belowHalf) ≤
      LinearMap.ker (allPlaceOriginDefect owner z) := by
  rintro value ⟨test, rfl⟩
  exact allPlaceOriginDefect_relation_eq_zero
    owner z positive belowHalf test

abbrev AllPlaceOriginCokernel
    (owner : GlobalGermOwner)
    (z : ℂ) (positive : 0 < z.re)
    (belowHalf : z.re < (1 / 2 : ℝ)) :=
  AllPlaceOriginJointCarrier z ⧸
    LinearMap.range
      (allPlaceOriginRelationMap owner z positive belowHalf)

def allPlaceOriginCokernelSourceMap
    (owner : GlobalGermOwner)
    (z : ℂ) (positive : 0 < z.re)
    (belowHalf : z.re < (1 / 2 : ℝ)) :
    AllPlaceOriginJointCarrier z →ₗ[ℂ]
      AllPlaceOriginCokernel owner z positive belowHalf :=
  Submodule.mkQ _

/-- The repaired defect descends through the joint all-place relation
cokernel, unlike the bare origin coordinate. -/
def descendedAllPlaceOriginDefect
    (owner : GlobalGermOwner)
    (z : ℂ) (positive : 0 < z.re)
    (belowHalf : z.re < (1 / 2 : ℝ)) :
    AllPlaceOriginCokernel owner z positive belowHalf →ₗ[ℂ] ℂ :=
  Submodule.liftQ _ (allPlaceOriginDefect owner z)
    (allPlaceOriginRelation_range_le_defect_ker
      owner z positive belowHalf)

theorem descendedAllPlaceOriginDefect_source_readback
    (owner : GlobalGermOwner)
    (z : ℂ) (positive : 0 < z.re)
    (belowHalf : z.re < (1 / 2 : ℝ))
    (value : AllPlaceOriginJointCarrier z) :
    descendedAllPlaceOriginDefect owner z positive belowHalf
        (allPlaceOriginCokernelSourceMap owner z positive belowHalf value) =
      allPlaceOriginDefect owner z value := by
  rfl

theorem allPlaceOriginDefect_arithmeticUnit
    (owner : GlobalGermOwner) (z : ℂ) :
    allPlaceOriginDefect owner z
        ((0 : QuarterMellinL2Test z), (1 : ℂ)) = -1 := by
  rw [allPlaceOriginDefect_apply, map_zero]
  norm_num

/-- The repaired descent is not a vacuous zero functional: the retained
arithmetic unit has read `-1` in the quotient. -/
theorem descendedAllPlaceOriginDefect_ne_zero
    (owner : GlobalGermOwner)
    (z : ℂ) (positive : 0 < z.re)
    (belowHalf : z.re < (1 / 2 : ℝ)) :
    descendedAllPlaceOriginDefect owner z positive belowHalf ≠ 0 := by
  intro zero
  have atUnit := LinearMap.congr_fun zero
    (allPlaceOriginCokernelSourceMap owner z positive belowHalf
      ((0 : QuarterMellinL2Test z), (1 : ℂ)))
  rw [LinearMap.zero_apply,
    descendedAllPlaceOriginDefect_source_readback,
    allPlaceOriginDefect_arithmeticUnit] at atUnit
  norm_num at atUnit

/-- The source-generated Euler-log root gives the canonical all-place
instance without a caller-selected owner. -/
theorem globalEulerLogRoot_originDefect_relation_eq_zero
    (z : ℂ) (positive : 0 < z.re)
    (belowHalf : z.re < (1 / 2 : ℝ))
    (test : SchwartzMap ℝ ℂ) :
    allPlaceOriginDefect globalEulerLogOccurrence.root.1 z
        (allPlaceOriginRelationMap globalEulerLogOccurrence.root.1
          z positive belowHalf test) = 0 :=
  allPlaceOriginDefect_relation_eq_zero
    globalEulerLogOccurrence.root.1 z positive belowHalf test

end
