import H0mework.Arithmetic.PrimeShadow.P322
import H0mework.Arithmetic.PrimeSearch.P330

/-!
# Proposition 331: half-sigma atomic closed seed

P328 gives the closed-form sigma-atomic position at an arbitrary nontrivial
rate `σ`, P322 identifies the half-sigma atomic support with the Euler-product
prime index, and P330 makes the half-sigma Goldbach projection computational.

This file closes the small but useful half-sigma specialization:

* every half-sigma atomic rate generated by a prime `p` is exactly
  `1 - (1 / 2)^p`;
* its residual/headroom is exactly `(1 / 2)^p`;
* the typed sigma-atomic support value has the same closed form;
* the same prime support is the Euler-product support and the finite-search
  Goldbach frontend support.

Boundary: this is a closed-form coupling seed.  It is not RH, not Goldbach,
and not a faithful-pullback theorem by itself.
-/

noncomputable section

set_option linter.unusedSectionVars false

namespace SaturationMonoid
namespace AffineRelaxation

open Complex

/-! ## Half-sigma atomic closed forms -/

theorem halfSigma_residualBase_eq :
    (1 : ℝ) - (1 / 2 : ℝ) = (1 / 2 : ℝ) := by
  norm_num

/-- THEOREM 1: at half sigma, every sigma-atomic prime position is
`1 - 2^{-p}` in rate coordinates. -/
theorem halfSigma_sigmaAtomicClosedPosition_eq
    (p : PrimeExponent) :
    sigmaAtomicClosedPosition (1 / 2 : ℝ) p =
      1 - (1 / 2 : ℝ) ^ p.1 := by
  unfold sigmaAtomicClosedPosition
  rw [halfSigma_residualBase_eq]

/-- THEOREM 2: at half sigma, the residual/headroom of a prime atomic rate is
exactly `2^{-p}`. -/
theorem halfSigma_keep_sigmaAtomicClosedPosition
    (p : PrimeExponent) :
    1 - sigmaAtomicClosedPosition (1 / 2 : ℝ) p =
      (1 / 2 : ℝ) ^ p.1 := by
  calc
    1 - sigmaAtomicClosedPosition (1 / 2 : ℝ) p =
        ((1 : ℝ) - (1 / 2 : ℝ)) ^ p.1 := by
      exact keep_sigmaAtomicClosedPosition (σ := (1 / 2 : ℝ)) p
    _ = (1 / 2 : ℝ) ^ p.1 := by
      rw [halfSigma_residualBase_eq]

/-- THEOREM 3: the tagged half-sigma atomic support has the same closed-form
rate value `1 - 2^{-p}`. -/
theorem halfSigma_primeToSigmaAtomicRateSupport_val_closedForm
    (p : PrimeExponent) :
    ((primeToSigmaAtomicRateSupport (1 / 2 : ℝ)
      (ne_of_lt halfSigma_mem_Ioo.2) p).1.1 : ℝ) =
      1 - (1 / 2 : ℝ) ^ p.1 := by
  rw [primeToSigmaAtomicRateSupport_val_closedForm]
  exact halfSigma_sigmaAtomicClosedPosition_eq p

/-! ## Packaged seed: closed atomics + Euler primes + finite search -/

/-- A compact certificate that the half-sigma atomic layer has closed-form
positions, shares the Euler-product prime index, and exposes the already-proved
finite Goldbach search frontend. -/
structure P331HalfSigmaAtomicClosedSeedCertificate where
  sigma_atomic_support_equiv_primes :
    SigmaAtomicRateSupport (K := ℝ) (1 / 2 : ℝ)
        (ne_of_lt halfSigma_mem_Ioo.2) ≃ Nat.Primes
  rate_closed_form :
    ∀ p : PrimeExponent,
      sigmaAtomicClosedPosition (1 / 2 : ℝ) p =
        1 - (1 / 2 : ℝ) ^ p.1
  headroom_closed_form :
    ∀ p : PrimeExponent,
      1 - sigmaAtomicClosedPosition (1 / 2 : ℝ) p =
        (1 / 2 : ℝ) ^ p.1
  tagged_support_value_closed_form :
    ∀ p : PrimeExponent,
      ((primeToSigmaAtomicRateSupport (1 / 2 : ℝ)
        (ne_of_lt halfSigma_mem_Ioo.2) p).1.1 : ℝ) =
        1 - (1 / 2 : ℝ) ^ p.1
  zeta_euler_product_prime_indexed :
    ∀ {s : ℂ}, 1 < s.re →
      HasProd
        (fun p : PrimeExponent => (1 - (p.1 : ℂ) ^ (-s))⁻¹)
        (riemannZeta s)
  rate_iterated_search_complete :
    ∀ n : ℕ,
      HalfSigmaRateGoldbachComplete (iteratedRate (1 / 2 : ℝ) n) ↔
        (goldbachSearchNat n).isSome = true

/-- The canonical half-sigma atomic closed seed certificate. -/
def p331HalfSigmaAtomicClosedSeedCertificate :
    P331HalfSigmaAtomicClosedSeedCertificate where
  sigma_atomic_support_equiv_primes :=
    halfSigmaAtomicSupportEquivNatPrimes
  rate_closed_form :=
    halfSigma_sigmaAtomicClosedPosition_eq
  headroom_closed_form :=
    halfSigma_keep_sigmaAtomicClosedPosition
  tagged_support_value_closed_form :=
    halfSigma_primeToSigmaAtomicRateSupport_val_closedForm
  zeta_euler_product_prime_indexed := by
    intro s hs
    exact riemannZeta_eulerProduct_hasProd_primeExponent (s := s) hs
  rate_iterated_search_complete :=
    halfSigmaRateGoldbachComplete_iteratedRate_iff_goldbachSearchNat

end AffineRelaxation
end SaturationMonoid
