import H0mework.Arithmetic.AtomicCodes.P1001
import H0mework.Physics.AlphaSources.P785

/-!
# Proposition 1002: same-carrier object with four residual readouts

This file builds the unified same-carrier object promised after P1001.  The
object carries one generated SU(7) endpoint cell plus the alpha source readout
on the same carrier.  Its residual readouts are:

* physical color trace residual;
* endpoint balance residual;
* atom-irreducibility residual;
* alpha convergence residual.

The atom-irreducibility residual is present as a readout, but the producer does
not close it.  Closing it requires replacing the older global placeholder
irreducibility predicate with the real SU(7)/tensor atomic predicate.  The
producer therefore proves only the residual components already generated by
the current upstream algebra: physical trace, endpoint balance, and alpha
convergence.
-/

noncomputable section

namespace SaturationMonoid
namespace StandardModelConstraint

set_option linter.defProp false

/-! ## Unified same-carrier object -/

/-- Same-carrier object: one endpoint/color generated cell, one alpha-source
readout, and one atom-irreducibility residual readout.  No field stores a
target equality. -/
structure SameCarrierObject (n : ℕ) where
  endpointCell : SU7SameCarrierAtomicCell n
  alphaSource : AlphaStrongResidualSource -> ℚ
  atomIrreducibilityReadout : SameCarrierSU7Atom -> ℤ

/-- Physical color-trace residual read from the same object. -/
def sameCarrierPhysicalTraceResidual
    {n : ℕ} (O : SameCarrierObject n) : ℤ :=
  colorTraceResidual O.endpointCell

/-- Endpoint-balance residual read from the same object. -/
def sameCarrierEndpointResidual
    {n : ℕ} (O : SameCarrierObject n) : ℤ :=
  endpointBalanceResidual O.endpointCell

/-- Atom-irreducibility residual read from the same object.  This is a debt
readout until the real representation-theoretic irreducibility predicate is
installed. -/
def sameCarrierAtomIrreducibilityResidual
    {n : ℕ} (O : SameCarrierObject n) : ℤ :=
  O.atomIrreducibilityReadout O.endpointCell.leftAtom +
    O.atomIrreducibilityReadout O.endpointCell.rightAtom

/-- Alpha-convergence residual read from the same object.  It is the exact
inverse correction, shifted so closure is the zero fiber. -/
def sameCarrierAlphaConvergenceResidual
    {n : ℕ} (O : SameCarrierObject n) : ℚ :=
  inverseCorrectionFromAlphaGap
      (alphaStrongTwoLoopSMOutput ℚ)
      (∑ s : AlphaStrongResidualSource, O.alphaSource s) +
    ((89000 : ℚ) / 128511)

/-- The four residual readouts as one same-carrier product. -/
def sameCarrierResidualVector
    {n : ℕ} (O : SameCarrierObject n) : (ℤ × ℤ) × (ℤ × ℚ) :=
  ((sameCarrierPhysicalTraceResidual O,
      sameCarrierEndpointResidual O),
    (sameCarrierAtomIrreducibilityResidual O,
      sameCarrierAlphaConvergenceResidual O))

/-- Full zero fiber for the same-carrier object.  This is defined but not
claimed by the current producer, because the atom-irreducibility component is
not closed yet. -/
def SameCarrierFullZero
    {n : ℕ} (O : SameCarrierObject n) : Prop :=
  sameCarrierResidualVector O = ((0, 0), (0, 0))

/-! ## Canonical upstream-produced object -/

/-- Canonical same-carrier object parameterized by the still-open
atom-irreducibility readout. -/
def sameCarrierObjectOfIrreducibilityReadout
    (n : ℕ) (irr : SameCarrierSU7Atom -> ℤ) :
    SameCarrierObject n where
  endpointCell := sameCarrierAtomicZeroCandidate n
  alphaSource := alphaStrongFourSourceIndependentContribution
  atomIrreducibilityReadout := irr

/-- The canonical same-carrier object has zero physical trace residual. -/
theorem sameCarrierObject_physicalTrace_zero
    (n : ℕ) (irr : SameCarrierSU7Atom -> ℤ) :
    sameCarrierPhysicalTraceResidual
      (sameCarrierObjectOfIrreducibilityReadout n irr) = 0 := by
  simp [sameCarrierPhysicalTraceResidual,
    sameCarrierObjectOfIrreducibilityReadout,
    sameCarrierAtomicZeroCandidate_colorTrace_zero]

/-- The canonical same-carrier object has zero endpoint-balance residual. -/
theorem sameCarrierObject_endpoint_zero
    (n : ℕ) (irr : SameCarrierSU7Atom -> ℤ) :
    sameCarrierEndpointResidual
      (sameCarrierObjectOfIrreducibilityReadout n irr) = 0 := by
  simp [sameCarrierEndpointResidual,
    sameCarrierObjectOfIrreducibilityReadout,
    sameCarrierAtomicZeroCandidate_endpointBalance_zero]

/-- The canonical same-carrier object has zero alpha-convergence residual. -/
theorem sameCarrierObject_alpha_zero
    (n : ℕ) (irr : SameCarrierSU7Atom -> ℤ) :
    sameCarrierAlphaConvergenceResidual
      (sameCarrierObjectOfIrreducibilityReadout n irr) = 0 := by
  unfold sameCarrierAlphaConvergenceResidual
    sameCarrierObjectOfIrreducibilityReadout
  rw [alphaStrongIndependentFourSource_inverseResidual]
  norm_num

/-- Current upstream producer on the unified same carrier: physical trace,
endpoint balance, and alpha convergence are zero on the same object.  The
atom-irreducibility residual is carried by the object but not used to close
the producer. -/
theorem sameCarrierObject_coreProducedResiduals_zero :
    ∀ n : ℕ, 2 ≤ n ->
      ∀ _ : SameCarrierSU7Atom -> ℤ,
        ∃ O : SameCarrierObject n,
          sameCarrierPhysicalTraceResidual O = 0 ∧
            sameCarrierEndpointResidual O = 0 ∧
              sameCarrierAlphaConvergenceResidual O = 0 := by
  intro n _hn irr
  refine
    ⟨sameCarrierObjectOfIrreducibilityReadout n irr,
      ?_, ?_, ?_⟩
  · exact sameCarrierObject_physicalTrace_zero n irr
  · exact sameCarrierObject_endpoint_zero n irr
  · exact sameCarrierObject_alpha_zero n irr

/-- If the same-carrier full zero fiber is eventually produced, endpoint
balance reflects out immediately. -/
theorem sameCarrierFullZero_reflects_endpoint
    {n : ℕ} {O : SameCarrierObject n}
    (hzero : SameCarrierFullZero O) :
    sameCarrierEndpointResidual O = 0 := by
  unfold SameCarrierFullZero sameCarrierResidualVector at hzero
  exact congrArg Prod.snd (congrArg Prod.fst hzero)

/-- If the same-carrier full zero fiber is eventually produced, the alpha
convergence component reflects out immediately. -/
theorem sameCarrierFullZero_reflects_alpha
    {n : ℕ} {O : SameCarrierObject n}
    (hzero : SameCarrierFullZero O) :
    sameCarrierAlphaConvergenceResidual O = 0 := by
  unfold SameCarrierFullZero sameCarrierResidualVector at hzero
  exact congrArg Prod.snd (congrArg Prod.snd hzero)


end StandardModelConstraint
end SaturationMonoid
