import H0mework.Physics.BranchSources.P868

/-!
# Proposition 869: the branch-weight generator is exactly Goldbach-strength

P868 moved the SU(7) color-loop route down to raw branch families and
representation weights.  This file closes that throat mathematically: with the
current carrier choice

`PrimeExponent = { n : ℕ // Nat.Prime n }`,

having a raw branch-weight generator on every even fiber is equivalent to the
ordinary even Goldbach statement.

So this path is not an independent producer yet.  To produce Goldbach from
physics, the next object must be lower than `PrimeExponent`: an actual SU(7)
branching / representation spectrum whose prime-edge projection is proved
afterward, not stored in the branch cell.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open SaturationMonoid.AffineRelaxation

set_option linter.defProp false

/-! ## Goldbach constructs the current branch-weight generator -/

/-- The one-cell branch family generated by a Goldbach prime pair. -/
def branchWeightGenerator_of_goldbachPair
    {n : ℕ} (p q : PrimeExponent)
    (hsum : 2 * n = p.1 + q.1) :
    SU7RepresentationBranchWeightGenerator n :=
  let cell : SU7PrimeEdgeBranchCell n :=
    { branch := SU3FlagSchubertCell.e
      leftPrime := p
      rightPrime := q }
  { branchFamily := { branchCells := [cell] }
    representationWeight := fun _ => 1
    supportCell := cell
    support_mem := by simp
    support_weight_positive := by simp
    support_residual_zero := by
      change ((p.1 + q.1 : ℤ) - (2 * n : ℤ) = 0)
      omega }

/-- THEOREM 1: ordinary even Goldbach produces the current P868 raw
branch-weight generator on every even fiber. -/
theorem branchWeightGeneratorEveryEvenFiber_of_evenGoldbach
    (H : EvenGoldbachStatement) :
    SU7RepresentationBranchWeightGeneratorEveryEvenFiber := by
  intro n hn
  rcases H n hn with ⟨p, q, hsum⟩
  exact ⟨branchWeightGenerator_of_goldbachPair p q hsum⟩

/-! ## Exact strength of the current branch-weight generator throat -/

/-- THEOREM 2: with `PrimeExponent` already baked into branch cells, the raw
SU(7) branch-weight generator target is equivalent to ordinary even Goldbach.
-/
theorem branchWeightGeneratorEveryEvenFiber_iff_evenGoldbach :
    SU7RepresentationBranchWeightGeneratorEveryEvenFiber ↔
      EvenGoldbachStatement := by
  constructor
  · exact evenGoldbach_of_branchWeightGenerator
  · exact branchWeightGeneratorEveryEvenFiber_of_evenGoldbach

/-! ## Certificate -/

/-- P869 certificate: the current P868 branch-weight generator is exactly
Goldbach-strength.  The independent producer must therefore live below
`PrimeExponent`, at the SU(7) branching-spectrum level. -/
structure BranchWeightGeneratorGoldbachStrengthCertificate : Prop where
  goldbach_to_generator :
    EvenGoldbachStatement ->
      SU7RepresentationBranchWeightGeneratorEveryEvenFiber
  generator_to_goldbach :
    SU7RepresentationBranchWeightGeneratorEveryEvenFiber ->
      EvenGoldbachStatement
  iff_statement :
    SU7RepresentationBranchWeightGeneratorEveryEvenFiber ↔
      EvenGoldbachStatement

def branchWeightGeneratorGoldbachStrengthCertificate :
    BranchWeightGeneratorGoldbachStrengthCertificate where
  goldbach_to_generator :=
    branchWeightGeneratorEveryEvenFiber_of_evenGoldbach
  generator_to_goldbach :=
    evenGoldbach_of_branchWeightGenerator
  iff_statement :=
    branchWeightGeneratorEveryEvenFiber_iff_evenGoldbach


end
end StandardModelConstraint
end SaturationMonoid
