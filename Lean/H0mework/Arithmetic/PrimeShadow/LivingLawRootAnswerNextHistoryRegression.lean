import H0mework.Foundation.Runtime.AnswerHistory
import H0mework.Arithmetic.PrimeShadow.LivingLawRootAnswerNextRegression
import H0mework.Arithmetic.PrimeShadow.LivingLawRootTemporalAnswerNextRegression

/-!
# Regression: a terminal answer remains inside one generated history

The first process state emits a compiler-generated local terminal.  Its
source-fixed handoff enters the existing native-write root.  The second row is
then generated by that root's own compiler.  Observation fuel ends the finite
readout; no terminal branch stops the process history.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace RootAnswerNextHistoryRegression

open SourceNativeLedgerCompilerRegression
open SourceNativeRootAuthorityRegression
open RootAnswerNextRegression
open RootTemporalAnswerNextRegression

def livingWriteRoot : SourceNativeLivingRootClosure N V :=
  SourceNativeAuthoritativeRootClosure.toLivingWithoutFaithfulTerminal
    (boolWorld false) (fun _current => by
      change IsEmpty PEmpty
      infer_instance)

/-- The write root has one source-generated finite visit at every requested
depth. -/
def writeRootVisit : Nat → RootVisit livingWriteRoot.toAuthoritativeRoot.toRoot
  | 0 => livingWriteRoot.toAuthoritativeRoot.toRoot.initialVisit
  | n + 1 => (writeRootVisit n).next rfl

/-- Temporal embedding is a readout of that exact finite history; it is not a
second successor spelling. -/
def writeTemporalVisit (n : Nat) :
    SourceNativeTemporalVisitAt
      livingWriteRoot.toAuthoritativeRoot.toLedgerRoot :=
  .finite (writeRootVisit n)

/-- Finite chronology has one normal form.  Taking one temporal successor is
definitionally the finite embedding of the extended root visit; there is no
second generic temporal-step spelling of the same causal history. -/
theorem finite_successor_is_canonical_root_visit :
    writeTemporalVisit 1 =
      .finite
        (livingWriteRoot.toAuthoritativeRoot.toRoot.initialVisit.next rfl) :=
  rfl

def stateAt : Option Nat → SourceNativeLivingRootCurrentAt N
  | none => ⟨TerminalV, livingTerminalRoot, .finite terminalVisit⟩
  | some n => ⟨V, livingWriteRoot, writeTemporalVisit n⟩

/-- Constructive finite depth of a heterogeneous process current when its
temporal history is finite. -/
def finiteDepth?
    (current : SourceNativeLivingRootCurrentAt N) : Option Nat :=
  match current.visit.history with
  | .finite history => some (ProductiveFiniteRootHistoryAt.causalDepth history)
  | .postCofinal _ => none

theorem writeTemporalVisit_depth (index : Nat) :
    finiteDepth? (stateAt (some index)) = some index := by
  induction index with
  | zero => rfl
  | succ index inductionHypothesis =>
      change
        some
            (ProductiveFiniteRootHistoryAt.causalDepth
                (writeRootVisit index).history + 1) =
          some (index + 1)
      have priorDepth :
          ProductiveFiniteRootHistoryAt.causalDepth
              (writeRootVisit index).history = index := by
        change
          some
              (ProductiveFiniteRootHistoryAt.causalDepth
                (writeRootVisit index).history) =
            some index at inductionHypothesis
        exact Option.some.inj inductionHypothesis
      rw [priorDepth]

theorem terminalVocabulary_ne_writeVocabulary : TerminalV ≠ V := by
  intro equality
  have fiber_eq := congrArg
    (fun vocabulary : Vocabulary =>
      Sigma fun current : vocabulary.Current =>
        vocabulary.FaithfulTerminalAt current) equality
  have impossible :
      Sigma fun current : V.Current => V.FaithfulTerminalAt current :=
    fiber_eq ▸ ⟨(), PUnit.unit⟩
  exact nomatch impossible.2

/-- The process carrier is only a presentation of registered living currents;
it contains no second state bit capable of selecting another future. -/
theorem stateAt_injective : Function.Injective stateAt := by
  intro left right equality
  cases left with
  | none =>
      cases right with
      | none => rfl
      | some right =>
          have vocabulary_eq := congrArg SourceNativeLivingRootCurrentAt.V equality
          exact False.elim (terminalVocabulary_ne_writeVocabulary vocabulary_eq)
  | some left =>
      cases right with
      | none =>
          have vocabulary_eq := congrArg SourceNativeLivingRootCurrentAt.V equality
          exact False.elim
            (terminalVocabulary_ne_writeVocabulary vocabulary_eq.symm)
      | some right =>
          have depth_eq := congrArg finiteDepth? equality
          rw [writeTemporalVisit_depth left, writeTemporalVisit_depth right] at depth_eq
          cases Option.some.inj depth_eq
          rfl

def successor : Option Nat → Option Nat
  | none => some 0
  | some n => some (n + 1)

def process : SourceNativeLivingRootProcess N where
  State := Option Nat
  stateAt := stateAt
  stateAt_injective := stateAt_injective
  initial := none
  successorAt := by
    intro state
    refine ⟨successor state, ?_⟩
    cases state with
    | none => exact ⟨rfl, trivial⟩
    | some n => exact ⟨rfl, by rfl⟩

def history : SourceNativeLivingRootHistoryAt process 2 none :=
  process.generateHistory 2 none

/-- The local terminal does not grant a free choice of the next world.  The
process successor erases to the exact handoff occurrence generated by that
terminal; only the target scope's later living law is new source state. -/
theorem terminal_successor_is_exact_generated_handoff :
    (process.stateAt (process.successor none)).erase =
      livingTerminalRoot.generatedTerminalHandoffAt
        (.finite terminalVisit) exactTerminalOccurrence :=
  rfl

/-- Read only the state reached after the requested finite prefix. -/
def historyTarget
    {fuel : Nat} {state : process.State} :
    SourceNativeLivingRootHistoryAt process fuel state → process.State
  | .exhausted target => target
  | .step tail => historyTarget tail

/-- The local terminal is row zero's typed answer; row one is already the
second visit of the native-write root. -/
theorem terminal_then_write_reaches_second_write_visit :
    historyTarget history = some 1 :=
  rfl

/-- A process-state presentation cannot hide a fork that appears only after
the current root occurrence has been registered. -/
theorem same_registered_current_cannot_fork
    {left right : process.State}
    (sameCurrent : process.stateAt left = process.stateAt right) :
    process.stateAt (process.successor left) =
      process.stateAt (process.successor right) :=
  process.successor_current_eq_of_current_eq sameCurrent

/-! A true cofinal landing enters the same process kernel.  Its later rows
extend the cofinal causal history instead of restarting from a finite visit. -/

def cofinalPostHistory : Nat → SourceNativePostCofinalReachableAt
    livingRoot.toAuthoritativeRoot.toLedgerRoot ()
  | 0 => .cofinal cofinalVisit
  | n + 1 => .step (cofinalPostHistory n) rfl

def cofinalProcessVisit (index : Nat) : SourceNativeTemporalVisitAt
    livingRoot.toAuthoritativeRoot.toLedgerRoot :=
  ⟨(), .postCofinal (cofinalPostHistory index)⟩

def postCofinalDepth
    {N : WorldRelationNetwork} {V : Vocabulary}
    {root : SourceNativeLedgerRootClosure N V}
    {current : V.Current} :
    SourceNativePostCofinalReachableAt
      root current → Nat
  | .cofinal _visit => 0
  | .step prior _next_eq => postCofinalDepth prior + 1

def cofinalDepth?
    (current : SourceNativeLivingRootCurrentAt N) : Option Nat :=
  match current.visit.history with
  | .finite _ => none
  | .postCofinal history => some (postCofinalDepth history)

theorem cofinalProcessVisit_depth (index : Nat) :
    cofinalDepth? ⟨V, livingRoot, cofinalProcessVisit index⟩ = some index := by
  induction index with
  | zero => rfl
  | succ index inductionHypothesis =>
      change some (postCofinalDepth (cofinalPostHistory index) + 1) =
        some (index + 1)
      have priorDepth : postCofinalDepth (cofinalPostHistory index) = index := by
        change some (postCofinalDepth (cofinalPostHistory index)) =
          some index at inductionHypothesis
        exact Option.some.inj inductionHypothesis
      rw [priorDepth]

def cofinalProcess : SourceNativeLivingRootProcess N where
  State := Nat
  stateAt := fun n => ⟨V, livingRoot, cofinalProcessVisit n⟩
  stateAt_injective := by
    intro left right equality
    have depth_eq := congrArg cofinalDepth? equality
    rw [cofinalProcessVisit_depth left, cofinalProcessVisit_depth right] at depth_eq
    exact Option.some.inj depth_eq
  initial := 0
  successorAt := fun n => ⟨Nat.succ n, rfl, by rfl⟩

def cofinalHistory : SourceNativeLivingRootHistoryAt
    cofinalProcess 2 cofinalProcess.initial :=
  cofinalProcess.generateHistory 2 cofinalProcess.initial

theorem cofinal_process_retains_boundary_after_successor :
    SourceNativeTemporalReachableAt.hasCofinalBoundary
      (cofinalProcess.stateAt
        (cofinalProcess.successor cofinalProcess.initial)).visit.history = true :=
  rfl

#print axioms terminal_successor_is_exact_generated_handoff
#print axioms SourceNativeLivingRootClosure.generatedNextCurrentAt_lawSurface_eq
#print axioms SourceNativeLivingRootProcess.successor_lawSurface_eq

