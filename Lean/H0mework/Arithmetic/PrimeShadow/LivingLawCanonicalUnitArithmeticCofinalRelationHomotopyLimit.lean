import H0mework.Arithmetic.UnitArithmetic.EulerLimit
import H0mework.Arithmetic.UnitArithmetic.CofinalReversalRelation
import H0mework.Realization.HomotopyLimits.Sequential
import H0mework.Realization.MappingCone.Functoriality

/-!
# Homotopy limit of the cofinal unit arithmetic relation tower

The stage-indexed reversal cokernels and their actual restrictions form one
inverse tower of one-term integral complexes.  The frozen sequential
homotopy-limit kernel generates the product, shift, `1 - shift` boundary,
mapping cocone, and derived restriction coherence on the same cofinal Euler
occurrence.  The result is the relation limit, not yet the determinant
zero-locus: that requires actual source-generated atoms and higher cells.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace CanonicalUnitArithmeticCofinalRelationHomotopyLimit

open CanonicalUnitArithmeticCofinalEulerLimit
open CanonicalUnitArithmeticCofinalReversalRelation
open CanonicalUnitArithmeticCommonCarrier
open CanonicalUnitArithmeticPrimePowerIncidence
open CategoryTheory
open CochainMappingCoconeFunctoriality
open SequentialHomotopyLimit

noncomputable section

attribute [local instance] HasDerivedCategory.standard

abbrev StageLatticeModule (stage : Nat) : ModuleCat.{0} ℤ :=
  ModuleCat.of ℤ (StageRelationLattice stage)

noncomputable abbrev stageLatticeComplex (stage : Nat) :
    IntegralCochainComplex :=
  (CochainComplex.singleFunctor (ModuleCat ℤ) 0).obj
    (StageLatticeModule stage)

noncomputable def stageBoundaryMap (stage : Nat) :
    stageLatticeComplex stage ⟶ stageLatticeComplex stage :=
  (CochainComplex.singleFunctor (ModuleCat ℤ) 0).map
    (ModuleCat.ofHom (stageBoundary stage))

/-- The full two-term reversal relation complex.  Taking the cokernel first
would make a classical coordinate projection equivalent to the desired
fixed-point conclusion; the mapping cocone retains the boundary as actual
derived material instead. -/
noncomputable abbrev stageComplex (stage : Nat) : IntegralCochainComplex :=
  CochainComplex.mappingCocone (stageBoundaryMap stage)

noncomputable def stageLatticeRestriction (stage : Nat) :
    stageLatticeComplex (stage + 1) ⟶ stageLatticeComplex stage :=
  (CochainComplex.singleFunctor (ModuleCat ℤ) 0).map
    (ModuleCat.ofHom (relationRestriction stage))

theorem stageLatticeRestriction_boundary_square (stage : Nat) :
    stageLatticeRestriction stage ≫ stageBoundaryMap stage =
      stageBoundaryMap (stage + 1) ≫ stageLatticeRestriction stage := by
  unfold stageLatticeRestriction stageBoundaryMap
  rw [← Functor.map_comp, ← Functor.map_comp]
  apply congrArg
  apply ModuleCat.hom_ext
  exact (relationRestriction_boundary_square stage).symm

/-- Mapping-cocone functoriality turns the actual reversal square into the
transition of full relation complexes. -/
noncomputable def stageTransition (stage : Nat) :
    stageComplex (stage + 1) ⟶ stageComplex stage :=
  mappingCoconeMap
    (stageBoundaryMap (stage + 1)) (stageBoundaryMap stage)
    (stageLatticeRestriction stage) (stageLatticeRestriction stage)
    (stageLatticeRestriction_boundary_square stage)

/-- Actual inverse tower generated by the reversal boundary squares. -/
noncomputable def relationTower : ℕᵒᵖ ⥤ IntegralCochainComplex :=
  Functor.ofOpSequence
    (X := stageComplex)
    stageTransition

abbrev TowerRoot :=
  (DomainPoint × CoordinateFreeRelationSource) × GeneratedCofinalEulerLimit

def dependentOccurrence : RootedAccountedUnfolding
    (TowerRoot × (ℕᵒᵖ ⥤ IntegralCochainComplex)) :=
  cofinalLimitOccurrence.map fun root => (root, relationTower)

def homotopyLimitFace : RootGeneratedSequentialHomotopyLimitAt
    dependentOccurrence :=
  RootGeneratedSequentialHomotopyLimitAt.generate

theorem homotopyLimitFace_projects_to_cofinalEulerRoot :
    homotopyLimitFace.root = cofinalLimitOccurrence := by
  rw [RootGeneratedSequentialHomotopyLimitAt.root, dependentOccurrence,
    RootedAccountedUnfolding.map_map]
  change cofinalLimitOccurrence.map id = cofinalLimitOccurrence
  exact RootedAccountedUnfolding.map_id _

theorem towerObject_eq (stage : Nat) :
    homotopyLimitFace.towerObject stage = stageComplex stage :=
  rfl

theorem transitionAt_eq (stage : Nat) :
    homotopyLimitFace.transitionAt stage = stageTransition stage :=
  Functor.ofOpSequence_map_homOfLE_succ stageTransition stage

/-- The coordinate-free derived limit of the actual relation tower. -/
abbrev derivedRelationLimit : IntegralCochainComplex :=
  homotopyLimitFace.homotopyLimit

theorem derived_difference_zero :
    DerivedCategory.Q.map
          (CochainComplex.mappingCocone.fst homotopyLimitFace.difference) ≫
        DerivedCategory.Q.map homotopyLimitFace.difference = 0 :=
  homotopyLimitFace.derivedDifference_zero

theorem derived_restriction_naturality (stage : Nat) :
    DerivedCategory.Q.map (homotopyLimitFace.restriction (stage + 1)) ≫
        DerivedCategory.Q.map (homotopyLimitFace.transitionAt stage) =
      DerivedCategory.Q.map (homotopyLimitFace.restriction stage) :=
  homotopyLimitFace.derivedRestriction_naturality stage

theorem preserves_common_root_and_stage_restrictions (stage : Nat) :
    homotopyLimitFace.root = dependentOccurrence.map Prod.fst ∧
      homotopyLimitFace.root.root = dependentOccurrence.root.1 ∧
      homotopyLimitFace.actualTower = dependentOccurrence.root.2 ∧
      homotopyLimitFace.towerObject stage =
        dependentOccurrence.root.2.obj (Opposite.op stage) ∧
      homotopyLimitFace.transitionAt stage =
        dependentOccurrence.root.2.map
          (homOfLE (Nat.le_add_right stage 1)).op :=
  homotopyLimitFace.preserves_shared_root_and_actual_tower stage

end
end CanonicalUnitArithmeticCofinalRelationHomotopyLimit
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
