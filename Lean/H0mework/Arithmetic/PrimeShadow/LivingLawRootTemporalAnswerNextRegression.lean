import H0mework.Foundation.Cofinal.TemporalAnswer
import H0mework.Foundation.Authority.Representation
import H0mework.Arithmetic.PrimeShadow.LivingLawRootSourceNativeAuthorityRegression

/-!
# Regression: a cofinal boundary remains inside the root answer-and-next law

The fixed one-current source generates every finite prefix and recognizes the
unique constant path's cofinal landing.  The boundary uses the same root
emitter, patch compiler, whole-ledger compiler, and next transition.  Its
successor history retains the cofinal constructor instead of restarting a
fresh finite `RootVisit`.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace RootTemporalAnswerNextRegression

open SourceNativeLedgerCompilerRegression
open SourceNativeRootAuthorityRegression

/-- The ambient event carrier may contain sibling values with the same state
target, but the source compiler emits exactly one of them at this generated
path.  Carrier inhabitance does not grant cofinal authority. -/
theorem sibling_boundary_values_do_not_share_authority :
    V.cofinal.target false = V.cofinal.target true ∧
      V.cofinal.emit? = some false ∧
      V.cofinal.emit? ≠ some true :=
  ⟨rfl, rfl, by
    change some false ≠ some true
    intro equality
    exact Bool.noConfusion (Option.some.inj equality)⟩

def livingRoot : SourceNativeLivingRootClosure N V :=
  (boolWorld false).toLivingWithoutFaithfulTerminal (fun _current => by
    change IsEmpty PEmpty
    infer_instance)

def productiveHistory :
    ProductiveFiniteRootHistoryAt livingRoot.toAuthoritativeRoot.toLedgerRoot where
  currentAt := fun _ => ()
  initial_eq := rfl
  next_eq := fun _ => rfl

def cofinalVisit : SourceNativeCofinalVisitAt
    livingRoot.toAuthoritativeRoot.toLedgerRoot :=
  (productiveHistory.generatedCofinalVisit? (fun _emitted_eq _index => rfl)).get
    (by rfl)

/-- A second proof presentation of the same deterministic path.  The cofinal
source may not use this record-level difference to select another event. -/
def alternateProductiveHistory :
    ProductiveFiniteRootHistoryAt livingRoot.toAuthoritativeRoot.toLedgerRoot where
  currentAt := fun index => Nat.rec () (fun _ _ => ()) index
  initial_eq := rfl
  next_eq := fun _ => rfl

def alternateCofinalVisit : SourceNativeCofinalVisitAt
    livingRoot.toAuthoritativeRoot.toLedgerRoot :=
  (alternateProductiveHistory.generatedCofinalVisit?
      (fun _emitted_eq index => by cases index <;> rfl)).get (by rfl)

theorem cofinal_history_presentation_cannot_change_visit :
    cofinalVisit = alternateCofinalVisit :=
  cofinalVisit.eq alternateCofinalVisit

def temporalVisit : SourceNativeTemporalVisitAt
    livingRoot.toAuthoritativeRoot.toLedgerRoot :=
  .cofinal cofinalVisit

def temporalEvolution : SourceNativeTemporalVisitGeneratedEvolutionAt
    livingRoot.toAuthoritativeRoot.toLedgerRoot temporalVisit :=
  livingRoot.toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit
    temporalVisit

/-- Complete temporal authority generated by the same admitted root and visit. -/
def authoritativeTemporalEvolution :
    SourceNativeAuthoritativeTemporalEvolutionAt
      livingRoot.toAuthoritativeRoot temporalVisit :=
  livingRoot.toAuthoritativeRoot.authoritativeEvolutionAt temporalVisit

/-- The sibling source generates its own temporal authority at the shared
lower ledger visit. -/
def siblingAuthoritativeTemporalEvolution :
    SourceNativeAuthoritativeTemporalEvolutionAt
      (boolWorld true) temporalVisit :=
  (boolWorld true).authoritativeEvolutionAt temporalVisit

/-- The ledger coordinate has no constructor for complete-source authority. -/
theorem erased_temporal_readout_cannot_mint_authority : True := by
  fail_if_success
    exact (temporalEvolution :
      SourceNativeAuthoritativeTemporalEvolutionAt
        livingRoot.toAuthoritativeRoot temporalVisit)
  trivial

/-- The complete-source compiler emits the root-sealed token. -/
theorem authority_compiler_cannot_emit_an_erased_token : True := by
  fail_if_success
    exact (livingRoot.toAuthoritativeRoot.temporalVisitAuthorityCompiler.compile
      temporalVisit :
        Sigma fun visit : SourceNativeTemporalVisitAt
            livingRoot.toAuthoritativeRoot.toLedgerRoot =>
          SourceNativeTemporalVisitGeneratedEvolutionAt
            livingRoot.toAuthoritativeRoot.toLedgerRoot visit)
  trivial

/-- Complete temporal authority restricts to the canonical ledger coordinate. -/
theorem authoritative_temporal_evolution_restricts_exactly :
    authoritativeTemporalEvolution.toLedgerReadout = temporalEvolution :=
  rfl

/-- An equal ledger root does not identify two complete source laws. -/
theorem sibling_source_temporal_authority_cannot_be_reused : True := by
  fail_if_success
    exact (authoritativeTemporalEvolution :
      SourceNativeAuthoritativeTemporalEvolutionAt
        (boolWorld true) temporalVisit)
  trivial

/-! ## Recurrent currents retain causal authority identity -/

def recurrentFirstHistory :
    livingRoot.toAuthoritativeRoot.toRoot.ReachableAt () :=
  livingRoot.toAuthoritativeRoot.toRoot.initialReachable

def recurrentSecondHistory :
    livingRoot.toAuthoritativeRoot.toRoot.ReachableAt () :=
  livingRoot.toAuthoritativeRoot.toRoot.nextReachable recurrentFirstHistory rfl

def recurrentFirstVisit : RootVisit livingRoot.toAuthoritativeRoot.toRoot :=
  ⟨(), recurrentFirstHistory⟩

def recurrentSecondVisit : RootVisit livingRoot.toAuthoritativeRoot.toRoot :=
  ⟨(), recurrentSecondHistory⟩

theorem recurrent_visits_are_distinct :
    recurrentFirstVisit ≠ recurrentSecondVisit := by
  intro equality
  cases equality

def recurrentFirstAuthority :
    SourceNativeAuthoritativeTemporalEvolutionAt
      livingRoot.toAuthoritativeRoot (.finite recurrentFirstVisit) :=
  livingRoot.toAuthoritativeRoot.authoritativeEvolutionAt
    (.finite recurrentFirstVisit)

def recurrentSecondAuthority :
    SourceNativeAuthoritativeTemporalEvolutionAt
      livingRoot.toAuthoritativeRoot (.finite recurrentSecondVisit) :=
  livingRoot.toAuthoritativeRoot.authoritativeEvolutionAt
    (.finite recurrentSecondVisit)

/-- Equal current labels do not permit causal-authority replay. -/
theorem recurrent_authority_cannot_replay_prior_history : True := by
  fail_if_success
    exact (recurrentFirstAuthority :
      SourceNativeAuthoritativeTemporalEvolutionAt
        livingRoot.toAuthoritativeRoot (.finite recurrentSecondVisit))
  trivial

theorem cofinal_occurrence_is_exact_root_emitter :
    temporalEvolution.occurrence =
      livingRoot.emitted temporalVisit.current :=
  temporalEvolution.occurrence_eq

/-- The boundary current is generated by the fixed cofinal event. -/
theorem cofinal_current_is_event_target :
    cofinalVisit.current = V.cofinal.target cofinalVisit.event :=
  cofinalVisit.current_eq_eventTarget

/-- The fixed source compiler, not merely the target current, fixes the exact
temporal visit. -/
theorem cofinal_event_identity_is_recorded
    (other : SourceNativeCofinalVisitAt
      livingRoot.toAuthoritativeRoot.toLedgerRoot) :
    other = cofinalVisit :=
  other.eq cofinalVisit

/-- A sibling value in the ambient event family cannot be wrapped as an
actual cofinal visit. -/
theorem unselected_cofinal_event_has_no_visit_authority : True := by
  fail_if_success
    exact ({ event := true, emitted_eq := rfl } :
      SourceNativeCofinalVisitAt livingRoot.toAuthoritativeRoot.toLedgerRoot)
  trivial

theorem cofinal_trace_is_exact_generated_stream :
    temporalEvolution.priorPatches =
      .cofinal
        (SourceNativeLedgerRootClosure.generatedCofinalPriorPatchesAt
          livingRoot.toAuthoritativeRoot.toLedgerRoot cofinalVisit) :=
  rfl

theorem cofinal_whole_ledger_is_root_compiler_image :
    HEq temporalEvolution.wholeLedgerWriteBack
      (SourceNativeLedgerRootClosure.generatedLedgerAt
        livingRoot.toAuthoritativeRoot.toLedgerRoot temporalVisit.current) :=
  temporalEvolution.wholeLedgerWriteBack_eq

theorem successor_retains_cofinal_history :
    (livingRoot.generatedNextCurrentAt temporalVisit).visit.history.hasCofinalBoundary =
      true :=
  rfl

/-- Static source readout and temporal coface are not two compatible outcome
grammars: they are the same dependent source-native fibre at this occurrence. -/
theorem cofinal_projection_temporal_face_is_source_face :
    HEq (temporalEvolution.projectionOutcome PUnit.unit)
      (livingRoot.toAuthoritativeRoot.projectionOutcomeAt PUnit.unit
        temporalVisit.current) :=
  temporalEvolution.projectionOutcome_heq_sourceOutcome PUnit.unit

/-- The causal trace is a direct coordinate of the common high-dimensional
occurrence, not a cross-domain transport. -/
theorem cofinal_trace_is_direct_root_coordinate :
    temporalEvolution.priorPatches =
      .cofinal
        (SourceNativeLedgerRootClosure.generatedCofinalPriorPatchesAt
          livingRoot.toAuthoritativeRoot.toLedgerRoot cofinalVisit) := by
  rfl

def cofinal_temporal_authority_is_canonical :
    CanonicalReceiptAuthority.CanonicalReceipt
      livingRoot.toAuthoritativeRoot.temporalVisitAuthorityCompiler
      ⟨temporalVisit, authoritativeTemporalEvolution⟩ :=
  SourceNativeAuthoritativeRootClosure.generatedAtTemporalVisit_isCanonical
    livingRoot.toAuthoritativeRoot temporalVisit

end RootTemporalAnswerNextRegression
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
