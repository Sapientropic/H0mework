import H0mework.Realization.Relations.P230
import H0mework.Realization.Residual.P327

/-!
# Proposition 328: P312+ closed forms and direct Goldbach search

The P312+ layer can expose three concrete artifacts without adding new
mathematical assumptions:

1. the retention density/gamma-law closed forms already proved by P229/P230;
2. the closed-form algebraic position of every nondegenerate sigma-atomic rate;
3. a finite direct Goldbach search algorithm, sound and complete for each
   fixed input `n`.

Boundary: the search algorithm is pointwise complete for a given `n`; it is not
a proof that every even `n ≥ 4` succeeds.  In the framework language, it is the
direct computation surface for the length-two H-space predicate, not a global
Goldbach theorem.
-/

open MeasureTheory ProbabilityTheory
open scoped Real Topology ENNReal

noncomputable section

set_option linter.unusedSectionVars false

namespace SaturationMonoid
namespace AffineRelaxation

variable {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]

/-! ## Retention closed forms, re-exported as a P312+ certificate layer -/

/-- THEOREM 1: P229's density-level retention curve is the shifted-power
closed form. -/
theorem retentionDensityClosedForm
    {shape rate time : ℝ}
    (hshape : 0 < shape) (hrate : 0 < rate) (htime : 0 ≤ time) :
    GammaMixtureForgetting.normalizedGammaDensityLaplace shape rate time =
      (1 + time / rate) ^ (-shape) :=
  GammaMixtureForgetting.normalizedGammaDensityLaplace_eq_shiftedPower
    hshape hrate htime

/-- THEOREM 2: P230's Mathlib gamma-law expectation is the same shifted-power
closed form. -/
theorem retentionGammaMeasureClosedForm
    {shape rate time : ℝ}
    (hshape : 0 < shape) (hrate : 0 < rate) (htime : 0 ≤ time) :
    ∫ x, Real.exp (-(x * time)) ∂(ProbabilityTheory.gammaMeasure shape rate) =
      (1 + time / rate) ^ (-shape) :=
  GammaMixtureForgetting.gammaMeasure_laplaceExpectation_eq_shiftedPower
    hshape hrate htime

/-! ## Sigma-atomic closed-form positions -/

/-- The closed-form algebraic position of the sigma-atomic rate generated by a
prime exponent. -/
def sigmaAtomicClosedPosition (σ : K) (p : PrimeExponent) : K :=
  1 - (1 - σ) ^ p.1

/-- THEOREM 3: sigma-atomic positions are exactly iterated effective rates at
prime exponents. -/
theorem sigmaAtomicClosedPosition_eq_iteratedRate
    (σ : K) (p : PrimeExponent) :
    sigmaAtomicClosedPosition σ p = iteratedRate σ p.1 := by
  rfl

/-- THEOREM 4: the residual/headroom of a sigma-atomic position is the prime
power `(1-σ)^p`. -/
theorem keep_sigmaAtomicClosedPosition
    (σ : K) (p : PrimeExponent) :
    1 - sigmaAtomicClosedPosition σ p = (1 - σ) ^ p.1 := by
  simp [sigmaAtomicClosedPosition]

/-- THEOREM 5: tagged sigma-atomic support has closed-form value
`1-(1-σ)^p`. -/
theorem primeToSigmaAtomicRateSupport_val_closedForm
    (σ : K) (hσ : σ ≠ 1) (p : PrimeExponent) :
    ((primeToSigmaAtomicRateSupport σ hσ p).1.1 : K) =
      sigmaAtomicClosedPosition σ p := by
  rfl

/-- THEOREM 6: on `0 < σ < 1`, closed-form atomic positions are faithful in
the prime exponent. -/
theorem sigmaAtomicClosedPosition_injective_of_mem_Ioo
    {σ : K} (hσ0 : 0 < σ) (hσ1 : σ < 1) :
    Function.Injective (sigmaAtomicClosedPosition σ) := by
  intro p q h
  apply Subtype.ext
  apply iteratedRate_injective_of_mem_Ioo hσ0 hσ1
  simpa [sigmaAtomicClosedPosition, iteratedRate] using h

/-- THEOREM 7: equality of closed-form atomic positions is exactly equality
of prime exponents on the nondegenerate interval. -/
theorem sigmaAtomicClosedPosition_eq_iff_of_mem_Ioo
    {σ : K} (hσ0 : 0 < σ) (hσ1 : σ < 1)
    {p q : PrimeExponent} :
    sigmaAtomicClosedPosition σ p = sigmaAtomicClosedPosition σ q ↔
      p = q := by
  constructor
  · intro h
    exact sigmaAtomicClosedPosition_injective_of_mem_Ioo hσ0 hσ1 h
  · intro h
    rw [h]

/-! ## Direct finite Goldbach search -/

/-- Candidate pairs searched for a Goldbach decomposition of `n`. -/
def goldbachCandidates (n : ℕ) : List (ℕ × ℕ) :=
  List.range (n + 1) ×ˢ List.range (n + 1)

/-- A raw natural-number pair is a Goldbach pair for `n`. -/
def GoldbachPairPredicate (n : ℕ) (pair : ℕ × ℕ) : Prop :=
  Nat.Prime pair.1 ∧ Nat.Prime pair.2 ∧ n = pair.1 + pair.2

instance goldbachPairPredicateDecidable
    (n : ℕ) (pair : ℕ × ℕ) :
    Decidable (GoldbachPairPredicate n pair) := by
  unfold GoldbachPairPredicate
  infer_instance

/-- Boolean predicate used by the direct finite search. -/
def goldbachPairBool (n : ℕ) (pair : ℕ × ℕ) : Bool :=
  decide (GoldbachPairPredicate n pair)

/-- Direct finite search for a Goldbach pair of `n`.  It scans all pairs
`0 ≤ p,q ≤ n`, which is a complete finite search space whenever
`n = p + q`. -/
def goldbachSearchNat (n : ℕ) : Option (ℕ × ℕ) :=
  (goldbachCandidates n).find? (goldbachPairBool n)

/-- THEOREM 8: if the direct search returns a pair, that pair is genuinely a
Goldbach pair for `n`. -/
theorem goldbachSearchNat_sound
    {n : ℕ} {pair : ℕ × ℕ}
    (h : goldbachSearchNat n = some pair) :
    GoldbachPairPredicate n pair := by
  have hb :
      goldbachPairBool n pair = true := by
    exact List.find?_some h
  exact of_decide_eq_true (by
    simpa [goldbachPairBool] using hb)

/-- THEOREM 9: the finite search space contains every witness to
`HasPrimeAdditiveDecomposition n`. -/
theorem goldbachWitness_mem_candidates
    {n : ℕ} (p q : PrimeExponent)
    (h : n = p.1 + q.1) :
    (p.1, q.1) ∈ goldbachCandidates n := by
  rw [goldbachCandidates, List.mem_product]
  constructor
  · rw [List.mem_range]
    have hp_le : p.1 ≤ n := by
      rw [h]
      exact Nat.le_add_right p.1 q.1
    exact Nat.lt_succ_of_le hp_le
  · rw [List.mem_range]
    have hq_le : q.1 ≤ n := by
      rw [h]
      exact Nat.le_add_left q.1 p.1
    exact Nat.lt_succ_of_le hq_le

/-- THEOREM 10: direct search succeeds exactly when the ordinary pointwise
Goldbach predicate holds at `n`. -/
theorem goldbachSearchNat_isSome_iff
    (n : ℕ) :
    (goldbachSearchNat n).isSome = true ↔
      HasPrimeAdditiveDecomposition n := by
  rw [goldbachSearchNat, List.find?_isSome]
  constructor
  · rintro ⟨pair, _hmem, hbool⟩
    have hp : GoldbachPairPredicate n pair := of_decide_eq_true (by
      simpa [goldbachPairBool] using hbool)
    exact ⟨⟨pair.1, hp.1⟩, ⟨pair.2, hp.2.1⟩, hp.2.2⟩
  · rintro ⟨p, q, hsum⟩
    refine ⟨(p.1, q.1), goldbachWitness_mem_candidates p q hsum, ?_⟩
    unfold goldbachPairBool
    exact decide_eq_true ⟨p.2, q.2, hsum⟩

/-- THEOREM 11: direct search succeeds on even input `2*n` exactly when the
pointwise even Goldbach predicate holds there. -/
theorem goldbachSearchNat_even_isSome_iff
    (n : ℕ) :
    (goldbachSearchNat (2 * n)).isSome = true ↔
      HasPrimeAdditiveDecomposition (2 * n) :=
  goldbachSearchNat_isSome_iff (2 * n)

/-- A compact certificate for the P312+ closed-form/direct-computation layer.
-/
structure P312PlusClosedFormAndSearchCertificate where
  retention_density_closed :
    ∀ {shape rate time : ℝ}, 0 < shape -> 0 < rate -> 0 ≤ time ->
      GammaMixtureForgetting.normalizedGammaDensityLaplace shape rate time =
        (1 + time / rate) ^ (-shape)
  retention_gamma_measure_closed :
    ∀ {shape rate time : ℝ}, 0 < shape -> 0 < rate -> 0 ≤ time ->
      (∫ x, Real.exp (-(x * time)) ∂
        (ProbabilityTheory.gammaMeasure shape rate)) =
        (1 + time / rate) ^ (-shape)
  sigma_atomic_position :
    ∀ (σ : ℝ) (p : PrimeExponent),
      sigmaAtomicClosedPosition σ p = 1 - (1 - σ) ^ p.1
  sigma_atomic_position_faithful :
    ∀ {σ : ℝ}, 0 < σ -> σ < 1 ->
      Function.Injective (sigmaAtomicClosedPosition σ)
  goldbach_search_sound :
    ∀ {n : ℕ} {pair : ℕ × ℕ},
      goldbachSearchNat n = some pair -> GoldbachPairPredicate n pair
  goldbach_search_complete :
    ∀ n : ℕ,
      (goldbachSearchNat n).isSome = true ↔
        HasPrimeAdditiveDecomposition n

/-- THEOREM 12: the canonical P312+ closed-form/direct-search certificate. -/
theorem p312PlusClosedFormAndSearchCertificate :
    P312PlusClosedFormAndSearchCertificate where
  retention_density_closed := by
    intro shape rate time hshape hrate htime
    exact retentionDensityClosedForm hshape hrate htime
  retention_gamma_measure_closed := by
    intro shape rate time hshape hrate htime
    exact retentionGammaMeasureClosedForm hshape hrate htime
  sigma_atomic_position := by
    intro σ p
    rfl
  sigma_atomic_position_faithful := by
    intro σ hσ0 hσ1
    exact sigmaAtomicClosedPosition_injective_of_mem_Ioo hσ0 hσ1
  goldbach_search_sound := by
    intro n pair h
    exact goldbachSearchNat_sound h
  goldbach_search_complete := goldbachSearchNat_isSome_iff

end AffineRelaxation
end SaturationMonoid
