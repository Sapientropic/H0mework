import H0mework.Realization.Residual.P743
import H0mework.Arithmetic.PrimeShadow.P755

/-!
# Proposition 756: prime-pair fixedness is zero trace production

P754 turned the explicit prime-pair producer into zero residual energy.
P755 turned the same producer into dynamical fixedness under the certified
phase-flow step.  P743 says the first formula is the residual split

`r = residualKeep sigma r + residualTrace sigma r`.

This file welds the same arithmetic residual to the trace/information side of
that split.  At the canonical half-rate, the trace produced by the residual
`N - p - q` is `1/2 * (N - p - q)`, so zero trace production is equivalent to
the residual itself being zero.  Thus the remaining producer is simultaneously:

* an explicit prime-pair producer,
* a zero-energy producer,
* a dynamical fixed-point producer,
* and a zero-trace/information producer.
-/

noncomputable section

namespace SaturationMonoid
namespace AffineRelaxation

open ComplexityProjection

/-! ## Arithmetic residual trace -/

/-- The canonical half-rate trace generated by the arithmetic residual
`N - p - q`.  This is the P743 trace side of the same residual carrier used in
P754/P755. -/
def goldbachInformationTrace (target : ℕ)
    (pair : PrimeExponent × PrimeExponent) : ℝ :=
  residualTrace (K := ℝ) (E := ℝ) (1 / 2 : ℝ)
    ((goldbachPairResidual target pair) ())

/-- THEOREM 1: the arithmetic information trace is exactly half the
prime-pair residual. -/
theorem goldbachInformationTrace_eq_half_residual
    (target : ℕ) (pair : PrimeExponent × PrimeExponent) :
    goldbachInformationTrace target pair =
      (1 / 2 : ℝ) *
        ((target : ℝ) - (pair.1.1 : ℝ) - (pair.2.1 : ℝ)) := by
  simp [goldbachInformationTrace, goldbachPairResidual, residualTrace]

/-- THEOREM 2: zero trace production is exactly the additive prime-pair
equation. -/
theorem goldbachInformationTrace_zero_iff_sum
    (target : ℕ) (pair : PrimeExponent × PrimeExponent) :
    goldbachInformationTrace target pair = 0 ↔
      target = pair.1.1 + pair.2.1 := by
  constructor
  · intro htrace
    rw [goldbachInformationTrace_eq_half_residual] at htrace
    have hres :
        (target : ℝ) - (pair.1.1 : ℝ) - (pair.2.1 : ℝ) = 0 := by
      nlinarith
    have hcast :
        (target : ℝ) = ((pair.1.1 + pair.2.1 : ℕ) : ℝ) := by
      norm_num
      linarith
    exact_mod_cast hcast
  · intro hsum
    rw [goldbachInformationTrace_eq_half_residual]
    have hcast :
        (target : ℝ) = ((pair.1.1 + pair.2.1 : ℕ) : ℝ) := by
      exact_mod_cast hsum
    norm_num [hcast]

/-- THEOREM 3: zero trace production is exactly zero shared energy. -/
theorem goldbachInformationTrace_zero_iff_zeroEnergy
    (target : ℕ) (pair : PrimeExponent × PrimeExponent) :
    goldbachInformationTrace target pair = 0 ↔
      hamiltonianEnergyReadout (goldbachEnergyState target pair) = 0 :=
  (goldbachInformationTrace_zero_iff_sum target pair).trans
    (goldbachEnergyState_zero_iff_sum target pair).symm

/-- THEOREM 4: zero trace production is exactly dynamical fixedness. -/
theorem goldbachInformationTrace_zero_iff_fixedPoint
    (target : ℕ) (pair : PrimeExponent × PrimeExponent) :
    goldbachInformationTrace target pair = 0 ↔
      goldbachDynamicalFixedPoint target pair :=
  (goldbachInformationTrace_zero_iff_sum target pair).trans
    (goldbachDynamicalFixedPoint_iff_sum target pair).symm

/-! ## Global zero-trace producer surfaces -/

/-- A global even-Goldbach producer read through the P743 trace/information
side of the residual split: for every even target it chooses a typed prime pair
whose arithmetic residual produces zero trace at the canonical half-rate. -/
structure EvenGoldbachTraceInformationProducer where
  pick : (n : ℕ) -> 2 ≤ n -> PrimeExponent × PrimeExponent
  trace_zero :
    ∀ (n : ℕ) (hn : 2 ≤ n),
      goldbachInformationTrace (2 * n) (pick n hn) = 0

/-- THEOREM 5: global zero-trace production is equivalent to the explicit
prime-pair producer. -/
theorem evenGoldbachTraceInformationProducer_iff_primePairProducer :
    Nonempty EvenGoldbachTraceInformationProducer ↔
      Nonempty EvenGoldbachPrimePairProducer := by
  constructor
  · rintro ⟨T⟩
    refine ⟨{ pick := T.pick, sum_pick := ?_ }⟩
    intro n hn
    exact (goldbachInformationTrace_zero_iff_sum (2 * n) (T.pick n hn)).mp
      (T.trace_zero n hn)
  · rintro ⟨P⟩
    refine ⟨{ pick := P.pick, trace_zero := ?_ }⟩
    intro n hn
    exact (goldbachInformationTrace_zero_iff_sum (2 * n) (P.pick n hn)).mpr
      (P.sum_pick n hn)

/-- THEOREM 6: global zero-trace production is exactly ordinary even
Goldbach. -/
theorem evenGoldbachTraceInformationProducer_iff_goldbach :
    Nonempty EvenGoldbachTraceInformationProducer ↔ EvenGoldbachStatement :=
  evenGoldbachTraceInformationProducer_iff_primePairProducer.trans
    evenGoldbachPrimePairProducer_iff_goldbach

/-- THEOREM 7: global zero-trace production is exactly global zero-energy
production. -/
theorem evenGoldbachTraceInformationProducer_iff_zeroEnergyProducer :
    Nonempty EvenGoldbachTraceInformationProducer ↔
      Nonempty EvenGoldbachZeroEnergyProducer :=
  evenGoldbachTraceInformationProducer_iff_primePairProducer.trans
    evenGoldbachZeroEnergyProducer_iff_primePairProducer.symm

/-- THEOREM 8: global zero-trace production is exactly global dynamical
fixed-point production. -/
theorem evenGoldbachTraceInformationProducer_iff_fixedPointProducer :
    Nonempty EvenGoldbachTraceInformationProducer ↔
      Nonempty EvenGoldbachDynamicalFixedPointProducer :=
  evenGoldbachTraceInformationProducer_iff_primePairProducer.trans
    evenGoldbachDynamicalFixedPointProducer_iff_primePairProducer.symm

/-- A search-backed zero-trace surface: the P329 search returns a typed pair
whose arithmetic residual produces zero trace. -/
def EvenGoldbachSearchTraceInformationSuccess : Prop :=
  ∀ (n : ℕ), 2 ≤ n ->
    ∃ p q : PrimeExponent,
      goldbachSearchPrimePair (2 * n) = some (p, q) ∧
        goldbachInformationTrace (2 * n) (p, q) = 0

/-- THEOREM 9: search-backed zero trace is exactly ordinary even Goldbach. -/
theorem evenGoldbachSearchTraceInformationSuccess_iff_goldbach :
    EvenGoldbachSearchTraceInformationSuccess ↔ EvenGoldbachStatement := by
  constructor
  · intro h n hn
    rcases h n hn with ⟨p, q, _hsearch, htrace⟩
    exact ⟨p, q,
      (goldbachInformationTrace_zero_iff_sum (2 * n) (p, q)).mp htrace⟩
  · intro h n hn
    have hsome :
        (goldbachSearchPrimePair (2 * n)).isSome = true := by
      exact (goldbachSearchPrimePair_isSome_iff (2 * n)).mpr (h n hn)
    cases hsearch : goldbachSearchPrimePair (2 * n) with
    | none =>
        simp [hsearch] at hsome
    | some pair =>
        rcases pair with ⟨p, q⟩
        refine ⟨p, q, rfl, ?_⟩
        have hsum : 2 * n = p.1 + q.1 :=
          goldbachSearchPrimePair_sound hsearch
        exact (goldbachInformationTrace_zero_iff_sum (2 * n) (p, q)).mpr hsum

/-- THEOREM 10: the natural-coded Euler-pullback representative producer
exists exactly when the global zero-trace producer exists. -/
theorem naturalCodedEulerPullbackRepresentativeProducer_iff_traceInformation :
    Nonempty (CodedDescentEulerPullbackRepresentativeProducer
      naturalCodedSpectralExponentAdapter) ↔
      Nonempty EvenGoldbachTraceInformationProducer :=
  naturalCodedEulerPullbackRepresentativeProducer_iff_primePairProducer.trans
    evenGoldbachTraceInformationProducer_iff_primePairProducer.symm

/-- THEOREM 11: the natural-coded Euler-pullback representative producer
exists exactly when P329 search returns zero-trace witnesses globally. -/
theorem naturalCodedEulerPullbackRepresentativeProducer_iff_searchTraceInformation :
    Nonempty (CodedDescentEulerPullbackRepresentativeProducer
      naturalCodedSpectralExponentAdapter) ↔
      EvenGoldbachSearchTraceInformationSuccess :=
  naturalCodedEulerPullbackRepresentativeProducer_iff_goldbach.trans
    evenGoldbachSearchTraceInformationSuccess_iff_goldbach.symm

/-! ## Certificate packaging -/

/-- P756 certificate: the remaining prime-pair/energy/fixed-point producer is
also exactly the zero-trace side of the P743 first formula. -/
structure NaturalCodedPrimePairTraceInformationCertificate where
  trace_zero_iff_sum :
    ∀ (target : ℕ) (pair : PrimeExponent × PrimeExponent),
      goldbachInformationTrace target pair = 0 ↔
        target = pair.1.1 + pair.2.1
  trace_zero_iff_zero_energy :
    ∀ (target : ℕ) (pair : PrimeExponent × PrimeExponent),
      goldbachInformationTrace target pair = 0 ↔
        hamiltonianEnergyReadout (goldbachEnergyState target pair) = 0
  trace_zero_iff_fixed_point :
    ∀ (target : ℕ) (pair : PrimeExponent × PrimeExponent),
      goldbachInformationTrace target pair = 0 ↔
        goldbachDynamicalFixedPoint target pair
  trace_information_producer_iff_prime_pair_producer :
    Nonempty EvenGoldbachTraceInformationProducer ↔
      Nonempty EvenGoldbachPrimePairProducer
  trace_information_producer_iff_goldbach :
    Nonempty EvenGoldbachTraceInformationProducer ↔ EvenGoldbachStatement
  trace_information_producer_iff_zero_energy_producer :
    Nonempty EvenGoldbachTraceInformationProducer ↔
      Nonempty EvenGoldbachZeroEnergyProducer
  trace_information_producer_iff_fixed_point_producer :
    Nonempty EvenGoldbachTraceInformationProducer ↔
      Nonempty EvenGoldbachDynamicalFixedPointProducer
  search_trace_information_iff_goldbach :
    EvenGoldbachSearchTraceInformationSuccess ↔ EvenGoldbachStatement
  euler_pullback_iff_trace_information :
    Nonempty (CodedDescentEulerPullbackRepresentativeProducer
      naturalCodedSpectralExponentAdapter) ↔
      Nonempty EvenGoldbachTraceInformationProducer
  euler_pullback_iff_search_trace_information :
    Nonempty (CodedDescentEulerPullbackRepresentativeProducer
      naturalCodedSpectralExponentAdapter) ↔
      EvenGoldbachSearchTraceInformationSuccess
  p743_first_formula :
    ResidualSplitFirstFormulaCertificate.{0, 0, 0}
  p755_fixed_point_bridge :
    NaturalCodedPrimePairFixedPointCertificate

/-- THEOREM 12: canonical P756 certificate. -/
def naturalCodedPrimePairTraceInformationCertificate :
    NaturalCodedPrimePairTraceInformationCertificate where
  trace_zero_iff_sum := goldbachInformationTrace_zero_iff_sum
  trace_zero_iff_zero_energy := goldbachInformationTrace_zero_iff_zeroEnergy
  trace_zero_iff_fixed_point := goldbachInformationTrace_zero_iff_fixedPoint
  trace_information_producer_iff_prime_pair_producer :=
    evenGoldbachTraceInformationProducer_iff_primePairProducer
  trace_information_producer_iff_goldbach :=
    evenGoldbachTraceInformationProducer_iff_goldbach
  trace_information_producer_iff_zero_energy_producer :=
    evenGoldbachTraceInformationProducer_iff_zeroEnergyProducer
  trace_information_producer_iff_fixed_point_producer :=
    evenGoldbachTraceInformationProducer_iff_fixedPointProducer
  search_trace_information_iff_goldbach :=
    evenGoldbachSearchTraceInformationSuccess_iff_goldbach
  euler_pullback_iff_trace_information :=
    naturalCodedEulerPullbackRepresentativeProducer_iff_traceInformation
  euler_pullback_iff_search_trace_information :=
    naturalCodedEulerPullbackRepresentativeProducer_iff_searchTraceInformation
  p743_first_formula := residualSplitFirstFormulaCertificate
  p755_fixed_point_bridge := naturalCodedPrimePairFixedPointCertificate

end AffineRelaxation

/-! ## Grand-root packaging -/

namespace GrandUnification

open AffineRelaxation

universe u

/-- P756 root: the natural-coded mathematical producer, zero-energy producer,
fixed-point producer, and P743 zero-trace information producer are the same
remaining front. -/
structure NaturalCodedPrimePairTraceInformationRootCertificate
    (E : Type u) [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [CompleteSpace E] where
  p755_root :
    NaturalCodedPrimePairFixedPointRootCertificate E
  trace_information_bridge :
    NaturalCodedPrimePairTraceInformationCertificate

/-- THEOREM 13: canonical P756 root certificate. -/
def naturalCodedPrimePairTraceInformationRootCertificate
    (E : Type u) [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [CompleteSpace E] :
    NaturalCodedPrimePairTraceInformationRootCertificate E where
  p755_root := naturalCodedPrimePairFixedPointRootCertificate (E := E)
  trace_information_bridge := naturalCodedPrimePairTraceInformationCertificate

end GrandUnification
