import H0mework.Realization.RelaxationFlow.P305

/-!
# Proposition 306: sigma-atomic rates are prime iteration steps

Propositions 303--305 put the arithmetic spine in the right order:

* iteration counts `n : ℕ` are primary;
* serial iteration gives addition of counts;
* iteration-of-iteration gives multiplication of counts;
* noisy-OR rates are the effective rates induced by those counts.

This file names the corresponding atoms.  A `σ`-atomic element is an effective
rate whose iteration exponent is prime.

There are two honest versions.

* The tagged version remembers the prime exponent that produced the rate.  It
  is unconditionally equivalent to the subtype of prime natural numbers.
* The untagged support inside the non-absorbing noisy-OR rate group is
  equivalent to the prime subtype when the `σ`-iteration map is injective.  This
  nondegeneracy condition is necessary: for example `σ = 0` collapses every
  iteration count to the identity rate.
-/

noncomputable section

namespace SaturationMonoid
namespace AffineRelaxation

open SatOrFieldAlgebra

variable {K : Type*} [Field K]

/-! ## Prime iteration exponents -/

/-- The subtype of prime natural numbers, used as the arithmetic target of
sigma-atomic elements. -/
abbrev PrimeExponent : Type :=
  { n : ℕ // Nat.Prime n }

/-- A tagged `σ`-atomic element: a prime iteration exponent together with the
effective `σ`-rate it generates.  The rate is a projection, not extra data, so
this type cannot silently identify two different prime exponents in degenerate
fields or at degenerate base rates. -/
structure SigmaAtomicElement (σ : K) (hσ : σ ≠ 1) where
  exponent : ℕ
  prime_exponent : Nat.Prime exponent

/-- The effective noisy-OR rate generated by a tagged `σ`-atomic element. -/
def SigmaAtomicElement.rate
    {σ : K} {hσ : σ ≠ 1}
    (a : SigmaAtomicElement σ hσ) :
    NonAbsorbingRate (α := K) :=
  iteratedNonAbsorbingRate σ hσ a.exponent

@[simp] theorem SigmaAtomicElement.rate_val
    {σ : K} {hσ : σ ≠ 1}
    (a : SigmaAtomicElement σ hσ) :
    a.rate.1 = iteratedRate σ a.exponent := rfl

/-- THEOREM 1: tagged `σ`-atomic elements are exactly prime exponents. -/
def sigmaAtomicElementEquivPrimes
    (σ : K) (hσ : σ ≠ 1) :
    SigmaAtomicElement σ hσ ≃ PrimeExponent where
  toFun a := ⟨a.exponent, a.prime_exponent⟩
  invFun p := ⟨p.1, p.2⟩
  left_inv := by
    intro a
    cases a
    rfl
  right_inv := by
    intro p
    cases p
    rfl

/-! ## Untagged atomic support in the rate group -/

/-- The untagged support of prime-generated effective rates inside the
non-absorbing noisy-OR rate group. -/
def SigmaAtomicRateSupport
    (σ : K) (hσ : σ ≠ 1) : Type _ :=
  { r : NonAbsorbingRate (α := K) //
      ∃ p : ℕ, Nat.Prime p ∧ r = iteratedNonAbsorbingRate σ hσ p }

/-- The rate-support map from prime exponents into untagged sigma-atomic
support. -/
def primeToSigmaAtomicRateSupport
    (σ : K) (hσ : σ ≠ 1) :
    PrimeExponent → SigmaAtomicRateSupport σ hσ :=
  fun p =>
    ⟨iteratedNonAbsorbingRate σ hσ p.1,
      ⟨p.1, p.2, rfl⟩⟩

/-- The exponent selected from an untagged atomic support element.  This is
classical because support membership stores existence, not a canonical witness.
-/
def SigmaAtomicRateSupport.exponent
    {σ : K} {hσ : σ ≠ 1}
    (r : SigmaAtomicRateSupport σ hσ) : ℕ :=
  Classical.choose r.2

/-- The selected exponent is prime. -/
theorem SigmaAtomicRateSupport.exponent_prime
    {σ : K} {hσ : σ ≠ 1}
    (r : SigmaAtomicRateSupport σ hσ) :
    Nat.Prime r.exponent :=
  (Classical.choose_spec r.2).1

/-- The selected exponent really generates the support element. -/
theorem SigmaAtomicRateSupport.eq_iterated_exponent
    {σ : K} {hσ : σ ≠ 1}
    (r : SigmaAtomicRateSupport σ hσ) :
    r.1 = iteratedNonAbsorbingRate σ hσ r.exponent :=
  (Classical.choose_spec r.2).2

/-- Read an untagged support element back as a prime exponent. -/
def SigmaAtomicRateSupport.toPrimeExponent
    {σ : K} {hσ : σ ≠ 1}
    (r : SigmaAtomicRateSupport σ hσ) : PrimeExponent :=
  ⟨r.exponent, r.exponent_prime⟩

/-- THEOREM 2: if the iteration map has no period/collapse, prime exponents
and untagged sigma-atomic rates are equivalent. -/
def sigmaAtomicRateSupportEquivPrimes
    (σ : K) (hσ : σ ≠ 1)
    (hinj :
      Function.Injective
        (fun n : ℕ => iteratedNonAbsorbingRate σ hσ n)) :
    SigmaAtomicRateSupport σ hσ ≃ PrimeExponent where
  toFun r := r.toPrimeExponent
  invFun p := primeToSigmaAtomicRateSupport σ hσ p
  left_inv := by
    intro r
    change primeToSigmaAtomicRateSupport σ hσ r.toPrimeExponent = r
    apply Subtype.ext
    exact r.eq_iterated_exponent.symm
  right_inv := by
    intro p
    apply Subtype.ext
    have hchosen :
        (primeToSigmaAtomicRateSupport σ hσ p).toPrimeExponent.1 = p.1 := by
      apply hinj
      exact (primeToSigmaAtomicRateSupport σ hσ p).eq_iterated_exponent.symm
    exact hchosen

/-- THEOREM 3: in unbundled form, the inverse map sends a prime `p` to the
`p`-step effective rate. -/
@[simp] theorem sigmaAtomicRateSupportEquivPrimes_symm_apply_val
    (σ : K) (hσ : σ ≠ 1)
    (hinj :
      Function.Injective
        (fun n : ℕ => iteratedNonAbsorbingRate σ hσ n))
    (p : PrimeExponent) :
    ((sigmaAtomicRateSupportEquivPrimes σ hσ hinj).symm p).1.1 =
      iteratedRate σ p.1 := rfl

/-- THEOREM 4: without the injectivity/nonperiodicity hypothesis, the untagged
support can collapse.  At base rate `σ = 0`, every iteration count has the same
effective rate. -/
theorem iteratedNonAbsorbingRate_zero_base_eq
    (n m : ℕ) :
    iteratedNonAbsorbingRate (K := K) 0 (by simp) n =
      iteratedNonAbsorbingRate (K := K) 0 (by simp) m := by
  ext
  simp [iteratedNonAbsorbingRate, iteratedRate]

/-- A compact certificate for sigma-atomicity as prime iteration. -/
structure SigmaAtomicPrimeCertificate
    (σ : K) (hσ : σ ≠ 1) where
  tagged_equiv_primes :
    SigmaAtomicElement σ hσ ≃ PrimeExponent
  support_equiv_primes_of_injective :
    Function.Injective
        (fun n : ℕ => iteratedNonAbsorbingRate σ hσ n) →
      SigmaAtomicRateSupport σ hσ ≃ PrimeExponent
  zero_base_collapses :
    ∀ n m : ℕ,
      iteratedNonAbsorbingRate (K := K) 0 (by simp) n =
        iteratedNonAbsorbingRate (K := K) 0 (by simp) m

/-- THEOREM 5: the canonical sigma-atomic prime certificate. -/
def sigmaAtomicPrimeCertificate
    (σ : K) (hσ : σ ≠ 1) :
    SigmaAtomicPrimeCertificate σ hσ where
  tagged_equiv_primes := sigmaAtomicElementEquivPrimes σ hσ
  support_equiv_primes_of_injective :=
    sigmaAtomicRateSupportEquivPrimes σ hσ
  zero_base_collapses := iteratedNonAbsorbingRate_zero_base_eq

end AffineRelaxation
end SaturationMonoid
