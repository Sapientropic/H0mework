import H0mework.Arithmetic.PrimeProjection.P321
import Mathlib.NumberTheory.EulerProduct.DirichletLSeries

/-!
# Proposition 322: Euler product as the prime-indexed coupling seed

P321 showed that the concrete Goldbach/H1 bridge cannot live on the
unconstrained product carrier: arithmetic rates and H1 spectral phases can be
varied independently there.

The user's next observation is the right correction: the Euler product is not
another projected predicate.  It is the prime-indexed producer that couples the
arithmetic and analytic sides.

This file formalizes the part that can be machine-checked now:

* the half-sigma atomic support uses the same prime index as Mathlib's Euler
  product (`Nat.Primes`);
* Mathlib's real Riemann zeta has the Euler product on `Re(s) > 1`;
* the same half-plane is zero-free for `riemannZeta`;
* the Goldbach side is the already-proved half-sigma additive-prime projection.

Boundary: this is a coupling-seed certificate, not RH, not Goldbach, and not
the final faithful-pullback proof.  It says the next carrier must be the graph
or descent object generated by this Euler prime producer, rather than the
free product carrier refuted in P321.
-/

noncomputable section

namespace SaturationMonoid
namespace AffineRelaxation

open Complex

/-! ## Prime support shared by sigma-atomicity and Euler products -/

/-- The project-local prime-exponent type is exactly Mathlib's `Nat.Primes`.
-/
def primeExponentEquivNatPrimes : PrimeExponent ≃ Nat.Primes :=
  { toFun := fun p => ⟨p.1, p.2⟩
    invFun := fun p => ⟨p.1, p.2⟩
    left_inv := by
      intro p
      cases p
      rfl
    right_inv := by
      intro p
      cases p
      rfl }

/-- The half-sigma atomic rate support is indexed by the same prime type used
by Mathlib's Euler products. -/
def halfSigmaAtomicSupportEquivNatPrimes :
    SigmaAtomicRateSupport (K := ℝ) (1 / 2 : ℝ)
        (ne_of_lt halfSigma_mem_Ioo.2) ≃ Nat.Primes :=
  (sigmaAtomicRateSupportEquivPrimes_of_mem_Ioo
      (K := ℝ) halfSigma_mem_Ioo.1 halfSigma_mem_Ioo.2).trans
    primeExponentEquivNatPrimes

/-! ## The analytic Euler product side -/

/-- THEOREM 1: Riemann zeta has its Euler product on the half-plane
`Re(s) > 1`, indexed by the same prime subtype. -/
theorem riemannZeta_eulerProduct_hasProd_primeExponent
    {s : ℂ} (hs : 1 < s.re) :
    HasProd
      (fun p : PrimeExponent => (1 - (p.1 : ℂ) ^ (-s))⁻¹)
      (riemannZeta s) := by
  let f : Nat.Primes → ℂ :=
    fun p => (1 - ((p : ℕ) : ℂ) ^ (-s))⁻¹
  have h : HasProd f (riemannZeta s) := by
    simpa [f] using riemannZeta_eulerProduct_hasProd (s := s) hs
  have h' :
      HasProd (f ∘ primeExponentEquivNatPrimes) (riemannZeta s) :=
    (primeExponentEquivNatPrimes.hasProd_iff
      (f := f) (a := riemannZeta s)).mpr h
  convert h' using 1 <;>
    rfl

/-- THEOREM 2: equivalently, the prime-indexed Euler product equals zeta as a
topological product. -/
theorem riemannZeta_eulerProduct_tprod_primeExponent
    {s : ℂ} (hs : 1 < s.re) :
    (∏' p : PrimeExponent, (1 - (p.1 : ℂ) ^ (-s))⁻¹) =
      riemannZeta s := by
  exact (riemannZeta_eulerProduct_hasProd_primeExponent (s := s) hs).tprod_eq

/-- THEOREM 3: on the Euler-product half-plane, the zeta value is nonzero.
This is the analytic "zero-location" face that Euler product really supplies;
it is far weaker than RH, but it is an honest zero-free region. -/
theorem riemannZeta_ne_zero_on_eulerProduct_halfPlane
    {s : ℂ} (hs : 1 < s.re) :
    riemannZeta s ≠ 0 :=
  riemannZeta_ne_zero_of_one_lt_re hs

/-! ## The algebraic Goldbach projection side -/

/-- THEOREM 4: the Goldbach projection on the half-sigma rate image is exactly
ordinary additive prime decomposition of the exponent. -/
theorem halfSigmaEulerPrime_goldbachProjection
    (n : ℕ) :
    HalfSigmaRateGoldbachComplete (iteratedRate (1 / 2 : ℝ) n) ↔
      HasPrimeAdditiveDecomposition n :=
  halfSigmaRateGoldbachComplete_iteratedRate_iff n

/-! ## Packaged Euler-product coupling seed -/

/-- The Euler product coupling seed: the prime index used by the half-sigma
atomic support is the same index used by the analytic Euler product, while the
Goldbach and spectral sides remain separate projected questions.

The negative field records P321: without this Euler-style coupling/descent
object, the free product carrier cannot host the concrete faithful pullback.
-/
structure EulerProductCouplingSeedCertificate where
  sigma_atomic_support_equiv_primes :
    SigmaAtomicRateSupport (K := ℝ) (1 / 2 : ℝ)
        (ne_of_lt halfSigma_mem_Ioo.2) ≃ Nat.Primes
  zeta_euler_product :
    ∀ {s : ℂ}, 1 < s.re →
      HasProd
        (fun p : PrimeExponent => (1 - (p.1 : ℂ) ^ (-s))⁻¹)
        (riemannZeta s)
  zeta_tprod :
    ∀ {s : ℂ}, 1 < s.re →
      (∏' p : PrimeExponent, (1 - (p.1 : ℂ) ^ (-s))⁻¹) =
        riemannZeta s
  zeta_zero_free_on_euler_halfPlane :
    ∀ {s : ℂ}, 1 < s.re → riemannZeta s ≠ 0
  goldbach_projection :
    ∀ n : ℕ,
      HalfSigmaRateGoldbachComplete (iteratedRate (1 / 2 : ℝ) n) ↔
        HasPrimeAdditiveDecomposition n
  product_carrier_not_enough :
    Not (Nonempty ConcreteGoldbachH1FaithfulPullbackObligation)

/-- THEOREM 5: the canonical Euler-product coupling seed certificate. -/
def eulerProductCouplingSeedCertificate :
    EulerProductCouplingSeedCertificate where
  sigma_atomic_support_equiv_primes :=
    halfSigmaAtomicSupportEquivNatPrimes
  zeta_euler_product := by
    intro s hs
    exact riemannZeta_eulerProduct_hasProd_primeExponent (s := s) hs
  zeta_tprod := by
    intro s hs
    exact riemannZeta_eulerProduct_tprod_primeExponent (s := s) hs
  zeta_zero_free_on_euler_halfPlane := by
    intro s hs
    exact riemannZeta_ne_zero_on_eulerProduct_halfPlane (s := s) hs
  goldbach_projection := halfSigmaEulerPrime_goldbachProjection
  product_carrier_not_enough :=
    concreteGoldbachH1_obligation_impossible_on_productCarrier

end AffineRelaxation
end SaturationMonoid
