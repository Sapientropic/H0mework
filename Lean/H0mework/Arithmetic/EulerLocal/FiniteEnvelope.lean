import H0mework.Arithmetic.EulerLocal.LandingSuccessor

/-!
# Unit-normalized finite envelope of one actual factorization row

Every unit history is additively generated by the same unit occurrence.  A
local quotient history therefore enters the finite envelope as its actual
cardinality coefficient times one `quotientUnit` generator; it does not mint
a new generator indexed by `(p,k)`.

The whole component is the unit-normalized dual pair.  For one actual
prime-power factor the folded relation is

`componentDifference - p^k * quotientCardinality * quotientUnitDifference`.

This file supplies only the domain-local fold image and records its exact
factorization/successor facts beside that image.  The conjunction below is
not a local-carrier-to-envelope evaluator/reversal commuting square and must
not be consumed as one.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace CanonicalUnitArithmeticFactorizationEulerUnitNormalizedFiniteEnvelope

open ArithmeticGeneration
open CanonicalUnitArithmeticFactorizationOccurrence
open CanonicalUnitArithmeticFactorizationEulerLocalLanding
open CanonicalUnitArithmeticFactorizationEulerLocalLandingSuccessor

noncomputable section

inductive EnvelopeRole
  | component
  | quotientUnit
  deriving DecidableEq

instance envelopeRoleFintype : Fintype EnvelopeRole where
  elems := {.component, .quotientUnit}
  complete := by
    intro role
    cases role <;> simp

abbrev Generator := EnvelopeRole × Fin 2
abbrev Lattice := Generator →₀ ℤ

def basis (role : EnvelopeRole) (dualIndex : Fin 2) : Lattice :=
  Finsupp.single (role, dualIndex) 1

def componentDifference : Lattice :=
  basis .component 0 - basis .component 1

def quotientUnitDifference : Lattice :=
  basis .quotientUnit 0 - basis .quotientUnit 1

variable {requestedPrime : Nat.Primes} {requestedExponent : Nat}

/-- Actual number of unit occurrences in the quotient-history factor. -/
def quotientUnitCoefficient
    (factor : RuntimePrimePowerFactorAt requestedPrime requestedExponent) : Nat :=
  (quotientHistory factor.primeIndex factor.exponentIndex).cardinalShadow

def wholeUnitCoefficient
    (factor : RuntimePrimePowerFactorAt requestedPrime requestedExponent) : Nat :=
  (factorialHistory (runtimeWholeHistory factor.stage)).cardinalShadow

/-- Unit-normalized fold image of the actual local relation. -/
def relation
    (factor : RuntimePrimePowerFactorAt requestedPrime requestedExponent) :
    Lattice :=
  componentDifference -
    ((requestedPrime : Nat) ^ requestedExponent *
      quotientUnitCoefficient factor) • quotientUnitDifference

theorem wholeUnitCoefficient_eq_primePower_mul_quotient
    (factor : RuntimePrimePowerFactorAt requestedPrime requestedExponent) :
    wholeUnitCoefficient factor =
      (requestedPrime : Nat) ^ requestedExponent *
        quotientUnitCoefficient factor := by
  have landing := congrArg UnitHistory.cardinalShadow
    factor.actual_joint_landing
  simpa [wholeUnitCoefficient, quotientUnitCoefficient,
    UnitHistory.cardinalShadow_joint,
    primePowerHistory, quotientHistory,
    factor.actual_prime_power_value] using landing

theorem relation_eq_wholeCoefficient_normalForm
    (factor : RuntimePrimePowerFactorAt requestedPrime requestedExponent) :
    relation factor = componentDifference -
      wholeUnitCoefficient factor • quotientUnitDifference := by
  unfold relation
  rw [wholeUnitCoefficient_eq_primePower_mul_quotient]

abbrev FactorizationRoot :=
  Σ authority : RuntimeAuthority,
    GeneratedUnitFactorizationAt (authorityWholeHistory authority)

def relationOccurrence
    (factor : RuntimePrimePowerFactorAt requestedPrime requestedExponent) :
    RootedAccountedUnfolding (FactorizationRoot × Lattice) :=
  (factorizationOccurrence factor.stage).map fun root =>
    (root, relation factor)

theorem relationOccurrence_projects_to_factorization
    (factor : RuntimePrimePowerFactorAt requestedPrime requestedExponent) :
    (relationOccurrence factor).map Prod.fst =
      factorizationOccurrence factor.stage := by
  rw [relationOccurrence, RootedAccountedUnfolding.map_map]
  change (factorizationOccurrence factor.stage).map id =
    factorizationOccurrence factor.stage
  exact RootedAccountedUnfolding.map_id _

/-- A bookkeeping conjunction of the actual local feed and the folded row.
It does not construct a realization square into the finite envelope. -/
theorem records_actual_local_feed_and_foldedRow
    (factor : RuntimePrimePowerFactorAt requestedPrime requestedExponent) :
    factorialHistory (runtimeWholeHistory factor.stage) =
        (primePowerHistory factor.primeIndex factor.exponentIndex).joint
          (quotientHistory factor.primeIndex factor.exponentIndex) ∧
      quotientEvaluator factor (difference factor)
          requestedPrime requestedExponent = 0 ∧
      carrierRestriction factor (difference factor.advance) =
        difference factor ∧
      relation factor = componentDifference -
        wholeUnitCoefficient factor • quotientUnitDifference :=
  ⟨factor.actual_joint_landing, difference_quotientZero factor,
    carrierRestriction_difference factor,
    relation_eq_wholeCoefficient_normalForm factor⟩

end
end CanonicalUnitArithmeticFactorizationEulerUnitNormalizedFiniteEnvelope
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
