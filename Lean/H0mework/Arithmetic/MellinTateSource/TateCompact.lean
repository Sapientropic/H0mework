import Mathlib.Analysis.Calculus.Deriv.Abs
import H0mework.Arithmetic.MobiusSource.CompactMobiusInverse

/-! # The actual Tate reciprocal of a compact-annulus source -/

set_option autoImplicit false
set_option maxHeartbeats 3000000

namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.BurnolPhysicalState

open Complex FourierTransform MeasureTheory Set Filter
open scoped SchwartzMap ContDiff

noncomputable section

private theorem compactAdditiveSource_contDiff
    (source : burnolCompactAnnulusSource) :
    ContDiff ℝ ∞ (burnolCompactAdditiveSource source) := by
  rw [contDiff_iff_contDiffAt]
  intro x
  by_cases hx : x = 0
  · subst x
    have near : ∀ᶠ y : ℝ in nhds 0, |y| < (1 / 4 : ℝ) :=
      (isOpen_lt continuous_abs continuous_const).mem_nhds (by norm_num)
    refine (contDiffAt_const : ContDiffAt ℝ ∞
      (fun _ : ℝ ↦ (0 : ℂ)) 0).congr_of_eventuallyEq ?_
    filter_upwards [near] with y hy
    rw [burnolCompactAdditiveSource_zero_of_abs_le_quarter source hy.le]
  · have near : ∀ᶠ y : ℝ in nhds x, y ≠ 0 := eventually_ne_nhds hx
    have absSmooth : ContDiffAt ℝ ∞ (fun y : ℝ ↦ |y|) x :=
      contDiffAt_abs (n := (⊤ : ℕ∞)) hx
    have absComplexSmooth : ContDiffAt ℝ ∞
        (fun y : ℝ ↦ ((|y| : ℝ) : ℂ)) x :=
      Complex.ofRealCLM.contDiff.contDiffAt.comp x absSmooth
    have inverseSmooth : ContDiffAt ℝ ∞ (fun y : ℝ ↦ y⁻¹) x :=
      contDiffAt_inv ℝ hx
    have sourceSmooth : ContDiffAt ℝ ∞ (fun y : ℝ ↦ source.1 y⁻¹) x :=
      (source.1.contDiffAt (⊤ : ℕ∞)).comp x inverseSmooth
    have smooth : ContDiffAt ℝ ∞ (fun y : ℝ ↦
        (((|y| : ℝ) : ℂ)⁻¹) * source.1 y⁻¹) x :=
      (absComplexSmooth.inv
        (Complex.ofReal_ne_zero.mpr (abs_ne_zero.mpr hx))).mul sourceSmooth
    refine smooth.congr_of_eventuallyEq ?_
    filter_upwards [near] with y hy
    simp only [burnolCompactAdditiveSource, hy, ↓reduceIte]

private theorem compactAdditiveSource_hasCompactSupport
    (source : burnolCompactAnnulusSource) :
    HasCompactSupport (burnolCompactAdditiveSource source) := by
  apply HasCompactSupport.intro (isCompact_Icc : IsCompact (Icc (-4 : ℝ) 4))
  intro x outside
  apply burnolCompactAdditiveSource_zero_of_four_le_abs source
  by_contra notOutside
  have absLt : |x| < 4 := lt_of_not_ge notOutside
  exact outside ⟨(by linarith [neg_le_of_abs_le absLt.le]),
    (le_of_abs_le absLt.le)⟩

/-- The reciprocal additive function is itself an actual compact-annulus
Schwartz source. -/
def burnolCompactTateReciprocalSchwartz
    (source : burnolCompactAnnulusSource) : SchwartzMap ℝ ℂ :=
  (compactAdditiveSource_hasCompactSupport source).toSchwartzMap
    (compactAdditiveSource_contDiff source)

@[simp] theorem burnolCompactTateReciprocalSchwartz_apply
    (source : burnolCompactAnnulusSource) (x : ℝ) :
    burnolCompactTateReciprocalSchwartz source x =
      burnolCompactAdditiveSource source x := rfl

def burnolCompactTateReciprocalSource
    (source : burnolCompactAnnulusSource) : burnolCompactAnnulusSource :=
  ⟨burnolCompactTateReciprocalSchwartz source,
    burnolCompactAdditiveSource_even source,
    fun _ inside ↦ burnolCompactAdditiveSource_zero_of_abs_le_quarter source inside,
    fun _ outside ↦ burnolCompactAdditiveSource_zero_of_four_le_abs source outside⟩

/-- Cubic reciprocal integrability generated by the compact source gap. -/
theorem burnolCompactAnnulusSource_norm_div_abs_cube_integrable
    (source : burnolCompactAnnulusSource) :
    Integrable (fun u : ℝ ↦ ‖source.1 u‖ / |u| ^ 3) := by
  have measurable : AEStronglyMeasurable (fun u : ℝ ↦
      ‖source.1 u‖ / |u| ^ 3) :=
    (source.1.continuous.measurable.norm.div
      (continuous_abs.measurable.pow_const 3)).aestronglyMeasurable
  refine (source.1.integrable.norm.const_mul 64).mono' measurable ?_
  filter_upwards with u
  by_cases inside : |u| ≤ (1 / 4 : ℝ)
  · rw [source.2.2.1 u inside, norm_zero]
    simp
  · have lower : (1 / 4 : ℝ) ≤ |u| := le_of_not_ge inside
    have denominator : (1 / 4 : ℝ) ^ 3 ≤ |u| ^ 3 := by
      exact pow_le_pow_left₀ (by norm_num) lower 3
    rw [Real.norm_eq_abs, abs_of_nonneg
      (div_nonneg (norm_nonneg _) (pow_nonneg (abs_nonneg _) _))]
    calc
      ‖source.1 u‖ / |u| ^ 3 ≤ ‖source.1 u‖ / (1 / 4 : ℝ) ^ 3 := by
        gcongr
      _ = 64 * ‖source.1 u‖ := by ring

/-- Reciprocal first-moment integrability generated by the same gap. -/
theorem burnolCompactAnnulusSource_inv_mul_integrable
    (source : burnolCompactAnnulusSource) :
    Integrable (fun u : ℝ ↦ (u : ℂ)⁻¹ * source.1 u) := by
  have measurable : AEStronglyMeasurable (fun u : ℝ ↦
      (u : ℂ)⁻¹ * source.1 u) :=
    ((Complex.measurable_ofReal.comp measurable_id).inv.mul
      source.1.continuous.measurable).aestronglyMeasurable
  refine (source.1.integrable.norm.const_mul 4).mono' measurable ?_
  filter_upwards with u
  by_cases inside : |u| ≤ (1 / 4 : ℝ)
  · rw [source.2.2.1 u inside]
    simp
  · have hu : u ≠ 0 := by rintro rfl; simp at inside
    have lower : (1 / 4 : ℝ) ≤ |u| := le_of_not_ge inside
    rw [norm_mul, norm_inv, norm_real, Real.norm_eq_abs]
    apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
    rw [inv_eq_one_div]
    exact (div_le_iff₀ (abs_pos.mpr hu)).2 (by nlinarith)

/-- The actual reciprocal source is an involution, including the origin
fixed by the source gap. -/
theorem burnolCompactTateReciprocalSource_additiveSource
    (source : burnolCompactAnnulusSource) (t : ℝ) :
    burnolCompactAdditiveSource (burnolCompactTateReciprocalSource source) t =
      source.1 t := by
  by_cases ht : t = 0
  · subst t
    rw [source.2.2.1 0 (by norm_num)]
    simp [burnolCompactAdditiveSource]
  · rw [burnolCompactAdditiveSource, if_neg ht,
      show (burnolCompactTateReciprocalSource source).1 t⁻¹ =
        burnolCompactTateReciprocalSchwartz source t⁻¹ by rfl,
      burnolCompactTateReciprocalSchwartz_apply,
      burnolCompactAdditiveSource, if_neg (inv_ne_zero ht), inv_inv, abs_inv]
    push_cast
    field_simp [abs_ne_zero.mpr ht]

theorem burnolCompactAnnulusSource_positiveIntegral_eq_half
    (source : burnolCompactAnnulusSource) :
    (∫ t : ℝ in Ioi 0, source.1 t) =
      (1 / 2 : ℂ) * ∫ t : ℝ, source.1 t := by
  have negative : (∫ t : ℝ in Iic 0, source.1 t) =
      ∫ t : ℝ in Ioi 0, source.1 t := by
    calc
      _ = ∫ t : ℝ in Iic 0, source.1 (-t) := by
        exact setIntegral_congr_fun measurableSet_Iic
          (fun t _ ↦ (source.2.1 t).symm)
      _ = _ := by
        simpa only [neg_zero] using integral_comp_neg_Iic 0 source.1
  have full : (∫ t : ℝ, source.1 t) =
      2 * ∫ t : ℝ in Ioi 0, source.1 t := by
    rw [← setIntegral_univ, ← Iic_union_Ioi (a := (0 : ℝ)),
      setIntegral_union (Iic_disjoint_Ioi le_rfl) measurableSet_Ioi
        source.1.integrable.integrableOn source.1.integrable.integrableOn,
      negative]
    ring
  rw [full]
  ring

/-- The second Tate mean is exactly the Fourier-gap normalization. -/
theorem burnolCompactTateReciprocalSource_normalization
    (source : burnolCompactAnnulusSource) :
    burnolCompactAdditiveNormalization (burnolCompactTateReciprocalSource source) =
      -burnolCompactAdditiveFourierGapConstant source := by
  rw [burnolCompactAdditiveNormalization,
    ← burnolCompactAnnulusSource_positiveIntegral_eq_half
      (burnolCompactTateReciprocalSource source)]
  change (∫ t : ℝ in Ioi 0, burnolCompactAdditiveSource source t) =
    -burnolCompactAdditiveFourierGapConstant source
  rw [burnolCompactAdditiveFourierGapConstant]
  ring

/-- The reciprocal Jacobian keeps the other compact-source mean. -/
theorem burnolCompactTateReciprocalSource_reciprocalMoment
    (source : burnolCompactAnnulusSource) :
    (∫ u : ℝ in Ioi 0, (u : ℂ)⁻¹ * source.1 u) =
      burnolCompactAdditiveNormalization
        (burnolCompactTateReciprocalSource source) := by
  have moment := burnolCompactCenteredMobiusInverse_reciprocalMoment
    (burnolCompactTateReciprocalSource source)
  simp_rw [burnolCompactCenteredMobiusInverse_roundtrip,
    burnolCompactTateReciprocalSource_additiveSource] at moment
  rw [burnolCompactAdditiveCoSum_eq_neg_normalization_of_abs_le_quarter
    (burnolCompactTateReciprocalSource source) (t := 0) (by norm_num)] at moment
  simpa only [neg_neg] using moment

end
end NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.BurnolPhysicalState
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
