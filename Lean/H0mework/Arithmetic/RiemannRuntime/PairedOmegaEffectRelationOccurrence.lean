import H0mework.Realization.Completion.HistoryInstallation
import H0mework.Arithmetic.RiemannRuntime.PairedOmegaAccountedEffectHistory

/-!
# Actual presented relation generated by the paired-Omega effect history

Every finite installed effect stage generates three role atoms: phase,
retained incidence and centered trace.  Their source relation is
`phase - retained - centeredTrace`.  A linear evaluator sends those atoms
back to the exact installed `RuntimeEffect`; the already generated
conservation theorem kills the relation.

The successor on generators shifts only the stage index.  Hence one source
seed relation and one fixed continuation occurrence expose the whole formal
cofinal relation history without a caller table or a compatibility premise.
-/

set_option autoImplicit false
set_option maxHeartbeats 3000000

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalRiemann
namespace ClozelGeneralizedDual
namespace CenteredGram
namespace IntegralGraphJointAction

open CanonicalUnitArithmeticRoot
open CofinalHistorySettlement
open CofinalHistorySettlementFace

noncomputable section

inductive RuntimeEffectRelationRole
  | phase
  | retained
  | centeredTrace
  deriving DecidableEq

abbrev RuntimeEffectRelationGenerator := Nat × RuntimeEffectRelationRole

def runtimeEffectRelationAtom
    (stage : Nat) (role : RuntimeEffectRelationRole) :
    RuntimeEffectRelationGenerator →₀ ℤ :=
  Finsupp.single (stage, role) 1

/-- The exact additive relation already proved by the installed effect row. -/
def runtimeEffectStageRelation (stage : Nat) :
    RuntimeEffectRelationGenerator →₀ ℤ :=
  runtimeEffectRelationAtom stage .phase -
    runtimeEffectRelationAtom stage .retained -
      runtimeEffectRelationAtom stage .centeredTrace

def runtimeEffectRelationGeneratorValue
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    RuntimeEffectRelationGenerator → QRich.ClozelJPair
  | (stage, .phase) =>
      (installedRuntimeEffectValueAt observation nontrivial stage).phase
  | (stage, .retained) =>
      (installedRuntimeEffectValueAt observation nontrivial stage).retained
  | (stage, .centeredTrace) =>
      (installedRuntimeEffectValueAt observation nontrivial stage).centeredTrace

/-- Evaluation of the free relation carrier in the actual installed effect
carrier. -/
def runtimeEffectRelationEvaluator
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    (RuntimeEffectRelationGenerator →₀ ℤ) →ₗ[ℤ] QRich.ClozelJPair :=
  (Finsupp.liftAddHom fun generator =>
    AddMonoidHom.flip (smulAddHom ℤ QRich.ClozelJPair)
      (runtimeEffectRelationGeneratorValue observation nontrivial generator)
    ).toIntLinearMap

theorem runtimeEffectStageRelation_evaluates_zero
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (stage : Nat) :
    runtimeEffectRelationEvaluator observation nontrivial
        (runtimeEffectStageRelation stage) = 0 := by
  rw [runtimeEffectStageRelation, map_sub, map_sub]
  simp only [runtimeEffectRelationEvaluator,
    runtimeEffectRelationAtom, Finsupp.liftAddHom_apply_single,
    AddMonoidHom.coe_toIntLinearMap, AddMonoidHom.flip_apply,
    smulAddHom_apply, one_smul]
  change
    (installedRuntimeEffectValueAt observation nontrivial stage).phase -
        (installedRuntimeEffectValueAt observation nontrivial stage).retained -
      (installedRuntimeEffectValueAt observation nontrivial stage).centeredTrace = 0
  rw [installedRuntimeEffectValueAt_conservation
    observation nontrivial stage]
  abel

def runtimeEffectShiftGenerator :
    RuntimeEffectRelationGenerator → RuntimeEffectRelationGenerator
  | (stage, role) => (stage + 1, role)

def runtimeEffectShiftRelation
    (relation : RuntimeEffectRelationGenerator →₀ ℤ) :
    RuntimeEffectRelationGenerator →₀ ℤ :=
  relation.mapDomain runtimeEffectShiftGenerator

@[simp] theorem runtimeEffectShiftRelation_atom
    (stage : Nat) (role : RuntimeEffectRelationRole) :
    runtimeEffectShiftRelation (runtimeEffectRelationAtom stage role) =
      runtimeEffectRelationAtom (stage + 1) role := by
  simp [runtimeEffectShiftRelation, runtimeEffectRelationAtom,
    runtimeEffectShiftGenerator]

@[simp] theorem runtimeEffectShiftRelation_stageRelation
    (stage : Nat) :
    runtimeEffectShiftRelation (runtimeEffectStageRelation stage) =
      runtimeEffectStageRelation (stage + 1) := by
  simp [runtimeEffectShiftRelation, runtimeEffectStageRelation,
    runtimeEffectRelationAtom, runtimeEffectShiftGenerator,
    Finsupp.mapDomain_sub]

def runtimeEffectPresentedRelationEvent (stage : Nat) :
    PresentedRelationEventAt RuntimeEffectRelationGenerator :=
  .relation (runtimeEffectStageRelation stage)

def runtimeEffectShiftPresentedEvent :
    PresentedRelationEventAt RuntimeEffectRelationGenerator →
      PresentedRelationEventAt RuntimeEffectRelationGenerator
  | .generator generator => .generator (runtimeEffectShiftGenerator generator)
  | .relation relation => .relation (runtimeEffectShiftRelation relation)

@[simp] theorem runtimeEffectShiftPresentedEvent_stage
    (stage : Nat) :
    runtimeEffectShiftPresentedEvent
        (runtimeEffectPresentedRelationEvent stage) =
      runtimeEffectPresentedRelationEvent (stage + 1) := by
  simp [runtimeEffectShiftPresentedEvent, runtimeEffectPresentedRelationEvent]

def runtimeEffectRelationSeedAt (stage : Nat) :
    RootedAccountedUnfolding
      (PresentedRelationEventAt RuntimeEffectRelationGenerator) :=
  RootedAccountedUnfolding.zero (runtimeEffectPresentedRelationEvent stage)

def runtimeEffectRelationContinuation :
    RootedAccountedUnfolding
      (PresentedRelationEventAt RuntimeEffectRelationGenerator →
        RootedAccountedUnfolding
          (PresentedRelationEventAt RuntimeEffectRelationGenerator)) :=
  RootedAccountedUnfolding.zero fun event =>
    RootedAccountedUnfolding.zero (runtimeEffectShiftPresentedEvent event)

/-- Same-source material law.  The emitted current determines the seed
stage; the continuation is the fixed shift above. -/
abbrev runtimeEffectRelationMaterialLaw
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    SourceNativeCofinalHistoryMaterialLaw
      (runtimeEffectAuthoritySource observation nontrivial
        ).restructuringSource.toLedgerSource :=
  SourceNativeCofinalHistoryMaterialLaw.create
    RuntimeEffectRelationGenerator
    (fun occurrence => RootedAccountedUnfolding.zero occurrence)
    (fun _occurrence => rfl)
    (fun {current} _occurrence =>
      runtimeEffectRelationSeedAt (currentEffectStage current))
    (fun _occurrence => runtimeEffectRelationContinuation)

@[simp] theorem runtimeEffectRelationMaterialLaw_seed_root
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    {current : Current}
    (occurrence :
      (runtimeEffectAuthoritySource observation nontrivial
        ).restructuringSource.source.toRootSource.actual.OccurrenceAt current) :
    ((runtimeEffectRelationMaterialLaw observation nontrivial).seedAt
      occurrence).root =
        runtimeEffectPresentedRelationEvent (currentEffectStage current) :=
  rfl

@[simp] theorem runtimeEffectRelationMaterialLaw_continuation_root
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    {current : Current}
    (occurrence :
      (runtimeEffectAuthoritySource observation nontrivial
        ).restructuringSource.source.toRootSource.actual.OccurrenceAt current) :
    ((runtimeEffectRelationMaterialLaw observation nontrivial).continuationAt
      occurrence).root = runtimeEffectRelationContinuation.root :=
  rfl

end

end IntegralGraphJointAction
end CenteredGram
