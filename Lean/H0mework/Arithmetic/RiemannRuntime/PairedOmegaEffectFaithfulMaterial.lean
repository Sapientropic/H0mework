import H0mework.Realization.Completion.FaithfulInstallation
import H0mework.Arithmetic.RiemannRuntime.PairedOmegaEffectRelationRoot

/-!
# Faithful material for the paired-Omega detector relation

The actual generator evaluator already constructed from installed effect
stages is now an occurrence-indexed sibling of the formal relation history.
The combined material accepts neither soundness nor a faithful/coverage
verdict.  Those are generated by the neutral realization kernel.
-/

set_option autoImplicit false
set_option maxHeartbeats 3000000

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalRiemann
namespace ClozelGeneralizedDual
namespace CenteredGram
namespace IntegralGraphJointAction

open CofinalFaithfulSettlementFace

noncomputable section

def runtimeEffectRelationEvaluatorOccurrence
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    RootedAccountedUnfolding
      (RuntimeEffectRelationGenerator → QRich.ClozelJPair) :=
  RootedAccountedUnfolding.zero
    (runtimeEffectRelationGeneratorValue observation nontrivial)

abbrev runtimeEffectFaithfulMaterialLaw
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    SourceNativeCofinalFaithfulMaterialLaw
      (runtimeEffectRelationAuthoritySource observation nontrivial
        ).restructuringSource.toLedgerSource
      QRich.ClozelJPair :=
  SourceNativeCofinalFaithfulMaterialLaw.create
    (runtimeEffectRelationMaterialLaw observation nontrivial)
    (fun _occurrence =>
      runtimeEffectRelationEvaluatorOccurrence observation nontrivial)

@[simp] theorem runtimeEffectFaithfulMaterialLaw_evaluator_root
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    {current : CanonicalUnitArithmeticRoot.Current}
    (occurrence :
      (runtimeEffectRelationAuthoritySource observation nontrivial
        ).restructuringSource.source.toRootSource.actual.OccurrenceAt current) :
    ((runtimeEffectFaithfulMaterialLaw observation nontrivial).evaluatorAt
      occurrence).root =
        runtimeEffectRelationGeneratorValue observation nontrivial :=
  rfl

end

end IntegralGraphJointAction
end CenteredGram
end ClozelGeneralizedDual
end CanonicalRiemann
