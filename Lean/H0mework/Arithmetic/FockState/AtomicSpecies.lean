import H0mework.Arithmetic.GoldbachDynamics.FactorOrbit

/-!
# Source-generated atomic species on the particle face

The existing complete endpoint classifier is lifted without adding a primality
premise.  Its prime branch becomes an atom whose species is generated as
`two` or `odd`; its composite branch retains the actual proper factorization
selected by the same classifier.  Applying this face in order to both ends of
an effective split exposes the only terminal species patterns compatible with
the generated even total charge.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalArithmeticState
namespace ParticleWaveFockAtomicSpecies

open CanonicalUnitArithmeticEffectiveAdditiveProducer
open CanonicalUnitArithmeticEffectiveFactorRepairOrbitProducer

noncomputable section

/-- The two prime species visible to the additive particle detector. -/
inductive AtomicSpecies
  | two
  | odd
  deriving DecidableEq

/-- A prime endpoint generated by the complete endpoint classifier, together
with the classifier-generated `two | odd` species evidence. -/
structure PrimeAtomAt (value : Nat) : Type where
  private mk ::
  endpoint : PrimeEndpointAt value
  species : AtomicSpecies
  species_spec : match species with
    | .two => value = 2
    | .odd => Odd value

theorem PrimeAtomAt.isPrime {value : Nat} (atom : PrimeAtomAt value) :
    Nat.Prime value :=
  atom.endpoint.isPrime

theorem PrimeAtomAt.value_eq_two {value : Nat} (atom : PrimeAtomAt value)
    (species_eq : atom.species = .two) : value = 2 := by
  simpa [species_eq] using atom.species_spec

theorem PrimeAtomAt.value_odd {value : Nat} (atom : PrimeAtomAt value)
    (species_eq : atom.species = .odd) : Odd value := by
  simpa [species_eq] using atom.species_spec

/-- The prime classifier itself decides whether its atom is `two` or odd. -/
def generatedPrimeAtom {value : Nat}
    (endpoint : PrimeEndpointAt value) : PrimeAtomAt value :=
  if value_eq : value = 2 then
      { endpoint := endpoint
        species := .two
        species_spec := value_eq }
  else
      { endpoint := endpoint
        species := .odd
        species_spec := endpoint.isPrime.odd_of_ne_two value_eq }

theorem generatedPrimeAtom_species_two {value : Nat}
    (endpoint : PrimeEndpointAt value) (value_eq : value = 2) :
    (generatedPrimeAtom endpoint).species = .two := by
  cases species_eq : (generatedPrimeAtom endpoint).species with
  | two => rfl
  | odd =>
      have value_odd : Odd value :=
        (generatedPrimeAtom endpoint).value_odd species_eq
      subst value
      obtain ⟨half, half_eq⟩ := value_odd
      omega

theorem generatedPrimeAtom_species_odd {value : Nat}
    (endpoint : PrimeEndpointAt value) (value_ne_two : value ≠ 2) :
    (generatedPrimeAtom endpoint).species = .odd := by
  cases species_eq : (generatedPrimeAtom endpoint).species with
  | two =>
      exact (value_ne_two
        ((generatedPrimeAtom endpoint).value_eq_two species_eq)).elim
  | odd => rfl

/-- One endpoint is either a classified prime atom or the actual proper
factorization selected by `generatedPrimeOrFactor`. -/
inductive AtomOrDecayAt (value : Nat) : Type
  | atom (primeAtom : PrimeAtomAt value)
  | decay (factorization : ProperFactorizationAt value)

def AtomOrDecayAt.species? {value : Nat} :
    AtomOrDecayAt value -> Option AtomicSpecies
  | .atom primeAtom => some primeAtom.species
  | .decay _factorization => none

/-- Source-fixed endpoint face.  No primality, parity, or factor witness is a
caller input. -/
noncomputable def generatedAtomOrDecay (value : Nat) (floor : 2 ≤ value) :
    AtomOrDecayAt value :=
  match generatedPrimeOrFactor value floor with
  | .inl endpoint => .atom (generatedPrimeAtom endpoint)
  | .inr factorization => .decay factorization

theorem generatedAtomOrDecay_eq_atom_of_classifier {value : Nat}
    (floor : 2 ≤ value) (endpoint : PrimeEndpointAt value)
    (decision : generatedPrimeOrFactor value floor = .inl endpoint) :
    generatedAtomOrDecay value floor = .atom (generatedPrimeAtom endpoint) := by
  simp only [generatedAtomOrDecay, decision]

theorem generatedAtomOrDecay_eq_decay_of_classifier {value : Nat}
    (floor : 2 ≤ value) (factorization : ProperFactorizationAt value)
    (decision : generatedPrimeOrFactor value floor = .inr factorization) :
    generatedAtomOrDecay value floor = .decay factorization := by
  simp only [generatedAtomOrDecay, decision]

theorem generatedAtomOrDecay_species_two_of_value_eq_two {value : Nat}
    (floor : 2 ≤ value) (value_eq : value = 2) :
    (generatedAtomOrDecay value floor).species? = some .two := by
  subst value
  have decision :=
    generatedPrimeOrFactor_eq_prime 2 floor Nat.prime_two
  rw [generatedAtomOrDecay_eq_atom_of_classifier floor _ decision]
  simp only [AtomOrDecayAt.species?, Option.some.injEq]
  exact generatedPrimeAtom_species_two _ rfl

/-- Ordered left/right source classification of one actual effective split. -/
structure OrderedClassificationAt {index : Nat}
    (state : EffectiveSplitAt index) : Type where
  private mk ::
  left : AtomOrDecayAt (splitLeft state)
  left_eq : left = generatedAtomOrDecay (splitLeft state)
    (splitLeft_atLeastTwo state)
  right : AtomOrDecayAt (splitRight state)
  right_eq : right = generatedAtomOrDecay (splitRight state)
    (splitRight_atLeastTwo state)

def generatedOrderedClassification {index : Nat}
    (state : EffectiveSplitAt index) : OrderedClassificationAt state :=
  { left := generatedAtomOrDecay (splitLeft state)
      (splitLeft_atLeastTwo state)
    left_eq := rfl
    right := generatedAtomOrDecay (splitRight state)
      (splitRight_atLeastTwo state)
    right_eq := rfl }

def OrderedClassificationAt.leftSpecies? {index : Nat}
    {state : EffectiveSplitAt index} (classification : OrderedClassificationAt state) :
    Option AtomicSpecies :=
  classification.left.species?

def OrderedClassificationAt.rightSpecies? {index : Nat}
    {state : EffectiveSplitAt index} (classification : OrderedClassificationAt state) :
    Option AtomicSpecies :=
  classification.right.species?

/-- At total charge four, the endpoint floors force the ordered generated
classification to be `two x two`.  Terminality is not needed for this
stronger statement. -/
theorem generatedOrderedClassification_target_four_is_two_two {index : Nat}
    (state : EffectiveSplitAt index)
    (target_eq : repairTargetValue index = 4) :
    (generatedOrderedClassification state).leftSpecies? = some .two ∧
      (generatedOrderedClassification state).rightSpecies? = some .two := by
  have landing := split_landing state
  have left_floor := splitLeft_atLeastTwo state
  have right_floor := splitRight_atLeastTwo state
  have left_eq : splitLeft state = 2 := by omega
  have right_eq : splitRight state = 2 := by omega
  constructor
  · simp only [OrderedClassificationAt.leftSpecies?, generatedOrderedClassification]
    exact generatedAtomOrDecay_species_two_of_value_eq_two _ left_eq
  · simp only [OrderedClassificationAt.rightSpecies?, generatedOrderedClassification]
    exact generatedAtomOrDecay_species_two_of_value_eq_two _ right_eq

private theorem repairTargetValue_even (index : Nat) :
    Even (repairTargetValue index) := by
  simpa only [repairTargetValue] using evenTargetHistory_is_even index

private theorem generatedAtomOrDecay_species_odd_of_terminalPrime {value : Nat}
    (floor : 2 ≤ value) (terminalPrime : Nat.Prime value)
    (value_ne_two : value ≠ 2) :
    (generatedAtomOrDecay value floor).species? = some .odd := by
  have decision :=
    generatedPrimeOrFactor_eq_prime value floor terminalPrime
  rw [generatedAtomOrDecay_eq_atom_of_classifier floor _ decision]
  simp only [AtomOrDecayAt.species?, Option.some.injEq]
  exact generatedPrimeAtom_species_odd _ value_ne_two

/-- Above total charge four, an actual prime-pair terminal can contain no
prime-two endpoint; the generated ordered species are therefore odd/odd. -/
theorem primePairTerminal_target_gt_four_is_odd_odd {index : Nat}
    (state : EffectiveSplitAt index)
    (target_gt : 4 < repairTargetValue index)
    (terminal : PrimePairTerminalAt state) :
    (generatedOrderedClassification state).leftSpecies? = some .odd ∧
      (generatedOrderedClassification state).rightSpecies? = some .odd := by
  have target_even := repairTargetValue_even index
  have two_even : Even (2 : Nat) := ⟨1, by omega⟩
  have landing := split_landing state
  have left_ne_two : splitLeft state ≠ 2 := by
    intro left_eq
    have right_even : Even (splitRight state) := by
      rw [splitRight, left_eq]
      exact target_even.tsub two_even
    have right_eq := terminal.rightPrime.even_iff.mp right_even
    omega
  have right_ne_two : splitRight state ≠ 2 := by
    intro right_eq
    have left_eq_sub :
        splitLeft state = repairTargetValue index - 2 := by
      omega
    have left_even : Even (splitLeft state) := by
      rw [left_eq_sub]
      exact target_even.tsub two_even
    have left_eq := terminal.leftPrime.even_iff.mp left_even
    omega
  constructor
  · simp only [OrderedClassificationAt.leftSpecies?, generatedOrderedClassification]
    exact generatedAtomOrDecay_species_odd_of_terminalPrime _
      terminal.leftPrime left_ne_two
  · simp only [OrderedClassificationAt.rightSpecies?, generatedOrderedClassification]
    exact generatedAtomOrDecay_species_odd_of_terminalPrime _
      terminal.rightPrime right_ne_two

def OrderedClassificationAt.IsMixed {index : Nat}
    {state : EffectiveSplitAt index} (classification : OrderedClassificationAt state) :
    Prop :=
  (classification.leftSpecies? = some .two ∧
      classification.rightSpecies? = some .odd) ∨
    (classification.leftSpecies? = some .odd ∧
      classification.rightSpecies? = some .two)

private theorem some_two_ne_some_odd :
    (some .two : Option AtomicSpecies) ≠ some .odd := by
  decide

private theorem some_odd_ne_some_two :
    (some .odd : Option AtomicSpecies) ≠ some .two := by
  decide

/-- No actual prime-pair terminal has a mixed `two/odd` species readout. -/
theorem primePairTerminal_not_mixed {index : Nat}
    (state : EffectiveSplitAt index)
    (terminal : PrimePairTerminalAt state) :
    ¬ (generatedOrderedClassification state).IsMixed := by
  have landing := split_landing state
  have left_floor := splitLeft_atLeastTwo state
  have right_floor := splitRight_atLeastTwo state
  have target_floor : 4 ≤ repairTargetValue index := by omega
  intro mixed
  by_cases target_eq : repairTargetValue index = 4
  · have species :=
      generatedOrderedClassification_target_four_is_two_two state target_eq
    rcases mixed with mixed | mixed
    · exact some_two_ne_some_odd (species.2.symm.trans mixed.2)
    · exact some_two_ne_some_odd (species.1.symm.trans mixed.1)
  · have target_gt : 4 < repairTargetValue index := by omega
    have species :=
      primePairTerminal_target_gt_four_is_odd_odd state target_gt terminal
    rcases mixed with mixed | mixed
    · exact some_odd_ne_some_two (species.1.symm.trans mixed.1)
    · exact some_odd_ne_some_two (species.2.symm.trans mixed.2)

end

end ParticleWaveFockAtomicSpecies
end CanonicalArithmeticState
end NoIslandNoMagic
