import H0mework.Physics.BranchSources.P926

/-!
# Proposition 927: generated coverage gives no-gap / unit-bracket descent

P926 made the raw branch spectrum explicit and made its residual-energy bound
computed.  This file extracts the dynamical content of a successful generated
coverage check:

```text
Boolean generated spectrum + coverage check
  -> strict residual descent
  -> unit energy density
  -> one-unit successor law
  -> no unit permanent holonomy
  -> zero raw residual cell
```

This is the generated-spectrum form of the confinement/no-gap route: a gap is
exactly a residual-split obstruction that would leave a nonzero cell unable to
spend the next unit of holonomy.  The generated coverage check rules that out.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open SaturationMonoid.AffineRelaxation
open RunningSigmaBeta

set_option linter.defProp false

/-! ## Generated coverage to checked local rules -/

/-- The P921 checked local energy-shell rule generated by P926's explicit
finite spectrum certificate. -/
def checkedLocalEnergyShellRule_of_generatedCoverageCertificate
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    SU7RawBranchingCheckedLocalEnergyShellRule rawCodeTensorCoding n :=
  checkedLocalEnergyShellRule_of_certifiedCellList
    (certifiedCellList_of_atomicCheckedCellList
      (atomicCheckedCellList_of_booleanAtomicCheckedCellList
        (booleanAtomicCheckedCellList_of_generatedCoverageCertificate G)))

/-- Its spectrum is definitionally the explicit generated spectrum from P926.
-/
theorem checkedLocalEnergyShellRule_of_generatedCoverage_spectrum_eq
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    (checkedLocalEnergyShellRule_of_generatedCoverageCertificate G).spectrum =
      booleanGeneratedRawBranchingSpectrum n G.codeBound := by
  rfl

/-- A generated coverage certificate gives strict residual descent on its
explicit generated spectrum. -/
theorem generatedCoverage_strictSuccessorLaw
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    SU7RawBranchingSpectrumStrictSuccessorLaw
      (booleanGeneratedRawBranchingSpectrum n G.codeBound) := by
  change SU7RawBranchingSpectrumStrictSuccessorLaw
    (checkedLocalEnergyShellRule_of_generatedCoverageCertificate G).spectrum
  exact checkedLocalEnergyShell_strictSuccessorLaw
    (checkedLocalEnergyShellRule_of_generatedCoverageCertificate G)

/-- A generated coverage certificate gives unit-density at the top of every
strict descent. -/
theorem generatedCoverage_energyUnitDensity
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    SU7RawBranchingSpectrumEnergyUnitDensity
      (booleanGeneratedRawBranchingSpectrum n G.codeBound) := by
  change SU7RawBranchingSpectrumEnergyUnitDensity
    (checkedLocalEnergyShellRule_of_generatedCoverageCertificate G).spectrum
  exact checkedLocalEnergyShell_energyUnitDensity
    (checkedLocalEnergyShellRule_of_generatedCoverageCertificate G)

/-- Strict descent on a generated coverage certificate forbids strict
permanent holonomy. -/
theorem generatedCoverage_forbidsStrictPermanentHolonomy
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    SU7RawBranchingSpectrumForbidsStrictPermanentHolonomy
      (booleanGeneratedRawBranchingSpectrum n G.codeBound) :=
  (noRawStrictPermanentHolonomy_iff_strictSuccessorLaw
    (booleanGeneratedRawBranchingSpectrum n G.codeBound)).mpr
      (generatedCoverage_strictSuccessorLaw G)

/-- A generated coverage certificate gives the exact one-unit successor law:
the unit bracket. -/
theorem generatedCoverage_unitSuccessorLaw
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    SU7RawBranchingSpectrumUnitSuccessorLaw
      (booleanGeneratedRawBranchingSpectrum n G.codeBound) :=
  unitSuccessorLaw_of_strictSuccessorLaw_and_unitDensity
    (booleanGeneratedRawBranchingSpectrum n G.codeBound)
    (generatedCoverage_strictSuccessorLaw G)
    (generatedCoverage_energyUnitDensity G)

/-- Equivalently, generated coverage forbids unit permanent holonomy. -/
theorem generatedCoverage_forbidsUnitPermanentHolonomy
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    SU7RawBranchingSpectrumForbidsUnitPermanentHolonomy
      (booleanGeneratedRawBranchingSpectrum n G.codeBound) :=
  (noRawUnitPermanentHolonomy_iff_unitSuccessorLaw
    (booleanGeneratedRawBranchingSpectrum n G.codeBound)).mpr
      (generatedCoverage_unitSuccessorLaw G)

/-! ## Zero raw cell and physical readout -/

/-- The local no-gap rule generated by the explicit coverage certificate. -/
def localNoGapRule_of_generatedCoverageCertificate
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    SU7RawBranchingLocalNoGapRule rawCodeTensorCoding n :=
  localNoGapRule_of_checkedLocalEnergyShellRule
    (checkedLocalEnergyShellRule_of_generatedCoverageCertificate G)

/-- Generated coverage computes an in-spectrum zero raw residual cell. -/
theorem exists_zeroRawCell_of_generatedCoverageCertificate
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    ∃ z : SU7BranchingDecompositionCell n,
      z ∈ (booleanGeneratedRawBranchingSpectrum n G.codeBound).cells ∧
        rawAtomCodeBranchingDecompositionResidual z = 0 := by
  change ∃ z : SU7BranchingDecompositionCell n,
    z ∈ (localNoGapRule_of_generatedCoverageCertificate G).spectrum.cells ∧
      rawAtomCodeBranchingDecompositionResidual z = 0
  exact exists_zeroRawCell_of_localNoGapRule
    (localNoGapRule_of_generatedCoverageCertificate G)

/-- Generated coverage computes the physical zero branch cell through the
no-gap route. -/
def generatedPhysicalZeroBranchCell_of_generatedCoverageNoGap
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    SU7GeneratedPhysicalZeroBranchCell n :=
  generatedPhysicalZeroBranchCell_of_localNoGapRule
    (localNoGapRule_of_generatedCoverageCertificate G)

/-- The no-gap physical zero cell agrees with the checked-list readout from
P926. -/
theorem generatedPhysicalZeroBranchCell_generatedCoverageNoGap_eq_checked
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    generatedPhysicalZeroBranchCell_of_generatedCoverageNoGap G =
      generatedPhysicalZeroBranchCell_of_generatedCoverageCertificate G := by
  rfl

/-! ## Certificate -/

/-- P927 certificate: generated coverage is the concrete no-gap / unit-bracket
producer on explicit raw spectra. -/
structure SU7GeneratedCoverageNoGapUnitBracketCertificate where
  generated_to_checked_local :
    ∀ {n : ℕ}, SU7GeneratedBooleanRawBranchingCoverageCertificate n ->
      SU7RawBranchingCheckedLocalEnergyShellRule rawCodeTensorCoding n
  strict_descent :
    ∀ {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n),
      SU7RawBranchingSpectrumStrictSuccessorLaw
        (booleanGeneratedRawBranchingSpectrum n G.codeBound)
  unit_density :
    ∀ {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n),
      SU7RawBranchingSpectrumEnergyUnitDensity
        (booleanGeneratedRawBranchingSpectrum n G.codeBound)
  unit_bracket :
    ∀ {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n),
      SU7RawBranchingSpectrumUnitSuccessorLaw
        (booleanGeneratedRawBranchingSpectrum n G.codeBound)
  forbids_unit_permanent_holonomy :
    ∀ {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n),
      SU7RawBranchingSpectrumForbidsUnitPermanentHolonomy
        (booleanGeneratedRawBranchingSpectrum n G.codeBound)
  zero_raw_cell :
    ∀ {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n),
      ∃ z : SU7BranchingDecompositionCell n,
        z ∈ (booleanGeneratedRawBranchingSpectrum n G.codeBound).cells ∧
          rawAtomCodeBranchingDecompositionResidual z = 0
  physical_zero :
    ∀ {n : ℕ}, SU7GeneratedBooleanRawBranchingCoverageCertificate n ->
      SU7GeneratedPhysicalZeroBranchCell n

/-- Canonical P927 no-gap/unit-bracket certificate. -/
def su7GeneratedCoverageNoGapUnitBracketCertificate :
    SU7GeneratedCoverageNoGapUnitBracketCertificate where
  generated_to_checked_local :=
    checkedLocalEnergyShellRule_of_generatedCoverageCertificate
  strict_descent :=
    generatedCoverage_strictSuccessorLaw
  unit_density :=
    generatedCoverage_energyUnitDensity
  unit_bracket :=
    generatedCoverage_unitSuccessorLaw
  forbids_unit_permanent_holonomy :=
    generatedCoverage_forbidsUnitPermanentHolonomy
  zero_raw_cell :=
    exists_zeroRawCell_of_generatedCoverageCertificate
  physical_zero :=
    generatedPhysicalZeroBranchCell_of_generatedCoverageNoGap


end
end StandardModelConstraint
end SaturationMonoid
