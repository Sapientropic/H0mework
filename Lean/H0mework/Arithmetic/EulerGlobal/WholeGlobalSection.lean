import H0mework.Arithmetic.EulerGlobal.DeterminantSection
import H0mework.Arithmetic.EulerGlobal.WholeDerivedSection

/-!
# Global determinant section generated by the whole relation action

The frozen derived-action engine reads the common whole relation complex in
degrees zero and one.  Its actual alternating numerator factors as the inner
full-Euler polynomial times the relation denominator.  The cancelled factor
is definitionally the already generated local full-Euler section, so the
existing source successor generates the same global pro-section `D`.

This is a shared-occurrence identification, not a post-hoc comparison of two
determinants: both local readouts reduce to the same actual inner action on the
same factorization stage.
-/

set_option autoImplicit false
set_option maxHeartbeats 2000000

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace CanonicalUnitArithmeticFactorizationFullEulerWholeRelationGlobalDeterminantSection

open CanonicalUnitArithmeticFactorizationEulerDependentDiagram
open CanonicalUnitArithmeticFactorizationFullEulerDerivedDeterminantSection
open CanonicalUnitArithmeticFactorizationFullEulerDeterminantSuccessor
open CanonicalUnitArithmeticFactorizationFullEulerGlobalDeterminantSection
open CanonicalUnitArithmeticFactorizationFullEulerWholeRelationDerivedDeterminantSection

noncomputable section

theorem innerDeterminantPolynomial_eq_existing
    (seed : FactorizationPayload) (stage : Nat) :
    innerEulerDeterminantPolynomial seed stage =
      determinantPolynomial seed stage := by
  rfl

theorem actualRelationAlternatingNumerator_eq_D_mul_denominator
    (seed : FactorizationPayload) (stage : Nat) :
    (actualAlternatingFraction seed stage).numerator =
      determinantPolynomial seed stage *
        (actualAlternatingFraction seed stage).denominator := by
  rw [actualAlternatingFraction_cancels_to_inner,
    innerDeterminantPolynomial_eq_existing]

theorem relationCancelledDeterminant_successor_factorization
    (seed : FactorizationPayload) (stage : Nat) :
    innerEulerDeterminantPolynomial seed (stage + 1) =
      relativeKernelDeterminantPolynomial seed stage *
        innerEulerDeterminantPolynomial seed stage := by
  rw [innerDeterminantPolynomial_eq_existing,
    innerDeterminantPolynomial_eq_existing]
  exact determinantPolynomial_successor_factorization seed stage

theorem globalD_local_restriction_reads_relation_action (stage : Nat) :
    (GlobalDeterminantSectionDiagram.obj
      (Opposite.op stage)).polynomial =
        innerEulerDeterminantPolynomial seedOccurrence.root stage := by
  rw [globalSection_local_restriction,
    innerDeterminantPolynomial_eq_existing]

theorem generated_global_D_preserves_relation_action_cancellation :
    globalSectionFace.cofinalFace.root = seedOccurrence ∧
      (∀ stage : Nat,
        (GlobalDeterminantSectionDiagram.obj
          (Opposite.op stage)).polynomial =
            innerEulerDeterminantPolynomial seedOccurrence.root stage) ∧
      (∀ stage : Nat,
        (actualAlternatingFraction seedOccurrence.root stage).numerator =
          (GlobalDeterminantSectionDiagram.obj
              (Opposite.op stage)).polynomial *
            (actualAlternatingFraction seedOccurrence.root stage).denominator) := by
  refine ⟨globalSectionFace.preserves_root_local_successor_and_global_section.1,
    globalD_local_restriction_reads_relation_action, ?_⟩
  intro stage
  rw [globalD_local_restriction_reads_relation_action]
  exact actualRelationAlternatingNumerator_eq_D_mul_denominator
    seedOccurrence.root stage

end
end CanonicalUnitArithmeticFactorizationFullEulerWholeRelationGlobalDeterminantSection
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
