noncomputable section

/-- One local factor with all authority needed by the global coordinate fold.
The constructor is private: callers cannot submit a power series detached
from the actual determinant occurrence. -/
structure GeneratedLocalDeterminantCoordinateFactorAt
    (requestedPrime : Nat.Primes) : Type where
  private mk ::
  factor : RuntimePrimePowerFactorAt requestedPrime 1
  actualLanding :
    factorialHistory
        (CanonicalUnitArithmeticFactorizationOccurrence.runtimeWholeHistory
          factor.stage) =
      (primePowerHistory factor.primeIndex factor.exponentIndex).joint
        (quotientHistory factor.primeIndex factor.exponentIndex)
  globalFactor :
    {polynomial : Polynomial ℤ //
      polynomial ∣
        (GlobalDeterminantSectionDiagram.obj
          (Opposite.op factor.stage)).polynomial}
  globalFactor_eq : globalFactor.1 =
    CanonicalUnitArithmeticFactorizationFullEulerDerivedDeterminantSection.localEulerDeterminantFactor
      seedOccurrence.root factor.stage (requestedBaseIndex factor 0)

namespace GeneratedLocalDeterminantCoordinateFactorAt

def generate (prime : Nat.Primes) :
    GeneratedLocalDeterminantCoordinateFactorAt prime := by
  let factor := RuntimePrimePowerFactorAt.generate prime 1 (by omega)
  let localFactor :=
    CanonicalUnitArithmeticFactorizationFullEulerDerivedDeterminantSection.localEulerDeterminantFactor
      seedOccurrence.root factor.stage (requestedBaseIndex factor 0)
  have dividesGlobal : localFactor ∣
      (GlobalDeterminantSectionDiagram.obj
        (Opposite.op factor.stage)).polynomial := by
    rw [globalD_local_restriction_reads_relation_action,
      CanonicalUnitArithmeticFactorizationFullEulerWholeRelationGlobalDeterminantSection.innerDeterminantPolynomial_eq_existing,
      CanonicalUnitArithmeticFactorizationFullEulerDerivedDeterminantSection.determinantPolynomial_eq_actual_product]
    exact Finset.dvd_prod_of_mem _ (Finset.mem_univ _)
  exact ⟨factor, factor.actual_joint_landing,
    ⟨localFactor, dividesGlobal⟩, rfl⟩

noncomputable def normalizedGlobalFactor {prime : Nat.Primes}
    (generated : GeneratedLocalDeterminantCoordinateFactorAt prime) :
    Polynomial ℚ :=
  generated.globalFactor.1.eval₂
    (Polynomial.C.comp (Int.castRingHom ℚ))
    (Polynomial.X * Polynomial.C (((prime : Nat) : ℚ)⁻¹))

noncomputable def normalizedGlobalSeries {prime : Nat.Primes}
    (generated : GeneratedLocalDeterminantCoordinateFactorAt prime) :
    PowerSeries ℚ :=
  PowerSeries.invOfUnit
    (↑generated.normalizedGlobalFactor : PowerSeries ℚ) 1

def arithmeticFactor {prime : Nat.Primes}
    (factor : GeneratedLocalDeterminantCoordinateFactorAt prime) :
    ArithmeticFunction ℚ :=
  ArithmeticFunction.ofPowerSeries (prime : Nat)
    factor.normalizedGlobalSeries

theorem normalizedGlobalFactor_eq_actual {prime : Nat.Primes}
    (generated : GeneratedLocalDeterminantCoordinateFactorAt prime) :
    generated.normalizedGlobalFactor =
      normalizedActualLocalDeterminantFactor generated.factor 0 := by
  unfold normalizedGlobalFactor normalizedActualLocalDeterminantFactor
  rw [generated.globalFactor_eq]

theorem normalizedGlobalSeries_eq_actual {prime : Nat.Primes}
    (generated : GeneratedLocalDeterminantCoordinateFactorAt prime) :
    generated.normalizedGlobalSeries =
      normalizedActualLocalZetaSeries generated.factor 0 := by
  unfold normalizedGlobalSeries normalizedActualLocalZetaSeries
  rw [normalizedGlobalFactor_eq_actual]

@[simp] theorem generate_arithmeticFactor (prime : Nat.Primes) :
    (generate prime).arithmeticFactor =
      sourceLocalFormalEulerFactorQ prime :=
  by
    unfold arithmeticFactor sourceLocalFormalEulerFactorQ
    rw [normalizedGlobalSeries_eq_actual,
      normalizedActualLocalZetaSeries_eq_sourceLocal_map]

theorem generate_preserves_actual_determinant_factor
    (prime : Nat.Primes) :
    let generated := generate prime
    factorialHistory
        (CanonicalUnitArithmeticFactorizationOccurrence.runtimeWholeHistory
          generated.factor.stage) =
        (primePowerHistory generated.factor.primeIndex
          generated.factor.exponentIndex).joint
          (quotientHistory generated.factor.primeIndex
            generated.factor.exponentIndex) ∧
      generated.globalFactor.1 ∣
        (GlobalDeterminantSectionDiagram.obj
          (Opposite.op generated.factor.stage)).polynomial ∧
      generated.normalizedGlobalFactor = 1 - Polynomial.X ∧
      generated.normalizedGlobalSeries = PowerSeries.mk 1 := by
  let generated := generate prime
  exact ⟨generated.actualLanding, generated.globalFactor.2,
    (normalizedGlobalFactor_eq_actual generated).trans
      (normalizedActualLocalDeterminantFactor_eq_sourcePolynomial _ _),
    (normalizedGlobalSeries_eq_actual generated).trans
      (normalizedActualLocalZetaSeries_eq_geometric _ _)⟩

end GeneratedLocalDeterminantCoordinateFactorAt

/-- Euler prefix whose local factors are projections of actual determinant
certificates, not a separately chosen local-factor table. -/
def castArithmeticFunctionValue
    (value : ArithmeticFunction ℤ) : ArithmeticFunction ℚ :=
  ⟨fun n => (value n : ℚ), by simp⟩

@[simp] theorem castArithmeticFunctionValue_apply
    (value : ArithmeticFunction ℤ) (n : Nat) :
    castArithmeticFunctionValue value n = (value n : ℚ) :=
  rfl

def castArithmeticFunction :
    ArithmeticFunction ℤ →+* ArithmeticFunction ℚ where
  toFun := castArithmeticFunctionValue
  map_zero' := by
    ext n
    simp
  map_one' := by
    ext n
    simp [ArithmeticFunction.one_apply]
  map_add' left right := by
    ext n
    change ((left n + right n : ℤ) : ℚ) =
      (left n : ℚ) + (right n : ℚ)
    norm_num
  map_mul' left right := by
    ext n
    change
      ((∑ x ∈ n.divisorsAntidiagonal, left x.1 * right x.2 : ℤ) : ℚ) =
        ∑ x ∈ n.divisorsAntidiagonal,
          (left x.1 : ℚ) * (right x.2 : ℚ)
    push_cast
    rfl

@[simp] theorem castArithmeticFunction_apply
    (value : ArithmeticFunction ℤ) (n : Nat) :
    castArithmeticFunction value n = (value n : ℚ) :=
  rfl

theorem sourceLocalFormalEulerFactorQ_eq_cast
    (prime : Nat.Primes) :
    sourceLocalFormalEulerFactorQ prime =
      castArithmeticFunction (sourceLocalFormalEulerFactor prime) := by
  ext n
  unfold sourceLocalFormalEulerFactorQ sourceLocalFormalEulerFactor
  rw [castArithmeticFunction_apply]
  rw [sourceLocalZetaPowerSeries_eq_mk_one]
  rw [show PowerSeries.map (Int.castRingHom ℚ) (PowerSeries.mk 1) =
      PowerSeries.mk 1 by
    ext exponent
    simp]
  by_cases power : ∃ exponent : Nat, (prime : Nat) ^ exponent = n
  · obtain ⟨exponent, rfl⟩ := power
    rw [ArithmeticFunction.ofPowerSeries_apply_pow prime.property.one_lt,
      ArithmeticFunction.ofPowerSeries_apply_pow prime.property.one_lt]
    simp
  · rw [ArithmeticFunction.ofPowerSeries_apply prime.property.one_lt,
      ArithmeticFunction.ofPowerSeries_apply prime.property.one_lt,
      Function.extend_apply', Function.extend_apply'] <;> simp_all

def determinantCoordinatePrefix : UnitHistory → ArithmeticFunction ℚ
  | .empty => 1
  | .next prior =>
      (GeneratedLocalDeterminantCoordinateFactorAt.generate
        (primeAtStage prior.cardinalShadow)).arithmeticFactor *
          determinantCoordinatePrefix prior

@[simp] theorem determinantCoordinatePrefix_empty :
    determinantCoordinatePrefix .empty = 1 :=
  rfl

@[simp] theorem determinantCoordinatePrefix_next (prior : UnitHistory) :
    determinantCoordinatePrefix (.next prior) =
      (GeneratedLocalDeterminantCoordinateFactorAt.generate
        (primeAtStage prior.cardinalShadow)).arithmeticFactor *
          determinantCoordinatePrefix prior :=
  rfl

theorem determinantCoordinatePrefix_eq_finiteEulerPrefix
    (history : UnitHistory) :
    determinantCoordinatePrefix history =
      castArithmeticFunction (finiteEulerPrefix history) := by
  induction history with
  | empty =>
      rw [determinantCoordinatePrefix_empty, finiteEulerPrefix_empty, map_one]
  | next prior inductionHypothesis =>
      rw [determinantCoordinatePrefix_next, finiteEulerPrefix_next,
        GeneratedLocalDeterminantCoordinateFactorAt.generate_arithmeticFactor,
        sourceLocalFormalEulerFactorQ_eq_cast, map_mul,
        inductionHypothesis]

def runtimeDeterminantCoordinatePrefix (stage : Nat) :
    ArithmeticFunction ℚ :=
  determinantCoordinatePrefix
    (CanonicalUnitArithmeticRuntimeCofinalEuler.runtimeWholeHistory stage)

theorem runtimeDeterminantCoordinatePrefix_eq_runtimeEulerPrefix
    (stage : Nat) :
    runtimeDeterminantCoordinatePrefix stage =
      castArithmeticFunction (runtimeEulerPrefix stage) := by
  unfold runtimeDeterminantCoordinatePrefix runtimeEulerPrefix
  exact determinantCoordinatePrefix_eq_finiteEulerPrefix _

theorem runtimeDeterminantCoordinatePrefix_eventually_eq
    (coefficient : Nat) :
    ∀ᶠ stage : Nat in atTop,
      runtimeDeterminantCoordinatePrefix stage coefficient =
        (formalEulerCoefficients coefficient : ℚ) := by
  filter_upwards
    [runtimeEulerPrefix_eventually_eq_formalEulerCoefficients coefficient]
      with stage equality
  rw [runtimeDeterminantCoordinatePrefix_eq_runtimeEulerPrefix,
    castArithmeticFunction_apply, equality]

/-- The global germ is generated from the certified determinant prefixes.
Its value is not accepted from a caller. -/
structure GeneratedGlobalDeterminantCoordinateGerm : Type where
  private mk ::
  coefficients : ArithmeticFunction ℚ
  generated : ∀ coefficient : Nat,
    ∀ᶠ stage : Nat in atTop,
      runtimeDeterminantCoordinatePrefix stage coefficient =
        coefficients coefficient

def GeneratedGlobalDeterminantCoordinateGerm.generate :
    GeneratedGlobalDeterminantCoordinateGerm :=
  ⟨castArithmeticFunction formalEulerCoefficients, by
    intro coefficient
    simpa only [castArithmeticFunction_apply] using
      runtimeDeterminantCoordinatePrefix_eventually_eq coefficient⟩

/-- Same exact factorization occurrence, now carrying the generated global
coordinate germ rather than an independently regenerated Euler source. -/
def globalGermOccurrence : RootedAccountedUnfolding
    (FactorizationPayload × GeneratedGlobalDeterminantCoordinateGerm) :=
  seedOccurrence.map fun owner =>
    (owner, GeneratedGlobalDeterminantCoordinateGerm.generate)

theorem globalGermOccurrence_projects :
    globalGermOccurrence.map Prod.fst = seedOccurrence := by
  unfold globalGermOccurrence
  rw [RootedAccountedUnfolding.map_map]
  change seedOccurrence.map id = seedOccurrence
  exact RootedAccountedUnfolding.map_id _

theorem generatedGlobalCoefficients_eq_formalEulerCoefficients :
    globalGermOccurrence.root.2.coefficients =
      castArithmeticFunction formalEulerCoefficients := by
  apply ArithmeticFunction.ext
  intro coefficient
  have together :=
    (globalGermOccurrence.root.2.generated coefficient).and
      (runtimeDeterminantCoordinatePrefix_eventually_eq coefficient)
  rcases together.exists with ⟨stage, generatedEq, formalEq⟩
  exact generatedEq.symm.trans formalEq

theorem castArithmeticFunction_zeta :
    castArithmeticFunction (ArithmeticFunction.zeta : ArithmeticFunction ℤ) =
      (ArithmeticFunction.zeta : ArithmeticFunction ℚ) := by
  ext coefficient
  by_cases zero : coefficient = 0
  · subst coefficient
    simp
  · rw [castArithmeticFunction_apply,
      ArithmeticFunction.natCoe_apply,
      ArithmeticFunction.natCoe_apply,
      ArithmeticFunction.zeta_apply_ne zero]
    norm_num

theorem generatedGlobalCoefficients_eq_zeta :
    globalGermOccurrence.root.2.coefficients =
      (ArithmeticFunction.zeta : ArithmeticFunction ℚ) := by
  rw [generatedGlobalCoefficients_eq_formalEulerCoefficients,
    formalEulerCoefficients_eq_zeta, castArithmeticFunction_zeta]

noncomputable def globalDeterminantCoordinateGerm (coordinate : ℂ) : ℂ :=
  LSeries (fun n =>
    (globalGermOccurrence.root.2.coefficients n : ℂ)) coordinate

theorem globalDeterminantCoordinateGerm_eq_riemannZeta
    {coordinate : ℂ} (converges : 1 < coordinate.re) :
    globalDeterminantCoordinateGerm coordinate =
      riemannZeta coordinate := by
  unfold globalDeterminantCoordinateGerm
  rw [generatedGlobalCoefficients_eq_zeta]
  calc
    LSeries
        (fun n => ((ArithmeticFunction.zeta : ArithmeticFunction ℚ) n : ℂ))
        coordinate = LSeries 1 coordinate := by
          apply LSeries_congr
          intro n nonzero
          simp [ArithmeticFunction.zeta_apply_ne nonzero]
    _ = riemannZeta coordinate := LSeries_one_eq_riemannZeta converges

/-- A downstream analytic realization of the already generated germ. -/
structure ComplexRealization : Type where
  function : ℂ → ℂ
  analyticAwayOne : AnalyticOnNhd ℂ function ({1} : Set ℂ)ᶜ
  agreesWithGeneratedGerm : ∀ {coordinate : ℂ},
    1 < coordinate.re →
      function coordinate = globalDeterminantCoordinateGerm coordinate

def mathlibRealization : ComplexRealization where
  function := riemannZeta
  analyticAwayOne := analyticOn_riemannZeta
  agreesWithGeneratedGerm := fun converges =>
    (globalDeterminantCoordinateGerm_eq_riemannZeta converges).symm

/-- The half-plane germ determines every analytic realization on the
punctured plane. -/
theorem ComplexRealization.eqOn_awayOne
    (left right : ComplexRealization) :
    Set.EqOn left.function right.function ({1} : Set ℂ)ᶜ := by
  have agreement (coordinate : ℂ) (converges : 1 < coordinate.re) :
      left.function coordinate = right.function coordinate :=
    (left.agreesWithGeneratedGerm converges).trans
      (right.agreesWithGeneratedGerm converges).symm
  exact left.analyticAwayOne.eqOn_of_preconnected_of_eventuallyEq
    right.analyticAwayOne
    (isConnected_compl_singleton_of_one_lt_rank (by simp) 1).isPreconnected
    (by norm_num : (2 : ℂ) ∈ ({1} : Set ℂ)ᶜ)
    (eventuallyEq_of_mem
      ((isOpen_lt continuous_const Complex.continuous_re).mem_nhds
        (by norm_num))
      agreement)

theorem ComplexRealization.eq_mathlib_of_ne_one
    (realization : ComplexRealization) {coordinate : ℂ}
    (notPole : coordinate ≠ 1) :
    realization.function coordinate = riemannZeta coordinate :=
  realization.eqOn_awayOne mathlibRealization notPole

/-- Fixedness-free coordinate regression: a zero of any analytic realization
of the generated germ is exactly a Mathlib zeta zero away from the pole.  No
second zero-fibre carrier is introduced. -/
theorem complexRealization_zero_iff
    (coordinate : ℂ) (notPole : coordinate ≠ 1) :
    (∃ realization : ComplexRealization,
        realization.function coordinate = 0) ↔
      riemannZeta coordinate = 0 := by
  constructor
  · rintro ⟨realization, zero⟩
    rw [← realization.eq_mathlib_of_ne_one notPole]
    exact zero
  · intro zero
    exact ⟨mathlibRealization, zero⟩

theorem preserves_actual_factors_global_germ_and_unique_coordinate :
    globalGermOccurrence.map Prod.fst = seedOccurrence ∧
      (∀ prime : Nat.Primes,
        let generated :=
          GeneratedLocalDeterminantCoordinateFactorAt.generate prime
        generated.arithmeticFactor =
            ArithmeticFunction.ofPowerSeries (prime : Nat)
              generated.normalizedGlobalSeries ∧
          generated.globalFactor.1 ∣
            (GlobalDeterminantSectionDiagram.obj
              (Opposite.op generated.factor.stage)).polynomial ∧
          generated.normalizedGlobalFactor =
            1 - Polynomial.X ∧
          generated.normalizedGlobalSeries =
            PowerSeries.mk 1) ∧
      globalGermOccurrence.root.2.coefficients =
        (ArithmeticFunction.zeta : ArithmeticFunction ℚ) ∧
      (∀ realization : ComplexRealization,
        Set.EqOn realization.function riemannZeta ({1} : Set ℂ)ᶜ) := by
  exact ⟨globalGermOccurrence_projects,
    fun prime => ⟨rfl,
      (GeneratedLocalDeterminantCoordinateFactorAt.generate prime).globalFactor.2,
      (GeneratedLocalDeterminantCoordinateFactorAt.normalizedGlobalFactor_eq_actual _).trans
        (normalizedActualLocalDeterminantFactor_eq_sourcePolynomial _ _),
      (GeneratedLocalDeterminantCoordinateFactorAt.normalizedGlobalSeries_eq_actual _).trans
        (normalizedActualLocalZetaSeries_eq_geometric _ _)⟩,
    generatedGlobalCoefficients_eq_zeta,
    fun realization => realization.eqOn_awayOne mathlibRealization⟩

end
