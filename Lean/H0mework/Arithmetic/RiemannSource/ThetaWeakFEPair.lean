import Mathlib.NumberTheory.LSeries.RiemannZeta
import H0mework.Arithmetic.RiemannSource.ThetaCofinalFold

/-!
# Weak functional-equation pair generated by the theta fold

Mathlib's `hurwitzEvenFEPair 0` is used as a frozen analytic consumer.  Its
two kernels are identified pointwise on `t > 0` with the cofinal sum of the
source-owned finite folds before its Mellin continuation, pole correction,
or functional equation is exposed.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalRiemann

open CanonicalUnitArithmeticFactorizationEulerDependentDiagram
open CanonicalUnitArithmeticFactorizationGlobalDeterminantCoordinateRealization
open Complex
open RootedAccountedUnfolding

noncomputable section

/-- A weak FE-pair may be stored only after both of its positive-real kernels
have been identified with finite source folds. -/
structure GeneratedRiemannWeakFEPairAt (owner : GlobalGermOwner) : Type 5 where
  private mk ::
  pair : WeakFEPair ℂ
  pair_eq : pair = HurwitzZeta.hurwitzEvenFEPair 0
  f_generated : ∀ (t : ℝ), 0 < t →
    pair.f t = ((∑' stage, generatedRiemannThetaTerm owner t stage : ℝ) : ℂ)
  g_generated : ∀ (t : ℝ), 0 < t →
    pair.g t = ((∑' stage, generatedRiemannThetaTerm owner t stage : ℝ) : ℂ)

namespace GeneratedRiemannWeakFEPairAt

def generate (owner : GlobalGermOwner) :
    GeneratedRiemannWeakFEPairAt owner where
  pair := HurwitzZeta.hurwitzEvenFEPair 0
  pair_eq := rfl
  f_generated := by
    intro t positive
    change (HurwitzZeta.evenKernel 0 t : ℂ) = _
    rw [tsum_generatedRiemannThetaTerm owner positive]
  g_generated := by
    intro t positive
    change (HurwitzZeta.cosKernel 0 t : ℂ) = _
    rw [← HurwitzZeta.evenKernel_eq_cosKernel_of_zero,
      tsum_generatedRiemannThetaTerm owner positive]

@[simp] theorem generate_pair (owner : GlobalGermOwner) :
    (generate owner).pair = HurwitzZeta.hurwitzEvenFEPair 0 :=
  rfl

@[simp] theorem generate_f₀ (owner : GlobalGermOwner) :
    (generate owner).pair.f₀ = 1 := by
  simp [generate, HurwitzZeta.hurwitzEvenFEPair]

@[simp] theorem generate_g₀ (owner : GlobalGermOwner) :
    (generate owner).pair.g₀ = 1 := by
  rfl

theorem generate_selfDual (owner : GlobalGermOwner) :
    (generate owner).pair.symm = (generate owner).pair := by
  rw [generate_pair, HurwitzZeta.hurwitzEvenFEPair_zero_symm]

/-- The Mellin transform consumes the already identified theta kernel minus
its generated zero mode. -/
theorem generate_hasMellin (owner : GlobalGermOwner)
    {s : ℂ} (halfPlane : (1 / 2 : ℝ) < s.re) :
    HasMellin
        ((generate owner).pair.f · - (generate owner).pair.f₀)
        s ((generate owner).pair.Λ s) :=
  (generate owner).pair.hasMellin halfPlane

theorem generate_entireCorrectedMellin (owner : GlobalGermOwner) :
    Differentiable ℂ (generate owner).pair.Λ₀ :=
  (generate owner).pair.differentiable_Λ₀

theorem generate_functionalEquation (owner : GlobalGermOwner) (s : ℂ) :
    (generate owner).pair.Λ ((generate owner).pair.k - s) =
      (generate owner).pair.ε • (generate owner).pair.symm.Λ s :=
  (generate owner).pair.functional_equation s

end GeneratedRiemannWeakFEPairAt

abbrev WeakFEPairPayload :=
  Σ owner : GlobalGermOwner, GeneratedRiemannWeakFEPairAt owner

/-- The analytic consumer remains on the literal arithmetic germ occurrence. -/
def generatedRiemannWeakFEPairOccurrence :
    RootedAccountedUnfolding WeakFEPairPayload :=
  globalGermOccurrence.map fun owner =>
    ⟨owner, GeneratedRiemannWeakFEPairAt.generate owner⟩

theorem generatedRiemannWeakFEPairOccurrence_projects :
    generatedRiemannWeakFEPairOccurrence.map Sigma.fst =
      globalGermOccurrence := by
  rw [generatedRiemannWeakFEPairOccurrence,
    RootedAccountedUnfolding.map_map]
  change globalGermOccurrence.map id = globalGermOccurrence
  exact RootedAccountedUnfolding.map_id _

theorem generatedRiemannWeakFEPairOccurrence_projects_to_seed :
    (generatedRiemannWeakFEPairOccurrence.map Sigma.fst).map Prod.fst =
      seedOccurrence := by
  rw [generatedRiemannWeakFEPairOccurrence_projects,
    globalGermOccurrence_projects]

end
end CanonicalRiemann
end NoIslandNoMagic
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
