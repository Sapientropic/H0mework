import H0mework.Arithmetic.SourceRepair.ActiveRepairProducer
import H0mework.Arithmetic.SourceAtoms.HolonomyGapObstruction

/-!
# Defect-to-holonomy map

This file lowers the holonomy socket from a three-field obstruction law to the
more direct mechanism target:

```text
projection defect -> closed strict residual holonomy based at that defect
```

It still does not construct such a map.  The point is to make the missing
source theorem explicit, so future representation / GT / crystal / branching
dynamics have a precise target that is not endpoint coverage.
-/

namespace RepresentationArithmeticAtomProjectionDefect

universe u

/-- Closed strict residual holonomy based at a fixed source evidence.

This is the local target generated by a projection defect: return to the same
source evidence while strictly lowering its Nat-valued residual energy. -/
structure ClosedStrictResidualHolonomyAt
    (SourceEvidence : Type u)
    (Residual : AdditiveResidualTransportCategory SourceEvidence)
    (source : SourceEvidence) where
  target : SourceEvidence
  closes : target = source
  residual_drops :
    Residual.residualEnergy target < Residual.residualEnergy source

/-- Forget the explicit base point of a local closed strict holonomy. -/
def closedStrictResidualHolonomyOfAt
    {SourceEvidence : Type u}
    {Residual : AdditiveResidualTransportCategory SourceEvidence}
    {source : SourceEvidence}
    (H : ClosedStrictResidualHolonomyAt SourceEvidence Residual source) :
    ClosedStrictResidualHolonomy SourceEvidence Residual where
  source := source
  target := H.target
  closes := H.closes
  residual_drops := H.residual_drops

/-- A fixed-base closed strict holonomy is impossible. -/
theorem no_closed_strict_residual_holonomy_at
    {SourceEvidence : Type u}
    {Residual : AdditiveResidualTransportCategory SourceEvidence}
    {source : SourceEvidence} :
    ¬ Nonempty
      (ClosedStrictResidualHolonomyAt SourceEvidence Residual source) := by
  intro h
  rcases h with ⟨H⟩
  exact
    no_closed_strict_residual_holonomy
      ⟨closedStrictResidualHolonomyOfAt H⟩

/-- Feasible defect-to-holonomy map.

This is a more mechanism-facing version of
`FeasibleAtomProjectionDefectHolonomyObstructionLaw`: every feasible defect
directly generates a forbidden closed strict residual holonomy based at the
defect's source evidence. -/
structure FeasibleAtomProjectionDefectToHolonomyMap
    (Atomic : Nat -> Prop) (SourceEvidence : Type u)
    (Residual : AdditiveResidualTransportCategory SourceEvidence)
    (Source : RepresentationFeasibleCategory SourceEvidence)
    (n : Nat) where
  holonomy_at :
    ∀ {k : Nat}
      (defect :
        FeasibleAtomProjectionDefect
          Atomic SourceEvidence Residual Source n k),
        ClosedStrictResidualHolonomyAt
          SourceEvidence Residual defect.demand.demand.evidence

/-- A feasible defect-to-holonomy map generates the older holonomy obstruction
law. -/
def feasibleHolonomyObstructionLawOfDefectToHolonomyMap
    {Atomic : Nat -> Prop} {SourceEvidence : Type u}
    {Residual : AdditiveResidualTransportCategory SourceEvidence}
    {Source : RepresentationFeasibleCategory SourceEvidence}
    {n : Nat}
    (M :
      FeasibleAtomProjectionDefectToHolonomyMap
        Atomic SourceEvidence Residual Source n) :
    FeasibleAtomProjectionDefectHolonomyObstructionLaw
      Atomic SourceEvidence Residual Source n where
  terminalEvidence := fun defect => (M.holonomy_at defect).target
  closes := fun defect => (M.holonomy_at defect).closes
  residual_drops := fun defect => (M.holonomy_at defect).residual_drops

/-- Feasible defect-to-holonomy maps exclude feasible defects. -/
theorem no_feasible_atom_projection_defect_of_defect_to_holonomy_map
    {Atomic : Nat -> Prop} {SourceEvidence : Type u}
    {Residual : AdditiveResidualTransportCategory SourceEvidence}
    {Source : RepresentationFeasibleCategory SourceEvidence}
    {n : Nat}
    (M :
      FeasibleAtomProjectionDefectToHolonomyMap
        Atomic SourceEvidence Residual Source n) :
    ∀ k : Nat,
      ¬ Nonempty
        (FeasibleAtomProjectionDefect
          Atomic SourceEvidence Residual Source n k) :=
  no_feasible_atom_projection_defect_of_holonomy_obstruction
    (feasibleHolonomyObstructionLawOfDefectToHolonomyMap M)

/-- Demand-level feasible consequence of a defect-to-holonomy map. -/
theorem not_not_atom_realization_of_feasible_demand_by_defect_to_holonomy_map
    {Atomic : Nat -> Prop} {SourceEvidence : Type u}
    {Residual : AdditiveResidualTransportCategory SourceEvidence}
    {Source : RepresentationFeasibleCategory SourceEvidence}
    {n k : Nat}
    (M :
      FeasibleAtomProjectionDefectToHolonomyMap
        Atomic SourceEvidence Residual Source n)
    (demand :
      FeasibleRepRepairDemand SourceEvidence Residual Source n k) :
    ¬¬ ∃ p : ArithmeticAtomPair Atomic n,
      ArithmeticAtomPair.energy p = k :=
  not_not_atom_realization_of_feasible_demand_by_holonomy_obstruction
    (feasibleHolonomyObstructionLawOfDefectToHolonomyMap M)
    demand

/-- Traced feasible defect-to-holonomy map.

The returned holonomy is based at the traced defect's source evidence, so the
sourcePath / phaseTrace / sigmaTag / producerTrace context is not discarded
before the obstruction is invoked. -/
structure TracedFeasibleAtomProjectionDefectToHolonomyMap
    (SourcePath PhaseTrace SigmaTag ProducerTrace : Type u)
    (Atomic : Nat -> Prop) (SourceEvidence : Type u)
    (Residual : AdditiveResidualTransportCategory SourceEvidence)
    (Source : RepresentationFeasibleCategory SourceEvidence)
    (n : Nat) where
  holonomy_at :
    ∀ {k : Nat}
      (defect :
        TracedFeasibleAtomProjectionDefect
          SourcePath PhaseTrace SigmaTag ProducerTrace
          Atomic SourceEvidence Residual Source n k),
        ClosedStrictResidualHolonomyAt
          SourceEvidence Residual defect.demand.demand.demand.evidence

/-- A traced defect-to-holonomy map generates the older traced holonomy
obstruction law. -/
def tracedHolonomyObstructionLawOfDefectToHolonomyMap
    {SourcePath PhaseTrace SigmaTag ProducerTrace : Type u}
    {Atomic : Nat -> Prop} {SourceEvidence : Type u}
    {Residual : AdditiveResidualTransportCategory SourceEvidence}
    {Source : RepresentationFeasibleCategory SourceEvidence}
    {n : Nat}
    (M :
      TracedFeasibleAtomProjectionDefectToHolonomyMap
        SourcePath PhaseTrace SigmaTag ProducerTrace
        Atomic SourceEvidence Residual Source n) :
    TracedFeasibleAtomProjectionDefectHolonomyObstructionLaw
      SourcePath PhaseTrace SigmaTag ProducerTrace
      Atomic SourceEvidence Residual Source n where
  terminalEvidence := fun defect => (M.holonomy_at defect).target
  closes := fun defect => (M.holonomy_at defect).closes
  residual_drops := fun defect => (M.holonomy_at defect).residual_drops

/-- Traced defect-to-holonomy maps exclude traced feasible defects. -/
theorem no_traced_feasible_atom_projection_defect_of_defect_to_holonomy_map
    {SourcePath PhaseTrace SigmaTag ProducerTrace : Type u}
    {Atomic : Nat -> Prop} {SourceEvidence : Type u}
    {Residual : AdditiveResidualTransportCategory SourceEvidence}
    {Source : RepresentationFeasibleCategory SourceEvidence}
    {n : Nat}
    (M :
      TracedFeasibleAtomProjectionDefectToHolonomyMap
        SourcePath PhaseTrace SigmaTag ProducerTrace
        Atomic SourceEvidence Residual Source n) :
    ∀ k : Nat,
      ¬ Nonempty
        (TracedFeasibleAtomProjectionDefect
          SourcePath PhaseTrace SigmaTag ProducerTrace
          Atomic SourceEvidence Residual Source n k) :=
  no_traced_feasible_atom_projection_defect_of_holonomy_obstruction
    (tracedHolonomyObstructionLawOfDefectToHolonomyMap M)

/-- Demand-level traced consequence of a defect-to-holonomy map. -/
theorem not_not_atom_realization_of_traced_feasible_demand_by_defect_to_holonomy_map
    {SourcePath PhaseTrace SigmaTag ProducerTrace : Type u}
    {Atomic : Nat -> Prop} {SourceEvidence : Type u}
    {Residual : AdditiveResidualTransportCategory SourceEvidence}
    {Source : RepresentationFeasibleCategory SourceEvidence}
    {n k : Nat}
    (M :
      TracedFeasibleAtomProjectionDefectToHolonomyMap
        SourcePath PhaseTrace SigmaTag ProducerTrace
        Atomic SourceEvidence Residual Source n)
    (demand :
      TracedFeasibleRepRepairDemand
        SourcePath PhaseTrace SigmaTag ProducerTrace
        SourceEvidence Residual Source n k) :
    ¬¬ ∃ p : ArithmeticAtomPair Atomic n,
      ArithmeticAtomPair.energy p = k :=
  not_not_atom_realization_of_traced_feasible_demand_by_holonomy_obstruction
    (tracedHolonomyObstructionLawOfDefectToHolonomyMap M)
    demand

/-- Active produced demand plus a traced defect-to-holonomy map rules out the
active missing-realization branch without endpoint witness return. -/
theorem not_not_atom_realization_of_active_produced_demand_by_defect_to_holonomy_map
    {SourcePath PhaseTrace SigmaTag ProducerTrace : Type u}
    {Atomic : Nat -> Prop} {SourceEvidence : Type u}
    {Residual : AdditiveResidualTransportCategory SourceEvidence}
    {Source : RepresentationFeasibleCategory SourceEvidence}
    {n k : Nat}
    (P :
      ActiveTracedFeasibleRepairProducer
        SourcePath PhaseTrace SigmaTag ProducerTrace
        SourceEvidence Residual Source)
    (M :
      TracedFeasibleAtomProjectionDefectToHolonomyMap
        SourcePath PhaseTrace SigmaTag ProducerTrace
        Atomic SourceEvidence Residual Source n)
    (hActive : P.Active n k) :
    ¬¬ ∃ p : ArithmeticAtomPair Atomic n,
      ArithmeticAtomPair.energy p = k :=
  not_not_atom_realization_of_traced_feasible_demand_by_defect_to_holonomy_map
    M (P.produce hActive)

/-- Defect-exclusion form for active produced demands using a traced
defect-to-holonomy map. -/
theorem no_traced_feasible_defect_of_active_produced_demand_by_defect_to_holonomy_map
    {SourcePath PhaseTrace SigmaTag ProducerTrace : Type u}
    {Atomic : Nat -> Prop} {SourceEvidence : Type u}
    {Residual : AdditiveResidualTransportCategory SourceEvidence}
    {Source : RepresentationFeasibleCategory SourceEvidence}
    {n k : Nat}
    (P :
      ActiveTracedFeasibleRepairProducer
        SourcePath PhaseTrace SigmaTag ProducerTrace
        SourceEvidence Residual Source)
    (M :
      TracedFeasibleAtomProjectionDefectToHolonomyMap
        SourcePath PhaseTrace SigmaTag ProducerTrace
        Atomic SourceEvidence Residual Source n)
    (_hActive : P.Active n k) :
    ¬ Nonempty
      (TracedFeasibleAtomProjectionDefect
        SourcePath PhaseTrace SigmaTag ProducerTrace
        Atomic SourceEvidence Residual Source n k) :=
  no_traced_feasible_atom_projection_defect_of_defect_to_holonomy_map M k


end RepresentationArithmeticAtomProjectionDefect
