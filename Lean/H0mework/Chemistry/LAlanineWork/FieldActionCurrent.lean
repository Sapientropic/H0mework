import H0mework.Chemistry.LAlanineWork.GeneratedFieldCapacity
import H0mework.Chemistry.LAlanineThermalRuntime.InstalledTimedPairEntropy
import H0mework.Foundation.Source.SequentialAction

/-! # The field action receives the exact pair generated by the preceding root write -/

set_option autoImplicit false

namespace SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Molecule
namespace LAlanine40K2025.Thermal.Work.Runtime

open _root_.SaturationMonoid.ResponsibilityLifecycle
open _root_.SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution
open _root_.SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
open Propagation.Interface Propagation.Producer Preparation Collision Drive
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Molecule.LAlanine40K2025.Propagation.Runtime
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Molecule.LAlanine40K2025.Thermal.Runtime
open scoped ComplexOrder

noncomputable section

def fieldSourceRuntime : LivingRuntimeState electronicRuntimeProcess := electronicRuntimeSecondNative.tick.next

def fieldSourceTime : ℚ := timedPairInitialTime + nativeClockStep

theorem fieldSourceTime_held : HoldsCollision fieldSourceTime :=
  (holdsCollision_next timedPairInitialTime).mpr (Or.inr collision_next_held)

theorem fieldSourceRuntime_current :
    fieldSourceRuntime.current.visit.current = .nativeElectronicCurrent fieldSourceTime := rfl

def fieldReceivedPair : JointMatrix Basis := actualTimedPairCurrent fieldSourceTime fieldSourceTime_held

theorem fieldReceivedPair_is_previous_target :
    fieldReceivedPair = actualTimedPairTarget timedPairInitialTime collision_next_held := by
  exact (actualTimedPairTarget_is_next_current timedPairInitialTime collision_next_held).symm

theorem fieldReceivedPair_eq_source : fieldReceivedPair = sourceFieldCycleCurrent := by
  rw [fieldReceivedPair, actualTimedPairCurrent_eq_source]
  have age : timedPairAge fieldSourceTime = nativeClockStep := by
    unfold timedPairAge fieldSourceTime
    ring
  rw [age]
  rfl

structure FieldState where
  localClock : ℚ
  pair : JointMatrix Basis
  positive : pair.PosSemidef
  normalized : pair.trace = 1
  netWork : ℝ

def fieldInitialState : FieldState where
  localClock := 0
  pair := fieldReceivedPair
  positive := (actualTimedPair_positive_normalized fieldSourceTime fieldSourceTime_held).1
  normalized := (actualTimedPair_positive_normalized fieldSourceTime fieldSourceTime_held).2.1
  netWork := 0

/-- Work is the two switching receipts generated from the received joint. -/
def fieldStateNext (current : FieldState) : FieldState where
  localClock := current.localClock + nativeClockStep
  pair := fieldCycleAdvance current.pair
  positive := fieldCycleAdvance_posSemidef current.pair current.positive
  normalized := (fieldCycleAdvance_trace current.pair).trans current.normalized
  netWork := current.netWork + fieldCycleWork current.pair

theorem fieldStateNext_capacity (current : FieldState) :
    fieldCapacity (fieldStateNext current).pair (fieldStateNext current).positive.isHermitian -
      fieldCapacity current.pair current.positive.isHermitian =
      (fieldStateNext current).netWork - current.netWork := by
  change fieldCapacity (fieldCycleAdvance current.pair) _ - fieldCapacity current.pair _ = _
  rw [fieldCycle_capacityBalance]
  change fieldCycleWork current.pair = current.netWork + fieldCycleWork current.pair - current.netWork
  ring

theorem fieldStateNext_received : (fieldStateNext fieldInitialState).pair =
    fieldCycleAdvance (actualTimedPairTarget timedPairInitialTime collision_next_held) := by
  change fieldCycleAdvance fieldReceivedPair = _
  rw [fieldReceivedPair_is_previous_target]

end

end LAlanine40K2025.Thermal.Work.Runtime
end SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Molecule
