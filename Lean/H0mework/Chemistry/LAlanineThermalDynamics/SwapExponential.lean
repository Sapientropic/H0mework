open scoped Matrix

noncomputable section

section Involution

variable {A : Type*} [NormedRing A] [NormedAlgebra ℂ A]

/-- Evaluation on the two eigenspaces of an involution. -/
private def involutionEvaluation (S : A) (square : S * S = 1) : ℂ × ℂ →ₐ[ℂ] A where
  toFun z := ((z.1 + z.2) / 2) • (1 : A) + ((z.1 - z.2) / 2) • S
  map_one' := by norm_num
  map_mul' z w := by
    dsimp
    simp only [add_mul, mul_add, smul_mul_smul_comm, one_mul, mul_one, square]
    module
  map_zero' := by simp
  map_add' z w := by dsimp; module
  commutes' z := by
    change ((z + z) / 2) • (1 : A) + ((z - z) / 2) • S = algebraMap ℂ A z
    rw [Algebra.algebraMap_eq_smul_one]
    module

theorem exp_smul_involution (S : A) (square : S * S = 1) (z : ℂ) :
    NormedSpace.exp (z • S) =
      ((Complex.exp z + Complex.exp (-z)) / 2) • (1 : A) +
      ((Complex.exp z - Complex.exp (-z)) / 2) • S := by
  let : NormedAlgebra ℚ A := .restrictScalars ℚ ℂ A
  have continuousEval : Continuous (involutionEvaluation S square) := by
    change Continuous (fun z : ℂ × ℂ =>
      ((z.1 + z.2) / 2) • (1 : A) + ((z.1 - z.2) / 2) • S)
    fun_prop
  have h := NormedSpace.map_exp (involutionEvaluation S square) continuousEval (z, -z)
  have evalInput : involutionEvaluation S square (z, -z) = z • S := by
    dsimp [involutionEvaluation]
    module
  rw [evalInput] at h
  change (((NormedSpace.exp (z, -z)).1 + (NormedSpace.exp (z, -z)).2) / 2) • (1 : A) +
    (((NormedSpace.exp (z, -z)).1 - (NormedSpace.exp (z, -z)).2) / 2) • S = _ at h
  simpa only [Prod.fst_exp, Prod.snd_exp, ← Complex.exp_eq_exp_ℂ] using h.symm

theorem exp_neg_I_smul_involution (S : A) (square : S * S = 1) (angle : ℝ) :
    NormedSpace.exp ((-Complex.I * (angle : ℂ)) • S) =
      (Real.cos angle : ℂ) • (1 : A) -
      (Complex.I * (Real.sin angle : ℂ)) • S := by
  rw [exp_smul_involution S square]
  have negAngle : -Complex.I * (angle : ℂ) = (-(angle : ℂ)) * Complex.I := by ring
  rw [negAngle, show -(-(angle : ℂ) * Complex.I) = (angle : ℂ) * Complex.I by ring]
  rw [Complex.exp_mul_I, Complex.exp_mul_I]
  simp only [Complex.cos_neg, Complex.sin_neg, ← Complex.ofReal_cos, ← Complex.ofReal_sin]
  module

end Involution

open scoped Matrix.Norms.Operator in
theorem swap_exponential {ι : Type*} [Fintype ι] [DecidableEq ι] (angle : ℝ) :
    NormedSpace.exp ((-Complex.I * (angle : ℂ)) • (swapOperator : JointMatrix ι)) =
      partialSwap (Real.cos angle) (Real.sin angle) :=
  exp_neg_I_smul_involution (swapOperator : JointMatrix ι) swap_squared angle

end

