set_option autoImplicit false
set_option maxRecDepth 65536

namespace SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Molecule
namespace LAlanine40K2025.BasinRefinement.WholeBandGeneratedInputs

open SourceRectangle WholeBandSource

open Lean Elab Term Command in
elab "assembleInputSourceRows" : command => liftTermElabM do
  let root ← getCurrNamespace
  let mut entries : List Expr := []
  for f in [:2048] do
    let b := f / 16
    let digits := (if b < 10 then "00" else if b < 100 then "0" else "") ++ toString b
    let name := root ++ Name.mkSimple ("Block16_" ++ digits) ++ Name.mkSimple s!"row{f}"
    let some (.defnInfo info) := (← getEnv).find? name | throwError "source row missing {name}"
    unless info.safety == .safe do throwError "unsafe source row"
    unless ← Meta.isDefEq info.type (Lean.mkConst ``CalculatedInput) do throwError "source row type"
    entries := entries ++ [Lean.mkConst name]
  WholeCellSource.declareSource `rows (← Meta.mkArrayLit (Lean.mkConst ``CalculatedInput) entries)

assembleInputSourceRows

theorem rows_size : rows.size = 2048 := rfl

open Lean Elab Term Command in
elab "recognizeOriginalInputArrays" : command => liftTermElabM do
  for (suffix, projection, original) in
      [(`rows_list_original_boxes, ``CalculatedInput.rawBox, ``rawCallBoxes),
       (`rows_list_original_reductions, ``CalculatedInput.rawReductions, ``rawCallReductions)] do
    let list ← Meta.mkAppM ``Array.toList #[Lean.mkConst ``rows]
    let left ← Meta.mkAppM ``List.map #[Lean.mkConst projection, list]
    let right ← Meta.mkAppM ``Array.toList #[Lean.mkConst original]
    let type ← Meta.mkEq left right
    let value ← Meta.mkEqRefl right
    addDecl (.thmDecl { name := (← getCurrNamespace) ++ suffix, levelParams := [], type, value })

recognizeOriginalInputArrays

theorem rows_original_boxes : rows.map CalculatedInput.rawBox = rawCallBoxes := by
  apply Array.toList_inj.mp
  rw [Array.toList_map]
  exact rows_list_original_boxes

theorem rows_original_reductions : rows.map CalculatedInput.rawReductions = rawCallReductions := by
  apply Array.toList_inj.mp
  rw [Array.toList_map]
  exact rows_list_original_reductions

noncomputable def rowAt (f : FullBandCall) : CalculatedInput :=
  rows[f.val]'(by rw [rows_size]; exact f.isLt)

private theorem projection_original {α : Type} [Inhabited α] (project : CalculatedInput → α)
    (original : Array α) (same : rows.map project = original) (f : FullBandCall) :
    project (rowAt f) = original[f.val]! :=
  calculated_projection rows f.val (by rw [rows_size]; exact f.isLt) project original same

theorem row_original_box (f : FullBandCall) : (rowAt f).rawBox = rawCallBoxes[f.val]! :=
  projection_original _ _ rows_original_boxes f

theorem row_original_reductions (f : FullBandCall) : (rowAt f).rawReductions = rawCallReductions[f.val]! :=
  projection_original _ _ rows_original_reductions f

/-- Whole-array recognition returns each calculation to its exact original call. -/
noncomputable def all_calculations (f : FullBandCall) :
    InputCalculation (callBox f) (callReductions f) := by
  have calculation := (rowAt f).calculation
  change InputCalculation (fun a => integerInterval ((rawCallBoxes[f.val]!)[a.val]!))
    (fun g => (rawCallReductions[f.val]!)[g.val]!)
  simpa only [row_original_box, row_original_reductions] using calculation

end LAlanine40K2025.BasinRefinement.WholeBandGeneratedInputs
end SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Molecule
