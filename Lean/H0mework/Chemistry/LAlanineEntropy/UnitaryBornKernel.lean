import H0mework.Quantum.GNS.NormalizedGram
import H0mework.Chemistry.LAlanineEntropy.FiniteThermalDataProcessing

/-! # The Born kernel is generated by the actual unitary, not a stochastic input -/

set_option autoImplicit false

namespace SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Molecule
namespace LAlanine40K2025.Thermal.Quantum

open MeasureTheory ProbabilityTheory
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Molecule.LAlanine40K2025.Thermal.Population
open scoped ENNReal

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def bornWeight (U : Matrix.unitaryGroup ι ℂ) (output input : ι) : ℝ :=
  Complex.normSq (U output input)

theorem bornWeight_nonnegative (U : Matrix.unitaryGroup ι ℂ) (output input : ι) :
    0 ≤ bornWeight U output input := Complex.normSq_nonneg _

theorem bornWeight_column (U : Matrix.unitaryGroup ι ℂ) (input : ι) :
    ∑ output, bornWeight U output input = 1 := by
  have exactColumn := congrArg (fun A : Matrix ι ι ℂ => A input input)
    (Unitary.coe_star_mul_self U)
  simp only [Matrix.mul_apply, Matrix.star_apply, Matrix.one_apply_eq] at exactColumn
  have complexSum : (∑ output, (bornWeight U output input : ℂ)) = 1 := by
    simpa only [bornWeight, Complex.star_def, ← Complex.normSq_eq_conj_mul_self] using exactColumn
  have realSum := congrArg Complex.re complexSum
  simpa only [Complex.re_sum, Complex.ofReal_re, Complex.one_re] using realSum

theorem bornWeight_row (U : Matrix.unitaryGroup ι ℂ) (output : ι) :
    ∑ input, bornWeight U output input = 1 := by
  have exactRow := congrArg (fun A : Matrix ι ι ℂ => A output output)
    (Unitary.coe_mul_star_self U)
  simp only [Unitary.coe_star, Matrix.mul_apply, Matrix.star_apply, Matrix.one_apply_eq] at exactRow
  have complexSum : (∑ input, (bornWeight U output input : ℂ)) = 1 := by
    simpa only [bornWeight, Complex.star_def, Complex.mul_conj] using exactRow
  have realSum := congrArg Complex.re complexSum
  simpa only [Complex.re_sum, Complex.ofReal_re, Complex.one_re] using realSum

def bornColumn (U : Matrix.unitaryGroup ι ℂ) (input : ι) : PMF ι :=
  PMF.ofFintype (fun output => ENNReal.ofReal (bornWeight U output input)) (by
    rw [← ENNReal.ofReal_sum_of_nonneg (fun output _ => bornWeight_nonnegative U output input),
      bornWeight_column, ENNReal.ofReal_one])

@[simp] theorem bornColumn_apply (U : Matrix.unitaryGroup ι ℂ) (input output : ι) :
    bornColumn U input output = ENNReal.ofReal (bornWeight U output input) := rfl

def bornPopulation (U : Matrix.unitaryGroup ι ℂ) (p : PMF ι) : PMF ι :=
  p.bind (bornColumn U)

theorem bornPopulation_apply (U : Matrix.unitaryGroup ι ℂ) (p : PMF ι) (output : ι) :
    bornPopulation U p output = ∑ input, p input * ENNReal.ofReal (bornWeight U output input) := by
  simp only [bornPopulation, PMF.bind_apply, bornColumn_apply, tsum_fintype]

theorem bornPopulation_toReal (U : Matrix.unitaryGroup ι ℂ) (p : PMF ι) (output : ι) :
    (bornPopulation U p output).toReal =
      ∑ input, (p input).toReal * bornWeight U output input := by
  rw [bornPopulation_apply, ENNReal.toReal_sum]
  · apply Finset.sum_congr rfl
    intro input _
    rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal (bornWeight_nonnegative U output input)]
  · intro input _
    exact ENNReal.mul_ne_top (p.apply_ne_top input) ENNReal.ofReal_ne_top

variable [MeasurableSpace ι] [MeasurableSingletonClass ι]

def bornKernel (U : Matrix.unitaryGroup ι ℂ) : Kernel ι ι where
  toFun input := (bornColumn U input).toMeasure
  measurable' := measurable_of_countable _

instance bornKernel_isMarkov (U : Matrix.unitaryGroup ι ℂ) : IsMarkovKernel (bornKernel U) :=
  ⟨fun input => inferInstanceAs (IsProbabilityMeasure (bornColumn U input).toMeasure)⟩

theorem bornKernel_comp (U : Matrix.unitaryGroup ι ℂ) (p : PMF ι) :
    bornKernel U ∘ₘ p.toMeasure = (bornPopulation U p).toMeasure := by
  apply Measure.ext_iff_singleton.mpr
  intro output
  rw [Measure.bind_apply (measurableSet_singleton output) (Kernel.aemeasurable _), lintegral_fintype]
  change (∑ input, (bornColumn U input).toMeasure {output} * p.toMeasure {input}) = _
  simp only [PMF.toMeasure_apply_singleton, measurableSet_singleton, bornColumn_apply, bornPopulation_apply]
  exact Finset.sum_congr rfl fun input _ => mul_comm _ _

end

end LAlanine40K2025.Thermal.Quantum
end SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Molecule
