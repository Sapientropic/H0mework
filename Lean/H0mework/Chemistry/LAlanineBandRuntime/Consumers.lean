import H0mework.Chemistry.LAlanineBandRuntime.ParentConsumers

set_option autoImplicit false

namespace SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Molecule
namespace LAlanine40K2025.BasinRefinement.WholeBandRuntime

open SourceGaussianModel SourceSignedEvaluator SourceRectangle IntervalParameterMap WholeBandSource WholeBandGeometry
noncomputable section

theorem wholeBandRuntime_source_restrictions :
    type_of% (wholeBandRuntimeFace_factorizes wholeBandRuntimeSeed (.component .certificate)) ∧
    type_of% cell16_raw_calls ∧
    (∀ c, generatedWholeBandMaterial.callBoxes (cell16Call c) = TrueTubeSource.callBox c) ∧
    type_of% cell16_callReductions ∧
    (∀ c, generatedWholeBandMaterial.callReports (cell16Call c) = TrueTubeWholeSource.recordedCallField c) ∧
    type_of% cell16_raw_rows ∧
    (∀ d i, generatedWholeBandMaterial.initialBoxes 16 d i = TrueTubeSource.initialBox d i) ∧
    (∀ d i, generatedWholeBandMaterial.tubeBoxes 16 d i = TrueTubeSource.tubeBox d i) ∧
    (∀ d i, generatedWholeBandMaterial.endpointBoxes 16 d i = TrueTubeSource.endpointBox d i) ∧
    type_of% cell16_elapsed ∧ type_of% source_step_and_sign ∧ type_of% source_seed_preserved :=
  ⟨wholeBandRuntime_sourceCertificate.1, wholeBandRuntime_sourceCertificate.2.rawRestriction,
    wholeBandRuntime_sourceCertificate.2.boxRestriction, wholeBandRuntime_sourceCertificate.2.reductionRestriction,
    wholeBandRuntime_sourceCertificate.2.reportRestriction, wholeBandRuntime_sourceCertificate.2.rowRestriction,
    wholeBandRuntime_sourceCertificate.2.initialRestriction, wholeBandRuntime_sourceCertificate.2.tubeRestriction,
    wholeBandRuntime_sourceCertificate.2.endpointRestriction, wholeBandRuntime_sourceCertificate.2.elapsedRestriction,
    wholeBandRuntime_sourceCertificate.2.stepAndSign, wholeBandRuntime_sourceCertificate.2.seedSource⟩

theorem wholeBandRuntime_actual_fields :
    type_of% (wholeBandRuntimeFace_factorizes wholeBandRuntimeSeed (.component .certificate)) ∧
    Function.Injective generatedWholeBandMaterial.certifiedCalls ∧
    (∀ c x, InRectangle (generatedWholeBandMaterial.callBoxes (generatedWholeBandMaterial.certifiedCalls c)) x →
      FieldHolds (generatedWholeBandMaterial.callReports (generatedWholeBandMaterial.certifiedCalls c)) x) ∧
    (∀ j b x, InRectangle (generatedWholeBandMaterial.callBoxes 0) x →
      Holds (WholeBandCache.calculatedAO generatedWholeBandMaterial.newInitialCache j b)
        (orbital (source_terms b) (SourceRectangle.multiindex (SourceFields.fullJet j)) x)) ∧
    WholeBandMatrix.RowsCertificate generatedWholeBandMaterial.newInitialMatrix
      (WholeBandCache.calculatedAO generatedWholeBandMaterial.newInitialCache) ∧
    type_of% WholeBandCache.Call0.matrix_gradient_report ∧ type_of% WholeBandCache.Call0.matrix_hessian_report :=
  ⟨wholeBandRuntime_sourceCertificate.1, wholeBandRuntime_sourceCertificate.2.certifiedAddresses,
    wholeBandRuntime_sourceCertificate.2.actualFields, wholeBandRuntime_sourceCertificate.2.newInitialOrbitals,
    wholeBandRuntime_sourceCertificate.2.newInitialCalculation,
    wholeBandRuntime_sourceCertificate.2.newInitialGradient, wholeBandRuntime_sourceCertificate.2.newInitialHessian⟩

theorem wholeBandRuntime_seed_geometry :
    type_of% (wholeBandRuntimeFace_factorizes wholeBandRuntimeSeed (.component .certificate)) ∧
    type_of% source_cells_in_segments ∧
    (∀ c, (generatedWholeBandMaterial.cellDomains c).Nonempty) ∧
    (∀ c d p q, p ∈ generatedWholeBandMaterial.cellDomains c → q ∈ generatedWholeBandMaterial.cellDomains d →
      (generatedWholeBandMaterial.cellSeeds c p = generatedWholeBandMaterial.cellSeeds d q ↔
        p 0 = q 0 ∧ p 1 = q 1)) ∧
    type_of% seam_seed_agrees ∧ type_of% distinct_coordinates_not_folded ∧
    type_of% seed_derivative_kernel_exact ∧ type_of% seed_surface_derivative_injective ∧
    generatedWholeBandMaterial.cellSeeds 16 = ContinuousParameterMap.initialMap 0 4 :=
  ⟨wholeBandRuntime_sourceCertificate.1, wholeBandRuntime_sourceCertificate.2.cellIncidence,
    wholeBandRuntime_sourceCertificate.2.nonemptyCells, wholeBandRuntime_sourceCertificate.2.seedClassification,
    wholeBandRuntime_sourceCertificate.2.seamCommuting, wholeBandRuntime_sourceCertificate.2.noSeedFold,
    wholeBandRuntime_sourceCertificate.2.derivativeKernel, wholeBandRuntime_sourceCertificate.2.surfaceImmersion,
    wholeBandRuntime_sourceCertificate.2.originalSeed⟩

end
end LAlanine40K2025.BasinRefinement.WholeBandRuntime
end SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Molecule
